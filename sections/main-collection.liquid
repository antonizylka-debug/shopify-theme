{%- liquid
  assign current_filter_size = 0

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
-%}

<div
  class="collection-content"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
>
  <div id="CollectionAjaxContent">
    <div class="page-width">
      {%- liquid
        assign links_block = blank
        assign subcollections_block = blank
        for block in section.blocks
          if block.type == 'collection_links' and block.settings.menu != blank
            assign links_block = block
          endif
          if block.type == 'subcollections'
            assign subcollections_block = block
          endif
        endfor

        comment
          Rzad podkolekcji chowamy przy aktywnych filtrach i na dalszych stronach.
          canonical_url zawiera page= dopiero od drugiej strony.
        endcomment
        assign show_subcollections = false
        if subcollections_block != blank and current_filter_size == 0
          unless canonical_url contains 'page='
            assign show_subcollections = true
          endunless
        endif

        assign sort_in_row = section.settings.enable_sort
      -%}

      {%- if show_subcollections -%}
        {%- render 'subcollections',
          per_row: subcollections_block.settings.subcollections_per_row,
          menu: subcollections_block.settings.menu
        -%}
      {%- endif -%}

      {%- if links_block != blank or sort_in_row -%}
        <div class="collection-links-row">
          {%- if links_block != blank -%}
            {%- assign links_menu = linklists[links_block.settings.menu] -%}
            <nav class="collection-links collection-links--{{ links_block.settings.alignment }}" {{ links_block.shopify_attributes }}>
              {%- for menu_link in links_menu.links -%}
                {%- liquid
                  comment
                    Pigulka jest aktywna takze na podstronach kolekcji nadrzednej,
                    np. WOMEN'S zostaje czarne na /collections/womens-dresses.
                  endcomment
                  assign link_is_current = false

                  assign link_url_clean = menu_link.url | split: '?' | first
                  if menu_link.active or menu_link.child_active
                    assign link_is_current = true
                  elsif collection.handle == 'all' and link_url_clean contains '/collections/all'
                    # "ALL" na stronie wszystkich produktow (kolekcja wirtualna)
                    assign link_is_current = true
                  elsif collection.handle == 'all' and link_url_clean == '/collections'
                    assign link_is_current = true
                  elsif menu_link.url == collection.url
                    assign link_is_current = true
                  elsif menu_link.url contains '/collections/'
                    assign link_handle = menu_link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first

                    if link_handle != blank and link_handle != 'all'
                      assign link_prefix = link_handle | append: '-'
                      assign link_prefix_size = link_prefix.size
                      assign collection_head = collection.handle | slice: 0, link_prefix_size

                      if collection_head == link_prefix
                        assign link_is_current = true
                      endif
                    endif
                  endif
                -%}
                <a
                  href="{{ menu_link.url }}"
                  class="collection-links__item{% if link_is_current %} collection-links__item--current{% endif %}"
                  {% if link_is_current %}aria-current="page"{% endif %}
                >{{ menu_link.title | escape }}</a>
              {%- endfor -%}
            </nav>
          {%- endif -%}

          {%- if section.settings.enable_sidebar and collection.filters.size > 0 -%}
            {%- comment -%}
              Na telefonie: FILTER i SORTÉR obok siebie, po polowie szerokosci,
              jak u Oliver & Blake. Na desktopie filtry sa w kolumnie, wiec
              przycisk jest ukryty.
            {%- endcomment -%}
            <button type="button" class="collection-toolbar__filter js-drawer-open-collection-filters" aria-controls="FilterDrawer">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 20 14" width="18" height="13"><path d="M1 1h18M4 7h12M7.5 13h5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              <span>{{ 'collections.filters.title_tags' | t }}{% if current_filter_size > 0 %} ({{ current_filter_size }}){% endif %}</span>
            </button>
          {%- endif -%}
          {%- if sort_in_row -%}
            <div class="collection-links-row__sort">
              {%- liquid
                assign sort_by = collection.sort_by | default: collection.default_sort_by
                assign sort_name = ''
                for option in collection.sort_options
                  if option.value == sort_by
                    assign sort_name = option.name
                  endif
                endfor
              -%}
              <label for="SortBy" class="hidden-label">{{ 'collections.sorting.title' | t }}</label>
              {%- comment -%}
                Wlasna lista sortowania jak u Oliver & Blake (przycisk + panel z
                ptaszkiem przy wybranej opcji). Prawdziwy select #SortBy zostaje
                ukryty - motyw nasluchuje jego zmiany i przeladowuje produkty.
              {%- endcomment -%}
              <button type="button" class="sort-box__label" data-sort-toggle aria-haspopup="listbox" aria-expanded="false">
                <span class="sort-box__prefix">{{ 'collections.sorting.title' | t }}:</span>
                <span class="sort-box__value" data-sort-current>{{ sort_name }}</span>
                <svg class="sort-box__chevron" aria-hidden="true" focusable="false" viewBox="0 0 12 8" width="11" height="7"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
              <ul class="sort-menu" role="listbox" data-sort-menu hidden>
                {%- for option in collection.sort_options -%}
                  <li role="option" aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}">
                    <button type="button" class="sort-menu__item{% if option.value == sort_by %} is-current{% endif %}" data-sort-value="{{ option.value }}">
                      <span>{{ option.name }}</span>
                      <svg class="sort-menu__check" aria-hidden="true" focusable="false" viewBox="0 0 14 10" width="13" height="9"><path d="m1 5 4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
              <select name="SortBy" id="SortBy" data-default-sortby="{{ collection.default_sort_by }}">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- render 'active-filters-row', filters: collection.filters -%}

      <div class="grid">
        <div class="grid__item medium-up--one-fifth grid__item--sidebar">
          {%- render 'collection-grid-filters',
            collection: collection,
            enable_sidebar: section.settings.enable_sidebar,
            filter_style: section.settings.filter_style,
            collapsed: section.settings.collapsed,
            enable_color_swatches: section.settings.enable_color_swatches,
            enable_swatch_labels: section.settings.enable_swatch_labels,
            group_colors: section.settings.group_colors
          -%}
        </div>
        <div class="grid__item medium-up--four-fifths grid__item--content">
          {%- liquid
            for block in section.blocks
              case block.type
              when 'product_grid'
                assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
              endcase
            endfor
          -%}
          {%- paginate collection.products by paginate_by -%}
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }} {%- if block.type == 'product-grid' -%}data-scroll-to{%- endif -%}>
              {%- case block.type -%}
              {%- when 'collection_description' -%}
                {%- if collection.description != blank and current_filter_size == 0 -%}
                  <div class="rte collection__description">
                    {{ collection.description }}
                  </div>
                {%- endif -%}
              {%- when 'collection_links' -%}
                {%- comment -%} renderowane wyzej, w pasku pelnej szerokosci {%- endcomment -%}
                {%- if false -%}
                  {%- assign links_menu = linklists[block.settings.menu] -%}
                  {%- if links_menu.links.size > 0 -%}
                    <nav class="collection-links collection-links--{{ block.settings.alignment }}" aria-label="{{ block.settings.menu }}">
                      {%- for menu_link in links_menu.links -%}
                        {%- assign is_current = false -%}
                        {%- if menu_link.url == collection.url -%}
                          {%- assign is_current = true -%}
                        {%- endif -%}
                        <a
                          href="{{ menu_link.url }}"
                          class="collection-links__item{% if is_current %} collection-links__item--current{% endif %}"
                          {% if is_current %}aria-current="page"{% endif %}
                        >{{ menu_link.title | escape }}</a>
                      {%- endfor -%}
                    </nav>
                  {%- endif -%}
                {%- endif -%}
              {%- when 'subcollections' -%}
                {%- comment -%}
                  Renderowany wyzej, nad rzedem pigulek i poza kolumna z siatka,
                  zeby zajmowal cala szerokosc kontenera strony.
                {%- endcomment -%}
              {%- when 'product_grid' -%}
                <div data-scroll-to>
                  {% render 'collection-grid',
                    collection: collection,
                    items: collection.products,
                    enable_sidebar: section.settings.enable_sidebar,
                    filter_style: section.settings.filter_style,
                    enable_sort: false,
                    enable_collection_count: block.settings.enable_collection_count,
                    per_row: block.settings.per_row,
                    mobile_flush_grid: block.settings.mobile_flush_grid,
                    quick_shop_enable: settings.quick_shop_enable
                  %}
                  {%- if paginate.pages > 1 -%}
                    {%- assign pagination_type = block.settings.pagination_type | default: 'load_more' -%}
                    {%- if pagination_type == 'pages' -%}
                      {%- render 'pagination', paginate: paginate -%}
                    {%- else -%}
                      {%- render 'load-more', paginate: paginate, mode: pagination_type, section_id: section.id -%}
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_sidebar == false or section.settings.filter_style == 'drawer' or collection.filters.size == 0 -%}
{% comment %}
  Override grid styles if sidebar is disabled
{% endcomment %}
{% style %}
  .collection-content .grid__item--sidebar { width: 0; padding:0; }
  .collection-content .grid__item--content { width: 100%; }
  .grid__item--sidebar { position: static; overflow: hidden; }
{% endstyle %}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "CollectionPage",
  {% if collection.description != blank %}
    "description": {{ collection.description | strip_html | json }},
  {% endif %}
  {% if page_image %}
    {% assign image_size = page_image.width | append: 'x' %}
    "image": {
      "@type": "ImageObject",
      "height": {{ page_image.height | json }},
      "url": {{ page_image | img_url: image_size | prepend: "https:" | json }},
      "width": {{ page_image.width | json }}
    },
  {% endif %}
  "name": {{ collection.title | json }}
}
</script>

{% style %}
  .collection-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin: 18px 0 30px;
  }

  .collection-links--center {
    justify-content: center;
  }

  .collection-links__item {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.32em;
    text-decoration-thickness: 1px;
    opacity: 0.75;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .collection-links__item:hover,
  .collection-links__item:focus {
    opacity: 1;
  }

  .collection-links__item--current {
    opacity: 1;
    font-weight: 600;
  }

  @media only screen and (max-width: 768px) {
    .collection-links {
      gap: 10px 20px;
      margin: 14px 0 24px;
    }

    .collection-links__item {
      font-size: 12px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-collection.settings.header_filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar",
      "label": "t:sections.main-collection.settings.enable_sidebar.label",
      "default": true,
      "info": "t:sections.main-collection.settings.enable_sidebar.info"
    },
    {
      "type": "checkbox",
      "id": "collapsed",
      "label": "t:sections.main-collection.settings.collapsed.label",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "t:sections.main-collection.settings.filter_style.label",
      "default": "sidebar",
      "options": [
        {
          "value": "sidebar",
          "label": "t:sections.main-collection.settings.filter_style.options.sidebar.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection.settings.filter_style.options.drawer.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "t:sections.main-collection.settings.enable_color_swatches.label",
      "info": "t:sections.main-collection.settings.enable_color_swatches.info"
    },
    {
      "type": "checkbox",
      "id": "enable_swatch_labels",
      "label": "t:common.enable_swatch_labels.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "group_colors",
      "label": "Group colour filter values",
      "default": true,
      "info": "Army Green, Olive Green and Green become one GREEN swatch."
    },
    {
      "type": "select",
      "id": "size_filter_mode",
      "label": "Filtr rozmiarów: rodzaj kolekcji",
      "info": "Ustala, jak liczby w filtrze Størrelse są grupowane. Automatycznie = według uchwytu kolekcji.",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automatycznie" },
        { "value": "womens_department", "label": "Dział damski (Dame, Nyheder, Udsalg…)" },
        { "value": "mens_department", "label": "Dział męski (Herre, Nyheder, Udsalg…)" },
        { "value": "womens_clothing", "label": "Odzież damska (UK → EU)" },
        { "value": "mens_clothing", "label": "Odzież męska" },
        { "value": "footwear", "label": "Buty (Sko EU)" },
        { "value": "bottoms", "label": "Spodnie (Talje)" },
        { "value": "accessories", "label": "Akcesoria" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:sections.main-collection.settings.enable_sort.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection_description",
      "name": "t:sections.main-collection.blocks.collection_description.name",
      "limit": 1
    },
    {
      "type": "product_grid",
      "name": "t:sections.main-collection.blocks.products.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_collection_count",
          "label": "t:sections.main-collection.blocks.products.settings.enable_collection_count.label",
          "default": true
        },
        {
          "type": "range",
          "id": "per_row",
          "label": "t:sections.main-collection.blocks.products.settings.per_row.label",
          "default": 4,
          "min": 2,
          "max": 5,
          "step": 1
        },
        {
          "type": "range",
          "id": "rows_per_page",
          "label": "t:sections.main-collection.blocks.products.settings.rows_per_page.label",
          "default": 7,
          "min": 3,
          "max": 20,
          "step": 1
        },
        {
          "type": "checkbox",
          "id": "mobile_flush_grid",
          "label": "t:sections.main-collection.blocks.products.settings.mobile_flush_grid.label",
          "default": false
        },
        {
          "type": "select",
          "id": "pagination_type",
          "label": "Kolejne produkty",
          "default": "load_more",
          "options": [
            { "value": "load_more", "label": "Przycisk „Vis flere”" },
            { "value": "infinite", "label": "Automatycznie przy przewijaniu" },
            { "value": "pages", "label": "Numery stron" }
          ]
        }
      ],
      "limit": 1
    },
    {
      "type": "collection_links",
      "name": "Collection links",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Utworz menu w Content > Menus z linkami do kolekcji."
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ]
        }
      ]
    },
    {
      "type": "subcollections",
      "name": "t:sections.main-collection.blocks.subcollections.name",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu with subcollections",
          "info": "Children of the active menu item are shown as a row. Defaults to the main menu."
        },
        {
          "type": "paragraph",
          "content": "t:sections.main-collection.blocks.subcollections.settings.content"
        },
        {
          "type": "range",
          "id": "subcollections_per_row",
          "label": "t:sections.main-collection.blocks.subcollections.settings.subcollections_per_row.label",
          "default": 5,
          "min": 2,
          "max": 5,
          "step": 1
        }
      ],
      "limit": 1
    }
  ]
}
{% endschema %}
