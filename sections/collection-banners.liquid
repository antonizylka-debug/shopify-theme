{%- liquid
  assign columns = section.settings.columns | default: 2
  assign gap = section.settings.gap | default: 30
  assign ratio = section.settings.image_ratio | default: '3 / 2'
  assign fixed_height = section.settings.banner_height | default: 0
  assign fixed_height_mobile = section.settings.banner_height_mobile | default: 0
-%}

<style>
  #CollectionBanners--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
  }

  #CollectionBanners--{{ section.id }} .collection-banners {
    display: grid;
    grid-template-columns: repeat({{ columns }}, minmax(0, 1fr));
    gap: {{ gap }}px;
  }

  #CollectionBanners--{{ section.id }} .collection-banner {
    position: relative;
    display: block;
    overflow: hidden;
    {% if fixed_height > 0 %}height: {{ fixed_height }}px;{% else %}aspect-ratio: {{ ratio }};{% endif %}
    background: #8d8a83;
    text-decoration: none;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: transform 0.6s cubic-bezier(0.2, 0.06, 0.05, 0.95);
  }

  #CollectionBanners--{{ section.id }} .collection-banner image-element {
    display: block;
    height: 100%;
  }

  #CollectionBanners--{{ section.id }} .collection-banner:hover .collection-banner__image {
    transform: scale(1.03);
  }

  #CollectionBanners--{{ section.id }} .collection-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: {% if section.settings.text_position == 'middle' %}linear-gradient(to right, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0) 65%){% else %}linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 55%){% endif %};
    pointer-events: none;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: {{ section.settings.content_padding | default: 40 }}px;
    {% if section.settings.text_position == 'middle' %}
      top: 0;
      justify-content: center;
    {% endif %}
  }

  #CollectionBanners--{{ section.id }} .collection-banner__eyebrow {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__heading {
    margin-bottom: 10px;
    font-size: {{ section.settings.heading_size | default: 26 }}px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__text {
    margin-bottom: 20px;
    font-size: 15px;
    line-height: 1.45;
    opacity: 0.92;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 26px;
    background: #ffffff;
    color: #16150f;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s ease;
  }

  #CollectionBanners--{{ section.id }} .collection-banner:hover .collection-banner__btn {
    background: #f2f0ec;
  }

  #CollectionBanners--{{ section.id }} .collection-banner__arrow {
    width: 24px;
    height: 12px;
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  #CollectionBanners--{{ section.id }} .collection-banner:hover .collection-banner__arrow {
    transform: translateX(4px);
  }

  @media only screen and (max-width: 768px) {
    #CollectionBanners--{{ section.id }} .collection-banners {
      grid-template-columns: minmax(0, 1fr);
      gap: {{ gap | at_most: 20 }}px;
    }

    {% if fixed_height_mobile > 0 %}
    #CollectionBanners--{{ section.id }} .collection-banner {
      height: {{ fixed_height_mobile }}px;
      aspect-ratio: auto;
    }
    {% endif %}

    #CollectionBanners--{{ section.id }} .collection-banner__content {
      padding: 24px;
    }

    #CollectionBanners--{{ section.id }} .collection-banner__heading {
      font-size: {{ section.settings.heading_size | default: 26 | times: 0.8 | round }}px;
    }
  }
</style>

<div id="CollectionBanners--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="collection-banners">
  <div class="{% if section.settings.full_width %}page-width page-width--flush{% else %}page-width{% endif %}">
    {%- if section.settings.title != blank -%}
      <h2 class="h3 text-center">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="collection-banners">
      {%- for block in section.blocks -%}
        {%- liquid
          assign banner_collection = block.settings.collection

          assign banner_image = block.settings.image
          if banner_image == blank and banner_collection.image != blank
            assign banner_image = banner_collection.image
          endif
          if banner_image == blank and banner_collection.products.first.featured_image != blank
            assign banner_image = banner_collection.products.first.featured_image
          endif

          assign banner_heading = block.settings.heading
          if banner_heading == blank
            assign banner_heading = banner_collection.title
          endif

          assign banner_url = block.settings.link
          if banner_url == blank
            assign banner_url = banner_collection.url
          endif
        -%}

        <a
          href="{{ banner_url | default: '#' }}"
          class="collection-banner"
          style="color: {{ block.settings.text_color | default: '#ffffff' }};"
          {{ block.shopify_attributes }}
        >
          {%- if banner_image != blank -%}
            {%- render 'image-element',
              img: banner_image,
              sizeVariable: '50vw',
              alt: banner_heading,
              classes: 'collection-banner__image'
            -%}
          {%- endif -%}

          <span class="collection-banner__content">
            {%- if block.settings.eyebrow != blank -%}
              <span class="collection-banner__eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {%- endif -%}

            {%- if banner_heading != blank -%}
              <span class="collection-banner__heading">{{ banner_heading | escape }}</span>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <span class="collection-banner__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <span class="collection-banner__btn">
                {{ block.settings.button_label | escape }}
                <svg aria-hidden="true" focusable="false" role="presentation" class="collection-banner__arrow" viewBox="0 0 24 12"><path d="M0 6h22M17.5 1.5 22 6l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection banners",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "info": "Leave empty to hide."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Banners per row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between banners",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "3 / 2",
      "options": [
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "16 / 9", "label": "Wide" },
        { "value": "21 / 9", "label": "Extra wide" },
        { "value": "3.6 / 1", "label": "Banner strip" }
      ]
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Fixed height (desktop)",
      "min": 0,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = use Image shape above."
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Fixed height (mobile)",
      "min": 0,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "default": "bottom",
      "options": [
        { "value": "bottom", "label": "Bottom left" },
        { "value": "middle", "label": "Middle left" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Text inset",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Image, heading and link are taken from it unless set below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small text above heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text under heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
