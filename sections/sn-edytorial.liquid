{%- comment -%}
  Edytorialowy baner na stronie produktu (06.10.2026, zamiast sn-kampagne,
  ktore Antoni uznal za amatorskie): duze zdjecie na cala szerokosc, na nim
  maly nadtytul, jedno zdanie, krotki opis i dyskretny link. Bez progow,
  licznika i hasel - rabat za ilosc jest przy cenie, w koszyku i w kolekcjach.

  Zdjecie: z ustawienia, a gdy puste - plik stilhusetnord-homepage-hero.webp
  z Content > Files (ten sam, ktory byl w poprzednim banerze).
{%- endcomment -%}
{%- liquid
  assign foto = section.settings.image
  if foto == blank
    assign foto = images['stilhusetnord-homepage-hero.webp']
  endif
  assign nadtytul = section.settings.overline
  if nadtytul == blank
    assign nadtytul = settings.campaign_name | split: '·' | first | strip
  endif
  assign link = section.settings.link | default: routes.all_products_collection_url
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .sne { margin: {{ section.settings.space_top }}px 0 {{ section.settings.space_bottom }}px; }
  #shopify-section-{{ section.id }} .sne__media {
    position: relative; overflow: hidden; background: #1c1d1d;
    aspect-ratio: {{ section.settings.ratio }};
  }
  #shopify-section-{{ section.id }} .sne__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transform: scale(1.02); transition: transform 1.6s cubic-bezier(.2, .7, .2, 1);
  }
  #shopify-section-{{ section.id }} .sne:hover .sne__img { transform: scale(1); }
  #shopify-section-{{ section.id }} .sne__cien {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.25) 42%, rgba(0, 0, 0, 0) 70%);
  }
  #shopify-section-{{ section.id }} .sne__txt {
    position: absolute; left: 0; bottom: 0; top: 0;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
    width: min(560px, 100%); padding: 0 0 72px 80px; color: #ffffff;
  }
  #shopify-section-{{ section.id }} .sne__over {
    margin: 0 0 18px; font-size: 11px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }
  #shopify-section-{{ section.id }} .sne__tytul {
    max-width: 11ch; margin: 0 0 18px; font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: 54px; font-weight: 400; line-height: 1.04; letter-spacing: -0.02em; text-transform: none;
    text-wrap: balance; color: #ffffff;
  }
  #shopify-section-{{ section.id }} .sne__tekst { max-width: 36ch; margin: 0 0 30px; font-size: 15px; line-height: 1.65; color: rgba(255, 255, 255, 0.82); }
  #shopify-section-{{ section.id }} .sne__link {
    display: inline-flex; align-items: center; gap: 12px; padding: 0 0 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.7); color: #ffffff; text-decoration: none;
    font-size: 12px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase;
    transition: border-color 0.25s ease, gap 0.25s ease;
  }
  #shopify-section-{{ section.id }} .sne__link:hover { gap: 18px; border-color: #ffffff; }
  #shopify-section-{{ section.id }} .sne__link svg { width: 15px; height: 15px; }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .sne { margin: {{ section.settings.space_top_mobile }}px 0 {{ section.settings.space_bottom_mobile }}px; }
    #shopify-section-{{ section.id }} .sne__media { aspect-ratio: 4 / 5; }
    #shopify-section-{{ section.id }} .sne__cien { background: linear-gradient(0deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.2) 45%, rgba(0, 0, 0, 0) 70%); }
    #shopify-section-{{ section.id }} .sne__txt { top: auto; width: 100%; padding: 0 24px 34px; }
    #shopify-section-{{ section.id }} .sne__over { margin-bottom: 12px; font-size: 10px; }
    #shopify-section-{{ section.id }} .sne__tytul { font-size: 34px; margin-bottom: 12px; }
    #shopify-section-{{ section.id }} .sne__tekst { font-size: 14px; margin-bottom: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sne__img { transform: none; transition: none; }
  }
{%- endstyle -%}

<div class="sne">
  <div class="sne__media">
    {%- if foto != blank -%}
      {{ foto | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.heading, class: 'sne__img' }}
    {%- endif -%}
    <div class="sne__cien" aria-hidden="true"></div>
    <div class="sne__txt">
      {%- if nadtytul != blank -%}<p class="sne__over">{{ nadtytul | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sne__tytul">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="sne__tekst">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="sne__link" href="{{ link }}">
          {{ section.settings.link_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty = stilhusetnord-homepage-hero.webp from Files." },
    {
      "type": "select", "id": "image_position", "label": "Photo focus", "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "ratio", "label": "Height (computer)", "default": "21 / 9",
      "options": [
        { "value": "21 / 9", "label": "Low" },
        { "value": "16 / 7", "label": "Medium" },
        { "value": "16 / 9", "label": "Tall" }
      ]
    },
    { "type": "text", "id": "overline", "label": "Small line above", "info": "Empty = campaign name from theme settings." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Køb flere, spar op til 30 %" },
    { "type": "text", "id": "text", "label": "Text", "default": "Bland frit – rabatten trækkes automatisk i kurven." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Se kollektionen" },
    { "type": "url", "id": "link", "label": "Link goes to" },
    { "type": "range", "id": "space_top", "label": "Space above", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_bottom", "label": "Space below", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_top_mobile", "label": "Space above (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_bottom_mobile", "label": "Space below (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}
