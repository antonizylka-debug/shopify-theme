{%- comment -%}
  Edytorialowy baner na stronie produktu (06.10.2026, zamiast sn-kampagne,
  ktore Antoni uznal za amatorskie): duze zdjecie na cala szerokosc, na nim
  nadtytul z czerwona kropka, duzy licznik do konca kampanii, tytul, jedno
  zdanie i bialy przycisk, ktory przewija do wyboru rozmiaru i "Laeg i kurv".

  Licznik liczy do prawdziwej daty z Ustawien motywu > Campaign > Campaign
  ends at. Bez daty albo po terminie znika (nadtytul zostaje).

  Zdjecie: z ustawienia, a gdy puste - plik stilhusetnord-homepage-hero.webp
  z Content > Files (ten sam, ktory byl w poprzednim banerze).
{%- endcomment -%}
{%- liquid
  assign foto = section.settings.image
  if foto == blank
    assign foto = images['stilhusetnord-homepage-hero.webp']
  endif
  assign nadtytul = section.settings.overline
  if nadtytul == blank
    assign nadtytul = settings.campaign_name | split: '·' | first | strip
  endif
  assign link = section.settings.link | default: routes.all_products_collection_url
  assign id_s = section.id
  case section.settings.ratio
    when '16 / 9'
      assign wysokosc_vw = 56.25
    when '16 / 7'
      assign wysokosc_vw = 43.75
    else
      assign wysokosc_vw = 42.86
  endcase
-%}
{%- style -%}
  #shopify-section-{{ id_s }} .sne { margin: {{ section.settings.space_top }}px 0 {{ section.settings.space_bottom }}px; }
  #shopify-section-{{ id_s }} .sne__media {
    position: relative; overflow: hidden; background: #1c1d1d;
    /* bez aspect-ratio + min-height: razem rozpychaly baner wszerz (1307 px przy 1024) */
    width: 100%; height: clamp(560px, {{ wysokosc_vw }}vw, 820px);
  }
  #shopify-section-{{ id_s }} .sne__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transform: scale(1.02); transition: transform 1.6s cubic-bezier(.2, .7, .2, 1);
  }
  #shopify-section-{{ id_s }} .sne:hover .sne__img { transform: scale(1); }
  #shopify-section-{{ id_s }} .sne__cien {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.66) 0%, rgba(0, 0, 0, 0.36) 45%, rgba(0, 0, 0, 0) 75%);
  }
  #shopify-section-{{ id_s }} .sne__txt {
    position: absolute; left: 0; top: 0; bottom: 0;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    width: min(600px, 100%); padding: 48px 0 48px 80px; color: #ffffff;
  }
  #shopify-section-{{ id_s }} .sne__over {
    display: flex; align-items: center; gap: 10px; margin: 0 0 16px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: #ffffff;
  }
  #shopify-section-{{ id_s }} .sne__dot { position: relative; width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #d6332e; }
  #shopify-section-{{ id_s }} .sne__dot::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%; background: #d6332e;
    animation: sne-puls 1.6s ease-out infinite;
  }
  @keyframes sne-puls { from { transform: scale(1); opacity: 0.8; } to { transform: scale(3); opacity: 0; } }

  #shopify-section-{{ id_s }} .sne__zegar {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0 0 26px;
    border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(0, 0, 0, 0.28);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  #shopify-section-{{ id_s }} .sne__zegar[hidden] { display: none; }
  #shopify-section-{{ id_s }} .sne__pole { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 78px; padding: 12px 10px 10px; }
  #shopify-section-{{ id_s }} .sne__pole + .sne__pole { border-left: 1px solid rgba(255, 255, 255, 0.22); }
  #shopify-section-{{ id_s }} .sne__liczba {
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback); font-size: 34px; font-weight: 400; line-height: 1;
    font-variant-numeric: tabular-nums; color: #ffffff;
  }
  #shopify-section-{{ id_s }} .sne__jedn { font-size: 9.5px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); }

  #shopify-section-{{ id_s }} .sne__tytul {
    max-width: 12ch; margin: 0 0 14px; font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: 52px; font-weight: 400; line-height: 1.04; letter-spacing: -0.02em; text-transform: none;
    text-wrap: balance; color: #ffffff;
  }
  #shopify-section-{{ id_s }} .sne__tekst { max-width: 38ch; margin: 0 0 28px; font-size: 15px; line-height: 1.65; color: rgba(255, 255, 255, 0.85); }
  #shopify-section-{{ id_s }} .sne__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 14px;
    min-height: 56px; padding: 0 44px; border: 1px solid #ffffff; background: #ffffff; color: #1c1d1d;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: background-color 0.25s ease, color 0.25s ease, gap 0.25s ease;
  }
  #shopify-section-{{ id_s }} .sne__btn:hover { background: transparent; color: #ffffff; gap: 20px; }
  #shopify-section-{{ id_s }} .sne__btn svg { width: 16px; height: 16px; }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ id_s }} .sne { margin: {{ section.settings.space_top_mobile }}px 0 {{ section.settings.space_bottom_mobile }}px; }
    #shopify-section-{{ id_s }} .sne__media { height: auto; aspect-ratio: 4 / 5.6; }
    #shopify-section-{{ id_s }} .sne__cien { background: linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.42) 50%, rgba(0, 0, 0, 0.05) 80%); }
    #shopify-section-{{ id_s }} .sne__txt { top: auto; justify-content: flex-end; width: 100%; padding: 0 18px 24px; }
    #shopify-section-{{ id_s }} .sne__over { margin-bottom: 12px; font-size: 10px; letter-spacing: 0.22em; }
    #shopify-section-{{ id_s }} .sne__zegar { width: 100%; margin-bottom: 18px; }
    #shopify-section-{{ id_s }} .sne__pole { min-width: 0; padding: 10px 4px 8px; }
    #shopify-section-{{ id_s }} .sne__liczba { font-size: 26px; }
    #shopify-section-{{ id_s }} .sne__jedn { font-size: 8.5px; letter-spacing: 0.14em; }
    #shopify-section-{{ id_s }} .sne__tytul { font-size: 32px; margin-bottom: 10px; }
    #shopify-section-{{ id_s }} .sne__tekst { font-size: 14px; margin-bottom: 18px; }
    #shopify-section-{{ id_s }} .sne__btn { width: 100%; min-height: 54px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ id_s }} .sne__img { transform: none; transition: none; }
    #shopify-section-{{ id_s }} .sne__dot::after { animation: none; }
  }
{%- endstyle -%}

<div class="sne" id="sne-{{ id_s }}">
  <div class="sne__media">
    {%- if foto != blank -%}
      {{ foto | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.heading, class: 'sne__img' }}
    {%- endif -%}
    <div class="sne__cien" aria-hidden="true"></div>
    <div class="sne__txt">
      {%- if nadtytul != blank -%}
        <p class="sne__over"><span class="sne__dot" aria-hidden="true"></span>{{ nadtytul | escape }}{% if settings.campaign_end != blank %} · {{ section.settings.timer_label | escape }}{% endif %}</p>
      {%- endif -%}

      {%- if settings.campaign_end != blank -%}
        <div class="sne__zegar" data-sne-zegar data-slut="{{ settings.campaign_end | escape }}" role="timer" aria-label="{{ section.settings.timer_label | escape }}" hidden>
          <span class="sne__pole"><span class="sne__liczba" data-sne-d>00</span><span class="sne__jedn">Dage</span></span>
          <span class="sne__pole"><span class="sne__liczba" data-sne-t>00</span><span class="sne__jedn">Timer</span></span>
          <span class="sne__pole"><span class="sne__liczba" data-sne-m>00</span><span class="sne__jedn">Min</span></span>
          <span class="sne__pole"><span class="sne__liczba" data-sne-s>00</span><span class="sne__jedn">Sek</span></span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}<h2 class="sne__tytul">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="sne__tekst">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="sne__btn" href="{% if section.settings.button_action == 'scroll' %}#{% else %}{{ link }}{% endif %}"{% if section.settings.button_action == 'scroll' %} data-sne-do-koszyka{% endif %}>
          {{ section.settings.link_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var ramka = document.getElementById('sne-{{ id_s }}');
    if (!ramka) return;

    /* licznik do prawdziwej daty konca kampanii */
    var zegar = ramka.querySelector('[data-sne-zegar]');
    if (zegar) {
      var m = (zegar.getAttribute('data-slut') || '').match(/(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T]+(\d{1,2})[:.](\d{2}))?/);
      var koniec = m ? (m[4] ? new Date(+m[1], m[2] - 1, +m[3], +m[4], +m[5], 0) : new Date(+m[1], m[2] - 1, +m[3], 23, 59, 59)) : null;
      var dwa = function (x) { return (x < 10 ? '0' : '') + x; };
      var tik = function () {
        var s = koniec ? Math.floor((koniec - new Date()) / 1000) : 0;
        if (s <= 0) { zegar.hidden = true; return false; }
        var d = Math.floor(s / 86400); s -= d * 86400;
        var h = Math.floor(s / 3600); s -= h * 3600;
        var mi = Math.floor(s / 60); s -= mi * 60;
        zegar.querySelector('[data-sne-d]').textContent = dwa(d);
        zegar.querySelector('[data-sne-t]').textContent = dwa(h);
        zegar.querySelector('[data-sne-m]').textContent = dwa(mi);
        zegar.querySelector('[data-sne-s]').textContent = dwa(s);
        zegar.hidden = false;
        return true;
      };
      if (tik()) setInterval(tik, 1000);
    }

    /* przycisk przewija do wyboru rozmiaru i "Laeg i kurv" na tej stronie produktu */
    var btn = ramka.querySelector('[data-sne-do-koszyka]');
    if (btn) btn.addEventListener('click', function (e) {
      var cel = document.querySelector('[data-pdp-atc], .pdp__atc, form[action*="/cart/add"] [type="submit"]');
      if (!cel) { window.location.href = {{ link | json }}; return; }
      e.preventDefault();
      var blok = document.querySelector('.pdp__sizes') || cel;
      blok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function () { cel.focus({ preventScroll: true }); }, 600);
    });
  })();
</script>

{% schema %}
{
  "name": "Editorial banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty = stilhusetnord-homepage-hero.webp from Files. Use min. 2400 px wide." },
    {
      "type": "select", "id": "image_position", "label": "Photo focus", "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "ratio", "label": "Height (computer)", "default": "21 / 9",
      "options": [
        { "value": "21 / 9", "label": "Low" },
        { "value": "16 / 7", "label": "Medium" },
        { "value": "16 / 9", "label": "Tall" }
      ]
    },
    { "type": "text", "id": "overline", "label": "Small line above", "info": "Empty = campaign name from theme settings." },
    { "type": "text", "id": "timer_label", "label": "Words before the countdown", "default": "Slutter om", "info": "Countdown uses Theme settings > Campaign > Campaign ends at. No date = no countdown." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Køb flere, spar op til 30 %" },
    { "type": "text", "id": "text", "label": "Text", "default": "Bland frit – rabatten trækkes automatisk i kurven." },
    { "type": "text", "id": "link_label", "label": "Button", "default": "Køb nu" },
    {
      "type": "select", "id": "button_action", "label": "Button does", "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Scrolls to size and Add to cart" },
        { "value": "link", "label": "Opens the link below" }
      ]
    },
    { "type": "url", "id": "link", "label": "Link (if the button opens a link)" },
    { "type": "range", "id": "space_top", "label": "Space above", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_bottom", "label": "Space below", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_top_mobile", "label": "Space above (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" },
    { "type": "range", "id": "space_bottom_mobile", "label": "Space below (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}
