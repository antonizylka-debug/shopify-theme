{%- capture icon_return -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>{%- endcapture -%}
{%- capture icon_truck -%}<path d="M2.5 5.5h10v10h-10z"/><path d="M12.5 8.5h4l3.5 3.5v3.5h-7.5"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/>{%- endcapture -%}
{%- capture icon_chat -%}<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>{%- endcapture -%}
{%- capture icon_shield -%}<path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/>{%- endcapture -%}
{%- capture icon_clock -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{%- endcapture -%}
{%- capture icon_card -%}<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18"/>{%- endcapture -%}
{%- capture icon_lock -%}<rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} .ob-usp {
    padding: {{ section.settings.padding }}px 0;
    background: {{ section.settings.color_bg }};
    color: {{ section.settings.color_text }};
    {% if section.settings.show_border_top %}border-top: 1px solid {{ section.settings.color_line }};{% endif %}
    {% if section.settings.show_border_bottom %}border-bottom: 1px solid {{ section.settings.color_line }};{% endif %}
  }

  #shopify-section-{{ section.id }} .ob-usp__viewport {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ob-usp__track {
    display: flex;
  }

  #shopify-section-{{ section.id }} .ob-usp__set {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 100%;
  }

  /* kopia zestawu potrzebna tylko do plynnej petli na telefonie */
  #shopify-section-{{ section.id }} .ob-usp__set--dup {
    display: none;
  }

  #shopify-section-{{ section.id }} .ob-usp__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .ob-usp__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    {% if section.settings.icon_box %}border: 1px solid {{ section.settings.color_line }};{% endif %}
  }

  #shopify-section-{{ section.id }} .ob-usp__icon svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .ob-usp__copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .ob-usp__title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ob-usp__sub {
    font-size: 14px;
    line-height: 1.2;
    color: {{ section.settings.color_muted }};
  }

  #shopify-section-{{ section.id }} .ob-usp__divider {
    flex: 0 0 1px;
    width: 1px;
    height: 36px;
    background: {{ section.settings.color_line }};
  }
  /* kreska na koncu zestawu - tylko w petli na telefonie, miedzy zestawami */
  #shopify-section-{{ section.id }} .ob-usp__divider--end {
    display: none;
  }

  @media only screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .ob-usp {
      padding: {{ section.settings.padding_mobile }}px 0;
    }

    #shopify-section-{{ section.id }} .ob-usp__inner {
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .ob-usp__track {
      /* szerokosc tresci (dwa identyczne zestawy): -50% to dokladnie jeden zestaw.
         Wczesniej zestaw mial sztywne 100% ekranu, tresc byla szersza
         i kopia nachodzila na oryginal */
      width: max-content;
      animation: ob-usp-scroll-{{ section.id }} {{ section.settings.scroll_seconds }}s linear infinite;
    }

    #shopify-section-{{ section.id }} .ob-usp__set {
      flex: 0 0 auto;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .ob-usp__set--dup {
      display: flex;
    }

    #shopify-section-{{ section.id }} .ob-usp__item {
      flex: 0 0 auto;
      padding: 0 20px;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ob-usp__divider--end {
      display: block;
    }
  }

  @keyframes ob-usp-scroll-{{ section.id }} {
    0% { transform: translate3d(-50%, 0, 0); }
    100% { transform: translate3d(0, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ob-usp__track {
      animation: none;
    }
  }
{%- endstyle -%}

{%- capture usp_set -%}
  {%- for block in section.blocks -%}
    {%- unless forloop.first -%}
      <span class="ob-usp__divider" aria-hidden="true"></span>
    {%- endunless -%}

    <div class="ob-usp__item" {{ block.shopify_attributes }}>
      <span class="ob-usp__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          {%- case block.settings.icon -%}
            {%- when 'return' -%}{{ icon_return }}
            {%- when 'truck' -%}{{ icon_truck }}
            {%- when 'chat' -%}{{ icon_chat }}
            {%- when 'shield' -%}{{ icon_shield }}
            {%- when 'clock' -%}{{ icon_clock }}
            {%- when 'card' -%}{{ icon_card }}
            {%- when 'lock' -%}{{ icon_lock }}
            {%- else -%}{{ icon_box }}
          {%- endcase -%}
        </svg>
      </span>
      <span class="ob-usp__copy">
        <span class="ob-usp__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}
          <span class="ob-usp__sub">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endfor -%}
  <span class="ob-usp__divider ob-usp__divider--end" aria-hidden="true"></span>
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
  <div class="ob-usp">
    <div class="page-width ob-usp__inner">
      <div class="ob-usp__viewport">
        <div class="ob-usp__track">
          <div class="ob-usp__set">{{ usp_set }}</div>
          <div class="ob-usp__set ob-usp__set--dup" aria-hidden="true">{{ usp_set }}</div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Promise bar",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "padding", "label": "Padding (desktop)", "default": 25, "min": 0, "max": 80, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_mobile", "label": "Padding (mobile)", "default": 17, "min": 0, "max": 60, "step": 1, "unit": "px" },
    { "type": "checkbox", "id": "show_border_top", "label": "Line above", "default": true },
    { "type": "checkbox", "id": "show_border_bottom", "label": "Line below", "default": true },
    { "type": "checkbox", "id": "icon_box", "label": "Frame around icons", "default": true },
    { "type": "range", "id": "scroll_seconds", "label": "Mobile scroll speed", "default": 24, "min": 8, "max": 60, "step": 1, "unit": "s" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Heading", "default": "#1c1d1d" },
    { "type": "color", "id": "color_muted", "label": "Description", "default": "#6e6b65" },
    { "type": "color", "id": "color_line", "label": "Lines and icon frames", "default": "#e6e3de" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "box",
          "options": [
            { "value": "box", "label": "Parcel" },
            { "value": "return", "label": "Return" },
            { "value": "truck", "label": "Delivery" },
            { "value": "chat", "label": "Support" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "clock", "label": "Clock" },
            { "value": "card", "label": "Payment" },
            { "value": "lock", "label": "Secure" }
          ]
        },
        { "type": "text", "id": "title", "label": "Heading", "default": "Fast dispatch" },
        { "type": "text", "id": "text", "label": "Description", "default": "Dispatched in 3 to 4 days" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promise bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "box", "title": "Fast dispatch", "text": "Dispatched in 3 to 4 days" } },
        { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "text": "Within 14 days of delivery" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Tracked delivery", "text": "On every order" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Here to help", "text": "Monday to Friday" } }
      ]
    }
  ]
}
{% endschema %}
