{%- comment -%}
  Baner kampanii na stronie produktu. Od 06.10.2026 wersja luksusowa: czarny panel,
  biale napisy, cienkie linie (tlo z ustawienia musi byc ciemne). Pierwotnie
  (zamiast bloku tekstowego w stylu
  Iselle, ktory wygladal jak wpis na blogu): zdjecie obok tresci,
  czerwony naglowek akcji z licznikiem (Ustawienia motywu > Campaign),
  duzy tytul, jedno zdanie, progi jako kafle (najwyzszy w czerni),
  krotkie zasady z ptaszkami, przycisk i haslo.
  Telefon: zdjecie na gorze, kafle w jednym rzedzie, przycisk na cala szerokosc.
  Progi musza sie zgadzac z rabatami automatycznymi w Shopify.
{%- endcomment -%}
{%- liquid
  assign progi = section.settings.tiers | split: ','
  assign ma_foto = false
  if section.settings.image != blank
    assign ma_foto = true
  endif
-%}
{%- style -%}
  /* Wersja luksusowa (06.10.2026): czarny panel jak baner w kolekcji, duzo powietrza,
     cienkie linie zamiast kafli, czerwien tylko w kropce, bialy przycisk. */
  #shopify-section-{{ section.id }} .snk { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .snk__panel { display: grid; grid-template-columns: minmax(0, 1fr); background: {{ section.settings.color_bg }}; color: #ffffff; }
  #shopify-section-{{ section.id }} .snk__panel--foto { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); }
  #shopify-section-{{ section.id }} .snk__panel--right .snk__foto { order: 2; }
  #shopify-section-{{ section.id }} .snk__foto { position: relative; min-height: 520px; overflow: hidden; }
  #shopify-section-{{ section.id }} .snk__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.image_position }}; }
  #shopify-section-{{ section.id }} .snk__tresc { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 64px 76px; min-width: 0; }
  #shopify-section-{{ section.id }} .snk__panel:not(.snk__panel--foto) .snk__tresc { align-items: center; text-align: center; max-width: 720px; margin: 0 auto; }

  #shopify-section-{{ section.id }} .snk__brw {
    display: flex; align-items: center; gap: 10px; margin: 0;
    font-size: 11px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(255, 255, 255, 0.78);
  }
  #shopify-section-{{ section.id }} .snk__dot { position: relative; width: 6px; height: 6px; border-radius: 50%; background: #d6332e; flex: 0 0 6px; }
  #shopify-section-{{ section.id }} .snk__dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: #d6332e; animation: snk-puls 1.8s ease-out infinite; }
  @keyframes snk-puls { from { transform: scale(1); opacity: 0.7; } to { transform: scale(3); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .snk__dot::after { animation: none; } }
  #shopify-section-{{ section.id }} .snk__czas { display: block; margin: 10px 0 0; font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: #ffffff; }
  #shopify-section-{{ section.id }} .snk__czas[hidden] { display: none; }
  #shopify-section-{{ section.id }} .snk__czas b { font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0.12em; }
  #shopify-section-{{ section.id }} .snk__kreska { width: 44px; height: 1px; margin: 26px 0 24px; background: rgba(255, 255, 255, 0.35); }
  #shopify-section-{{ section.id }} .snk__panel:not(.snk__panel--foto) .snk__kreska { margin-left: auto; margin-right: auto; }

  #shopify-section-{{ section.id }} .snk__tytul {
    margin: 0 0 18px; font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: {{ section.settings.title_size }}px; font-weight: 400; line-height: 1.08; letter-spacing: -0.015em;
    text-transform: none; text-wrap: balance; color: #ffffff;
  }
  #shopify-section-{{ section.id }} .snk__tekst { margin: 0 0 36px; max-width: 42ch; font-size: 15.5px; line-height: 1.7; color: rgba(255, 255, 255, 0.7); text-wrap: pretty; }

  #shopify-section-{{ section.id }} .snk__progi {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr);
    width: 100%; max-width: 540px; margin: 0; padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18); border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    list-style: none;
  }
  #shopify-section-{{ section.id }} .snk__prog { display: flex; flex-direction: column; align-items: center; gap: 6px; margin: 0; padding: 0 10px; background: none; text-align: center; }
  #shopify-section-{{ section.id }} .snk__prog + .snk__prog { border-left: 1px solid rgba(255, 255, 255, 0.18); }
  #shopify-section-{{ section.id }} .snk__ile { font-size: 10.5px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); white-space: nowrap; }
  #shopify-section-{{ section.id }} .snk__proc { font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback); font-size: clamp(20px, 2.1vw, 30px); font-weight: 400; line-height: 1; white-space: nowrap; font-variant-numeric: tabular-nums; color: #ffffff; }
  #shopify-section-{{ section.id }} .snk__prog--max { background: none; color: #ffffff; }
  #shopify-section-{{ section.id }} .snk__prog--max .snk__ile { color: #ffffff; }

  #shopify-section-{{ section.id }} .snk__zasady {
    display: flex; flex-wrap: wrap; gap: 6px 0; margin: 18px 0 0; padding: 0; list-style: none;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55);
  }
  #shopify-section-{{ section.id }} .snk__panel:not(.snk__panel--foto) .snk__zasady { justify-content: center; }
  #shopify-section-{{ section.id }} .snk__zasady li { display: inline-flex; align-items: center; margin: 0; }
  #shopify-section-{{ section.id }} .snk__zasady li:not(:last-child)::after { content: ""; width: 3px; height: 3px; margin: 0 12px; border-radius: 50%; background: rgba(255, 255, 255, 0.4); }
  #shopify-section-{{ section.id }} .snk__zasady svg { display: none; }

  #shopify-section-{{ section.id }} .snk__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 54px; margin-top: 38px; padding: 0 40px;
    border: 1px solid #ffffff; background: #ffffff; color: #1c1d1d; text-decoration: none;
    font-size: 12px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  #shopify-section-{{ section.id }} .snk__btn:hover { background: transparent; color: #ffffff; }
  #shopify-section-{{ section.id }} .snk__btn svg { width: 15px; height: 15px; transition: transform 0.25s ease; }
  #shopify-section-{{ section.id }} .snk__btn:hover svg { transform: translateX(4px); }
  #shopify-section-{{ section.id }} .snk__pilne { margin: 18px 0 0; font-size: 13.5px; font-style: italic; font-weight: 400; color: rgba(255, 255, 255, 0.62); }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .snk { padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px; }
    #shopify-section-{{ section.id }} .snk__panel--foto { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .snk__panel--right .snk__foto { order: 0; }
    #shopify-section-{{ section.id }} .snk__foto { min-height: 0; aspect-ratio: 4 / 3; }
    #shopify-section-{{ section.id }} .snk__tresc { padding: 36px 22px 34px; }
    #shopify-section-{{ section.id }} .snk__kreska { margin: 20px 0 18px; }
    #shopify-section-{{ section.id }} .snk__tytul { font-size: {{ section.settings.title_size_mobile }}px; margin-bottom: 14px; }
    #shopify-section-{{ section.id }} .snk__tekst { font-size: 15px; margin-bottom: 26px; }
    #shopify-section-{{ section.id }} .snk__progi { max-width: none; padding: 14px 0; }
    #shopify-section-{{ section.id }} .snk__ile { font-size: 9.5px; letter-spacing: 0.1em; }
    #shopify-section-{{ section.id }} .snk__proc { font-size: 22px; }
    #shopify-section-{{ section.id }} .snk__prog { padding: 0 4px; }
    #shopify-section-{{ section.id }} .snk__zasady { font-size: 9.5px; letter-spacing: 0.12em; }
    #shopify-section-{{ section.id }} .snk__zasady li:not(:last-child)::after { margin: 0 8px; }
    #shopify-section-{{ section.id }} .snk__btn { width: 100%; margin-top: 28px; }
  }
{%- endstyle -%}

<div class="snk">
  <div class="page-width">
    <div class="snk__panel{% if ma_foto %} snk__panel--foto snk__panel--{{ section.settings.layout }}{% endif %}">
      {%- if ma_foto -%}
        <div class="snk__foto">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 769px) 46vw, 100vw', alt: section.settings.heading, class: 'snk__img' }}
        </div>
      {%- endif -%}

      <div class="snk__tresc">
        {%- if section.settings.show_campaign and settings.campaign_name != blank -%}
          <p class="snk__brw">
            <span class="snk__dot" aria-hidden="true"></span>
            {{ settings.campaign_name | escape }}
            {%- if settings.campaign_end != blank -%}
            {%- endif -%}
          </p>
          {%- if settings.campaign_end != blank -%}
            <p class="snk__czas" data-sn-licznik data-slut="{{ settings.campaign_end | escape }}" hidden><span data-sn-etykieta>ends in</span> <b data-sn-czas></b></p>
          {%- endif -%}
          <div class="snk__kreska" aria-hidden="true"></div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="snk__tytul">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="snk__tekst">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if progi.size > 0 -%}
          <ol class="snk__progi">
            {%- for prog in progi -%}
              {%- assign czesci = prog | split: ':' -%}
              {%- assign ile = czesci[0] | strip -%}
              {%- assign proc = czesci[1] | strip -%}
              {%- if ile != blank and proc != blank -%}
                <li class="snk__prog{% if forloop.last %} snk__prog--max{% endif %}">
                  <span class="snk__ile">{{ ile }}{% if forloop.last %}+{% endif %} {{ section.settings.tier_word | escape }}</span>
                  <span class="snk__proc">−{{ proc }} %</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.rules != blank -%}
          {%- assign zasady = section.settings.rules | split: '·' -%}
          <ul class="snk__zasady">
            {%- for z in zasady -%}
              {%- assign zz = z | strip -%}
              {%- if zz != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 5 5L19 7"/></svg>{{ zz | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="snk__btn" href="{% if section.settings.button_action == 'scroll' %}#{% else %}{{ section.settings.button_link | default: routes.all_products_collection_url }}{% endif %}"{% if section.settings.button_action == 'scroll' %} data-snk-do-koszyka{% endif %}>
            {{ section.settings.button_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.urgency != blank -%}
          <p class="snk__pilne">{{ section.settings.urgency | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- if section.settings.show_campaign and settings.campaign_end != blank -%}{%- render 'sn-licznik' -%}{%- endif -%}
{%- if section.settings.button_action == 'scroll' -%}
<script>
  // przycisk banera przewija do "Laeg i kurv" na tej stronie produktu
  (function () {
    var btn = document.querySelector('#shopify-section-{{ section.id }} [data-snk-do-koszyka]');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      var cel = document.querySelector('[data-pdp-atc], .pdp__atc, form[action*="/cart/add"] [type="submit"]');
      if (!cel) return;
      e.preventDefault();
      var blok = cel.closest('.pdp__opt') ? cel : (document.querySelector('.pdp__sizes') || cel);
      blok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function () { cel.focus({ preventScroll: true }); }, 600);
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Campaign banner",
  "tag": "section",
  "class": "sn-kampagne",
  "settings": [
    { "type": "paragraph", "content": "Photo beside the offer. The red line on top is the campaign name and countdown from Theme settings, Campaign." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    {
      "type": "select", "id": "layout", "label": "Photo position", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "image_position", "label": "Photo focus", "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" }
      ]
    },
    { "type": "checkbox", "id": "show_campaign", "label": "Show campaign name and countdown", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy more – save up to 30%" },
    { "type": "text", "id": "text", "label": "Text", "default": "The seasonal sale is on. The more items you add to your cart, the more you save – on top of the sale prices." },
    { "type": "text", "id": "tiers", "label": "Steps (items:percent)", "default": "2:10, 3:20, 4:25, 5:30", "info": "Must match the automatic discounts in Shopify, Discounts. The last step also covers more items." },
    { "type": "text", "id": "tier_word", "label": "Word after the number", "default": "items" },
    { "type": "text", "id": "rules", "label": "Short rules", "default": "Mix and match · Applied automatically in the cart · No discount code", "info": "Separate with a middle dot (·). Each part gets a tick." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    {
      "type": "select", "id": "button_action", "label": "Button does", "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Scroll to Add to cart" },
        { "value": "link", "label": "Open the link below" }
      ]
    },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" },
    { "type": "text", "id": "urgency", "label": "Line under the button", "default": "Popular styles sell fast – once they're gone, they're gone." },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "color_bg", "label": "Background (dark - text is white)", "default": "#1c1d1d" },
    { "type": "range", "id": "title_size", "label": "Heading", "default": 38, "min": 24, "max": 56, "step": 1, "unit": "px" },
    { "type": "range", "id": "title_size_mobile", "label": "Heading (phone)", "default": 27, "min": 18, "max": 40, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Space above", "default": 48, "min": 0, "max": 100, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "default": 48, "min": 0, "max": 100, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below (phone)", "default": 28, "min": 0, "max": 80, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Campaign banner" }]
}
{% endschema %}
