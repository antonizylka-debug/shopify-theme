{%- liquid
  assign color_text = section.settings.color_text
  assign color_line = section.settings.color_line
-%}

{%- capture icon_truck -%}<path d="M2.5 5.5h10v10h-10z"/><path d="M12.5 8.5h4l3.5 3.5v3.5h-7.5"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/>{%- endcapture -%}
{%- capture icon_return -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>{%- endcapture -%}
{%- capture icon_box -%}<path d="M12 3 20 7.5v9L12 21 4 16.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>{%- endcapture -%}
{%- capture icon_chat -%}<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>{%- endcapture -%}
{%- capture icon_shield -%}<path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/>{%- endcapture -%}
{%- capture icon_clock -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{%- endcapture -%}
{%- capture icon_card -%}<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18"/>{%- endcapture -%}
{%- capture icon_leaf -%}<path d="M20 4c0 9-5 14-12 14H5c0-8 6-12 15-14Z"/><path d="M5 20c2-5 5-8 10-10"/>{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} .about-story {
    background: {{ section.settings.color_bg }};
    color: {{ color_text }};
  }

  /* --- wstep --- */

  #shopify-section-{{ section.id }} .about-block--intro {
    max-width: 720px;
    margin: 0 auto;
    padding: 96px 0 64px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .about-block__eyebrow {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ color_text | color_modify: 'alpha', 0.55 }};
  }

  #shopify-section-{{ section.id }} .about-block__heading {
    margin: 0 0 20px;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .about-block__heading--large {
    font-size: 48px;
  }

  #shopify-section-{{ section.id }} .about-block__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: {{ color_text | color_modify: 'alpha', 0.72 }};
  }

  #shopify-section-{{ section.id }} .about-block__body p {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .about-block__body p:last-child {
    margin-bottom: 0;
  }

  /* --- rzad: tekst i zdjecie --- */

  #shopify-section-{{ section.id }} .about-block--row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 72px;
    padding-bottom: 72px;
  }

  /* w markupie zdjecie jest pierwsze, czyli domyslnie po lewej -
     przesuwamy je dopiero dla wariantu "po prawej" */
  #shopify-section-{{ section.id }} .about-block--image-right .about-block__media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .about-block__media {
    aspect-ratio: 1 / 1;
    background: {{ color_text | color_modify: 'alpha', 0.06 }};
  }

  #shopify-section-{{ section.id }} .about-block__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .about-block__text {
    max-width: 551px;
  }

  /* --- obietnice --- */

  #shopify-section-{{ section.id }} .about-block--values {
    padding: 88px 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .about-block__subheading {
    max-width: 636px;
    margin: 0 auto 40px;
    font-size: 16px;
    line-height: 1.6;
    color: {{ color_text | color_modify: 'alpha', 0.72 }};
  }

  #shopify-section-{{ section.id }} .about-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .about-values__cell {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid {{ color_line }};
    background: {{ section.settings.color_cell }};
    text-align: left;
  }

  #shopify-section-{{ section.id }} .about-values__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border: 1px solid {{ color_text | color_modify: 'alpha', 0.1 }};
    background: {{ section.settings.color_bg }};
  }

  #shopify-section-{{ section.id }} .about-values__icon svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .about-values__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .about-values__desc {
    font-size: 13px;
    line-height: 1.4;
    color: {{ color_text | color_modify: 'alpha', 0.72 }};
  }

  /* --- zamkniecie --- */

  #shopify-section-{{ section.id }} .about-block--cta {
    padding-bottom: 96px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .about-block__cta-body {
    max-width: 551px;
    margin: 0 auto 28px;
    font-size: 16px;
    line-height: 1.6;
    color: {{ color_text | color_modify: 'alpha', 0.72 }};
  }

  #shopify-section-{{ section.id }} .about-block__cta-body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .about-block__cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background: {{ color_text }};
    color: {{ section.settings.color_btn_text }};
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .about-block__cta-btn:hover {
    opacity: 0.85;
  }

  @media only screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .about-block--intro {
      padding: 48px 0 32px;
    }

    #shopify-section-{{ section.id }} .about-block__heading {
      font-size: 26px;
    }

    #shopify-section-{{ section.id }} .about-block__heading--large {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .about-block__body,
    #shopify-section-{{ section.id }} .about-block__subheading {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .about-block--row {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-bottom: 40px;
    }

    /* na waskim ekranie zdjecie zawsze nad tekstem */
    #shopify-section-{{ section.id }} .about-block--image-left .about-block__media,
    #shopify-section-{{ section.id }} .about-block--image-right .about-block__media {
      order: -1;
    }

    #shopify-section-{{ section.id }} .about-block--values {
      padding: 48px 0;
    }

    #shopify-section-{{ section.id }} .about-values {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .about-block--cta {
      padding-bottom: 56px;
    }

    #shopify-section-{{ section.id }} .about-block__cta-btn {
      display: block;
    }
  }
{%- endstyle -%}

<div class="about-story">
  <div class="page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'intro' -%}
          <div class="about-block about-block--intro" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <p class="about-block__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h1 class="about-block__heading about-block__heading--large">{{ block.settings.heading | escape }}</h1>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-block__body about-block__body--lead">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'row' -%}
          <div class="about-block about-block--row about-block--image-{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
            <div class="about-block__media">
              {%- if block.settings.image != blank -%}
                {%- assign row_alt = block.settings.image.alt | default: block.settings.heading -%}
                {%- render 'image-element',
                  img: block.settings.image,
                  alt: row_alt,
                  classes: 'about-block__img',
                  sizeVariable: '50vw'
                -%}
              {%- endif -%}
            </div>

            <div class="about-block__text">
              {%- if block.settings.eyebrow != blank -%}
                <p class="about-block__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="about-block__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="about-block__body">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'values_head' -%}
          {%- comment -%}
            Naglowek sekcji obietnic wraz z siatka - wszystkie bloki typu value
            trafiaja tutaj, wiec w petli glownej sa pomijane.
          {%- endcomment -%}
          <div class="about-block about-block--values" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="about-block__heading about-block__heading--center about-block__heading--small">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-block__subheading">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
            {%- if value_blocks.size > 0 -%}
              <div class="about-values">
                {%- for value in value_blocks -%}
                  <div class="about-values__cell" {{ value.shopify_attributes }}>
                    <span class="about-values__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        {%- case value.settings.icon -%}
                          {%- when 'return' -%}{{ icon_return }}
                          {%- when 'box' -%}{{ icon_box }}
                          {%- when 'chat' -%}{{ icon_chat }}
                          {%- when 'shield' -%}{{ icon_shield }}
                          {%- when 'clock' -%}{{ icon_clock }}
                          {%- when 'card' -%}{{ icon_card }}
                          {%- when 'leaf' -%}{{ icon_leaf }}
                          {%- else -%}{{ icon_truck }}
                        {%- endcase -%}
                      </svg>
                    </span>
                    <span class="about-values__title">{{ value.settings.title | escape }}</span>
                    <span class="about-values__desc">{{ value.settings.text | escape }}</span>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'cta' -%}
          <div class="about-block about-block--cta" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="about-block__heading about-block__heading--center">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="about-block__cta-body">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="about-block__cta-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "About story",
  "max_blocks": 16,
  "settings": [
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1c1d1d" },
    { "type": "color", "id": "color_cell", "label": "Promise tile background", "default": "#f8f8f6" },
    { "type": "color", "id": "color_line", "label": "Tile border", "default": "#e6e3de" },
    { "type": "color", "id": "color_btn_text", "label": "Button text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "row",
      "name": "Text and image",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "right",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    },
    {
      "type": "values_head",
      "name": "Promises heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "paragraph", "content": "The tiles below come from the Promise blocks, wherever they sit in the list." }
      ]
    },
    {
      "type": "value",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Return" },
            { "value": "box", "label": "Parcel" },
            { "value": "chat", "label": "Support" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "clock", "label": "Clock" },
            { "value": "card", "label": "Payment" },
            { "value": "leaf", "label": "Materials" }
          ]
        },
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "text", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "cta",
      "name": "Call to action",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About story",
      "blocks": [
        { "type": "intro" },
        { "type": "row" },
        { "type": "values_head" },
        { "type": "value" },
        { "type": "value" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
