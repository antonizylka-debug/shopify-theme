<style>
  {%- if settings.color_announcement == settings.color_body_bg -%}
    .announcement-bar {
      border-bottom: 1px solid;
    }
  {%- endif -%}

  /* --- wszystkie wiadomosci w jednym rzedzie --- */
  .announcement-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 {{ section.settings.announcement_gap | default: 18 }}px;
  }

  .announcement-row__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .announcement-row__sep {
    opacity: 0.55;
  }

  .announcement-bar--row .announcement-text {
    font-weight: 600;
  }

  /* --- uklad "arrows": rzad na desktopie, strzalki na telefonie i tablecie --- */
  .announcement-bar.announcement-mobile-only { display: none; }
  @media only screen and (max-width: 1024px) {
    .announcement-bar.announcement-desktop-only { display: none; }
    .announcement-bar.announcement-mobile-only { display: flex; }
  }
  /* --- jedna wiadomosc ze strzalkami --- */
  {%- comment -%}
    Pasek nie moze byc wyzszy od naglowka - stad wysokosc i stopien
    pisma z ustawien, a nie na sztywno. Strzalki dostaja pelna
    wysokosc paska, wiec pole dotyku zostaje duze mimo niskiej belki.
  {%- endcomment -%}
  .announcement-arrows {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.bar_height }}px;
    padding: 0 {{ section.settings.bar_height | plus: 4 }}px;
  }
  .announcement-arrows__track {
    position: relative;
    flex: 1 1 auto;
    display: grid;
  }
  .announcement-arrows__slide {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 0;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .announcement-arrows__slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .announcement-arrows__slide .announcement-link {
    display: contents;
    color: inherit;
    text-decoration: none;
  }
  .announcement-arrows__title {
    font-size: {{ section.settings.bar_size }}px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .announcement-arrows__text {
    margin-left: 7px;
    font-size: {{ section.settings.bar_size }}px;
    line-height: 1.3;
    opacity: 0.85;
  }
  .announcement-arrows__btn {
    position: absolute;
    top: 0;
    bottom: 0;
    transform: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.bar_height | plus: 4 }}px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .announcement-arrows__btn--prev { left: 0; }
  .announcement-arrows__btn--next { right: 0; }
  .announcement-arrows__btn svg { width: 8px; height: 13px; }
  {%- comment -%}
    Na szerokim ekranie strzalki przyklejone do krawedzi stoja
    kilkaset pikselow od wiadomosci i nie czytaja sie jako jej
    sterowanie. Dlatego powyzej telefonu przestaja byc pozycjonowane
    absolutnie i ida w ten sam rzad co tresc, ktory jest wysrodkowany.
    Szerokosc sciezki bierze sie z najszerszej wiadomosci, wiec
    strzalki nie skacza przy zmianie komunikatu.
  {%- endcomment -%}
  @media only screen and (min-width: 769px) {
    .announcement-arrows {
      justify-content: center;
      padding: 0 12px;
    }
    .announcement-arrows__track { flex: 0 1 auto; }
    .announcement-arrows__btn {
      position: static;
      align-self: stretch;
      width: auto;
      padding: 0 {{ section.settings.arrow_gap }}px;
    }
  }
  @media only screen and (max-width: 768px) {
    /* na telefonie tylko naglowek wiadomosci - jedna linia, bez lamania */
    .announcement-arrows__text { display: none; }
    .announcement-arrows {
      min-height: {{ section.settings.bar_height_m }}px;
      padding: 0 {{ section.settings.bar_height_m | plus: 4 }}px;
    }
    .announcement-arrows__btn { width: {{ section.settings.bar_height_m | plus: 4 }}px; }
    .announcement-arrows__slide .announcement-arrows__title:only-child,
    .announcement-arrows__title { font-size: {{ section.settings.bar_size_m }}px; }
  }
  {%- if section.settings.announcement_sticky -%}
    /* --- pasek przyklejony do gory, bez animacji --- */
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 26;
    }
  {%- endif -%}
</style>

{%- render 'announcement-bar', section: section -%}

{%- if section.settings.announcement_layout == 'arrows' or section.settings.announcement_layout == 'arrows_all' -%}
  <script>
    (function () {
      var bar = document.querySelector('#shopify-section-{{ section.id }} [data-announcement-arrows]');
      if (!bar) return;
      var slides = bar.querySelectorAll('[data-announcement-slide]');
      if (slides.length < 2) return;
      var current = 0;
      var delay = (parseInt(bar.getAttribute('data-interval'), 10) || 5) * 1000;
      var timer = null;

      function show(index) {
        slides[current].classList.remove('is-active');
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('is-active');
      }
      function restart() {
        clearInterval(timer);
        timer = setInterval(function () { show(current + 1); }, delay);
      }

      bar.querySelector('[data-announcement-prev]').addEventListener('click', function () { show(current - 1); restart(); });
      bar.querySelector('[data-announcement-next]').addEventListener('click', function () { show(current + 1); restart(); });
      bar.addEventListener('mouseenter', function () { clearInterval(timer); });
      bar.addEventListener('mouseleave', restart);

      // przesuniecie palcem na telefonie
      var startX = null;
      bar.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
      bar.addEventListener('touchend', function (e) {
        if (startX === null) return;
        var dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) { show(current + (dx < 0 ? 1 : -1)); restart(); }
        startX = null;
      });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) restart();
    })();
  </script>
{%- endif -%}

{%- if section.settings.announcement_sticky -%}
  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;

      function setHeight() {
        document.documentElement.style.setProperty('--announcement-h', section.offsetHeight + 'px');
      }

      setHeight();
      window.addEventListener('resize', setHeight);
      document.addEventListener('shopify:section:load', setHeight);


    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.settings.header_announcement_bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "announcement_compact",
      "label": "t:sections.header.settings.announcement_compact.label"
    },
    {
      "type": "checkbox",
      "id": "announcement_sticky",
      "label": "Stick to top when scrolling",
      "default": false,
      "info": "The bar stays visible above the sticky header."
    },
    {
      "type": "select",
      "id": "announcement_layout",
      "label": "Layout",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "One message at a time" },
        { "value": "arrows", "label": "One row on desktop, arrows on phone and tablet" },
        { "value": "arrows_all", "label": "One message with arrows, on every screen" },
        { "value": "row", "label": "All messages in one row" }
      ]
    },
    {
      "type": "range",
      "id": "announcement_interval",
      "label": "Seconds per message (phone and tablet)",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "announcement_separator",
      "label": "Separator",
      "default": "dot",
      "info": "Used only in the one row layout.",
      "options": [
        { "value": "dot", "label": "Dot" },
        { "value": "line", "label": "Line" },
        { "value": "dash", "label": "Dash" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "info": "Keep it below the height of the header.",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "bar_size",
      "label": "Text size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "arrow_gap",
      "label": "Space between an arrow and the message",
      "info": "Only on screens wider than a phone. On a phone the arrows stay at the edges.",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "bar_height_m",
      "label": "Bar height (phone)",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "bar_size_m",
      "label": "Text size (phone)",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "announcement_gap",
      "label": "Space between messages",
      "min": 6,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "announcement",
      "name": "t:sections.header.blocks.announcement.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.header.blocks.announcement.settings.text.label",
          "default": "Nem returnering"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.header.blocks.announcement.settings.link_text.label",
          "default": "30-day returns on every order"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "settings": {}
  },
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}
