{% capture platform_logo %}{% if section.settings.review_logo != blank %}{{ section.settings.review_logo | image_url: width: 216 | image_tag: class: 'rvw__logo', alt: section.settings.logo_alt, loading: 'lazy' }}{% else %}<span class="rvw__trustpilot" role="img" aria-label="Trustpilot"><img src="data:image/png;base64," alt="" width="600" height="600" loading="lazy"></span>{% endif %}{% endcapture %}
{%- assign sample_content = true -%}
{%- if section.settings.content_source == 'custom' -%}{%- assign sample_content = false -%}{%- endif -%}
{%- assign has_samples = sample_content -%}
{%- for review_block in section.blocks -%}{%- if review_block.settings.is_sample -%}{%- assign has_samples = true -%}{%- endif -%}{%- endfor -%}
{%- comment -%}
  Sciana opinii: naglowek z ocena, pod nim przewijana siatka kart (opcjonalnie z odpowiedzia sklepu).
  Opinie wpisuje sie recznie w edytorze (bloki). Opcjonalne logo platformy wybierane w edytorze.
{%- endcomment -%}
{%- capture star_full -%}<svg viewBox="0 0 96 96" fill="currentColor" aria-hidden="true" focusable="false"><path d="M48 64.7 62.6 61 68.7 79.8 48 64.7ZM81.6 40.4H55.9L48 16.2 40.1 40.4H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2 20.7-15Z"/></svg>{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} .rvw {
    --rvw-star: #00B67A;
    --rvw-empty: #d9d6d1;
    --rvw-text: {{ section.settings.c_text }};
    --rvw-muted: #6b6f76;
    --rvw-accent: {{ section.settings.c_accent }};
    background: {{ section.settings.c_bg }};
    color: var(--rvw-text);
    padding: {{ section.settings.pad_y }}px 0;
  }
  #shopify-section-{{ section.id }} .rvw__head { text-align: center; margin-bottom: 18px; padding: 0 16px; }
  #shopify-section-{{ section.id }} .rvw__top { display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }
  #shopify-section-{{ section.id }} .rvw__verdict { font-size: 26px; line-height: 1.1; margin: 0; font-weight: 400; }
  #shopify-section-{{ section.id }} .rvw__stars { display: inline-flex; gap: 2px; color: var(--rvw-star); }
  #shopify-section-{{ section.id }} .rvw__stars svg { width: 16px; height: 16px; display: block; }
  #shopify-section-{{ section.id }} .rvw__stars .is-off { color: var(--rvw-empty); }
  #shopify-section-{{ section.id }} .rvw__top .rvw__stars svg { width: 26px; height: 26px; }
  #shopify-section-{{ section.id }} .rvw__rated { font-size: 14px; margin: 10px 0 0; }
  #shopify-section-{{ section.id }} .rvw__rated a { color: inherit; text-decoration: underline; }
  #shopify-section-{{ section.id }} .rvw__scroll {
    max-width: 1340px; margin: 0 auto; padding: 0 24px;
    max-height: {{ section.settings.max_h }}px; overflow-y: auto; overscroll-behavior: contain;
  }
  #shopify-section-{{ section.id }} .rvw__grid {
    display: grid; gap: 14px; grid-template-columns: repeat({{ section.settings.per_row }}, minmax(0, 1fr));
  }
  #shopify-section-{{ section.id }} .rvw__card {
    background: {{ section.settings.c_card }}; padding: 16px 16px 14px; font-size: 14px; line-height: 1.4;
    display: flex; flex-direction: column; min-width: 0;
  }
  #shopify-section-{{ section.id }} .rvw__meta { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .rvw__ver { display: inline-flex; align-items: center; gap: 4px; color: var(--rvw-muted); text-decoration: underline; }
  #shopify-section-{{ section.id }} .rvw__ver svg { width: 15px; height: 15px; }
  #shopify-section-{{ section.id }} .rvw__who { color: var(--rvw-muted); font-size: 12.5px; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .rvw__who strong { font-weight: 700; }
  #shopify-section-{{ section.id }} .rvw__title { font-size: 15px; font-weight: 700; margin: 0 0 6px; }
  #shopify-section-{{ section.id }} .rvw__body { margin: 0; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  #shopify-section-{{ section.id }} .rvw__card.is-open .rvw__body { display: block; -webkit-line-clamp: unset; }
  #shopify-section-{{ section.id }} .rvw__reply {
    margin-top: 12px; background: #fff; border-left: 3px solid var(--rvw-accent); padding: 12px 14px;
  }
  #shopify-section-{{ section.id }} .rvw__reply-head { display: flex; justify-content: space-between; gap: 10px; color: var(--rvw-muted); font-size: 13px; }
  #shopify-section-{{ section.id }} .rvw__reply-text { margin: 8px 0 0; }
  #shopify-section-{{ section.id }} .rvw__more {
    margin-top: auto; padding-top: 12px; align-self: center; background: none; border: 0; cursor: pointer;
    color: var(--rvw-accent); text-decoration: underline; font: inherit;
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .rvw__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .rvw__scroll { padding: 0 16px; }
    #shopify-section-{{ section.id }} .rvw__grid { grid-template-columns: minmax(0, 1fr); }
  }
  #shopify-section-{{ section.id }} .rvw--boxed .rvw__stars { gap: 3px; }
  #shopify-section-{{ section.id }} .rvw--boxed .rvw__stars > span { display: flex; background: var(--rvw-star); color: #fff; padding: 2px; }
  #shopify-section-{{ section.id }} .rvw--boxed .rvw__stars > span.is-off { background: var(--rvw-empty); color: #fff; }
  #shopify-section-{{ section.id }} .rvw--boxed .rvw__stars svg { width: 14px; height: 14px; }
  #shopify-section-{{ section.id }} .rvw--boxed .rvw__sum .rvw__stars svg, #shopify-section-{{ section.id }} .rvw--boxed .rvw__top .rvw__stars svg { width: 24px; height: 24px; }

#shopify-section-{{ section.id }} .rvw, #shopify-section-{{ section.id }} .rvw * { box-sizing:border-box; }
#shopify-section-{{ section.id }} .rvw { font-family:Arial,Helvetica,sans-serif; --rvw-empty:#dcdce6; --rvw-muted:#666; }
#shopify-section-{{ section.id }} .rvw h2, #shopify-section-{{ section.id }} .rvw h3 { font-family:inherit; text-transform:none; letter-spacing:normal; }
#shopify-section-{{ section.id }} .rvw p { letter-spacing:normal; }
#shopify-section-{{ section.id }} .rvw .rvw__stars { gap:2px; vertical-align:middle; line-height:1; flex-shrink:0; }
#shopify-section-{{ section.id }} .rvw--boxed .rvw__stars > span { padding:0; }
#shopify-section-{{ section.id }} .rvw--boxed .rvw__stars svg { width:18px; height:18px; }
#shopify-section-{{ section.id }} .rvw__title { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.3; }
#shopify-section-{{ section.id }} .rvw__logo { display:inline-block; width:108px; height:auto; max-height:32px; object-fit:contain; vertical-align:middle; }
#shopify-section-{{ section.id }} .rvw__logo-wrap { margin-top:8px; }
#shopify-section-{{ section.id }} .rvw__more:focus-visible, #shopify-section-{{ section.id }} .rvw__nav:focus-visible { outline:2px solid #008849; outline-offset:3px; }
@media (prefers-reduced-motion:reduce) { #shopify-section-{{ section.id }} .rvw__track { scroll-behavior:auto; } }

#shopify-section-{{ section.id }} .rvw__head { margin-bottom:34px; }
#shopify-section-{{ section.id }} .rvw__top { gap:10px; }
#shopify-section-{{ section.id }} .rvw__verdict { font-size:20px; }
#shopify-section-{{ section.id }} .rvw--boxed .rvw__top .rvw__stars svg { width:20px; height:20px; }
#shopify-section-{{ section.id }} .rvw--boxed .rvw__top .rvw__stars > span:not(.is-off) { background:#73CF11; }
#shopify-section-{{ section.id }} .rvw__rated { margin-top:10px; font-size:11px; line-height:1.4; }
#shopify-section-{{ section.id }} .rvw__rated .rvw__logo { width:64px; max-height:18px; margin-left:4px; }
#shopify-section-{{ section.id }} .rvw__scroll { max-width:1100px; padding:0 12px; scrollbar-width:auto; scrollbar-color:#929292 #fafafa; }
#shopify-section-{{ section.id }} .rvw__scroll::-webkit-scrollbar { width:10px; }
#shopify-section-{{ section.id }} .rvw__scroll::-webkit-scrollbar-track { background:#fafafa; }
#shopify-section-{{ section.id }} .rvw__scroll::-webkit-scrollbar-thumb { background:#929292; border-radius:8px; border:1px solid #fafafa; }
#shopify-section-{{ section.id }} .rvw__note { font-size:10px; color:#666; margin:0 0 12px; }
#shopify-section-{{ section.id }} .rvw__grid { gap:8px; align-items:start; }
#shopify-section-{{ section.id }} .rvw__card { padding:13px 13px 14px; font-size:10px; line-height:1.5; border-bottom:1px solid #e7edf3; }
#shopify-section-{{ section.id }} .rvw--boxed .rvw__card .rvw__stars svg { width:16px; height:16px; }
#shopify-section-{{ section.id }} .rvw__meta { gap:6px; margin-bottom:12px; }
#shopify-section-{{ section.id }} .rvw__ver { font-size:10px; }
#shopify-section-{{ section.id }} .rvw__ver svg { width:12px; height:12px; }
#shopify-section-{{ section.id }} .rvw__who { font-size:9px; margin-bottom:6px; }
#shopify-section-{{ section.id }} .rvw__title { font-size:11px; margin-bottom:5px; }
#shopify-section-{{ section.id }} .rvw__body { -webkit-line-clamp:4; white-space:pre-line; }
#shopify-section-{{ section.id }} .rvw__reply { margin-top:14px; padding:13px 10px; border-left-width:2px; }
#shopify-section-{{ section.id }} .rvw__reply-head { font-size:9px; gap:8px; align-items:flex-start; }
#shopify-section-{{ section.id }} .rvw__reply-head > span:first-child { display:flex; gap:6px; align-items:center; }
#shopify-section-{{ section.id }} .rvw__reply-head > span:last-child { white-space:nowrap; }
#shopify-section-{{ section.id }} .rvw__reply-arrow { width:10px; height:10px; color:var(--rvw-accent); flex-shrink:0; }
#shopify-section-{{ section.id }} .rvw__reply-text { display:none; margin:14px 0 0 16px; white-space:pre-line; }
#shopify-section-{{ section.id }} .rvw__card.is-open .rvw__reply-text { display:block; }
#shopify-section-{{ section.id }} .rvw__more { margin:0; padding:10px 0 0; font-size:10px; line-height:1.4; }
@media(max-width:599px) { #shopify-section-{{ section.id }} .rvw__card { font-size:13px; } #shopify-section-{{ section.id }} .rvw__title { font-size:14px; } #shopify-section-{{ section.id }} .rvw__who,#shopify-section-{{ section.id }} .rvw__reply-head,#shopify-section-{{ section.id }} .rvw__more { font-size:11px; } #shopify-section-{{ section.id }} .rvw__scroll { padding:0 16px; } }


/* Rating colours match the supplied stars-1.svg through stars-5.svg. */
#shopify-section-{{ section.id }} .rvw .rvw__stars[data-rating="1"] { color:#FF3722; }
#shopify-section-{{ section.id }} .rvw.rvw--boxed .rvw__stars[data-rating="1"] > span:not(.is-off) { background:#FF3722; color:#fff; }
#shopify-section-{{ section.id }} .rvw .rvw__stars[data-rating="2"] { color:#FF8622; }
#shopify-section-{{ section.id }} .rvw.rvw--boxed .rvw__stars[data-rating="2"] > span:not(.is-off) { background:#FF8622; color:#fff; }
#shopify-section-{{ section.id }} .rvw .rvw__stars[data-rating="3"] { color:#FFCE00; }
#shopify-section-{{ section.id }} .rvw.rvw--boxed .rvw__stars[data-rating="3"] > span:not(.is-off) { background:#FFCE00; color:#fff; }
#shopify-section-{{ section.id }} .rvw .rvw__stars[data-rating="4"] { color:#73CF11; }
#shopify-section-{{ section.id }} .rvw.rvw--boxed .rvw__stars[data-rating="4"] > span:not(.is-off) { background:#73CF11; color:#fff; }
#shopify-section-{{ section.id }} .rvw .rvw__stars[data-rating="5"] { color:#00B67A; }
#shopify-section-{{ section.id }} .rvw.rvw--boxed .rvw__stars[data-rating="5"] > span:not(.is-off) { background:#00B67A; color:#fff; }

#shopify-section-{{ section.id }} .rvw__demo {font:12px/1.5 Arial,sans-serif;text-align:center;margin:0 16px 20px;color:#555;}
#shopify-section-{{ section.id }} .rvw__sample-label {font:10px/1.3 Arial,sans-serif;margin:0 0 5px;color:#666;}
#shopify-section-{{ section.id }} .rvw__trustpilot {display:inline-block;position:relative;overflow:hidden;width:108px;height:28px;vertical-align:middle;}
#shopify-section-{{ section.id }} .rvw__trustpilot img {position:absolute;top:-34px;left:-6px;width:120px;height:120px;max-width:none;max-height:none;display:block;}
{%- endstyle -%}

<dp-reviews-wall style="display:block" class="rvw{% if section.settings.star_style == 'boxed' %} rvw--boxed{% endif %}">
{% if has_samples %}<p class="rvw__demo">DEMO — Sample reviews, not real customer testimonials or Trustpilot reviews.</p>{% endif %}
  {% if section.settings.show_summary %}<div class="rvw__head">
    <div class="rvw__top">
      {%- if section.settings.verdict != blank and has_samples == false -%}<h2 class="rvw__verdict">{{ section.settings.verdict | escape }}</h2>{%- endif -%}
      {% if section.settings.rating != blank and has_samples == false %}<span class="rvw__stars" data-rating="{{ section.settings.rating | round | at_least: 1 | at_most: 5 }}" role="img" aria-label="{{ section.settings.rating | escape }} / 5">
        {%- assign sum_full = section.settings.rating | round -%}
        {%- for i in (1..5) -%}<span class="{% if i > sum_full %}is-off{% endif %}">{{ star_full }}</span>{%- endfor -%}
      </span>{% endif %}
    </div>
    {% if section.settings.rating != blank and has_samples == false and section.settings.count_text != blank %}<p class="rvw__rated">
      Rated {{ section.settings.rating | escape }} / 5 based on
      {% if section.settings.count_url != blank %}<a href="{{ section.settings.count_url }}">{{ section.settings.count_text | escape }}</a>{% else %}<u>{{ section.settings.count_text | escape }}</u>{% endif %}

    </p>{% endif %}
<div class="rvw__logo-wrap">{{ platform_logo }}</div>
  </div>

  {% endif %}
  <div class="rvw__scroll" tabindex="0" role="region" aria-label="Customer reviews">
{% if section.settings.note != blank %}<p class="rvw__note">{{ section.settings.note | escape }}</p>{% endif %}
    <div class="rvw__grid">
      {% if sample_content %}
<article class="rvw__card" id="sample-{{ section.id }}-0"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>Emma W.</strong>, Sample date</p><h3 class="rvw__title">A lovely everyday sweater</h3><p class="rvw__body">The sweater feels soft and is easy to style with jeans or trousers. I especially like the relaxed fit without it looking too oversized.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, Emma! We are pleased you are enjoying the softness and relaxed fit of your sweater.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-0" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
<article class="rvw__card" id="sample-{{ section.id }}-1"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>James M.</strong>, Sample date</p><h3 class="rvw__title">Simple and comfortable</h3><p class="rvw__body">Really pleased with this sweater. Comfortable enough for everyday wear and smart enough to wear out for dinner.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, James! It is lovely to hear your sweater works for both everyday wear and evenings out.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-1" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
<article class="rvw__card" id="sample-{{ section.id }}-2"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>Olivia B.</strong>, Sample date</p><h3 class="rvw__title">Easy pieces to put together</h3><p class="rvw__body">I was looking for clothes that would make getting dressed a little easier. The knitwear and trousers work nicely together without needing much styling.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, Olivia! We are glad the knitwear and trousers make putting an outfit together easier.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-2" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
<article class="rvw__card" id="sample-{{ section.id }}-3"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>Daniel R.</strong>, Sample date</p><h3 class="rvw__title">Relaxed without looking baggy</h3><p class="rvw__body">The fit gives me room to move without looking too loose. A good option for days when I want to feel comfortable but still look put together.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, Daniel! We are happy the fit gives you the comfort and look you were hoping for.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-3" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
<article class="rvw__card" id="sample-{{ section.id }}-4"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>Charlotte L.</strong>, Sample date</p><h3 class="rvw__title">Helpful with my sizing question</h3><p class="rvw__body">I wasn’t sure which size to choose, so I contacted the team before ordering. Their advice was helpful, and I’m happy with how the cardigan fits.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, Charlotte! We are pleased our team could help you choose a comfortable cardigan size.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-4" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
<article class="rvw__card" id="sample-{{ section.id }}-5"><div class="rvw__meta"><span class="rvw__stars" data-rating="5" role="img" aria-label="Sample rating: 5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvw__sample-label">Sample review</p><p class="rvw__who"><strong>Michael T.</strong>, Sample date</p><h3 class="rvw__title">Comfortable through the day</h3><p class="rvw__body">The trousers are comfortable around the waist and don’t feel restrictive when I sit down. I’ve already worn them to work a few times.</p><div class="rvw__reply"><div class="rvw__reply-head"><span><svg class="rvw__reply-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 2 0 7l6 5V9c4 0 6 1 9 5-1-7-4-9-9-9V2Z"/></svg>Reply from Dalton &amp; Pierce</span><span>Sample date</span></div><p class="rvw__reply-text">Thank you, Michael! We are glad your trousers feel comfortable throughout the working day.</p></div><button type="button" class="rvw__more" data-rvw-more aria-expanded="false" aria-controls="sample-{{ section.id }}-5" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label | escape }}</button></article>
