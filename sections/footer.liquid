    },
    {
      "type": "checkbox",
      "id": "show_currency_flags",
      "label": "t:sections.footer.settings.show_currency_flags.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "t:sections.footer.settings.show_locale_selector.label",
      "default": true,
      "info": "t:sections.footer.settings.header_language_selector"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_additional_footer_content"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "t:sections.footer.settings.show_copyright.label"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:sections.footer.settings.copyright_text.label"
    },
    {
      "type": "checkbox",
      "id": "hide_powered_by",
      "label": "Hide \"Powered by Shopify\"",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show \"Back to top\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "back_to_top_label",
      "label": "\"Back to top\" label",
      "default": "Back to top"
    },
    {
      "type": "header",
      "content": "Spacing and divider"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line colour",
      "default": "#2b2c2c"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Space around divider",
      "default": 36,
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Padding - desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Padding - mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "default": 22,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "default": 22,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_spacing_mobile",
      "label": "Space between blocks",
      "default": 30,
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Space between links (desktop)",
      "default": 10,
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "link_spacing_mobile",
      "label": "Space between links (mobile)",
