{%- liquid
  assign show_selectors = false
  assign currency_selector = false
  assign locale_selector = false

  if section.settings.show_currency_selector and shop.enabled_currencies.size > 1
    assign currency_selector = true
  endif

  if section.settings.show_locale_selector and shop.enabled_locales.size > 1
    assign locale_selector = true
  endif

  if currency_selector or locale_selector
    assign show_selectors = true
  endif
-%}

{%- if settings.color_footer == settings.color_body_bg -%}
  {%- style -%}
    .site-footer {
      border-top: 1px solid {{ settings.color_borders }};
    }
  {%- endstyle -%}
{%- endif -%}

{%- liquid
  assign divider_color = section.settings.divider_color
  if divider_color == blank or divider_color == 'rgba(0,0,0,0)'
    assign divider_color = settings.color_footer_text
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .site-footer {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .footer__divider {
    background: {{ divider_color }};
    margin-top: {{ section.settings.divider_spacing }}px;
    margin-bottom: {{ section.settings.divider_spacing }}px;
  }

  #shopify-section-{{ section.id }} .footer__bottom {
    border-top-color: {{ divider_color }};
    margin-top: {{ section.settings.divider_spacing }}px;
    padding-top: {{ section.settings.divider_spacing | times: 0.7 | round }}px;
  }

  #shopify-section-{{ section.id }} .site-footer__linklist li {
    margin-bottom: {{ section.settings.link_spacing }}px;
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .site-footer {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .site-footer .page-width {
      padding-left: 16px;
      padding-right: 16px;
    }

    {%- comment -%}
      Menu ustawiamy w dwie kolumny, reszta bloków idzie na pełną szerokość.
      Odstęp między blokami daje siatka, więc pojedyncze bloki nie dokładają
      już własnego dolnego paddingu - inaczej przerwy podwajały się.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .site-footer .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.block_spacing_mobile }}px 14px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .site-footer .grid__item {
      grid-column: 1 / -1;
      width: auto;
      float: none;
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .site-footer .grid__item[data-type="menu"] {
      grid-column: span 1;
    }

    #shopify-section-{{ section.id }} .footer__clear {
      display: none;
    }

    {%- comment -%}
      Link w stopce to na telefonie cel dotykowy - stąd 44px wysokości,
      zamiast samego odstępu między wierszami.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .site-footer__linklist {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.link_spacing_mobile }}px;
    }

    #shopify-section-{{ section.id }} .site-footer__linklist li {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .site-footer__linklist a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .footer__title {
      margin-bottom: 8px;
      font-size: 14px;
      letter-spacing: 0.025em;
    }

    #shopify-section-{{ section.id }} .footer__brand-text,
    #shopify-section-{{ section.id }} .ob-support,
    #shopify-section-{{ section.id }} .footer__contact {
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .footer__contact-row {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .footer__social--boxed {
      justify-content: center;
    }

    {%- if section.settings.hide_mobile_separators -%}
      #shopify-section-{{ section.id }} .site-footer .grid__item:after {
        display: none;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<footer class="site-footer" data-section-id="{{ section.id }}" data-section-type="footer-section">
  <div class="page-width">

    <div class="grid">
      {%- assign row_width = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign row_width = row_width | plus: block.settings.container_width -%}
        {%- if row_width > 100 -%}
          <div class="footer__clear small--hide"></div>
          {%- assign row_width = row_width | minus: 100 -%}
        {%- endif -%}

        <div {{ block.shopify_attributes }} class="grid__item footer__item--{{ block.id }}" data-type="{{ block.type }}">
          {%- style -%}
            @media only screen and (min-width: 769px) and (max-width: 959px) {
              .footer__item--{{ block.id }} {
                width: 50%;
                padding-top: 40px;
              }
              .footer__item--{{ block.id }}:nth-child(2n + 1) {
                clear: left;
              }
            }
            @media only screen and (min-width: 960px) {
              .footer__item--{{ block.id }} {
                width: {{ block.settings.container_width }}%;
              }

            }
          {%- endstyle -%}

          {%- liquid
            case block.type
              when 'logo_social'
                render 'footer-logo', block: block
              when 'custom'
                render 'footer-custom-text', block: block, container_width: block.settings.container_width
              when 'newsletter'
                render 'footer-newsletter', block: block
              when 'menu'
                render 'footer-menu', block: block
              when 'follow_shop_cta'
                render 'follow-shop-cta', block: block
              when 'contact'
                render 'footer-contact', block: block
              when 'divider'
                echo '<div class="footer__divider"></div>'
            endcase
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if show_selectors -%}
      <div class="footer__section">
        {%- render 'multi-selectors',
          locale_selector: locale_selector,
          currency_selector: currency_selector,
          show_currency_flags: section.settings.show_currency_flags
          location: 'footer'
        -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      {%- unless shop.enabled_payment_types == empty -%}
        <ul class="inline-list payment-icons footer__section">
          {%- for type in shop.enabled_payment_types -%}
            <li class="icon--payment">
              {{ type | payment_type_svg_tag }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endunless -%}
    {%- endif -%}

    {%- if section.settings.show_copyright or section.settings.show_back_to_top -%}
      <div class="footer__bottom">
        <div class="footer__bottom-left">
          {%- if section.settings.show_copyright -%}
            <p class="footer__small-text">
              &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
              {%- if section.settings.copyright_text != blank -%}
                {{ section.settings.copyright_text }}
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- unless section.settings.hide_powered_by -%}
            <p class="footer__small-text">{{ powered_by_link }}</p>
          {%- endunless -%}
        </div>

        {%- if section.settings.show_back_to_top -%}
          <button type="button" class="footer__to-top" data-back-to-top>
            {{ section.settings.back_to_top_label | default: 'Back to top' }}
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 10 12"><path d="M5 11V1m0 0L1 5m4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</footer>

{% schema %}
{
