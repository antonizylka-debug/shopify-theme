{%- liquid
  assign color_text = section.settings.color_text
  assign color_muted = section.settings.color_muted
  assign color_soft = section.settings.color_soft
  assign color_line = section.settings.color_line
-%}

{%- capture icon_mail -%}<rect x="1.5" y="3.5" width="12" height="9" rx="1"/><path d="m1.9 4.2 5.6 4.3 5.6-4.3"/>{%- endcapture -%}
{%- capture icon_phone -%}<path d="M4.4 2.2h1.6L6.9 4.5 5.6 5.5c.7 1.4 1.8 2.5 3.2 3.2l1-1.3 2.3.9v1.6c0 .6-.5 1-1.1 1C6.6 11.4 3.1 7.9 2.6 3.3c-.1-.6.4-1.1 1-1.1Z"/>{%- endcapture -%}
{%- capture icon_clock -%}<circle cx="7.5" cy="7.5" r="5.5"/><path d="M7.5 4.2v3.5l2.3 1.4"/>{%- endcapture -%}
{%- capture icon_pin -%}<path d="M7.5 1.8c2.1 0 3.8 1.7 3.8 3.8 0 2.8-3.8 7.1-3.8 7.1S3.7 8.4 3.7 5.6c0-2.1 1.7-3.8 3.8-3.8Z"/><circle cx="7.5" cy="5.5" r="1.4"/>{%- endcapture -%}
{%- capture icon_chat -%}<path d="M2 3h11v7.5H6l-4 3V3Z"/><path d="M4.5 6h6M4.5 8h3.5"/>{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} .ob-contact {
    color: {{ color_text }};
  }

  #shopify-section-{{ section.id }} .ob-contact__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 40px;
  }

  /* --- okruszki --- */

  #shopify-section-{{ section.id }} .ob-contact__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .ob-crumb {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ob-crumb--link {
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-crumb--link:hover {
    color: {{ color_text }};
  }

  #shopify-section-{{ section.id }} .ob-crumb__sep {
    font-size: 12px;
    color: {{ color_muted }};
  }

  #shopify-section-{{ section.id }} .ob-crumb--current {
    color: {{ color_text }};
  }

  /* --- naglowek --- */

  #shopify-section-{{ section.id }} .ob-contact__titleblock {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .ob-contact__title {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ob-contact__tagline {
    max-width: 620px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: {{ color_muted }};
  }

  /* --- uklad --- */

  #shopify-section-{{ section.id }} .ob-contact__body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 32px 0 56px;
  }

  #shopify-section-{{ section.id }} .ob-contact__rule {
    height: 1px;
    background: {{ color_line }};
  }

  #shopify-section-{{ section.id }} .ob-contact__columns {
    display: flex;
    gap: 48px;
    padding-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .ob-contact__media,
  #shopify-section-{{ section.id }} .ob-contact__right {
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ob-contact__img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: {{ section.settings.image_height }}px;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ob-contact__right {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .ob-contact__block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .ob-contact__headinggroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .ob-contact__h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ob-contact__note {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: {{ color_soft }};
  }

  /* --- dane kontaktowe --- */

  #shopify-section-{{ section.id }} .ob-support {
    padding: 6px 28px;
    background: {{ section.settings.color_box }};
  }

  #shopify-section-{{ section.id }} .ob-support__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 0;
  }

  #shopify-section-{{ section.id }} .ob-support__row + .ob-support__row {
    border-top: 1px solid {{ color_line }};
  }

  #shopify-section-{{ section.id }} .ob-support__ic {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-support__label {
    display: block;
    margin-bottom: 3px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-support__value {
    display: block;
    font-size: 15px;
    line-height: 1.4;
    color: {{ color_text }};
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} a.ob-support__value:hover {
    text-decoration: underline;
  }

  /* --- formularz --- */

  #shopify-section-{{ section.id }} .ob-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .ob-form__row {
    display: flex;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .ob-form__field {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ob-form__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-form__field input,
  #shopify-section-{{ section.id }} .ob-form__field textarea {
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: 15px 14px;
    border: 1px solid {{ color_line }};
    border-radius: 0;
    background: none;
    color: {{ color_text }};
    font-family: inherit;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  #shopify-section-{{ section.id }} .ob-form__field textarea {
    height: 140px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .ob-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 14px 26px;
    border: 0;
    background: {{ color_text }};
    color: {{ section.settings.color_button_text }};
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ob-form__submit:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .ob-form__notice {
    padding: 14px;
    background: {{ section.settings.color_box }};
    font-size: 13px;
  }

  /* --- krotkie FAQ --- */

  #shopify-section-{{ section.id }} .ob-cfaq {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-cfaq__title {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__sub {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: {{ color_soft }};
  }

  #shopify-section-{{ section.id }} .ob-cfaq__list {
    width: 100%;
    max-width: 820px;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__row {
    border-bottom: 1px solid {{ color_line }};
  }

  #shopify-section-{{ section.id }} .ob-cfaq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 26px 0;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__q::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__chev {
    flex: 0 0 12px;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .ob-cfaq__row[open] .ob-cfaq__chev {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .ob-cfaq__a {
    padding: 0 0 18px;
    font-size: 12px;
    line-height: 1.6;
    color: {{ color_muted }};
  }

  #shopify-section-{{ section.id }} .ob-cfaq__a p {
    margin: 0;
  }

  @media only screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .ob-contact__content {
      padding-top: 24px;
    }

    #shopify-section-{{ section.id }} .ob-contact__title,
    #shopify-section-{{ section.id }} .ob-cfaq__title {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .ob-contact__body {
      gap: 32px;
      padding: 24px 0 40px;
    }

    #shopify-section-{{ section.id }} .ob-contact__columns {
      flex-direction: column;
      gap: 32px;
      padding-bottom: 8px;
    }

    #shopify-section-{{ section.id }} .ob-form__row {
      flex-direction: column;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .ob-support {
      padding: 4px 18px;
    }

    #shopify-section-{{ section.id }} .ob-form__submit {
      align-self: stretch;
    }
  }
{%- endstyle -%}

<div class="ob-contact">
  <div class="page-width ob-contact__content">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="ob-contact__crumbs" aria-label="Breadcrumb">
        <a class="ob-crumb ob-crumb--link" href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>
        <span class="ob-crumb__sep" aria-hidden="true">/</span>
        <span class="ob-crumb ob-crumb--current" aria-current="page">{{ section.settings.title | escape }}</span>
      </nav>
    {%- endif -%}

    <div class="ob-contact__titleblock">
      <h1 class="ob-contact__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.tagline != blank -%}
        <p class="ob-contact__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    <div class="ob-contact__body">
      <div class="ob-contact__rule"></div>

      <div class="ob-contact__columns">
        {%- if section.settings.image != blank -%}
          <div class="ob-contact__media">
            {%- render 'image-element',
              img: section.settings.image,
              alt: section.settings.image.alt | default: section.settings.title,
              classes: 'ob-contact__img',
              sizeVariable: '50vw'
            -%}
          </div>
        {%- endif -%}

        <div class="ob-contact__right">
          {%- assign support_blocks = section.blocks | where: 'type', 'support' -%}
          {%- if support_blocks.size > 0 -%}
            <div class="ob-contact__block">
              <div class="ob-contact__headinggroup">
                <h2 class="ob-contact__h2">{{ section.settings.support_title | escape }}</h2>
                {%- if section.settings.support_note != blank -%}
                  <p class="ob-contact__note">{{ section.settings.support_note | escape }}</p>
                {%- endif -%}
              </div>

              <div class="ob-support">
                {%- for block in support_blocks -%}
                  {%- liquid
                    assign value = block.settings.value | strip
                    assign href = ''

                    if value contains '@' and value contains '.'
                      assign href = 'mailto:' | append: value
                    elsif block.settings.icon == 'phone'
                      assign href = 'tel:' | append: value | remove: ' '
                    endif
                  -%}

                  <div class="ob-support__row" {{ block.shopify_attributes }}>
                    <span class="ob-support__ic" aria-hidden="true">
                      <svg viewBox="0 0 15 15" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        {%- case block.settings.icon -%}
                          {%- when 'phone' -%}{{ icon_phone }}
                          {%- when 'clock' -%}{{ icon_clock }}
                          {%- when 'pin' -%}{{ icon_pin }}
                          {%- when 'chat' -%}{{ icon_chat }}
                          {%- else -%}{{ icon_mail }}
                        {%- endcase -%}
                      </svg>
                    </span>
                    <span class="ob-support__text">
                      <span class="ob-support__label">{{ block.settings.label | escape }}</span>
                      {%- if href != blank -%}
                        <a class="ob-support__value" href="{{ href }}">{{ value | escape }}</a>
                      {%- else -%}
                        <span class="ob-support__value">{{ value | escape }}</span>
                      {%- endif -%}
                    </span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="ob-contact__block ob-contact__block--form">
            <div class="ob-contact__headinggroup">
              <h2 class="ob-contact__h2">{{ section.settings.form_title | escape }}</h2>
              {%- if section.settings.form_note != blank -%}
                <p class="ob-contact__note">{{ section.settings.form_note | escape }}</p>
              {%- endif -%}
            </div>

            {%- form 'contact', id: 'contact_form', class: 'ob-form' -%}
              {%- if form.posted_successfully? -%}
                <p class="ob-form__notice">{{ 'contact.form.post_success' | t }}</p>
              {%- elsif form.errors -%}
                <div class="ob-form__notice">{{ form.errors | default_errors }}</div>
              {%- endif -%}

              <div class="ob-form__row">
                <div class="ob-form__field">
                  <label class="ob-form__label" for="ContactName-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
                  <input
                    type="text"
                    id="ContactName-{{ section.id }}"
                    name="contact[name]"
                    autocomplete="name"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  >
                </div>

                <div class="ob-form__field">
                  <label class="ob-form__label" for="ContactEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
                  <input
                    type="email"
                    id="ContactEmail-{{ section.id }}"
                    name="contact[email]"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  >
                </div>
              </div>

              <div class="ob-form__field">
                <label class="ob-form__label" for="ContactBody-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
                <textarea id="ContactBody-{{ section.id }}" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>

              <button type="submit" class="ob-form__submit">
                {{ section.settings.button_label | default: 'Send message' | escape }}
              </button>
            {%- endform -%}
          </div>
        </div>
      </div>

      {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
      {%- if faq_blocks.size > 0 -%}
        <div class="ob-cfaq">
          <div class="ob-cfaq__head">
            {%- if section.settings.faq_eyebrow != blank -%}
              <p class="ob-cfaq__eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="ob-cfaq__title">{{ section.settings.faq_title | escape }}</h2>
            {%- if section.settings.faq_sub != blank -%}
              <p class="ob-cfaq__sub">{{ section.settings.faq_sub | escape }}</p>
            {%- endif -%}
          </div>

          <div class="ob-cfaq__list">
            {%- for block in faq_blocks -%}
              <details class="ob-cfaq__row" {{ block.shopify_attributes }}>
                <summary class="ob-cfaq__q">
                  <span>{{ block.settings.question | escape }}</span>
                  <svg class="ob-cfaq__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                    <path d="M2.75 4.5 6 7.75 9.25 4.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="ob-cfaq__a">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "max_blocks": 20,
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "home_label", "label": "First breadcrumb", "default": "Home" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Get in touch" },
    { "type": "text", "id": "tagline", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_height", "label": "Max image height", "default": 860, "min": 300, "max": 1200, "step": 10, "unit": "px" },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "support_title", "label": "Heading", "default": "Customer support" },
    { "type": "text", "id": "support_note", "label": "Note under the heading" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_title", "label": "Heading", "default": "Send us a message" },
    { "type": "text", "id": "form_note", "label": "Note under the heading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "header", "content": "Questions below the form" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "FAQs" },
    { "type": "text", "id": "faq_title", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "faq_sub", "label": "Subheading" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1c1d1d" },
    { "type": "color", "id": "color_muted", "label": "Secondary text", "default": "#4a4844" },
    { "type": "color", "id": "color_soft", "label": "Labels and notes", "default": "#6e6e6e" },
    { "type": "color", "id": "color_line", "label": "Lines and field borders", "default": "#e6e3de" },
    { "type": "color", "id": "color_box", "label": "Details box background", "default": "#f3f6fa" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "support",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "mail",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "clock", "label": "Hours" },
            { "value": "pin", "label": "Address" },
            { "value": "chat", "label": "Chat" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "value", "label": "Value", "info": "An address with @ becomes a mailto link, a phone becomes a tel link." }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "blocks": [
        { "type": "support", "settings": { "icon": "mail", "label": "Email", "value": "" } },
        { "type": "support", "settings": { "icon": "clock", "label": "Support hours", "value": "" } },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
