        { "type": "promise", "settings": { "icon": "lock", "title": "Sikker betaling", "text": "Krypteret" } },
        { "type": "accordion", "settings": { "title": "Detaljer", "use_description": true, "open_by_default": true } },
        { "type": "accordion", "settings": { "title": "Fragt og returnering" } },
        { "type": "accordion", "settings": { "title": "Kundeservice" } }
      ]
