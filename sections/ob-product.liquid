{%- comment -%}
  Strona produktu odwzorowana z oliverandblake.com.

  Zmierzone na zywo na ich stronie (1280px):
    siatka        623.75px | 465.23px, gap 48px, kontener 1137px
    galeria       grid 68px | 540px, gap 16px; miniatury w kolumnie, gap 10px
    kadr zdjecia  kwadrat 1/1, object-fit cover, przewijanie ze scroll-snap
    tytul         30px / 36px, waga 600
    cena          22.4px waga 600; przekreslona 16px waga 400, krycie 65%
    badge rabatu  14px waga 600, ls 0.35, tlo #e8edf5, tekst #2e4e7e, radius 3px
    etykieta opcji 14px waga 600, ls 0.35, uppercase, kolor #6e6b65
    kafel koloru  48x60, ramka 1px #1c1d1d, padding 3px
    kafel rozmiaru 84x46, ramka 1px #1c1d1d, 15px waga 500, ls 0.9
    przycisk      wysokosc 64, tlo #1c1d1d, 15px waga 600, ls 0.9, uppercase
    linia dostawy 12px, krycie 65%, padding 14px 0 0
    karty obietnic 148x136, ramka 1px #e6e3de, padding 18px 8px
    akordeon      summary 15px uppercase padding 18px 2px, tresc 14.4px
    telefon 375px jedna kolumna gap 12px, tytul 26px, galeria na gorze,
            miniatury poziomo, karty obietnic 108px

  Rzeczy, ktorych NIE przepisuje z ich strony, bo byly zmyslone:
    - ocena "4.8 Rated Excellent" - u nas wylaczona domyslnie, do podpiecia
      pod prawdziwa aplikacje z opiniami
    - "Almost sold out" - u nas liczone z realnego stanu magazynowego
    - data dostawy - u nas liczona z ustawien, nie zaszyta
{%- endcomment -%}

{%- liquid
  assign prod = product
  assign war = prod.selected_or_first_available_variant

  comment
    Ktora opcja jest kolorem, a ktora rozmiarem - po nazwie, zeby dzialalo
    i przy angielskich, i przy dunskich nazwach opcji.
  endcomment
  assign poz_koloru = 0
  assign poz_rozmiaru = 0
  for opt in prod.options_with_values
    assign nazwa = opt.name | downcase
    if nazwa contains 'farve' or nazwa contains 'color' or nazwa contains 'colour' or nazwa contains 'couleur'
      assign poz_koloru = forloop.index
    endif
    if nazwa contains 'størrelse' or nazwa contains 'storrelse' or nazwa contains 'size'
      assign poz_rozmiaru = forloop.index
    endif
  endfor

  assign oszczednosc = 0
  if war.compare_at_price > war.price
    assign roznica = war.compare_at_price | minus: war.price | times: 100.0
    assign oszczednosc = roznica | divided_by: war.compare_at_price | round
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .obp {
    --obp-text: {{ section.settings.color_text }};
    --obp-muted: {{ section.settings.color_muted }};
    --obp-line: {{ section.settings.color_line }};
    --obp-rule: {{ section.settings.color_rule }};
    --obp-btn: {{ section.settings.color_button }};
    --obp-btn-text: {{ section.settings.color_button_text }};
    --obp-save-bg: {{ section.settings.color_save_bg }};
    --obp-save-text: {{ section.settings.color_save_text }};
    --obp-low: {{ section.settings.color_low_stock }};
    color: var(--obp-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .obp__grid {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.media_ratio }}fr) minmax(0, {{ section.settings.info_ratio }}fr);
    gap: {{ section.settings.column_gap }}px;
    align-items: start;
  }

  /* ---------- galeria ---------- */
  #shopify-section-{{ section.id }} .obp__gallery {
    display: grid;
    grid-template-columns: {{ section.settings.thumb_size }}px minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  /* Kolumna miniatur nie moze byc wyzsza od zdjecia. Samo max-height: 100%
     nic nie daje, bo wiersz siatki rosnie razem z trescia - dlatego opakowanie
     rozciaga sie na wysokosc zdjecia, a lista lezy w nim absolutnie i scrolluje. */
  #shopify-section-{{ section.id }} .obp__thumbs-wrap {
    position: relative;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .obp__thumbs {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .obp__thumbs::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .obp__thumb {
    display: block;
    width: {{ section.settings.thumb_size }}px;
    aspect-ratio: 1 / 1;
    padding: 1px;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .obp__thumb.is-active { border-color: var(--obp-text); }
  #shopify-section-{{ section.id }} .obp__thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  #shopify-section-{{ section.id }} .obp__swipe {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .obp__swipe::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .obp__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
  }
  #shopify-section-{{ section.id }} .obp__slide img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  #shopify-section-{{ section.id }} .obp__dots {
    display: none;
    justify-content: center;
    gap: 6px;
    padding-top: 12px;
  }
  #shopify-section-{{ section.id }} .obp__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--obp-line); border: 0; padding: 0;
  }
  #shopify-section-{{ section.id }} .obp__dot.is-active { background: var(--obp-text); }

  /* ---------- naglowek ---------- */
  #shopify-section-{{ section.id }} .obp__title {
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 10px;
    /* motyw ma globalne wersaliki na naglowkach - tutaj je zdejmujemy,
       bo dlugi tytul produktu kapitalikami jest ciezki do czytania */
    text-transform: {% if section.settings.title_uppercase %}uppercase{% else %}none{% endif %};
    letter-spacing: {% if section.settings.title_uppercase %}0.02em{% else %}normal{% endif %};
  }

  /* ---------- okruszki ---------- */
  #shopify-section-{{ section.id }} .obp__crumbs {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--obp-muted);
    padding-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .obp__crumbs a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .obp__crumbs a:hover { text-decoration: underline; }
  #shopify-section-{{ section.id }} .obp__crumbs span { color: var(--obp-text); }
  #shopify-section-{{ section.id }} .obp__crumbs em { font-style: normal; padding: 0 6px; }

  #shopify-section-{{ section.id }} .obp__rating {
    display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .obp__stars { display: flex; gap: 2px; }
  #shopify-section-{{ section.id }} .obp__stars svg { width: 15px; height: 15px; }
  #shopify-section-{{ section.id }} .obp__rating__num { font-size: 15px; font-weight: 600; }
  #shopify-section-{{ section.id }} .obp__rating__label { font-size: 14px; color: var(--obp-muted); }

  #shopify-section-{{ section.id }} .obp__price {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    font-size: 22px; font-weight: 600;
  }
  #shopify-section-{{ section.id }} .obp__compare {
    font-size: 16px; font-weight: 400; opacity: 0.65;
  }
  #shopify-section-{{ section.id }} .obp__save {
    font-size: 14px; font-weight: 600; letter-spacing: 0.035em; text-transform: uppercase;
    background: var(--obp-save-bg); color: var(--obp-save-text);
    border-radius: 3px; padding: 4px 8px;
  }

  /* Kwota oszczednosci obok procentu. Ludzie czuja "1.100 kr" mocniej
     niz "50%", a obie liczby wynikaja z tych samych dwoch cen. */
  #shopify-section-{{ section.id }} .obp__savings {
    flex-basis: 100%;
    font-size: 14px; font-weight: 500;
    color: var(--obp-low);
    margin-top: 2px;
  }

  /* Linia zaufania tuz pod przyciskiem - w miejscu, gdzie klient
     podejmuje decyzje, a nie 300 px nizej */
  #shopify-section-{{ section.id }} .obp__reassure {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 6px 14px; padding: 12px 0 0;
    font-size: 13px; color: var(--obp-muted);
  }
  #shopify-section-{{ section.id }} .obp__reassure span {
    display: inline-flex; align-items: center; gap: 5px;
  }
  #shopify-section-{{ section.id }} .obp__reassure svg {
    width: 13px; height: 13px; flex: 0 0 13px;
  }

  /* Termin pakowania liczony na zywo z godziny granicznej */
  #shopify-section-{{ section.id }} .obp__cutoff {
    display: none;
    align-items: center; justify-content: center; gap: 6px;
    padding: 10px 0 0; font-size: 13px; font-weight: 500;
    color: var(--obp-low);
  }
  #shopify-section-{{ section.id }} .obp__cutoff.is-on { display: flex; }
  #shopify-section-{{ section.id }} .obp__cutoff svg { width: 14px; height: 14px; flex: 0 0 14px; }

  /* ---------- pasek przyklejony ---------- */
  #shopify-section-{{ section.id }} .obp__sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    background: #fff;
    border-top: 1px solid var(--obp-line);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.07);
    transform: translateY(102%);
    transition: transform 0.25s ease;
    padding: 10px 0;
  }
  #shopify-section-{{ section.id }} .obp__sticky.is-on { transform: translateY(0); }
  #shopify-section-{{ section.id }} .obp__sticky-in {
    display: flex; align-items: center; gap: 14px;
  }
  #shopify-section-{{ section.id }} .obp__sticky img {
    width: 46px; height: 46px; object-fit: cover; flex: 0 0 46px;
  }
  #shopify-section-{{ section.id }} .obp__sticky-txt { min-width: 0; flex: 1 1 auto; }
  #shopify-section-{{ section.id }} .obp__sticky-name {
    font-size: 14px; font-weight: 500;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .obp__sticky-price {
    font-size: 14px; color: var(--obp-muted); display: flex; gap: 7px; align-items: baseline;
  }
  #shopify-section-{{ section.id }} .obp__sticky-price s { opacity: 0.7; }
  #shopify-section-{{ section.id }} .obp__sticky-btn {
    flex: 0 0 auto; height: 48px; padding: 0 30px; border: 0; cursor: pointer;
    background: var(--obp-btn); color: var(--obp-btn-text);
    font-size: 14px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .obp__sticky-btn[disabled] { opacity: 0.45; cursor: not-allowed; }

  #shopify-section-{{ section.id }} .obp__rule {
    height: 1px; border: 0; background: var(--obp-rule); opacity: 0.35;
    margin: 18px 0;
  }

  /* ---------- opcje ---------- */
  #shopify-section-{{ section.id }} .obp__opt { margin-bottom: 18px; }
  #shopify-section-{{ section.id }} .obp__opt-head {
    display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .obp__label {
    font-size: 14px; font-weight: 600; letter-spacing: 0.035em;
    text-transform: uppercase; color: var(--obp-muted);
  }
  #shopify-section-{{ section.id }} .obp__val { font-size: 15px; font-weight: 500; }
  #shopify-section-{{ section.id }} .obp__sglink {
    margin-left: auto; font-size: 15px; font-weight: 500; letter-spacing: 0.06em;
    color: var(--obp-text); text-decoration: underline; text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .obp__swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  #shopify-section-{{ section.id }} .obp__swatch {
    width: 48px; height: 60px; padding: 3px;
    border: 1px solid var(--obp-line); background: none; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .obp__swatch.is-active { border-color: var(--obp-text); }
  #shopify-section-{{ section.id }} .obp__swatch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .obp__swatch-dot { display: block; width: 100%; height: 100%; }

  #shopify-section-{{ section.id }} .obp__sizes { display: flex; flex-wrap: wrap; gap: 8px; }
  #shopify-section-{{ section.id }} .obp__size {
    min-width: 62px; height: 46px; padding: 0 10px;
    border: 1px solid var(--obp-line); background: #fff; color: var(--obp-text);
    font-size: 15px; font-weight: 400; letter-spacing: 0.06em; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .obp__size.is-selected {
    border-color: var(--obp-text); font-weight: 500;
  }
  #shopify-section-{{ section.id }} .obp__size.is-soldout {
    color: var(--obp-muted); text-decoration: line-through; opacity: 0.55; cursor: not-allowed;
  }

  /* ---------- stan, przycisk, dostawa ---------- */
  #shopify-section-{{ section.id }} .obp__badge {
    font-size: 14px; font-weight: 500; letter-spacing: 0.035em;
    color: var(--obp-low); padding: 16px 0;
  }
  #shopify-section-{{ section.id }} .obp__atc {
    display: block; width: 100%; height: 64px; border: 0; cursor: pointer;
    background: var(--obp-btn); color: var(--obp-btn-text);
    font-size: 15px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .obp__atc[disabled] { opacity: 0.45; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .obp__promo {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    font-size: 12px; letter-spacing: 0.05em; opacity: 0.75; padding: 14px 0 0;
  }
  #shopify-section-{{ section.id }} .obp__promo svg { width: 15px; height: 15px; flex: 0 0 15px; }
  #shopify-section-{{ section.id }} .obp__promo strong { font-weight: 600; }
  #shopify-section-{{ section.id }} .obp__promo em { font-style: normal; opacity: 0.5; padding: 0 3px; }

  /* ---------- karty obietnic ---------- */
  #shopify-section-{{ section.id }} .obp__usp {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px;
    margin-top: 20px;
  }
  #shopify-section-{{ section.id }} .obp__usp-card {
    border: 1px solid var(--obp-line); padding: 18px 8px; text-align: center;
  }
  #shopify-section-{{ section.id }} .obp__usp-card svg {
    width: 20px; height: 20px; margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .obp__usp-l {
    font-size: 14px; font-weight: 700; letter-spacing: 0.035em;
    text-transform: uppercase; line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .obp__usp-s {
    font-size: 14px; color: var(--obp-muted); margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .obp__pay {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: {{ section.settings.pay_align }};
    gap: {{ section.settings.pay_gap }}px;
    padding: 18px 0 0;
  }
  #shopify-section-{{ section.id }} .obp__pay svg,
  #shopify-section-{{ section.id }} .obp__pay img {
    height: {{ section.settings.pay_size }}px;
    width: auto;
    display: block;
  }

  /* ---------- pasek kampanii ---------- */
  #shopify-section-{{ section.id }} .obp__campaign {
    display: block;
    background: {{ section.settings.campaign_bg }};
    color: {{ section.settings.campaign_text_color }};
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 11px 14px;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .obp__campaign small {
    display: block;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: none;
    opacity: 0.85;
    margin-top: 3px;
  }

  /* ---------- akordeony ---------- */
  #shopify-section-{{ section.id }} .obp__accs { margin-top: 10px; }
  #shopify-section-{{ section.id }} .obp__acc { border-top: 1px solid var(--obp-line); }
  #shopify-section-{{ section.id }} .obp__acc:last-child { border-bottom: 1px solid var(--obp-line); }
  #shopify-section-{{ section.id }} .obp__acc summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 2px; cursor: pointer; list-style: none;
    font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .obp__acc summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .obp__acc summary::after {
    content: ''; width: 9px; height: 9px; flex: 0 0 9px;
    border-right: 1px solid currentColor; border-bottom: 1px solid currentColor;
    transform: rotate(45deg); transition: transform 0.2s;
  }
  #shopify-section-{{ section.id }} .obp__acc[open] summary::after { transform: rotate(-135deg); }
  #shopify-section-{{ section.id }} .obp__acc-body {
    padding: 0 2px 18px; font-size: 14.4px; line-height: 1.65;
  }
  #shopify-section-{{ section.id }} .obp__acc-body p { margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .obp__acc-body ul { margin: 0; padding-left: 20px; }
  #shopify-section-{{ section.id }} .obp__acc-body li { margin-bottom: 4px; }

  /* ---------- telefon ---------- */
  @media only screen and (max-width: {{ section.settings.breakpoint }}px) {
    #shopify-section-{{ section.id }} .obp__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .obp__gallery {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    /* na telefonie miniatury wracaja do normalnego przeplywu i ida poziomo */
    #shopify-section-{{ section.id }} .obp__thumbs-wrap {
      position: static;
      order: 2;
    }
    #shopify-section-{{ section.id }} .obp__thumbs {
      position: static;
      inset: auto;
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
    }
    #shopify-section-{{ section.id }} .obp__stage { order: 1; }
    #shopify-section-{{ section.id }} .obp__crumbs {
      font-size: 11px;
      padding-bottom: 14px;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    #shopify-section-{{ section.id }} .obp__dots { display: flex; }
    #shopify-section-{{ section.id }} .obp__title { font-size: {{ section.settings.title_size_mobile }}px; }
    #shopify-section-{{ section.id }} .obp__usp { gap: 8px; }
    #shopify-section-{{ section.id }} .obp__usp-card { padding: 14px 4px; }
    /* Karty obietnic maja na telefonie po 108 px szerokosci - przy 14 px
       tekst lamal sie na trzy linie. Mniejszy stopien i ciasniejszy padding
       miesci "30 DAGES RETURRET" w dwoch. */
    #shopify-section-{{ section.id }} .obp__usp-card { padding: 13px 3px; }
    #shopify-section-{{ section.id }} .obp__usp-card svg { width: 17px; height: 17px; margin-bottom: 7px; }
    #shopify-section-{{ section.id }} .obp__usp-l { font-size: 11px; letter-spacing: 0.02em; line-height: 1.3; }
    #shopify-section-{{ section.id }} .obp__usp-s { font-size: 11px; margin-top: 3px; }

    #shopify-section-{{ section.id }} .obp__reassure { font-size: 12px; gap: 4px 10px; }

    /* Osiemnascie rozmiarow po 62 px robilo piec rzedow i spychalo przycisk
       o 110 px w dol. Wezsze kafle mieszcza szesc w rzedzie zamiast czterech,
       a 46 px wysokosci zostaje - to minimum dla palca. */
    #shopify-section-{{ section.id }} .obp__sizes { gap: 6px; }
    #shopify-section-{{ section.id }} .obp__size { min-width: 48px; padding: 0 7px; font-size: 14px; }

    #shopify-section-{{ section.id }} .obp__swatches { gap: 6px; }

    /* Kropki galerii same w sobie maja 6 px - za malo, zeby w nie trafic.
       Powiekszamy pole dotyku, nie sama kropke. */
    #shopify-section-{{ section.id }} .obp__dots { gap: 0; padding-top: 10px; }
    #shopify-section-{{ section.id }} .obp__dot {
      width: 26px; height: 26px; border-radius: 0; background: none; position: relative;
    }
    #shopify-section-{{ section.id }} .obp__dot::after {
      content: ''; position: absolute; left: 50%; top: 50%;
      width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%;
      background: var(--obp-line);
    }
    #shopify-section-{{ section.id }} .obp__dot.is-active::after { background: var(--obp-text); }

    /* miniatury przewijaja sie poziomo - niech zatrzymuja sie na kafelku */
    #shopify-section-{{ section.id }} .obp__thumbs {
      scroll-snap-type: x proximity;
      padding-bottom: 2px;
    }
    #shopify-section-{{ section.id }} .obp__thumb { scroll-snap-align: start; }

    #shopify-section-{{ section.id }} .obp__campaign {
      font-size: 12px; padding: 10px 12px; margin-bottom: 16px;
    }
    #shopify-section-{{ section.id }} .obp__campaign small { font-size: 11px; }

    #shopify-section-{{ section.id }} .obp__sticky img { display: none; }
    #shopify-section-{{ section.id }} .obp__sticky-btn { padding: 0 20px; height: 46px; }
    #shopify-section-{{ section.id }} .obp__sticky-in { gap: 10px; }
    #shopify-section-{{ section.id }} .obp__sticky-name { font-size: 13px; }
    #shopify-section-{{ section.id }} .obp__sticky-price { font-size: 13px; }
  }
{%- endstyle -%}

<div class="obp">
  <div class="page-width">

    {%- if section.settings.show_breadcrumbs -%}
      {%- liquid
        comment
          Srodkowy okruszek bierzemy z kolekcji, z ktorej klient wszedl
          (collection jest ustawione tylko na sciezce /collections/.../products/...).
        endcomment
        assign kolekcja = collection
      -%}
      <nav class="obp__crumbs" aria-label="{{ 'general.breadcrumbs.home_link_title' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        {%- if kolekcja != blank and kolekcja.handle != blank -%}
          <em>/</em><a href="{{ kolekcja.url }}">{{ kolekcja.title }}</a>
        {%- endif -%}
        <em>/</em><span>{{ prod.title }}</span>
      </nav>
    {%- endif -%}

    <div class="obp__grid">

      {%- comment -%} ---------- lewa kolumna: galeria ---------- {%- endcomment -%}
      <div class="obp__gallery" data-obp-gallery>
        {%- if prod.media.size > 1 -%}
          <div class="obp__thumbs-wrap">
          <div class="obp__thumbs">
            {%- for media in prod.media -%}
              {%- comment -%}
                alt liczymy osobno: "alt: media.alt | default: ..." zastosowaloby
                filtr default do calego wyniku image_tag, a nie do samego alt.
              {%- endcomment -%}
              {%- assign opis_zdjecia = media.alt | default: prod.title -%}
              <button
                type="button"
                class="obp__thumb{% if forloop.first %} is-active{% endif %}"
                data-obp-thumb="{{ forloop.index0 }}"
                aria-label="{{ prod.title | escape }} — {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: opis_zdjecia }}
              </button>
            {%- endfor -%}
          </div>
          </div>
        {%- endif -%}

        <div class="obp__stage">
          <div class="obp__swipe" data-obp-swipe>
            {%- if prod.media.size > 0 -%}
              {%- for media in prod.media -%}
                {%- assign opis_zdjecia = media.alt | default: prod.title -%}
                {%- if forloop.first -%}
                  {%- assign ladowanie = 'eager' -%}
                {%- else -%}
                  {%- assign ladowanie = 'lazy' -%}
                {%- endif -%}
                <div class="obp__slide" data-obp-slide="{{ forloop.index0 }}">
                  {{ media.preview_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: ladowanie,
                      sizes: '(min-width: 769px) 540px, 100vw',
                      widths: '375, 540, 750, 1080, 1200',
                      alt: opis_zdjecia }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="obp__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endif -%}
          </div>

          {%- if prod.media.size > 1 -%}
            <div class="obp__dots">
              {%- for media in prod.media -%}
                <button type="button" class="obp__dot{% if forloop.first %} is-active{% endif %}" data-obp-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- prawa kolumna: informacje ---------- {%- endcomment -%}
      <div class="obp__info">

        {%- comment -%}
          Pasek kampanii. Siedzi w ustawieniach SEKCJI, a nie przy produkcie,
          wiec wlaczasz go raz i jest na wszystkich produktach z tym szablonem.
          Wylaczasz tak samo - jednym przelacznikiem po wyprzedazy.
        {%- endcomment -%}
        {%- if section.settings.show_campaign and section.settings.campaign_title != blank -%}
          {%- if section.settings.campaign_link != blank -%}
            <a class="obp__campaign" href="{{ section.settings.campaign_link }}">
              {{ section.settings.campaign_title }}
              {%- if section.settings.campaign_sub != blank -%}
                <small>{{ section.settings.campaign_sub }}</small>
              {%- endif -%}
            </a>
          {%- else -%}
            <div class="obp__campaign">
              {{ section.settings.campaign_title }}
              {%- if section.settings.campaign_sub != blank -%}
                <small>{{ section.settings.campaign_sub }}</small>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="obp__head">
          <h1 class="obp__title">{{ prod.title }}</h1>

          {%- liquid
            comment
              Ocena z dwoch zrodel. "app" czyta metapole, ktore zapisuja
              aplikacje z opiniami (Judge.me, Shopify Product Reviews,
              Loox, Okendo) - wtedy liczba jest prawdziwa i sama sie
              aktualizuje. "manual" to wpisana recznie.
            endcomment
            assign ocena = blank
            assign liczba_opinii = 0

            if section.settings.rating_source == 'app'
              assign meta = prod.metafields.reviews.rating
              if meta != blank and meta.value != blank
                assign ocena = meta.value.rating | round: 1
              endif
              assign meta_ile = prod.metafields.reviews.rating_count
              if meta_ile != blank
                assign liczba_opinii = meta_ile.value | plus: 0
              endif
            elsif section.settings.rating_source == 'manual'
              assign ocena = section.settings.rating_value
            endif

            assign gwiazdek = 0
            if ocena != blank
              assign gwiazdek = ocena | plus: 0.0 | round
            endif
          -%}

          {%- if ocena != blank -%}
            <div class="obp__rating">
              <span class="obp__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- if forloop.index <= gwiazdek -%}
                    <svg viewBox="0 0 20 20" fill="currentColor" focusable="false"><path d="M10 1l2.39 4.84 5.35.78-3.87 3.77.91 5.32L10 13.27l-4.78 2.44.91-5.32L2.26 6.62l5.35-.78z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false"><path d="M10 1l2.39 4.84 5.35.78-3.87 3.77.91 5.32L10 13.27l-4.78 2.44.91-5.32L2.26 6.62l5.35-.78z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </span>
              <span class="obp__rating__num">{{ ocena }}</span>
              {%- if section.settings.rating_source == 'app' and liczba_opinii > 0 -%}
                <span class="obp__rating__label">{{ section.settings.rating_count_label }} {{ liczba_opinii }}</span>
              {%- elsif section.settings.rating_label != blank -%}
                <span class="obp__rating__label">{{ section.settings.rating_label }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="obp__price" data-obp-price>
            <span data-obp-price-now>{{ war.price | money }}</span>
            {%- if war.compare_at_price > war.price -%}
              <s class="obp__compare" data-obp-price-was>{{ war.compare_at_price | money }}</s>
              <span class="obp__save" data-obp-save>{{ section.settings.save_prefix }} {{ oszczednosc }}%</span>
              {%- if section.settings.show_savings_amount -%}
                {%- assign kwota_oszcz = war.compare_at_price | minus: war.price -%}
                <span class="obp__savings" data-obp-savings>{{ section.settings.savings_prefix }} {{ kwota_oszcz | money }}</span>
              {%- endif -%}
            {%- else -%}
              <s class="obp__compare" data-obp-price-was hidden></s>
              <span class="obp__save" data-obp-save hidden></span>
              <span class="obp__savings" data-obp-savings hidden></span>
            {%- endif -%}
          </div>
        </div>

        <hr class="obp__rule">

        {%- comment -%}
          Opcje. Kolor jako kafle ze zdjeciem wariantu, rozmiar jako kafle tekstowe.
          Reszta opcji (jesli produkt ma trzecia) leci jako kafle tekstowe.
        {%- endcomment -%}
        {%- for opt in prod.options_with_values -%}
          {%- assign i = forloop.index -%}
          {%- assign wybrana = opt.selected_value -%}

          <div class="obp__opt" data-obp-opt="{{ i }}" data-obp-opt-name="{{ opt.name | escape }}">
            <div class="obp__opt-head">
              <span class="obp__label">{{ opt.name }}</span>
              {%- if i == poz_koloru -%}
                <span class="obp__label">-</span>
                <span class="obp__val" data-obp-optval="{{ i }}">{{ wybrana }}</span>
              {%- endif -%}
              {%- if i == poz_rozmiaru and section.settings.size_guide_page != blank -%}
                <a class="obp__sglink" href="{{ section.settings.size_guide_page }}">{{ section.settings.size_guide_label }}</a>
              {%- endif -%}
            </div>

            {%- if i == poz_koloru -%}
              {%- assign idx0 = i | minus: 1 -%}
              <div class="obp__swatches">
                {%- for val in opt.values -%}
                  {%- liquid
                    comment
                      forloop.parentloop wskazywaloby tu na petle po wartosciach,
                      a potrzebny jest numer OPCJI - stad osobne idx0.
                    endcomment
                    assign zdjecie = blank
                    for v in prod.variants
                      assign v_val = v.options[idx0]
                      if v_val == val and v.featured_media != blank
                        assign zdjecie = v.featured_media.preview_image
                        break
                      endif
                    endfor
                    assign kolor_css = val | downcase | split: ' ' | last
                  -%}
                  <button
                    type="button"
                    class="obp__swatch{% if val == wybrana %} is-active{% endif %}"
                    data-obp-value="{{ val | escape }}"
                    data-obp-position="{{ i }}"
                    aria-label="{{ opt.name | escape }}: {{ val | escape }}">
                    {%- if zdjecie != blank -%}
                      {{ zdjecie | image_url: width: 120 | image_tag: loading: 'lazy', alt: val }}
                    {%- else -%}
                      <span class="obp__swatch-dot" style="background: {{ kolor_css }};"></span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="obp__sizes">
                {%- for val in opt.values -%}
                  <button
                    type="button"
                    class="obp__size{% if val == wybrana %} is-selected{% endif %}"
                    data-obp-value="{{ val | escape }}"
                    data-obp-position="{{ i }}">{{ val }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%} niski stan liczony z prawdziwego magazynu, nie zaszyty {%- endcomment -%}
        {%- liquid
          comment
            Dwa zrodla, bo w katalogu Stilhuset Nord zaden wariant nie ma
            wlaczonego sledzenia stanu - warunek magazynowy nigdy by nie zadzialal.

            'inventory' - z prawdziwego stanu (dziala dopiero po wlaczeniu
                          sledzenia w Shopify). Liquid nie zna slowa null,
                          wiec puste inventory_management sprawdzamy blankiem.
            'tag'        - produkt oznaczony tagiem, ktory sam ustawiasz.
                           Ty decydujesz, na czym to pokazac.
          endcomment
          assign malo_sztuk = false

          if section.settings.low_stock_source == 'inventory'
            if war.available and war.inventory_management != blank and war.inventory_quantity > 0 and war.inventory_quantity <= section.settings.low_stock_threshold
              assign malo_sztuk = true
            endif
          elsif section.settings.low_stock_source == 'tag'
            comment
              "tags contains" wymaga trafienia co do wielkiej litery i spacji.
              Przy tagu z "a" z kolkiem latwo o literowke, wiec porownujemy
              po sprowadzeniu obu stron do malych liter i obcieciu spacji.
            endcomment
            assign szukany_tag = section.settings.low_stock_tag | downcase | strip
            if szukany_tag != blank
              for t in prod.tags
                assign t_norm = t | downcase | strip
                if t_norm == szukany_tag
                  assign malo_sztuk = true
                  break
                endif
              endfor
            endif
          endif
        -%}
        <div class="obp__badge" data-obp-lowstock{% unless malo_sztuk %} hidden{% endunless %}>
          {{ section.settings.low_stock_text }}
        </div>

        {%- form 'product', prod, class: 'obp__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ war.id }}" data-obp-variant-id>
          <button
            type="submit"
            name="add"
            class="obp__atc"
            data-obp-atc
            {% unless war.available %}disabled{% endunless %}>
            <span data-obp-atc-text>
              {%- if war.available -%}
                {{ section.settings.add_label }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}

        {%- comment -%}
          Linia zaufania tuz pod przyciskiem. Kazdy z tych trzech punktow
          zdejmuje inna obawe: co jesli nie pasuje, ile zaplace za wysylke,
          czy platnosc jest bezpieczna.
        {%- endcomment -%}
        {%- if section.settings.show_reassure -%}
          <div class="obp__reassure">
            {%- assign punkty = section.settings.reassure_items | split: '|' -%}
            {%- for punkt in punkty -%}
              {%- assign tekst = punkt | strip -%}
              {%- if tekst != blank -%}
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 5 5L19 7"/></svg>
                  {{ tekst }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_cutoff -%}
          <div class="obp__cutoff" data-obp-cutoff hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span data-obp-cutoff-text></span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_delivery -%}
          <div class="obp__promo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M2.5 6h10v10h-10z"/><path d="M12.5 9h4l3.5 3.5V16h-7.5"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/>
            </svg>
            <strong>{{ section.settings.delivery_prefix }}</strong>
            <em>|</em>
            <span data-obp-eta>{{ section.settings.delivery_join }}</span>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- karty obietnic ---------- {%- endcomment -%}
        {%- assign karty = section.blocks | where: 'type', 'promise' -%}
        {%- if karty.size > 0 -%}
          <div class="obp__usp">
            {%- for block in karty -%}
              <div class="obp__usp-card" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}<path d="M2.5 6h10v10h-10z"/><path d="M12.5 9h4l3.5 3.5V16h-7.5"/><circle cx="6" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/>
                    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>
                    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                    {%- when 'shield' -%}<path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/>
                    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>
                    {%- else -%}<path d="M12 3 20 7.5v9L12 21 4 16.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>
                  {%- endcase -%}
                </svg>
                <div class="obp__usp-l">{{ block.settings.title }}</div>
                {%- if block.settings.text != blank -%}
                  <div class="obp__usp-s">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          {%- liquid
            comment
              'auto' bierze dokladnie to, co masz wlaczone w Shopify - nigdy
              nie pokaze metody, ktorej klient nie zobaczy w kasie.
              'lista' pozwala ustawic kolejnosc i wybrac tylko czesc.
              Ikony pochodza z zasobow Shopify (payment_type_svg_tag).
            endcomment
            if section.settings.pay_source == 'list'
              assign typy = section.settings.pay_list | split: ','
            else
              assign typy = shop.enabled_payment_types
            endif
            assign limit_ikon = section.settings.pay_limit
          -%}
          <div class="obp__pay">
            {%- for type in typy limit: limit_ikon -%}
              {%- assign kod = type | strip | downcase -%}
              {{ kod | payment_type_svg_tag: class: 'obp__pay-icon' }}
            {%- endfor -%}

            {%- comment -%}
              Metody, ktorych Shopify nie rysuje (np. MobilePay), dodajesz
              jako wlasny obrazek - blok "Payment logo".
            {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'payment_logo' and block.settings.image != blank -%}
                {{ block.settings.image
                  | image_url: height: 80
                  | image_tag: loading: 'lazy', alt: block.settings.name, class: 'obp__pay-icon' }}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} ---------- akordeony ---------- {%- endcomment -%}
        {%- assign sekcje = section.blocks | where: 'type', 'accordion' -%}
        {%- if sekcje.size > 0 -%}
          <div class="obp__accs">
            {%- for block in sekcje -%}
              <details class="obp__acc" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}</summary>
                <div class="obp__acc-body">
                  {%- if block.settings.use_description -%}
                    {{ prod.description }}
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>

  {%- comment -%}
    Pasek przyklejony pokazuje sie dopiero, gdy glowny przycisk zjedzie
    z ekranu. Na telefonie klient czyta opis i akordeony daleko pod
    przyciskiem - bez tego musialby przewijac z powrotem.
  {%- endcomment -%}
  {%- if section.settings.show_sticky -%}
    <div class="obp__sticky" data-obp-sticky>
      <div class="page-width">
        <div class="obp__sticky-in">
          {%- if prod.featured_media != blank -%}
            {{ prod.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod.title }}
          {%- endif -%}
          <div class="obp__sticky-txt">
            <div class="obp__sticky-name">{{ prod.title }}</div>
            <div class="obp__sticky-price">
              <span data-obp-sticky-now>{{ war.price | money }}</span>
              {%- if war.compare_at_price > war.price -%}
                <s data-obp-sticky-was>{{ war.compare_at_price | money }}</s>
              {%- else -%}
                <s data-obp-sticky-was hidden></s>
              {%- endif -%}
            </div>
          </div>
          <button type="button" class="obp__sticky-btn" data-obp-sticky-btn {% unless war.available %}disabled{% endunless %}>
            <span data-obp-sticky-label>
              {%- if war.available -%}{{ section.settings.add_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </span>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script type="application/json" data-obp-variants="{{ section.id }}">
  {{ prod.variants | json }}
</script>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var dane = root.querySelector('[data-obp-variants]');
    var warianty = [];
    try { warianty = JSON.parse(dane.textContent); } catch (e) { return; }

    var opcje = Array.prototype.map.call(root.querySelectorAll('[data-obp-opt]'), function (el) {
      return { poz: parseInt(el.dataset.obpOpt, 10), el: el };
    });

    // aktualny wybor czytamy z zaznaczonych kafli, zeby stan zawsze byl
    // brany z DOM, a nie z osobnej kopii, ktora moze sie rozjechac
    function wybor() {
      return opcje.map(function (o) {
        var akt = o.el.querySelector('.is-active, .is-selected');
        return akt ? akt.dataset.obpValue : null;
      });
    }

    function znajdz(wart) {
      for (var i = 0; i < warianty.length; i++) {
        var zgodne = true;
        for (var k = 0; k < wart.length; k++) {
          if (wart[k] !== null && warianty[i].options[k] !== wart[k]) { zgodne = false; break; }
        }
        if (zgodne) return warianty[i];
      }
      return null;
    }

    var pole = root.querySelector('[data-obp-variant-id]');
    var atc = root.querySelector('[data-obp-atc]');
    var atcText = root.querySelector('[data-obp-atc-text]');
    var teraz = root.querySelector('[data-obp-price-now]');
    var bylo = root.querySelector('[data-obp-price-was]');
    var save = root.querySelector('[data-obp-save]');
    var low = root.querySelector('[data-obp-lowstock]');
    var oszcz = root.querySelector('[data-obp-savings]');
    var sticky = root.querySelector('[data-obp-sticky]');
    var stTeraz = root.querySelector('[data-obp-sticky-now]');
    var stBylo = root.querySelector('[data-obp-sticky-was]');
    var stBtn = root.querySelector('[data-obp-sticky-btn]');
    var stLabel = root.querySelector('[data-obp-sticky-label]');

    var PROG = {{ section.settings.low_stock_threshold }};
    var ZRODLO_STANU = {{ section.settings.low_stock_source | json }};
    var WYPRZEDANE = {{ 'products.product.sold_out' | t | json }};
    var DODAJ = {{ section.settings.add_label | json }};
    var OSZCZ = {{ section.settings.save_prefix | json }};
    var OSZCZ_KWOTA = {{ section.settings.savings_prefix | json }};

    // formatowanie ceny zostawiamy motywowi - inaczej rozjedzie sie separator
    // i symbol waluty wzgledem reszty sklepu
    var FORMAT = {{ shop.money_format | json }};
    function kwota(grosze) {
      if (window.theme && window.theme.Currency && window.theme.Currency.formatMoney) {
        return window.theme.Currency.formatMoney(grosze, FORMAT);
      }
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(grosze, FORMAT);
      }
      return (grosze / 100).toFixed(2).replace('.', ',') + ' kr';
    }

    function odswiez() {
      var w = znajdz(wybor());

      // rozmiary niedostepne w tym kolorze przekreslamy, zamiast ukrywac -
      // klient widzi wtedy, ze rozmiar istnieje, tylko go nie ma
      opcje.forEach(function (o) {
        var inne = wybor();
        inne[o.poz - 1] = null;
        Array.prototype.forEach.call(o.el.querySelectorAll('[data-obp-value]'), function (btn) {
          var proba = inne.slice();
          proba[o.poz - 1] = btn.dataset.obpValue;
          var kandydat = znajdz(proba);
          var dostepny = kandydat && kandydat.available;
          btn.classList.toggle('is-soldout', !dostepny);
        });
      });

      if (!w) {
        atc.disabled = true;
        atcText.textContent = WYPRZEDANE;
        return;
      }

      if (pole) pole.value = w.id;
      atc.disabled = !w.available;
      atcText.textContent = w.available ? DODAJ : WYPRZEDANE;

      var naPrzecenie = w.compare_at_price && w.compare_at_price > w.price;

      if (teraz) teraz.innerHTML = kwota(w.price);
      if (bylo && save) {
        if (naPrzecenie) {
          bylo.innerHTML = kwota(w.compare_at_price);
          bylo.hidden = false;
          save.textContent = OSZCZ + ' ' + Math.round((w.compare_at_price - w.price) / w.compare_at_price * 100) + '%';
          save.hidden = false;
        } else {
          bylo.hidden = true;
          save.hidden = true;
        }
      }
      if (oszcz) {
        if (naPrzecenie) {
          oszcz.innerHTML = OSZCZ_KWOTA + ' ' + kwota(w.compare_at_price - w.price);
          oszcz.hidden = false;
        } else {
          oszcz.hidden = true;
        }
      }

      // pasek przyklejony pokazuje te same liczby co kolumna obok
      if (stTeraz) stTeraz.innerHTML = kwota(w.price);
      if (stBylo) {
        if (naPrzecenie) { stBylo.innerHTML = kwota(w.compare_at_price); stBylo.hidden = false; }
        else { stBylo.hidden = true; }
      }
      if (stBtn) stBtn.disabled = !w.available;
      if (stLabel) stLabel.textContent = w.available ? DODAJ : WYPRZEDANE;

      // w trybie tagu badge dotyczy calego produktu, wiec zmiana wariantu
      // nie moze go chowac - przeliczamy tylko w trybie magazynowym
      if (low && ZRODLO_STANU === 'inventory') {
        var maloSztuk = w.available && w.inventory_management && w.inventory_quantity > 0 && w.inventory_quantity <= PROG;
        low.hidden = !maloSztuk;
      }

      // adres z wariantem, zeby dalo sie podeslac link do konkretnego koloru
      if (history.replaceState) {
        var u = new URL(window.location.href);
        u.searchParams.set('variant', w.id);
        history.replaceState({}, '', u.toString());
      }

      // zdjecie wariantu na wierzch
      if (w.featured_media && w.featured_media.position) {
        przewin(w.featured_media.position - 1);
      }
    }

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-obp-value]');
      if (!btn || btn.classList.contains('is-soldout')) return;
      var grupa = btn.closest('[data-obp-opt]');
      Array.prototype.forEach.call(grupa.querySelectorAll('[data-obp-value]'), function (b) {
        b.classList.remove('is-active', 'is-selected');
      });
      btn.classList.add(btn.classList.contains('obp__swatch') ? 'is-active' : 'is-selected');
      var val = grupa.querySelector('[data-obp-optval]');
      if (val) val.textContent = btn.dataset.obpValue;
      odswiez();
    });

    // ---------- pasek przyklejony ----------
    // pokazuje sie dopiero, gdy glowny przycisk zjedzie z ekranu
    if (sticky && atc) {
      // Pasek jest position: fixed, wiec zaslanialby dol strony - dopoki
      // jest widoczny, dokladamy stronie tyle miejsca, ile sam zajmuje.
      function kompensuj(widoczny) {
        document.body.style.paddingBottom = widoczny
          ? sticky.getBoundingClientRect().height + 'px'
          : '';
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (wpisy) {
          var pokaz = !wpisy[0].isIntersecting;
          sticky.classList.toggle('is-on', pokaz);
          kompensuj(pokaz);
        }, { rootMargin: '0px 0px -10px 0px' }).observe(atc);
      }

      // po obrocie telefonu wysokosc paska moze sie zmienic
      window.addEventListener('resize', function () {
        if (sticky.classList.contains('is-on')) kompensuj(true);
      }, { passive: true });
      if (stBtn) {
        stBtn.addEventListener('click', function () {
          // klikamy prawdziwy przycisk formularza, zeby przeszly wszystkie
          // integracje motywu i aplikacji podpiete pod submit
          atc.click();
        });
      }
    }

    {%- if section.settings.show_cutoff -%}
    // ---------- godzina graniczna pakowania ----------
    // liczona na zywo z zegara klienta wzgledem ustawionej godziny.
    // Nic tu nie miga i nic sie nie resetuje - po prostu ile zostalo dzisiaj.
    (function () {
      var box = root.querySelector('[data-obp-cutoff]');
      var txt = root.querySelector('[data-obp-cutoff-text]');
      if (!box || !txt) return;
      var GODZINA = {{ section.settings.cutoff_hour }};
      var SZABLON = {{ section.settings.cutoff_text | json }};

      function odswiezCutoff() {
        var teraz = new Date();
        var dzien = teraz.getDay();
        // w weekend nie pakujemy, wiec nie ma czego odliczac
        if (dzien === 0 || dzien === 6) { box.hidden = true; box.classList.remove('is-on'); return; }

        var granica = new Date(teraz);
        granica.setHours(GODZINA, 0, 0, 0);
        var zostalo = granica - teraz;
        if (zostalo <= 0) { box.hidden = true; box.classList.remove('is-on'); return; }

        var godz = Math.floor(zostalo / 3600000);
        var min = Math.floor((zostalo % 3600000) / 60000);
        var ile = godz > 0 ? godz + ' t. ' + min + ' min.' : min + ' min.';
        txt.textContent = SZABLON.replace('{tid}', ile);
        box.hidden = false;
        box.classList.add('is-on');
      }

      odswiezCutoff();
      setInterval(odswiezCutoff, 60000);
    })();
    {%- endif -%}

    // ---------- galeria ----------
    var swipe = root.querySelector('[data-obp-swipe]');
    var thumbs = root.querySelectorAll('[data-obp-thumb]');
    var dots = root.querySelectorAll('[data-obp-dot]');

    function przewin(i) {
      if (!swipe) return;
      var slide = swipe.querySelector('[data-obp-slide="' + i + '"]');
      if (slide) swipe.scrollTo({ left: slide.offsetLeft - swipe.offsetLeft, behavior: 'smooth' });
    }

    function zaznacz(i) {
      Array.prototype.forEach.call(thumbs, function (t) { t.classList.toggle('is-active', parseInt(t.dataset.obpThumb, 10) === i); });
      Array.prototype.forEach.call(dots, function (d) { d.classList.toggle('is-active', parseInt(d.dataset.obpDot, 10) === i); });
    }

    Array.prototype.forEach.call(thumbs, function (t) {
      t.addEventListener('click', function () { przewin(parseInt(t.dataset.obpThumb, 10)); });
    });
    Array.prototype.forEach.call(dots, function (d) {
      d.addEventListener('click', function () { przewin(parseInt(d.dataset.obpDot, 10)); });
    });

    if (swipe) {
      var czekaj;
      swipe.addEventListener('scroll', function () {
        clearTimeout(czekaj);
        czekaj = setTimeout(function () {
          var i = Math.round(swipe.scrollLeft / swipe.clientWidth);
          zaznacz(i);
        }, 80);
      }, { passive: true });
    }

    {%- if section.settings.show_delivery -%}
    // ---------- data dostawy ----------
    // liczona, nie zaszyta: dni roboczych na pakowanie + dni tranzytu
    (function () {
      var eta = root.querySelector('[data-obp-eta]');
      if (!eta) return;
      var PAKOWANIE = {{ section.settings.processing_days }};
      var OD = {{ section.settings.transit_min }};
      var DO = {{ section.settings.transit_max }};
      var LACZNIK = {{ section.settings.delivery_join | json }};

      function dodajRobocze(data, ile) {
        var d = new Date(data);
        while (ile > 0) {
          d.setDate(d.getDate() + 1);
          var dz = d.getDay();
          if (dz !== 0 && dz !== 6) ile--;
        }
        return d;
      }

      var dzis = new Date();
      var a = dodajRobocze(dzis, PAKOWANIE + OD);
      var b = dodajRobocze(dzis, PAKOWANIE + DO);
      var fmt = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short' });

      // same daty pogrubione, tak jak we wzorcu - prefiks siedzi juz w HTML
      var zakres = document.createElement('strong');
      zakres.textContent = fmt.format(a) + ' - ' + fmt.format(b);
      eta.textContent = LACZNIK + ' ';
      eta.appendChild(zakres);
    })();
    {%- endif -%}

    odswiez();
  })();
</script>

