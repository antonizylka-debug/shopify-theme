{% capture platform_logo %}{% if section.settings.review_logo != blank %}{{ section.settings.review_logo | image_url: width: 216 | image_tag: class: 'rvs__logo', alt: section.settings.logo_alt, loading: 'lazy' }}{% else %}<span class="rvs__trustpilot" role="img" aria-label="Trustpilot"><img src="data:image/png;base64," alt="" width="600" height="600" loading="lazy"></span>{% endif %}{% endcapture %}
{%- assign sample_content = true -%}
{%- if section.settings.content_source == 'custom' -%}{%- assign sample_content = false -%}{%- endif -%}
{%- assign has_samples = false -%}
{%- if sample_content == false -%}{%- for review_block in section.blocks -%}{%- if review_block.settings.is_sample -%}{%- assign has_samples = true -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- comment -%}
  Pasek opinii: podsumowanie po lewej, karuzela kart po prawej.
  Opinie wpisuje sie recznie w edytorze (bloki). Opcjonalne logo platformy wybierane w edytorze.
{%- endcomment -%}
{%- capture star_full -%}<svg viewBox="0 0 96 96" fill="currentColor" aria-hidden="true" focusable="false"><path d="M48 64.7 62.6 61 68.7 79.8 48 64.7ZM81.6 40.4H55.9L48 16.2 40.1 40.4H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2 20.7-15Z"/></svg>{%- endcapture -%}

{%- style -%}
  #shopify-section-{{ section.id }} .rvs {
    --rvs-star: #00B67A;
    --rvs-empty: #d9d6d1;
    --rvs-text: {{ section.settings.c_text }};
    --rvs-muted: #6b6f76;
    background: {{ section.settings.c_bg }};
    color: var(--rvs-text);
    padding: {{ section.settings.pad_y }}px 0;
  }
  #shopify-section-{{ section.id }} .rvs__wrap {
    max-width: 1500px; margin: 0 auto; padding: 0 24px;
    display: flex; align-items: flex-start; gap: 28px;
  }
  #shopify-section-{{ section.id }} .rvs__sum { flex: 0 0 190px; text-align: center; padding-top: 4px; }
  #shopify-section-{{ section.id }} .rvs__verdict { font-size: 28px; line-height: 1.1; margin: 0 0 8px; font-weight: 400; }
  #shopify-section-{{ section.id }} .rvs__stars { display: inline-flex; gap: 2px; color: var(--rvs-star); }
  #shopify-section-{{ section.id }} .rvs__stars svg { width: 16px; height: 16px; display: block; }
  #shopify-section-{{ section.id }} .rvs__stars .is-off { color: var(--rvs-empty); }
  #shopify-section-{{ section.id }} .rvs__sum .rvs__stars svg { width: 30px; height: 30px; }
  #shopify-section-{{ section.id }} .rvs__based { font-size: 14px; margin: 8px 0 0; color: var(--rvs-text); }
  #shopify-section-{{ section.id }} .rvs__based a { color: inherit; text-decoration: underline; }
  #shopify-section-{{ section.id }} .rvs__main { position: relative; flex: 1 1 auto; min-width: 0; padding: 0 34px; }
  #shopify-section-{{ section.id }} .rvs__track {
    display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-behavior: smooth;
  }
  #shopify-section-{{ section.id }} .rvs__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .rvs__card {
    flex: 0 0 calc((100% - 24px * {{ section.settings.per_row | minus: 1 }}) / {{ section.settings.per_row }});
    scroll-snap-align: start; min-width: 0; font-size: 14px; line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .rvs__meta { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .rvs__ver { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; color: var(--rvs-muted); text-decoration: underline; }
  #shopify-section-{{ section.id }} .rvs__ver svg { width: 15px; height: 15px; }
  #shopify-section-{{ section.id }} .rvs__who { color: var(--rvs-muted); font-size: 12.5px; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .rvs__who strong { font-weight: 700; }
  #shopify-section-{{ section.id }} .rvs__title { font-size: 15px; font-weight: 700; margin: 0 0 4px; }
  #shopify-section-{{ section.id }} .rvs__body {
    margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .rvs__nav {
    position: absolute; top: 50%; transform: translateY(-50%); width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid var(--rvs-text); background: #fff; color: var(--rvs-text); cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
  }
  #shopify-section-{{ section.id }} .rvs__nav[disabled] { opacity: .25; cursor: default; border-color: #bbb; }
  #shopify-section-{{ section.id }} .rvs__nav--prev { left: 0; }
  #shopify-section-{{ section.id }} .rvs__nav--next { right: 0; }
  #shopify-section-{{ section.id }} .rvs__nav svg { width: 12px; height: 12px; }
  #shopify-section-{{ section.id }} .rvs__note { font-size: 14px; margin: 14px 0 0; padding-left: 0; }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .rvs__wrap { flex-direction: column; align-items: stretch; gap: 18px; }
    #shopify-section-{{ section.id }} .rvs__sum { flex: none; }
    #shopify-section-{{ section.id }} .rvs__card { flex-basis: calc((100% - 24px) / 2); }
  }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .rvs__wrap { padding: 0 16px; }
    #shopify-section-{{ section.id }} .rvs__main { padding: 0; }
    #shopify-section-{{ section.id }} .rvs__nav { display: none; }
    #shopify-section-{{ section.id }} .rvs__card { flex-basis: 82%; }
  }
  #shopify-section-{{ section.id }} .rvs--boxed .rvs__stars { gap: 3px; }
  #shopify-section-{{ section.id }} .rvs--boxed .rvs__stars > span { display: flex; background: var(--rvs-star); color: #fff; padding: 2px; }
  #shopify-section-{{ section.id }} .rvs--boxed .rvs__stars > span.is-off { background: var(--rvs-empty); color: #fff; }
  #shopify-section-{{ section.id }} .rvs--boxed .rvs__stars svg { width: 14px; height: 14px; }
  #shopify-section-{{ section.id }} .rvs--boxed .rvs__sum .rvs__stars svg, #shopify-section-{{ section.id }} .rvs--boxed .rvs__top .rvs__stars svg { width: 24px; height: 24px; }

#shopify-section-{{ section.id }} .rvs, #shopify-section-{{ section.id }} .rvs * { box-sizing:border-box; }
#shopify-section-{{ section.id }} .rvs { font-family:Arial,Helvetica,sans-serif; --rvs-empty:#dcdce6; --rvs-muted:#666; }
#shopify-section-{{ section.id }} .rvs h2, #shopify-section-{{ section.id }} .rvs h3 { font-family:inherit; text-transform:none; letter-spacing:normal; }
#shopify-section-{{ section.id }} .rvs p { letter-spacing:normal; }
#shopify-section-{{ section.id }} .rvs .rvs__stars { gap:2px; vertical-align:middle; line-height:1; flex-shrink:0; }
#shopify-section-{{ section.id }} .rvs--boxed .rvs__stars > span { padding:0; }
#shopify-section-{{ section.id }} .rvs--boxed .rvs__stars svg { width:18px; height:18px; }
#shopify-section-{{ section.id }} .rvs__title { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.3; }
#shopify-section-{{ section.id }} .rvs__logo { display:inline-block; width:108px; height:auto; max-height:32px; object-fit:contain; vertical-align:middle; }
#shopify-section-{{ section.id }} .rvs__logo-wrap { margin-top:8px; }
#shopify-section-{{ section.id }} .rvs__more:focus-visible, #shopify-section-{{ section.id }} .rvs__nav:focus-visible { outline:2px solid #008849; outline-offset:3px; }
@media (prefers-reduced-motion:reduce) { #shopify-section-{{ section.id }} .rvs__track { scroll-behavior:auto; } }

#shopify-section-{{ section.id }} .rvs__wrap { max-width:none; padding:0 12px; gap:28px; align-items:flex-start; }
#shopify-section-{{ section.id }} .rvs__sum { flex:0 0 162px; padding-top:0; }
#shopify-section-{{ section.id }} .rvs__verdict { font-size:24px; margin:0 0 5px; }
#shopify-section-{{ section.id }} .rvs--boxed .rvs__sum .rvs__stars svg { width:30px; height:30px; }
#shopify-section-{{ section.id }} .rvs--boxed .rvs__sum .rvs__stars > span:not(.is-off) { background:#73CF11; }
#shopify-section-{{ section.id }} .rvs__based { font-size:13px; margin:5px 0 0; line-height:1.3; }
#shopify-section-{{ section.id }} .rvs__main { padding:0 40px 0 52px; }
#shopify-section-{{ section.id }} .rvs__track { gap:40px; }
#shopify-section-{{ section.id }} .rvs__card { flex-basis:calc((100% - 40px * {{ section.settings.per_row | minus: 1 }}) / {{ section.settings.per_row }}); font-size:13px; line-height:1.25; }
#shopify-section-{{ section.id }} .rvs__meta { gap:8px; margin-bottom:9px; }
#shopify-section-{{ section.id }} .rvs__who { font-size:12px; margin-bottom:7px; }
#shopify-section-{{ section.id }} .rvs__title { font-size:14px; margin-bottom:4px; }
#shopify-section-{{ section.id }} .rvs__body { -webkit-line-clamp:2; }
#shopify-section-{{ section.id }} .rvs__ver { font-size:12px; }
#shopify-section-{{ section.id }} .rvs__nav { width:24px; height:24px; top:68px; }
#shopify-section-{{ section.id }} .rvs__note { font-size:13px; margin-top:19px; line-height:1.3; }
@media(max-width:989px) { #shopify-section-{{ section.id }} .rvs__wrap { flex-direction:column; align-items:stretch; } #shopify-section-{{ section.id }} .rvs__main { width:100%; max-width:100%; } #shopify-section-{{ section.id }} .rvs__sum { flex:none; } #shopify-section-{{ section.id }} .rvs__wrap { gap:24px; } #shopify-section-{{ section.id }} .rvs__card { flex-basis:calc((100% - 24px)/2); } #shopify-section-{{ section.id }} .rvs__track { gap:24px; } #shopify-section-{{ section.id }} .rvs__main { padding:0 36px; } }
@media(max-width:599px) { #shopify-section-{{ section.id }} .rvs__main { padding:0; } #shopify-section-{{ section.id }} .rvs__card { flex-basis:85%; } #shopify-section-{{ section.id }} .rvs__wrap { padding:0 16px; } }


/* Rating colours match the supplied stars-1.svg through stars-5.svg. */
#shopify-section-{{ section.id }} .rvs .rvs__stars[data-rating="1"] { color:#FF3722; }
#shopify-section-{{ section.id }} .rvs.rvs--boxed .rvs__stars[data-rating="1"] > span:not(.is-off) { background:#FF3722; color:#fff; }
#shopify-section-{{ section.id }} .rvs .rvs__stars[data-rating="2"] { color:#FF8622; }
#shopify-section-{{ section.id }} .rvs.rvs--boxed .rvs__stars[data-rating="2"] > span:not(.is-off) { background:#FF8622; color:#fff; }
#shopify-section-{{ section.id }} .rvs .rvs__stars[data-rating="3"] { color:#FFCE00; }
#shopify-section-{{ section.id }} .rvs.rvs--boxed .rvs__stars[data-rating="3"] > span:not(.is-off) { background:#FFCE00; color:#fff; }
#shopify-section-{{ section.id }} .rvs .rvs__stars[data-rating="4"] { color:#73CF11; }
#shopify-section-{{ section.id }} .rvs.rvs--boxed .rvs__stars[data-rating="4"] > span:not(.is-off) { background:#73CF11; color:#fff; }
#shopify-section-{{ section.id }} .rvs .rvs__stars[data-rating="5"] { color:#00B67A; }
#shopify-section-{{ section.id }} .rvs.rvs--boxed .rvs__stars[data-rating="5"] > span:not(.is-off) { background:#00B67A; color:#fff; }

#shopify-section-{{ section.id }} .rvs__demo {font:12px/1.5 Arial,sans-serif;text-align:center;margin:0 16px 20px;color:#555;}
#shopify-section-{{ section.id }} .rvs__sample-label {font:10px/1.3 Arial,sans-serif;margin:0 0 5px;color:#666;}
#shopify-section-{{ section.id }} .rvs__trustpilot {display:inline-block;position:relative;overflow:hidden;width:108px;height:28px;vertical-align:middle;}
#shopify-section-{{ section.id }} .rvs__trustpilot img {position:absolute;top:-34px;left:-6px;width:120px;height:120px;max-width:none;max-height:none;display:block;}
{%- endstyle -%}

<dp-reviews-strip style="display:block" class="rvs{% if section.settings.star_style == 'boxed' %} rvs--boxed{% endif %}" data-rvs>
{% if has_samples %}<p class="rvs__demo">DEMO — Sample reviews, not real customer testimonials or Trustpilot reviews.</p>{% endif %}
  <div class="rvs__wrap">
    {% if section.settings.show_summary %}<div class="rvs__sum">
      {%- if section.settings.verdict != blank and has_samples == false -%}<p class="rvs__verdict">{{ section.settings.verdict | escape }}</p>{%- endif -%}
      {% if section.settings.rating != blank and has_samples == false %}<span class="rvs__stars" data-rating="{{ section.settings.rating | round | at_least: 1 | at_most: 5 }}" role="img" aria-label="{{ section.settings.rating | escape }} / 5">
        {%- assign sum_full = section.settings.rating | round -%}
        {%- for i in (1..5) -%}<span class="{% if i > sum_full %}is-off{% endif %}">{{ star_full }}</span>{%- endfor -%}
      </span>{% endif %}
      {%- if section.settings.based_text != blank and has_samples == false and section.settings.count_text != blank -%}
        <p class="rvs__based">
          {{ section.settings.based_text | escape }}
          {%- if section.settings.count_text != blank %}
            {% if section.settings.count_url != blank %}<a href="{{ section.settings.count_url }}">{{ section.settings.count_text | escape }}</a>{% else %}<u>{{ section.settings.count_text | escape }}</u>{% endif %}
          {%- endif -%}
        </p>
      {%- endif -%}
<div class="rvs__logo-wrap">{{ platform_logo }}</div>
    </div>

    {% endif %}
    <div class="rvs__main">
      <button type="button" class="rvs__nav rvs__nav--prev" data-rvs-prev aria-label="Previous"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4"/></svg></button>
      <div class="rvs__track" data-rvs-track>
        {% if sample_content %}
<article class="rvs__card" id="imported-{{ section.id }}-11"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Sophie Taylor</strong>, Sep 15, 2026</p><h3 class="rvs__title">So easy to dress up</h3><p class="rvs__body">I bought this dress for a family dinner and ended up loving it much more than I expected. A pair of boots and a little jewellery were all I needed.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-17"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Benjamin Reed</strong>, Aug 26, 2026</p><h3 class="rvs__title">Looks great with jeans</h3><p class="rvs__body">Picked up a shirt for weekends and casual evenings. It looks great with dark jeans and feels comfortable to wear.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-22"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Charlotte Evans</strong>, Aug 6, 2026</p><h3 class="rvs__title">Love how it fits</h3><p class="rvs__body">The blouse has such a flattering shape. I&#x27;ve worn it to work and also out for coffee with friends. Really pleased with it.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-12"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Matthew Collins</strong>, Sep 12, 2026</p><h3 class="rvs__title">Happy with the purchase</h3><p class="rvs__body">Nice casual jacket, especially for layering. The fit is a touch looser than I&#x27;m used to, but the overall look is great.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-1"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Emily Carter</strong>, Oct 15, 2026</p><h3 class="rvs__title">Really happy with my order</h3><p class="rvs__body">I was a little unsure about ordering at first, but I&#x27;m glad I did. The sweater looks lovely and fits just how I wanted. I&#x27;ve already worn it a few times.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-2"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Sarah Mitchell</strong>, Oct 12, 2026</p><h3 class="rvs__title">Such a lovely sweater</h3><p class="rvs__body">Honestly, this is exactly the kind of sweater I was looking for. Comfortable, easy to style and looks great with jeans. Very pleased!</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-3"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Daniel Thompson</strong>, Oct 9, 2026</p><h3 class="rvs__title">Great everyday style</h3><p class="rvs__body">Ordered a casual shirt and I&#x27;m really happy with it. Nothing too flashy, just a nice fit and a clean look. Exactly my style.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-4"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Jessica Wilson</strong>, Oct 6, 2026</p><h3 class="rvs__title">Nice quality, slightly different fit</h3><p class="rvs__body">The cardigan is really pretty and feels nice. It&#x27;s a little more relaxed than I expected, but I actually like how it looks with a basic top underneath.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-5"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Amanda Brooks</strong>, Oct 3, 2026</p><h3 class="rvs__title">Exactly what I wanted</h3><p class="rvs__body">I&#x27;ve been looking for a simple, elegant outfit that I can wear to work or out for dinner. This one is perfect for both. So happy with my purchase.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-6"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Michael Harris</strong>, Sep 30, 2026</p><h3 class="rvs__title">Very comfortable</h3><p class="rvs__body">Really like the fit of the sweater I ordered. It&#x27;s comfortable without looking too casual. I&#x27;ve been wearing it regularly.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-7"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Olivia Bennett</strong>, Sep 27, 2026</p><h3 class="rvs__title">Love the colour</h3><p class="rvs__body">The colour is even nicer than I expected. It goes with so many things I already own. Really happy with how everything looks together.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-8"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Rachel Anderson</strong>, Sep 24, 2026</p><h3 class="rvs__title">Beautiful piece</h3><p class="rvs__body">The blouse is beautiful and looks really flattering. I wish the sleeves were just a little shorter, but overall I&#x27;m very happy with it.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-9"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>James Walker</strong>, Sep 21, 2026</p><h3 class="rvs__title">Simple and stylish</h3><p class="rvs__body">I prefer clothes that don&#x27;t have big logos everywhere. This shirt has a nice, understated look and works well for everyday wear.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-10"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Chloe Martin</strong>, Sep 18, 2026</p><h3 class="rvs__title">My new favourite cardigan</h3><p class="rvs__body">I&#x27;ve worn this cardigan three times already and I only recently got it. It looks great with jeans or trousers. Definitely a favourite.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-13"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Natalie Roberts</strong>, Sep 9, 2026</p><h3 class="rvs__title">Lovely addition to my wardrobe</h3><p class="rvs__body">I don&#x27;t usually write reviews, but I really like this blouse. The style is simple and feminine without being over the top. Very easy to wear.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-14"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Ethan Cooper</strong>, Sep 6, 2026</p><h3 class="rvs__title">Would shop again</h3><p class="rvs__body">Good-looking clothes and I found it easy to pick something that suited me. I&#x27;m pleased with the shirt I chose.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-15"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Victoria Adams</strong>, Sep 3, 2026</p><h3 class="rvs__title">Worth it for the style</h3><p class="rvs__body">I love the overall look of the sweater. It&#x27;s slightly lighter than I imagined, which actually works quite well for layering.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-16"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Lauren Phillips</strong>, Aug 30, 2026</p><h3 class="rvs__title">Just my style</h3><p class="rvs__body">I tend to stick to neutral colours and classic clothes, so this was right up my alley. The trousers look really nice with my favourite tops.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-18"><div class="rvs__meta"><span class="rvs__stars" data-rating="3" role="img" aria-label="3 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Isabella Moore</strong>, Aug 22, 2026</p><h3 class="rvs__title">Nice design but not quite my fit</h3><p class="rvs__body">I really liked the design of the dress, but the waist didn&#x27;t sit quite right on me. It&#x27;s a lovely style, just not the best fit for my shape.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-19"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Grace Campbell</strong>, Aug 18, 2026</p><h3 class="rvs__title">Really pretty and comfortable</h3><p class="rvs__body">The top is so easy to wear and I feel good in it. I like that it looks put together without needing much effort.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-20"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Lucas Turner</strong>, Aug 14, 2026</p><h3 class="rvs__title">Good addition to my wardrobe</h3><p class="rvs__body">The sweater looks good and is comfortable. I would have preferred a slightly more fitted cut, but I still wear it often.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-21"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Hannah Edwards</strong>, Aug 10, 2026</p><h3 class="rvs__title">Perfect for everyday outfits</h3><p class="rvs__body">I wanted something I could throw on without thinking too much about my outfit. This cardigan does exactly that. Love the relaxed style.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-23"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Jacob Foster</strong>, Aug 2, 2026</p><h3 class="rvs__title">Clean and classic</h3><p class="rvs__body">I like keeping my wardrobe pretty simple. The shirt I ordered fits right in and looks good with both jeans and chinos.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-24"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Megan Stewart</strong>, Jul 29, 2026</p><h3 class="rvs__title">Pretty and easy to style</h3><p class="rvs__body">The dress is lovely and I&#x27;m happy with the colour. I think a slightly different length would have suited me better, but it still looks nice.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-25"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Emma Richardson</strong>, Jul 25, 2026</p><h3 class="rvs__title">Feeling confident wearing this</h3><p class="rvs__body">I bought a new outfit because I wanted something fresh for the season. It fits my personal style perfectly and I feel really good wearing it.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-26"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Ryan Peterson</strong>, Jul 21, 2026</p><h3 class="rvs__title">Good casual option</h3><p class="rvs__body">I&#x27;ve been trying to find more casual pieces that still look neat. This sweater is exactly what I had in mind.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-27"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Madison Clark</strong>, Jul 17, 2026</p><h3 class="rvs__title">A really nice find</h3><p class="rvs__body">I wasn&#x27;t planning to buy another top, but the style caught my attention. Glad I went for it because it&#x27;s become one of my favourites.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-28"><div class="rvs__meta"><span class="rvs__stars" data-rating="3" role="img" aria-label="3 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Rebecca Lewis</strong>, Jul 13, 2026</p><h3 class="rvs__title">Beautiful colour, sizing wasn&#x27;t right</h3><p class="rvs__body">The colour and design were exactly what I hoped for. Unfortunately, the size I picked was too loose around the shoulders. I would consider trying another size.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-29"><div class="rvs__meta"><span class="rvs__stars" data-rating="4" role="img" aria-label="4 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span class="is-off">{{ star_full }}</span></span></div><p class="rvs__who"><strong>Aiden Murphy</strong>, Jul 9, 2026</p><h3 class="rvs__title">Nice style overall</h3><p class="rvs__body">I&#x27;m happy with the look of the jacket. The sleeves are slightly longer than I usually prefer, but it&#x27;s still a nice piece for casual outings.</p></article>
<article class="rvs__card" id="imported-{{ section.id }}-30"><div class="rvs__meta"><span class="rvs__stars" data-rating="5" role="img" aria-label="5 / 5"><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span><span>{{ star_full }}</span></span></div><p class="rvs__who"><strong>Nicole Parker</strong>, Jul 5, 2026</p><h3 class="rvs__title">Exactly my kind of fashion</h3><p class="rvs__body">I love finding pieces that are feminine but still practical for everyday life. This one is really versatile and easy to wear.</p></article>
{% else %}
{%- for block in section.blocks -%}
          {%- assign full = block.settings.rating | plus: 0 -%}
          <article class="rvs__card" {{ block.shopify_attributes }}>
            <div class="rvs__meta">
              <span class="rvs__stars" data-rating="{{ full }}" role="img" aria-label="{{ full }} / 5">
                {%- for i in (1..5) -%}<span class="{% if i > full %}is-off{% endif %}">{{ star_full }}</span>{%- endfor -%}
              </span>
              {%- if block.settings.verified -%}
                <span class="rvs__ver"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#6b6f76"/><path d="m4.8 8.2 2.2 2.2 4.2-4.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ section.settings.verified_label | escape }}</span>
              {%- endif -%}
            </div>
            {% if block.settings.is_sample %}<p class="rvs__sample-label">Sample review</p>{% endif %}<p class="rvs__who"><strong>{{ block.settings.name | escape }}</strong>{% if block.settings.date != blank %}, {{ block.settings.date | escape }}{% endif %}</p>
            {%- if block.settings.title != blank -%}<h3 class="rvs__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            <p class="rvs__body">{{ block.settings.body | escape }}</p>
          </article>
        {%- endfor -%}
{% endif %}
      </div>
      <button type="button" class="rvs__nav rvs__nav--next" data-rvs-next aria-label="Next"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 2 4 4-4 4"/></svg></button>
      {%- if section.settings.note != blank -%}<p class="rvs__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</dp-reviews-strip>

<script>
if (!customElements.get('dp-reviews-strip')) customElements.define('dp-reviews-strip', class extends HTMLElement {
 connectedCallback() {
  if (this.controller) return;
  this.controller = new AbortController();
  const signal = this.controller.signal;
  const track=this.querySelector('[data-rvs-track]'), prev=this.querySelector('[data-rvs-prev]'), next=this.querySelector('[data-rvs-next]');
  if (!track || !prev || !next) return;
  const sync=()=>{ prev.disabled=track.scrollLeft<=2; next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2; };
  const move=direction=>{ const card=track.querySelector('.rvs__card'); const gap=parseFloat(getComputedStyle(track).columnGap)||0; track.scrollBy({left:direction*((card?.getBoundingClientRect().width||300)+gap),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}); };
  prev.addEventListener('click',()=>move(-1),{signal}); next.addEventListener('click',()=>move(1),{signal});
  track.addEventListener('scroll',sync,{passive:true,signal});
  this.observer=new ResizeObserver(sync); this.observer.observe(track); sync();
 }
 disconnectedCallback() { this.controller?.abort(); this.controller = null; this.observer?.disconnect(); }
});
</script>

{% schema %}
{
  "name": "Reviews carousel",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "select",
      "id": "content_source",
      "label": "Review content",
      "default": "sample",
      "options": [
        {
          "value": "sample",
          "label": "Imported customer reviews (30)"
        },
        {
          "value": "custom",
          "label": "My customer review blocks"
        }
      ],
      "info": "Displays the 30 supplied customer reviews. Choose blocks to manage reviews manually."
    },
    {
      "type": "header",
      "content": "Summary (left)"
    },
    {
      "type": "text",
      "id": "verdict",
      "label": "Headline",
      "default": "Great"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating (stars)",
      "info": "A number from 1 to 5, e.g. 4.8. Decides how many stars are filled."
    },
    {
      "type": "text",
      "id": "based_text",
      "label": "Text before the count",
      "default": "Based on"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count text"
    },
    {
      "type": "url",
      "id": "count_url",
      "label": "Count link (optional)"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label",
      "default": "Verified"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the cards",
      "default": "Showing our favourite reviews"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Cards visible (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colours and spacing"
    },
    {
      "type": "select",
      "id": "star_style",
      "label": "Star style",
      "default": "boxed",
      "options": [
        {
          "value": "boxed",
          "label": "Boxed"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ]
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Text",
      "default": "#1c1d1d"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Space above and below",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "review_logo",
      "label": "Review platform logo",
      "info": "Choose your platform logo and enter your real rating and review count above."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alternative text",
      "default": "Review platform"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "select",
          "id": "rating",
          "label": "Stars",
          "default": "5",
          "options": [
            {
              "value": "5",
              "label": "5"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "1",
              "label": "1"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show the verified label",
          "info": "Only for reviews from confirmed buyers.",
          "default": false
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "Free text, e.g. 8 October."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text"
        },
        {
          "type": "checkbox",
          "id": "is_sample",
          "label": "Sample review (show demo label)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": []
    }
  ]
}
{% endschema %}
