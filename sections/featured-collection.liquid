{%- assign per_row = section.settings.per_row -%}
{%- assign product_limit = per_row | times: section.settings.rows -%}
{%- assign collection = collections[section.settings.home_featured_products] -%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div
  id="CollectionSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
  data-context="featured-collection">
  {%- liquid
    assign view_all_text = section.settings.view_all_text
    if view_all_text == blank
      assign view_all_text = 'collections.general.all_of_collection' | t
    endif
  -%}

  {%- if section.settings.title != blank or section.settings.eyebrow != blank or section.settings.view_all -%}
    <style>
      {% liquid
        assign shape_padding = ''
        case section.settings.image_shape
          when 'square'
            assign shape_padding = '100%'
          when 'landscape'
            assign shape_padding = '66%'
          when 'portrait'
            assign shape_padding = '120%'
          when 'tall'
            assign shape_padding = '165%'
        endcase
      %}

      {% if section.settings.image_height > 0 %}
        #CollectionSection-{{ section.id }} .grid__image-ratio {
          height: {{ section.settings.image_height }}px !important;
        }
        #CollectionSection-{{ section.id }} .grid__image-ratio:before {
          display: none !important;
        }
      {% elsif shape_padding != blank %}
        #CollectionSection-{{ section.id }} .grid__image-ratio:before {
          padding-top: {{ shape_padding }} !important;
        }
      {% endif %}

      {% if section.settings.image_height_mobile > 0 %}
        @media only screen and (max-width: 768px) {
          #CollectionSection-{{ section.id }} .grid__image-ratio {
            height: {{ section.settings.image_height_mobile }}px !important;
          }
          #CollectionSection-{{ section.id }} .grid__image-ratio:before {
            display: none !important;
          }
        }
      {% endif %}

      {% unless section.settings.image_crop == false %}
        #CollectionSection-{{ section.id }} .grid__image-ratio img {
          object-fit: cover !important;
          height: 100% !important;
          width: 100% !important;
        }
      {% endunless %}
      #CollectionSection-{{ section.id }} .section-header__titles {
        flex: 1 1 auto;
      }

      #CollectionSection-{{ section.id }} .section-header__eyebrow {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.6;
      }

      #CollectionSection-{{ section.id }} .section-header__title {
        font-size: {{ section.settings.heading_size | default: 30 }}px;
        {% if section.settings.heading_bold %}font-weight: 700;{% endif %}
        line-height: 1.1;
        margin-bottom: 0;
      }

      #CollectionSection-{{ section.id }} .section-header__link--plain {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        border: 0;
        background: none;
        padding: 0;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        color: inherit;
      }

      #CollectionSection-{{ section.id }} .section-header__arrow {
        width: 24px;
        height: 12px;
        flex: 0 0 auto;
        transition: transform 0.2s ease;
      }

      #CollectionSection-{{ section.id }} .section-header__link--plain:hover .section-header__arrow {
        transform: translateX(4px);
      }
    </style>

    <div class="page-width">
      <div class="section-header{% if section.settings.view_all %}{% unless settings.type_headers_align_text == 'center' %} section-header--with-link{% endunless %}{% endif %}">
        <div class="section-header__titles">
          {%- if section.settings.eyebrow != blank -%}
            <span class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="section-header__title">
            {{ section.settings.title }}
          </h2>
        </div>
        {%- if section.settings.view_all -%}
          <a
            href="{{ collection.url }}"
            class="{% if section.settings.view_all_plain %}section-header__link--plain section-header__link{% else %}btn btn--secondary btn--small section-header__link{% endif %}"
          >
            {{ view_all_text }}
            {%- if section.settings.view_all_plain -%}
              <svg aria-hidden="true" focusable="false" role="presentation" class="section-header__arrow" viewBox="0 0 24 12"><path d="M0 6h22M17.5 1.5 22 6l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width{% if section.settings.mobile_scrollable %} page-width--flush-small{% endif %}">
    <div{% if section.settings.mobile_scrollable %} class="grid-overflow-wrapper"{% endif %}>
      <div class="grid grid--uniform"{% if section.settings.mobile_scrollable %} data-aos="overflow__animation"{% endif %}>
        {%- liquid
          capture gridView
            render 'products_per_row', products_per_row: per_row, style: 'fractions'
          endcapture

          if section.settings.mobile_scrollable
            assign fallback = '39vw'
          else
            assign fallback = 'variable'
          endif
        -%}

        {%- if section.settings.home_featured_products == blank or collections[section.settings.home_featured_products].empty? or collections[section.settings.home_featured_products].products_count == 0 -%}

          {%- unless emptyState -%}
            {%- assign emptyState = true -%}
          {%- endunless -%}

          <div class="grid__item">
            <div class="grid grid--uniform">
              {%- for i in (1..product_limit) -%}
                <div class="grid__item grid-product {{ gridView }}" data-aos="row-of-{{ per_row }}">
                  <div class="grid-product__content">
                    <a href="{{ product.url | within: collection }}" class="grid-product__link">
                      <div class="grid-product__image-mask">
                        {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                        <div class="image-wrap">{{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}</div>
                      </div>
                      <div class="grid-product__meta">
                        <div class="grid-product__title">{{ 'home_page.onboarding.product_title' | t }}</div>
                        <div class="grid-product__price">$29</div>
                      </div>
                    </a>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

        {%- else -%}

          {%- for product in collections[section.settings.home_featured_products].products limit: product_limit -%}
            {%- render 'product-grid-item',
              product: product,
              collection: collection,
              per_row: per_row,
              quick_shop_enable: settings.quick_shop_enable,
              fallback: fallback,
            -%}
          {%- endfor -%}

          {%- if section.settings.view_all -%}

            {%- if section.settings.rows > 1 and section.settings.view_all_plain == false -%}
              <div class="grid__item text-center{% if section.settings.mobile_scrollable %} small--hide{% endif %}">
                <a href="{{ collections[section.settings.home_featured_products].url }}" class="btn">{{ 'collections.general.all_of_collection' | t }}</a>
              </div>
            {%- endif -%}

          {%- endif -%}

        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-collection.settings.title.label",
      "default": "Featured collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading",
      "info": "For example: MOST WANTED"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 54,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "heading_bold",
      "label": "Bold heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_all_plain",
      "label": "View all as text link with arrow",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all label",
      "info": "Leave empty for the default label."
    },
    { "type": "checkbox", "id": "image_crop", "label": "Crop images to same size", "default": true },
    { "type": "select", "id": "image_shape", "label": "Image shape", "default": "theme", "options": [
      { "value": "theme", "label": "Theme default" },
      { "value": "square", "label": "Square" },
      { "value": "landscape", "label": "Landscape" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "tall", "label": "Tall portrait" }
    ] },
    { "type": "range", "id": "image_height", "label": "Image height (desktop)", "min": 0, "max": 900, "step": 10, "unit": "px", "default": 0, "info": "0 = use Image shape." },
    { "type": "range", "id": "image_height_mobile", "label": "Image height (mobile)", "min": 0, "max": 700, "step": 10, "unit": "px", "default": 0 },
    {
      "type": "collection",
      "id": "home_featured_products",
      "label": "t:sections.featured-collection.settings.home_featured_products.label"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "t:sections.featured-collection.settings.per_row.label",
      "default": 4,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "t:sections.featured-collection.settings.rows.label",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "mobile_scrollable",
      "label": "t:sections.featured-collection.settings.mobile_scrollable.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "t:sections.featured-collection.settings.view_all.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.featured-collection.settings.divider.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.featured_collection.name",
      "category": "t:sections.categories.collections"
    }
  ],
  "blocks": [],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
