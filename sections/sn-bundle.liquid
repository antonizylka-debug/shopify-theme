{%- comment -%}
  Rzad produktow pod opisem: "polacz i zbierz wiekszy rabat".

  Kafel jest DOKLADNIE ten sam co w kolekcji - renderowany tym samym
  snippetem, wiec najezdzanie, mgielka, strzalki, kropki, rozmiary
  i przycisk koszyka wygladaja i dzialaja identycznie. Zadnej kopii
  wygladu, ktora rozjedzie sie przy nastepnej zmianie.

  Rzad przesuwa sie w bok, a pojemnik z przewijaniem przycina wszystko,
  co z niego wystaje - a karta po najechaniu rosnie w dol poza swoj
  kafel. Dlatego skrypt przelacza najechana karte na pozycjonowanie
  wzgledem okna i wpisuje jej wspolrzedne: wtedy wychodzi ponad pasek
  zamiast zostac uciety.
{%- endcomment -%}

{%- liquid
  assign kolekcja = collections[section.settings.collection]

  # Bez wybranej kolekcji bierzemy te, w ktorej stoi ogladany produkt.
  # Inaczej przy karcie meskiej kurtki lecialby rzad damskich sukienek,
  # bo sklep nie ma jednej kolekcji zbiorczej.
  if kolekcja == blank or kolekcja.products.size == 0
    assign kolekcja = product.collections.first
  endif

  assign lista = kolekcja.products
  assign ile = section.settings.count
-%}

{%- if lista.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .snb {
      background: {{ section.settings.color_bg }};
      color: {{ section.settings.color_text }};
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .snb__head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 20px; margin-bottom: 18px;
    }
    #shopify-section-{{ section.id }} .snb__title {
      margin: 0;
      font-size: {{ section.settings.title_size }}px;
      font-weight: 600; letter-spacing: 0.01em;
      text-transform: none; line-height: 1.2;
    }
    #shopify-section-{{ section.id }} .snb__all {
      flex: 0 0 auto;
      font-size: 12px; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: inherit; text-decoration: none;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .snb__all:hover { text-decoration: underline; text-underline-offset: 3px; }

    {%- comment -%}
      Pasek postepu do progu rabatu. Liczba rzeczy w koszyku pochodzi
      z /cart.js, a nie z niczego wpisanego - inaczej pokazywalby stan
      sprzed dodania i klient widzialby nieprawde.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .snb__postep { margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .snb__postep-txt {
      font-size: 15px; line-height: 1.5; margin-bottom: 10px;
    }
    #shopify-section-{{ section.id }} .snb__postep-txt b {
      font-weight: 700; color: {{ section.settings.color_accent }};
    }
    #shopify-section-{{ section.id }} .snb__tor {
      height: 6px; background: {{ section.settings.color_track }};
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .snb__wyp {
      height: 100%; width: 0;
      background: {{ section.settings.color_fill }};
      transition: width 0.5s cubic-bezier(0.25, 0.8, 0.3, 1);
    }
    #shopify-section-{{ section.id }} .snb__znaczniki {
      display: flex; justify-content: space-between;
      margin-top: 7px; font-size: 11px; color: {{ section.settings.color_muted }};
    }
    #shopify-section-{{ section.id }} .snb__znacznik.is-on {
      color: {{ section.settings.color_accent }}; font-weight: 700;
    }

    {%- comment -%}
      Strzalki stoja przy krawedziach zdjec, a nie przy krawedziach
      sekcji - wysokosc zdjecia wynika z szerokosci kafla i proporcji
      3:4, wiec srodek zdjecia to polowa tej wysokosci.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .snb__wrap { position: relative; }
    {%- comment -%}
      Strzalki obok siebie w prawym gornym rogu, przy odnosniku do
      kolekcji - same znaki, bez kolka. Przy krawedziach zdjec zaslanialy
      kafle i wchodzily w droge najezdzaniu.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .snb__nawigacja {
      display: flex; align-items: center; gap: 4px;
      flex: 0 0 auto;
    }
    #shopify-section-{{ section.id }} .snb__strzalka {
      display: flex; align-items: center; justify-content: center;
      width: 26px; height: 26px;
      padding: 0; border: 0; background: none;
      color: inherit;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    #shopify-section-{{ section.id }} .snb__strzalka svg { width: 9px; height: 15px; display: block; }
    #shopify-section-{{ section.id }} .snb__strzalka[disabled] { opacity: 0.25; cursor: default; }

    #shopify-section-{{ section.id }} .snb__track { /*ROW*/
      display: flex;
      flex-wrap: nowrap;
      gap: {{ section.settings.gap }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 4px;
      cursor: grab;
    }
    #shopify-section-{{ section.id }} .snb__track.is-drag {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }
    #shopify-section-{{ section.id }} .snb__track::-webkit-scrollbar { display: none; }

    {%- comment -%}
      Kafel z kolekcji ma wlasne klasy szerokosci pod siatke - w pasku
      musimy je przykryc, bo szerokosc ustala flex, nie siatka.
    {%- endcomment -%}
    {%- comment -%}
      Szerokosc kafla wynika z szerokosci paska podzielonej przez liczbe
      kafli na ekran - dzieki temu nigdy nie zostaje polowka kafla przy
      krawedzi. Przy stalej szerokosci w pikselach ostatni kafel prawie
      zawsze wypadal uciety, bo szerokosc strony nie jest jej wielokrotnoscia.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .snb__track > .grid__item {
      flex: 0 0 calc((100% - {{ section.settings.per_view | minus: 1 | times: section.settings.gap }}px) / {{ section.settings.per_view }});
      max-width: calc((100% - {{ section.settings.per_view | minus: 1 | times: section.settings.gap }}px) / {{ section.settings.per_view }});
      width: auto;
      padding-left: 0;
      scroll-snap-align: start;
    }

    {%- comment -%}
      Najechana karta przechodzi na pozycjonowanie wzgledem okna,
      dzieki czemu wychodzi poza pasek z przewijaniem. Wspolrzedne
      wpisuje skrypt, bo zna polozenie kafla po przewinieciu.
    {%- endcomment -%}
    {%- comment -%}
      Szuflada koszyka w tym motywie ma z-index 30, a jej przyciemnienie
      28. Karta z 40 lezala nad nimi i lapala klikniecia zamiast szuflady.
      25 stawia ja nad trescia strony, ale pod koszykiem.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .grid-product.is-out .grid-product__content {
      position: fixed;
      left: var(--snb-x, 0px);
      top: var(--snb-y, 0px);
      right: auto;
      width: var(--snb-w, auto);
      z-index: 25;
    }
    /* przy otwartej szufladzie karta w ogole nie wychodzi */
    .js-drawer-open #shopify-section-{{ section.id }} .grid-product.is-out .grid-product__content {
      position: absolute;
      left: var(--tile-pad-l, 0px);
      top: 0;
      width: auto;
      z-index: 6;
    }

    @media only screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .snb {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }
      #shopify-section-{{ section.id }} .snb__title { font-size: {{ section.settings.title_size_mobile }}px; }
      #shopify-section-{{ section.id }} .snb__track { margin: 0 -16px; padding: 0 16px 4px; }
      #shopify-section-{{ section.id }} .snb__track > .grid__item {
        flex-basis: calc((100% - {{ section.settings.per_view_mobile | minus: 1 | times: 12 }}px) / {{ section.settings.per_view_mobile }});
        max-width: calc((100% - {{ section.settings.per_view_mobile | minus: 1 | times: 12 }}px) / {{ section.settings.per_view_mobile }});
      }
    }
  {%- endstyle -%}

  <div class="snb">
    <div class="page-width">
      <div class="snb__head">
        <h2 class="snb__title">{{ section.settings.title }}</h2>
        <div class="snb__nawigacja">
          {%- if section.settings.all_label != blank and kolekcja.url != blank -%}
            <a class="snb__all" href="{{ kolekcja.url }}" style="margin-right: 10px;">{{ section.settings.all_label }}</a>
          {%- endif -%}
          <button type="button" class="snb__strzalka snb__strzalka--wstecz" data-snb-wstecz
                  aria-label="{{ section.settings.prev_label }}" disabled>
            <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M8.5 1.5 2 8l6.5 6.5"/></svg>
          </button>
          <button type="button" class="snb__strzalka snb__strzalka--dalej" data-snb-dalej
                  aria-label="{{ section.settings.next_label }}">
            <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M1.5 1.5 8 8l-6.5 6.5"/></svg>
          </button>
        </div>
      </div>

      {%- if section.settings.show_progress and section.settings.tiers != blank -%}
        {%- assign progi = section.settings.tiers | split: ',' -%}
        <div class="snb__postep" data-snb-postep
             data-tiers="{{ section.settings.tiers | escape }}"
             data-have="{{ section.settings.label_have | escape }}"
             data-items="{{ section.settings.label_items | escape }}"
             data-more="{{ section.settings.label_more | escape }}"
             data-max="{{ section.settings.label_max | escape }}"
             data-start="{{ section.settings.label_start | escape }}">
          <div class="snb__postep-txt" data-snb-txt></div>
          <div class="snb__tor"><div class="snb__wyp" data-snb-wyp></div></div>
          <div class="snb__znaczniki">
            {%- for prog in progi -%}
              {%- liquid
                assign para = prog | strip | split: ':'
                assign szt = para[0] | strip
                assign proc = para[1] | strip
              -%}
              {%- if szt != blank and proc != blank -%}
                <span class="snb__znacznik" data-snb-prog="{{ szt }}">{{ szt }} {{ section.settings.label_items }} · {{ proc }}%</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="snb__wrap">
      <div class="snb__track grid grid--uniform" data-snb-track>
        {%- for produkt in lista limit: ile -%}
          {%- render 'product-grid-item',
            product: produkt,
            per_row: 4,
            quick_shop_enable: settings.quick_shop_enable,
            fallback: '39vw'
          -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var sekcja = document.getElementById('shopify-section-{{ section.id }}');
      if (!sekcja) return;

      /* ---------- pasek postepu ---------- */
      var postep = sekcja.querySelector('[data-snb-postep]');
      if (postep) {
        var progi = (postep.getAttribute('data-tiers') || '').split(',')
          .map(function (t) {
            var cz = t.split(':');
            return { szt: parseInt(cz[0], 10), proc: parseInt(cz[1], 10) };
          })
          .filter(function (x) { return x.szt > 0 && x.proc > 0; })
          .sort(function (a, b) { return a.szt - b.szt; });

        var txt = postep.querySelector('[data-snb-txt]');
        var wyp = postep.querySelector('[data-snb-wyp]');
        var slowoSzt = postep.getAttribute('data-items') || '';

        function opisz(ile) {
          var osiagniety = null, nastepny = null;
          for (var i = 0; i < progi.length; i++) {
            if (ile >= progi[i].szt) osiagniety = progi[i];
            else if (!nastepny) nastepny = progi[i];
          }

          var maks = progi.length ? progi[progi.length - 1].szt : 1;
          wyp.style.width = Math.min(100, Math.round((ile / maks) * 100)) + '%';

          var znaczniki = postep.querySelectorAll('[data-snb-prog]');
          for (var j = 0; j < znaczniki.length; j++) {
            var szt = parseInt(znaczniki[j].getAttribute('data-snb-prog'), 10);
            znaczniki[j].classList.toggle('is-on', ile >= szt);
          }

          if (!osiagniety && nastepny) {
            txt.innerHTML = postep.getAttribute('data-start')
              .replace('#', '<b>' + nastepny.szt + ' ' + slowoSzt + '</b>')
              .replace('%', '<b>' + nastepny.proc + '%</b>');
            return;
          }
          if (osiagniety && !nastepny) {
            txt.innerHTML = postep.getAttribute('data-max')
              .replace('%', '<b>' + osiagniety.proc + '%</b>');
            return;
          }
          var brakuje = nastepny.szt - ile;
          txt.innerHTML =
            postep.getAttribute('data-have')
              .replace('#', '<b>' + ile + ' ' + slowoSzt + '</b>')
              .replace('%', '<b>' + osiagniety.proc + '%</b>') +
            ' ' +
            postep.getAttribute('data-more')
              .replace('#', '<b>' + brakuje + ' ' + slowoSzt + '</b>')
              .replace('%', '<b>' + nastepny.proc + '%</b>');
        }

        function policz() {
          fetch('/cart.js', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (k) { opisz(k.item_count || 0); })
            .catch(function () { opisz(0); });
        }

        /* Motyw ma kilka drog dodania do koszyka i nie kazda konczy sie
           zdarzeniem, ktore tu dolatuje - formularz na karcie produktu
           rozglasza je na sobie, a szuflada koszyka na dokumencie.
           Zamiast zgadywac ktora droga poszlo, przeliczamy po kazdym
           klikniecu w cokolwiek, co dodaje do koszyka, kilka razy
           z rzedu - bo odpowiedz sklepu potrafi przyjsc z opoznieniem. */
        var kolejka = [];
        function przelicz() {
          for (var i = 0; i < kolejka.length; i++) clearTimeout(kolejka[i]);
          kolejka = [400, 1200, 2500].map(function (ms) { return setTimeout(policz, ms); });
        }

        policz();
        document.addEventListener('ajaxProduct:added', policz);
        document.addEventListener('cart:build', policz);
        document.addEventListener('cart:open', przelicz);

        document.addEventListener('click', function (e) {
          if (!e.target.closest) return;
          if (e.target.closest('[data-snb-add], .snb__chip, [data-tile-add], .tile-hover__chip, button[name="add"], [type="submit"], .btn--add-to-cart, .add-to-cart')) {
            przelicz();
          }
        }, true);

        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) policz();
        });
        window.addEventListener('pageshow', policz);
      }

      var pasek = sekcja.querySelector('[data-snb-track]');
      if (!pasek) return;

      /* ---------- przewijanie: strzalki i przeciaganie myszka ----------
         Poza bramka najezdzania, bo przewijanie ma dzialac wszedzie,
         nie tylko tam, gdzie jest kursor. Wczesniej siedzialo pod nia
         i na czesci urzadzen strzalki w ogole sie nie podpinaly. */
      (function () {
        var wstecz = sekcja.querySelector('[data-snb-wstecz]');
        var dalej = sekcja.querySelector('[data-snb-dalej]');

        /* Przewijamy o pelna szerokosc paska, czyli o caly komplet
           widocznych kafli - wtedy po klikniecu znow widac same cale
           kafle, a nie polowki. */
        function krok() {
          var st = getComputedStyle(pasek);
          return pasek.clientWidth + (parseFloat(st.columnGap || st.gap) || 0);
        }

        /* Strzalki w naglowku gasna, gdy nie ma dokad przewijac. */
        function stan() {
          if (!wstecz || !dalej) return;
          var maks = pasek.scrollWidth - pasek.clientWidth;
          wstecz.disabled = pasek.scrollLeft < 4;
          dalej.disabled = pasek.scrollLeft > maks - 4;
        }

        if (wstecz) wstecz.addEventListener('click', function () {
          pasek.scrollBy({ left: -krok(), behavior: 'smooth' });
        });
        if (dalej) dalej.addEventListener('click', function () {
          pasek.scrollBy({ left: krok(), behavior: 'smooth' });
        });

        /* ---------- przeciaganie myszka ----------
           Dotyk ma wlasne przewijanie przegladarki, wiec go nie ruszamy.
           Przyciaganie do kafla wylaczamy na czas ciagniecia, bo inaczej
           pasek szarpie sie przy kazdym ruchu. */
        var ciagnie = false, startX = 0, startScroll = 0, droga = 0;
        var ostX = 0, ostT = 0, predkosc = 0;

        pasek.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'touch' || e.button !== 0) return;
          ciagnie = true;
          droga = 0;
          startX = e.clientX;
          startScroll = pasek.scrollLeft;
          ostX = e.clientX; ostT = performance.now(); predkosc = 0;
          pasek.classList.add('is-drag');
          pasek.style.scrollSnapType = 'none';
        });

        pasek.addEventListener('pointermove', function (e) {
          if (!ciagnie) return;
          var d = e.clientX - startX;
          if (Math.abs(d) > droga) droga = Math.abs(d);
          if (droga > 4) {
            e.preventDefault();
            pasek.setPointerCapture(e.pointerId);
          }
          var teraz = performance.now(), dt = teraz - ostT;
          if (dt > 0) {
            /* Ruch kursora w lewo to przewijanie w prawo, stad minus. */
            predkosc = predkosc * 0.4 + (-(e.clientX - ostX) / dt) * 0.6;
            ostX = e.clientX; ostT = teraz;
          }
          pasek.scrollLeft = startScroll - d;
        });

        /* Przyciaganie wraca dopiero, gdy pasek sam dojedzie na miejsce.
           Przywrocone w chwili puszczenia teleportuje kafle do najblizszego
           punktu - i to wlasnie wyglada tak, jakby zamiast przesuniecia
           podmienily sie zdjecia.

           Krzywa i czas jak w Swiperze, ktorego uzywa wzor: 300 ms i
           cubic-bezier(.25,.1,.25,1). scrollTo z behavior smooth tego nie
           odda, bo jedno i drugie nalezy tam do przegladarki. */
        function krzywa(x1, y1, x2, y2) {
          function A(a, b) { return 1 - 3 * b + 3 * a; }
          function B(a, b) { return 3 * b - 6 * a; }
          function C(a) { return 3 * a; }
          function wart(t, a, b) { return ((A(a, b) * t + B(a, b)) * t + C(a)) * t; }
          function nachyl(t, a, b) { return 3 * A(a, b) * t * t + 2 * B(a, b) * t + C(a); }
          return function (x) {
            var t = x;
            for (var i = 0; i < 5; i++) {
              var d = nachyl(t, x1, x2);
              if (d === 0) break;
              t -= (wart(t, x1, x2) - x) / d;
            }
            return wart(t, y1, y2);
          };
        }
        var EASE = krzywa(0.25, 0.1, 0.25, 1);
        var klatka = null;

        function celGestu() {
          var dzieci = pasek.children;
          if (dzieci.length < 2) return pasek.scrollLeft;
          var baza = pasek.getBoundingClientRect().left, poz = [];
          for (var i = 0; i < dzieci.length; i++) {
            poz.push(dzieci[i].getBoundingClientRect().left - baza + pasek.scrollLeft);
          }
          var krok = poz[1] - poz[0];
          var teraz = pasek.scrollLeft / krok;
          var j;
          if (Math.abs(predkosc) > 0.35) {
            j = predkosc > 0 ? Math.ceil(teraz) : Math.floor(teraz);
          } else {
            j = Math.round(teraz);
          }
          j = Math.max(0, Math.min(j, poz.length - 1));
          var maks = pasek.scrollWidth - pasek.clientWidth;
          return Math.max(0, Math.min(poz[j], maks));
        }

        function dosun() {
          var cel = celGestu();
          var start = pasek.scrollLeft, roznica = cel - start;
          if (Math.abs(roznica) < 1) { pasek.style.scrollSnapType = ''; stan(); return; }
          var t0 = performance.now();
          if (klatka) cancelAnimationFrame(klatka);
          klatka = requestAnimationFrame(function krok(teraz) {
            var p = (teraz - t0) / 300;
            if (p >= 1) {
              pasek.scrollLeft = cel;
              klatka = null;
              pasek.style.scrollSnapType = '';
              stan();
              return;
            }
            pasek.scrollLeft = start + roznica * EASE(p);
            klatka = requestAnimationFrame(krok);
          });
        }

        function koniec() {
          if (!ciagnie) return;
          ciagnie = false;
          pasek.classList.remove('is-drag');
          if (performance.now() - ostT > 90) predkosc = 0;
          stan();
          dosun();
        }
        pasek.addEventListener('pointerup', koniec);
        pasek.addEventListener('pointercancel', koniec);
        pasek.addEventListener('pointerleave', koniec);

        /* Po przeciagnieciu nie otwieramy produktu, w ktory akurat
           trafil kursor - inaczej kazde przesuniecie konczyloby sie
           wejsciem na karte produktu. */
        pasek.addEventListener('click', function (e) {
          if (droga > 6) { e.preventDefault(); e.stopPropagation(); droga = 0; }
        }, true);

        pasek.addEventListener('scroll', stan, { passive: true });
        window.addEventListener('resize', function () { stan(); wysokosc(); });
        window.addEventListener('load', wysokosc);

        function wysokosc() {
          var kafel = pasek.querySelector('.grid__item');
          if (!kafel) return;
          sekcja.style.setProperty('--snb-mid', Math.round(kafel.getBoundingClientRect().width * 2 / 3) + 'px');
        }

        stan();
        wysokosc();
      })();

      /* Tylko tam, gdzie jest prawdziwy kursor. Na dotyku ":hover"
         zostaje wlaczony po tapnieciu i karta wisialaby nad trescia. */
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

      var aktywny = null;
      var czeka = false;

      function ustaw() {
        czeka = false;
        if (!aktywny) return;
        var r = aktywny.getBoundingClientRect();
        var st = getComputedStyle(aktywny);
        var lewo = r.left + parseFloat(st.paddingLeft || 0);
        var prawo = r.right - parseFloat(st.paddingRight || 0);
        aktywny.style.setProperty('--snb-x', lewo + 'px');
        aktywny.style.setProperty('--snb-y', r.top + 'px');
        aktywny.style.setProperty('--snb-w', (prawo - lewo) + 'px');
      }

      function odswiez() {
        if (czeka) return;
        czeka = true;
        requestAnimationFrame(ustaw);
      }

      function otworz(kafel) {
        if (aktywny === kafel) return;
        zamknij();
        aktywny = kafel;
        ustaw();
        kafel.classList.add('is-out');
      }

      function zamknij() {
        if (!aktywny) return;
        aktywny.classList.remove('is-out');
        aktywny.style.removeProperty('--snb-x');
        aktywny.style.removeProperty('--snb-y');
        aktywny.style.removeProperty('--snb-w');
        aktywny = null;
      }



      pasek.addEventListener('mouseover', function (e) {
        var kafel = e.target.closest('.grid-product');
        if (kafel && pasek.contains(kafel)) otworz(kafel);
      });

      pasek.addEventListener('mouseleave', zamknij);

      /* Przy otwarciu szuflady koszyka karta wraca na miejsce - inaczej
         wisialaby nad przyciemnieniem i lapala klikniecia. */
      document.addEventListener('cart:open', zamknij);
      document.addEventListener('ajaxProduct:added', zamknij);
      pasek.addEventListener('scroll', odswiez, { passive: true });
      window.addEventListener('scroll', odswiez, { passive: true });
      window.addEventListener('resize', zamknij);
    })();
  </script>
{%- endif -%}

