<div class="page-width page-width--narrow page-content">
  {%- render 'breadcrumbs' -%}
  <header class="section-header">
    <h1 class="section-header__title">{%- render 'sn-tytul-strony', fallback: page.title -%}</h1>
  </header>

  <div class="rte rte--nomargin">
    {%- comment -%}
      Polityki maja tresc w motywie (snippets/sn-polityka-*), zeby byla spojna
      i nie zalezala od tego, co wpisano w panelu. Pozostale strony bez zmian.
    {%- endcomment -%}
    {%- case page.handle -%}
      {%- when 'vilkar-og-betingelser' -%}
        {%- render 'sn-polityka-handel' -%}
      {%- when 'retur-og-refusionspolitik' -%}
        {%- render 'sn-polityka-retur' -%}
      {%- when 'forsendelsespolitik' -%}
        {%- render 'sn-polityka-fragt' -%}
      {%- when 'payment-policy' -%}
        {%- render 'sn-polityka-betaling' -%}
      {%- when 'betalingspolitik' -%}
        {%- render 'sn-polityka-privat' -%}
      {%- when 'track-order' -%}
        {%- render 'sn-spor-ordre' -%}
      {%- else -%}
        {{ page.content }}
    {%- endcase -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section"
}
{% endschema %}
