{% doc %}
  @prompt
    wygeneruj mi navigation menu gdzie bede moglwybrtac menu ktore bedzie sie pokazywac od lwewj do prawej i ustawiac szerokosc kolor tla czcionka wielkosc itd 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-navigation-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-navigation-menu__list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-navigation-menu__item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-navigation-menu__link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    transition: color 0.3s ease;
    {% if block.settings.text_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-navigation-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-navigation-menu-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-navigation-menu__list-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.item_spacing | divided_by: 2 }}px;
    }

    .ai-navigation-menu__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<nav
  class="ai-navigation-menu-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  aria-label="Menu nawigacyjne"
>
  {% if block.settings.menu != blank %}
    <ul class="ai-navigation-menu__list-{{ ai_gen_id }}">
      {% for link in block.settings.menu.links %}
        <li class="ai-navigation-menu__item-{{ ai_gen_id }}">
          <a
            href="{{ link.url }}"
            class="ai-navigation-menu__link-{{ ai_gen_id }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div style="text-align: center; padding: 20px; color: #999;">
      Wybierz menu w ustawieniach bloku
    </div>
  {% endif %}
</nav>

{% schema %}
{
  "name": "Menu nawigacyjne",
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Wyrównanie",
      "options": [
        {
          "value": "flex-start",
          "label": "Do lewej"
        },
        {
          "value": "center",
          "label": "Do środka"
        },
        {
          "value": "flex-end",
          "label": "Do prawej"
        },
        {
          "value": "space-between",
          "label": "Rozłożone równomiernie"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Szerokość na desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Kolory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tło",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Kolor tekstu",
      "default": "#321004"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Kolor tekstu po najechaniu",
      "default": "#d1a972"
    },
    {
      "type": "header",
      "content": "Typografia"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Czcionka",
      "default": "outfit_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Rozmiar czcionki",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "text_uppercase",
      "label": "Wielkie litery",
      "default": false
    },
    {
      "type": "header",
      "content": "Odstępy"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Odstęp między elementami",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding pionowy",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding poziomy",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Menu nawigacyjne"
    }
  ]
}
{% endschema %}