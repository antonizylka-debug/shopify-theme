{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><path d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39m24.39 0v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44"/></svg>
{%- endcapture -%}

{%- liquid
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign size_names = 'size,størrelse,storrelse,rozmiar,größe,grosse,taille,talla,dimensioni,koko,' | append: size_trigger
  assign downcased_option = option.name | downcase

  assign is_size = false
  if size_names contains downcased_option
    assign is_size = true
  endif

  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="variant-wrapper js" data-type="button">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    {{ option.name }}
    {%- if connect_to_sizechart and is_size -%}
      <span class="variant__label-info">
        &mdash;
        {%- render
          'tool-tip-trigger',
          title: size_chart_title,
          content: section.blocks[sizechart_index].settings.size_chart.content,
          context: 'size-chart'
        -%}
      </span>
    {%- endif -%}
    {%- if is_color -%}
      <span class="variant__label-info">
        &mdash;
        <span
          data-variant-color-label
          data-index="{{ forloop.index0 }}"
          data-option-index="{{ color_option_index }}">
          {{ option.selected_value }}
        </span>
      </span>
    {%- endif -%}
  </label>
  {%- assign option_index = forloop.index -%}
  <fieldset class="variant-input-wrap"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <legend class="hide">{{ option.name }}</legend>
    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1 and block.settings.product_dynamic_variants_enable
          assign product_available = product.variants[forloop.index0].available
        endif
      -%}
      <div
        class="variant-input"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">
        <input type="radio"
          form="{{ form_id }}"
          {% if option.selected_value == value %} checked="checked"{% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">
        {%- if is_color -%}
          {%- liquid
            assign swatch_variant = null
            assign swatch_variant_fallback = null
            for v in product.variants
              case option_index
                when 1
                  assign v_color_val = v.option1
                when 2
                  assign v_color_val = v.option2
                else
                  assign v_color_val = v.option3
              endcase

              if v_color_val == value
                assign match_others = true
                if option_index != 1 and v.option1 != current_variant.option1
                  assign match_others = false
                endif
                if option_index != 2 and v.option2 != current_variant.option2
                  assign match_others = false
                endif
                if option_index != 3 and v.option3 != current_variant.option3
                  assign match_others = false
                endif

                if match_others
                  assign swatch_variant = v
                  break
                endif

                if swatch_variant_fallback == null
                  assign swatch_variant_fallback = v
                endif
              endif
            endfor

            if swatch_variant == null
              assign swatch_variant = swatch_variant_fallback
            endif

            assign swatch_image = swatch_variant.image | default: product.featured_image
          -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label color-swatch color-swatch--photo color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
          >
            {%- if swatch_image -%}
              <img
                class="color-swatch__image"
                src="{{ swatch_image | image_url: width: 160 }}"
                srcset="{{ swatch_image | image_url: width: 80 }} 80w, {{ swatch_image | image_url: width: 160 }} 160w"
                sizes="72px"
                alt="{{ value | escape }}"
                loading="lazy" decoding="async" width="80" height="80">
            {%- endif -%}
            <span class="color-swatch__label">{{ value | escape }}</span>
          </label>
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}">
            {%- if is_size -%}
              {%- capture size_text -%}{%- render 'size-label', label: value, product: product -%}{%- endcapture -%}
              {{- size_text | escape -}}
            {%- else -%}
              {{- value | escape -}}
            {%- endif -%}
          </label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
