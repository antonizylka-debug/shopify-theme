  /* =========================================================
     Strona kolekcji na telefonie jak u Oliver & Blake:
     pigulki kategorii, pod nimi FILTER i SORT po polowie,
     wieksze breadcrumbs, tytul i karty produktu
     ========================================================= */
  .collection-toolbar__filter {
    display: none;
  }

  .collection-links-row__sort {
    position: relative;
  }

  .sort-box__label {
    display: none;
  }

  @media only screen and (max-width: 768px) {
    .breadcrumb {
      margin-bottom: 12px;
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0.06em;
    }

    .breadcrumb a {
      opacity: 0.6;
    }

    .template-collection .section-header__title {
      font-size: 30px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .collection-count {
      margin-top: 4px;
      font-size: 12px;
    }

    .template-collection .collection-links-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 0;
      margin-bottom: 18px;
    }

    .template-collection .collection-links-row .collection-links {
      flex: 1 1 100%;
      gap: 10px;
      margin: 0;
    }

    .collection-links__item {
      padding: 12px 18px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .collection-toolbar__filter,
    .template-collection .collection-links-row__sort {
      flex: 1 1 calc(50% - 5px);
      min-width: 0;
      height: 46px;
    }

    .collection-toolbar__filter {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 12px;
      border: 1px solid rgba(0, 0, 0, 0.18);
      background: transparent;
      color: inherit;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .template-collection .collection-links-row__sort {
      display: flex;
    }

    .sort-box__label {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      padding: 0 12px;
      border: 1px solid rgba(0, 0, 0, 0.18);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      pointer-events: none;
    }

    .sort-box__value {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sort-box__chevron {
      flex: 0 0 auto;
      margin-left: 8px;
    }

    /* prawdziwy select lezy przezroczysty na ramce - natywna lista opcji */
    .collection-links-row__sort #SortBy {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    /* stary pasek z przyciskiem filtra nad siatka - zastapiony przez rzad wyzej */
    .template-collection .collection-filter {
      display: none;
    }

    /* karta produktu */
    .grid-product__title {
      font-size: 15px;
      line-height: 1.35;
      letter-spacing: 0.03em;
    }

    .grid-product__price {
      font-size: 16px;
      font-weight: 700;
    }

    .grid-product__price--original {
      font-weight: 400;
    }
  }

  /* =========================================================
     Karta produktu jak u Oliver & Blake: kropki kolorow (max 6
     + licznik), cena promocyjna przed przekreslona
     ========================================================= */
  .grid-product__colors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }

  .grid-product__colors .color-swatch {
    width: 14px;
    height: 14px;
    margin: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
    background-size: cover;
  }

  .grid-product__colors .color-swatch:nth-of-type(n + 7) {
    display: none;
  }

  .grid-product__colors-more {
    font-size: 12px;
    line-height: 14px;
    opacity: 0.7;
  }

  .grid-product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  .grid-product__price--original {
    order: 2;
    margin-right: 0;
    text-decoration: line-through;
  }

  .grid-product__price--savings {
    display: none;
  }

  /* =========================================================
     Sortowanie jak u Oliver & Blake: ramka "SORT: X" i panel
     z lista opcji, ptaszek przy wybranej (nadpisuje starsze
     reguly select-nakladki)
     ========================================================= */
  .collection-links-row__sort #SortBy {
    position: absolute;
    inset: auto;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .sort-box__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 46px;
    padding: 0 20px;
    border: 1px solid rgba(0, 0, 0, 0.16);
    background: #ffffff;
    color: inherit;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    pointer-events: auto;
    cursor: pointer;
  }

  .sort-box__value {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sort-box__chevron {
    flex: 0 0 auto;
    margin-left: 8px;
    transition: transform 0.15s ease;
  }

  .sort-box__label[aria-expanded="true"] .sort-box__chevron {
    transform: rotate(180deg);
  }

  .sort-menu {
    position: absolute;
    top: calc(100% - 1px);
    right: 0;
    z-index: 30;
    width: 100%;
    min-width: 220px;
    max-height: 320px;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.16);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .sort-menu[hidden] {
    display: none;
  }

  .sort-menu li {
    margin: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .sort-menu li:last-child {
    border-bottom: 0;
  }

  .sort-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
  }

  .sort-menu__item:hover {
    background: #f7f6f3;
  }

  .sort-menu__item.is-current {
    background: #f4f2ef;
  }

  .sort-menu__check {
    flex: 0 0 auto;
    visibility: hidden;
  }

  .sort-menu__item.is-current .sort-menu__check {
    visibility: visible;
  }

  /* =========================================================
     Dlugie nazwy produktow: max 2 linie i "..." jak u O&B
     ========================================================= */
  .grid-product .grid-product__title {
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    max-height: 2.8em;
  }

  /* lista kategorii dzialu: 8 pozycji, reszta po "Vis alle N i Dame" */
  #CollectionSidebar .tag-list--limited-8 > .tag:nth-child(n + 9) {
    display: none;
  }

  #CollectionSidebar .tag-list--limited-8.is-expanded > .tag:nth-child(n + 9) {
    display: list-item;
  }

  /* pigulki kategorii: bez podkreslen i ciemny tekst niezaleznie od stylow
     linkow z innych miejsc; aktywna czarna z bialym tekstem */
  .collection-links a.collection-links__item {
    color: #16150f !important;
    text-decoration: none !important;
    background: #ffffff;
  }

  .collection-links a.collection-links__item--current {
    background: #16150f !important;
    border-color: #16150f !important;
    color: #ffffff !important;
  }

  /* ==========================================================================
     Kafel w kolekcji 1:1 jak About You

     W spoczynku:   zdjecie / marka / nazwa / cena / pierwotnie / cena 30 dni
     Po najechaniu miedzy cene a "pierwotnie" wchodzi:  kolory / rozmiary / przycisk

     Kolejnosc w kodzie motywu jest inna (tytul, kolory, marka, a wszystkie
     ceny razem w jednym pudelku), wiec kontenery posrednie dostaja
     display: contents. Ich pudelka znikaja, dzieci staja sie bezposrednimi
     elementami jednej kolumny flex i dopiero tam ustawiamy kolejnosc.

     Karta po najechaniu przechodzi w position: absolute, zeby rosla w dol
     i zaslaniala rzad nizej zamiast rozpychac siatke. Kafel trzyma wtedy
     swoja wysokosc z min-height, ktore wpisuje skrypt.

     Wszystko tylko przy prawdziwym kursorze. Na dotyku ":hover" zostaje
     wlaczony po tapnieciu i karta zaslanialaby sasiedni kafel.
     ========================================================================== */
  .tile-hover { display: none; }
  .tile-nav { display: none; }

  /* Motyw sam podmienia zdjecie na drugie po najechaniu. U nich
     zdjecie stoi nieruchomo i zmienia je dopiero strzalka. */
  .grid-product .grid-product__secondary-image { display: none !important; }

  {%- comment -%}
    Telefon: tekst wysrodkowany jak na wzorcu, a zamiast najezdzania -
    okragly przycisk koszyka przy dolnej krawedzi zdjecia. Produkt
    z rozmiarami rozwija pod kaflem kafelki rozmiarow, bo bez wyboru
    rozmiaru nie ma czego dodac.
  {%- endcomment -%}
  @media screen and (max-width: 768px) {
    .grid-product .grid-product__content { text-align: center; }
    .grid-product .grid-product__image-mask { position: relative; }

    {%- comment -%}
      Na telefonie kafel jest tylko do ogladania: bez panelu z rozmiarami
      i bez kolek z kolorami. Rozmiar wybiera sie na karcie produktu -
      przy butach to pietnascie polowek i w kaflu to sie nie miesci.
    {%- endcomment -%}
    .grid-product .grid-product__colors { display: none; }
  }



  /* Plakietka na zdjeciu - zmierzona u nich: przylega do lewej krawedzi,
     zaokraglona tylko z prawej, wiekszy oddech od strony przyleglej. */
  .grid-product .grid-product__tag {
    position: absolute;
    left: 0;
    bottom: 14px;
    top: auto;
    right: auto;
    {%- comment -%}
      Warstwy w kaflu, od dolu: zdjecie, plakietka (1), mgielka (2),
      tekst i strzalki (3). Przy zerze plakietka wpadala pod opakowanie
      zdjecia, bo to takze element pozycjonowany i stoi dalej w kodzie -
      przy rownym z-index wygrywa ten pozniejszy.
    {%- endcomment -%}
    z-index: 1;
    padding: 3px 9px 3px 14px;
    border-radius: 0 4px 4px 0;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 1.35;
    background: #d9232a;
    color: #ffffff;
  }
  .grid-product .grid-product__tag--sold-out { background: #6e6b65; }
  .grid-product .grid-product__tag--custom { background: #16150f; }

  @media (hover: hover) and (pointer: fine) and (min-width: 769px) {
    .grid-product { position: relative; }
    .grid-product:hover { z-index: 6; }

    .grid-product .grid-product__content {
      display: flex;
      flex-direction: column;
      background: #fff;
      text-align: center;
    }
    .grid-product .grid__item-image-wrapper,
    .grid-product .grid-product__link,
    .grid-product .grid-product__meta,
    .grid-product .grid-product__price { display: contents; }

    .grid-product .grid-product__image-mask {
      order: 1;
      margin-bottom: 11px;
      {%- comment -%}
        Ta sama krzywa i czas dla wszystkiego, co sie rozsuwa - zdjecia
        odjezdzajacego w gore i paneli rosnacych w dol. Inaczej rozjezdza
        sie to na oczach. Krzywa wyhamowuje na koncu, wiec ruch nie urywa
        sie w pol drogi.
      {%- endcomment -%}
      transition: margin-bottom 0.65s cubic-bezier(0.25, 0.8, 0.3, 1);
    }
    {%- comment -%}
      Po najechaniu caly opis podjezdza o 22 px w gore, na dol zdjecia -
      dlatego marka, nazwa i cena ida do gory, a ceny historyczne w dol.
      Karta rosnie wiec w obie strony, a nie tylko w dol. Samo zdjecie
      stoi w miejscu: przesuwa sie to, co pod nim.
    {%- endcomment -%}
    .grid-product.is-measured:hover .grid-product__image-mask { margin-bottom: -33px; }
    .grid-product .grid-product__vendor { order: 2; }
    .grid-product .grid-product__title { order: 3; }
    .grid-product .grid-product__price-now { order: 4; }
    .grid-product .grid-product__colors { order: 5; }
    .grid-product .tile-hover { order: 6; }
    .grid-product .grid-product__price--original { order: 7; }
    .grid-product .grid-product__lowest { order: 8; }
    .grid-product .grid-product__price--savings,
    .grid-product .product__unit-price { order: 9; }

    .grid-product .grid-product__vendor {
      font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
      text-transform: uppercase; margin-bottom: 3px;
    }
    .grid-product .grid-product__title {
      font-size: 13px; line-height: 1.35;
      color: var(--colorTextBody, #6e6b65);
      margin-bottom: 6px;
    }
    .grid-product .grid-product__price-now { font-size: 15px; font-weight: 600; }
    /* Motyw daje tej linii opacity 0.45 - na polprzezroczystej karcie
       robi sie z niej szary cien. Pelne krycie i ciemniejsza szarosc. */
    .grid-product .grid-product__price--original,
    .grid-product .grid-product__lowest {
      display: block;
      font-size: 11.5px; line-height: 1.5;
      color: #56524c;
      opacity: 1;
      margin-top: 3px;
    }

    {%- comment -%}
      Kolory, rozmiary i przycisk wchodza pomiedzy cene a ceny
      historyczne. display nie da sie animowac, wiec zamiast chowac
      je zupelnie, zwijamy je do zerowej wysokosci - wtedy reszta
      rozsuwa sie plynnie zamiast przeskakiwac.
    {%- endcomment -%}
    .grid-product .grid-product__colors,
    .grid-product .tile-hover {
      display: block;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      margin: 0;
      transition:
        max-height 0.65s cubic-bezier(0.25, 0.8, 0.3, 1),
        margin 0.65s cubic-bezier(0.25, 0.8, 0.3, 1),
        opacity 0.34s ease 0.14s;
    }
    .grid-product .grid-product__colors { display: flex; justify-content: center; gap: 5px; }
    {%- comment -%}
      Docelowa wysokosc bierze sie z pomiaru, a nie z zapasu "na oko".
      Przy sztywnym max-height 220 px, gdy tresc ma 90, rozsuwanie
      konczylo sie po pierwszej trzeciej czasu, a przez reszte animowala
      sie pusta przestrzen - wygladalo to na szarpniecie bez animacji.
    {%- endcomment -%}
    .grid-product.is-measured:hover .grid-product__colors {
      max-height: var(--tile-colors-h, 40px);
      opacity: 1;
      margin: 8px 0 2px;
    }
    .grid-product.is-measured:hover .tile-hover {
      max-height: var(--tile-panel-h, 220px);
      opacity: 1;
      margin: 0;
    }

    /* Karta rosnie TYLKO w dol. Zadnego powiekszania na boki i do gory
       ani cienia - zmierzone u nich: ta sama gorna krawedz, biale tlo,
       box-shadow: none, wieksza jedynie wysokosc. */
    {%- comment -%}
      Kafel ma wlasne wciecie na odstep w siatce (u nas 22 px z lewej).
      Element ustawiony absolutnie liczy sie od KRAWEDZI WEWNETRZNEJ
      obramowania, czyli razem z tym wcieciem - przez co karta robila
      sie o te 22 px szersza i wychodzila w lewo, a zdjecie wygladalo,
      jakby sie powiekszalo. Dlatego left i right biora wciecie kafla,
      ktore podaje skrypt.
    {%- endcomment -%}
    {%- comment -%}
      Karta jest wyjeta z ukladu ZAWSZE, nie tylko po najechaniu.
      Wczesniej wracala do ukladu w chwili zjechania kursorem, a odstep
      i wysokosci dalej sie animowaly - wiec kafel kurczyl sie na oczach
      i caly rzad nizej obnizal sie i wracal. Teraz kafel trzyma stala
      wysokosc z min-height, a karta nasuwa sie na rzad nizej i nic
      pod nia nie drgnie.

      Klasa is-measured pilnuje, zeby to wlaczylo sie dopiero wtedy,
      gdy skrypt zdazyl zmierzyc kafel. Bez niej kafel bez zmierzonej
      wysokosci zapadlby sie do zera.
    {%- endcomment -%}
    .grid-product.is-measured .grid-product__content {
      position: absolute;
      left: var(--tile-pad-l, 0px);
      right: var(--tile-pad-r, 0px);
      top: 0;
      padding-bottom: 12px;
      background: transparent;
    }
    .grid-product.is-measured:hover .grid-product__content { z-index: 6; }
    {%- comment -%}
      Blok z opisem wchodzi NA dol zdjecia - tak jak u nich. Rysuje go
      ::before, bo samo tlo karty objelo by tez zdjecie i przykrylo je
      biala mgielka. Gorna krawedz liczy sie od wysokosci zdjecia,
      ktora podaje skrypt, minus zachodzenie.

      Zmierzone u nich: rgba(255,255,255,0.7) i blur(10px).
    {%- endcomment -%}
    .grid-product .grid-product__content::before {
      content: "";
      position: absolute;
      left: 0; right: 0; bottom: 0;
      top: calc(var(--tile-img-h, 100%) - 44px);
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      /* wlosowa kreska po bokach i na dole - zeby bylo widac, ze ta
         rozsunieta czesc nalezy do tego kafla, a nie do rzedu nizej */
      border-left: 1px solid rgba(28, 29, 29, 0.12);
      border-right: 1px solid rgba(28, 29, 29, 0.12);
      border-bottom: 1px solid rgba(28, 29, 29, 0.12);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease;
      z-index: 2;
    }
    .grid-product:hover .grid-product__content::before { opacity: 1; }
    /* tekst i panel nad mgielka, strzalki i kropki tez */
    .grid-product:hover .grid-product__vendor,
    .grid-product:hover .grid-product__title,
    .grid-product:hover .grid-product__price-now,
    .grid-product:hover .grid-product__colors,
    .grid-product:hover .tile-hover,
    .grid-product:hover .grid-product__price--original,
    .grid-product:hover .grid-product__lowest,
    .grid-product:hover .grid-product__price--savings {
      position: relative;
      z-index: 3;
    }
    .grid-product:hover .tile-nav { z-index: 3; }
    {%- comment -%}
      Plakietka nie znika - zostaje pod mgielka i rozmywa sie razem
      ze zdjeciem. O to chodzilo: karta ma na nia nachodzic.
    {%- endcomment -%}

    /* ---------- strzalki i kropki na zdjeciu ---------- */
    .grid-product__image-mask { position: relative; }
    .tile-nav {
      display: block;
      position: absolute;
      left: 0; right: 0; top: 0; bottom: 0;
      opacity: 0;
      transition: opacity 0.34s ease 0.14s;
      pointer-events: none;
    }
    .grid-product:hover .tile-nav { opacity: 1; }
    /* Zmierzone u nich: 35 x 41 px, tlo rgba(255,255,255,0.7),
       blur(10px), bez cienia, przylegle do krawedzi i zaokraglone
       tylko od strony zdjecia. */
    .tile-nav__btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 35px; height: 41px;
      display: flex; align-items: center; justify-content: center;
      padding: 0; border: 0;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      color: #1c1d1d;
      box-shadow: none;
      cursor: pointer;
      pointer-events: auto;
    }
    .tile-nav__btn--prev { left: 0; border-radius: 0 20px 20px 0; }
    .tile-nav__btn--next { right: 0; border-radius: 20px 0 0 20px; }
    /* na pierwszym zdjeciu nie ma po co cofac, na ostatnim - isc dalej */
    .tile-nav__btn.is-off { display: none; }
    .tile-nav__btn svg { width: 7px; height: 12px; display: block; }
    /* Kropki siedza na rozmytej pigulce - inaczej znikaja na jasnym
       zdjeciu. U nich blur(6px) i ledwie widoczne tlo. */
    .tile-nav__dots {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 50px;
      display: flex; align-items: center; justify-content: center; gap: 5px;
      height: 14px;
      padding: 0 8px;
      border-radius: 7px;
      background: rgba(242, 242, 242, 0.1);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .tile-nav__dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.85);
      transition: background 0.12s ease;
    }
    .tile-nav__dot.is-on { background: #16150f; }

    /* ---------- rozmiary i przycisk ---------- */
    /* Jedna linia, reszta w wielokropek. Buty maja po pietnascie
       polowek rozmiaru i bez tego lista lamala sie na piec wierszy,
       przez co karta rosla o 150 px zamiast o czterdziesci kilka. */
    .tile-hover__sizes {
      font-size: 11.5px;
      line-height: 1.4;
      color: var(--colorTextBody, #6e6b65);
      margin: 6px 0 8px;
      /* ten sam luz co przycisk, inaczej wielokropek siedzi na kresce */
      padding: 0 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* Nie na cala szerokosc karty - odsuniety od kreski po bokach
       i lekko zaokraglony, zeby nie stykal sie z jej krawedzia. */
    .tile-hover__btn {
      display: block;
      width: calc(100% - 24px);
      margin: 0 auto;
      padding: 11px 12px;
      border: 0;
      border-radius: 3px;
      background: #16150f;
      color: #fff;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.01em;
      cursor: pointer;
    }
    .tile-hover__btn:hover { background: #2e2c24; }
    .tile-hover__btn[disabled] { background: #b7b3ac; cursor: default; }
    .tile-hover__btn.is-done { background: #2f6b42; }

    .tile-hover__pick { margin-top: 8px; }
    .tile-hover__pick-label {
      font-size: 11.5px;
      color: var(--colorTextBody, #6e6b65);
      margin-bottom: 6px;
    }
    .tile-hover__chips { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; }
    .tile-hover__chip {
      min-width: 36px;
      padding: 7px 9px;
      border: 1px solid #d9d6d1;
      background: #fff;
      font-size: 12.5px;
      line-height: 1;
      cursor: pointer;
    }
    .tile-hover__chip:hover { border-color: #16150f; }
    .tile-hover__chip[disabled] {
      color: #b7b3ac;
      border-color: #ebe8e3;
      cursor: default;
      text-decoration: line-through;
    }
  }

  /* ==========================================================================
     Polecane produkty pod karta produktu

     Naglowek w tej samej konwencji co reszta strony: wlosowa kreska nad
     nim, maly napis wersalikami, bez ozdobnikow. Na telefonie zamiast
     ciasnej siatki dwoch kolumn - pasek przesuwany palcem, w ktorym
     kafel ma stala szerokosc i widac kawalek nastepnego, wiec od razu
     wiadomo, ze da sie przewijac.
     ========================================================================== */
  .product-recommendations-placeholder .section-header,
  #shopify-section-product-recommendations .section-header,
  .index-section .section-header {
    margin-bottom: 18px;
  }

  #shopify-section-product-recommendations .section-header__title,
  .product-recommendations ~ .section-header__title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    margin: 0;
    padding-top: 26px;
    border-top: 1px solid #e6e3de;
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-product-recommendations .grid,
    .product-recommendations .grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 12px;
      margin: 0 -16px;
      padding: 0 16px 4px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    #shopify-section-product-recommendations .grid::-webkit-scrollbar,
    .product-recommendations .grid::-webkit-scrollbar { display: none; }

    #shopify-section-product-recommendations .grid > .grid__item,
    .product-recommendations .grid > .grid__item {
      flex: 0 0 62%;
      max-width: 62%;
      width: auto;
      padding-left: 0;
      scroll-snap-align: start;
    }

    #shopify-section-product-recommendations .section-header__title {
      padding-top: 22px;
    }
  }

  /* ==========================================================================
     Jedna skala typografii dla sekcji, ktore dopisalem

     Zmierzone przed ujednoliceniem: naglowki sekcji chodzily w trzech
     wagach (400, 600, 700) i trzech rozmiarach (16,7 / 17 / 19 px),
     a werdykt w opiniach szedl krojem tekstowym zamiast naglowkowym.
     Ponizej jeden zestaw regul dla wszystkich.

     Krój bierze sie ze zmiennych motywu, wiec zmiana czcionki
     w edytorze przechodzi przez cala strone bez ruszania kodu.
     ========================================================================== */
  {%- comment -%}
    Waga 600, nie 700. Zmierzone na piecu dunskich sklepach odziezowych:
    Magasin, Bahne, Part Two, Zizzi, Masai - zaden nie uzywa 700
    w naglowkach, chodza w przedziale 400-600.

    Wersaliki zostaja tylko tam, gdzie naglowek ma dwa-trzy slowa.
    Dluzsze zdanie wielkimi literami czyta sie wolniej, bo wszystkie
    litery maja ten sam prostokatny obrys i oko nie ma sie czego zlapac.
  {%- endcomment -%}
  .obr__verdict-word,
  .obf__title,
  .snb__title,
  #shopify-section-product-recommendations .section-header__title,
  .index-section .section-header__title,
  .recently-viewed .section-header__title {
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  /* jedno slowo - wersaliki dzialaja jak znak, nie jak zdanie */
  .obr__verdict-word { text-transform: uppercase; letter-spacing: 0.03em; }

  /* naglowek w waskiej kolumnie karty produktu - ten sam kroj, mniejszy stopien */
  .snx__title {
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  /* nadtytuly nad naglowkami: jeden stopien, jeden odstep, jedna waga */
  .obf__eyebrow,
  .obr__eyebrow {
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* pytania i tytuly rozwijane: jeden stopien w akordeonie i w FAQ */
  .obf__item summary {
    font-size: 15px;
    font-weight: 600;
  }

  @media only screen and (max-width: 768px) {
    .obr__verdict-word,
    .obf__title,
    .snb__title,
    #shopify-section-product-recommendations .section-header__title,
    .index-section .section-header__title,
    .recently-viewed .section-header__title {
      font-size: 16px;
    }
  }

  /* ==========================================================================
     Szuflada koszyka a przyciemnienie strony

     Szuflada jest teraz renderowana z layout/theme.liquid, wiec stoi
     bezposrednio w body i jej z-index 30 liczy sie wzgledem calej strony.
     Przyciemnienie ma 26, wiec szuflada jest nad nim, a naglowek - ktory
     zostal w przyklejonej grupie z z-index 26 - pod nim. Czyli: przygaszona
     cala strona z naglowkiem wlacznie, jasna tylko szuflada.

     Zadnych nadpisan z-index nie trzeba; poprzednie proby podnosily albo
     cala grupe naglowka, albo zdejmowaly jej kontekst ukladania, i za
     kazdym razem cos innego wychodzilo nie tak.
     ========================================================================== */
</style>
