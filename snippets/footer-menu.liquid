{%- liquid
  assign tytul_menu = linklists[block.settings.menu].title
  if tytul_menu == 'HELP' or tytul_menu == 'Help'
    assign tytul_menu = 'Help'
  endif
-%}
{%- if linklists[block.settings.menu].links.size > 0 -%}
  {%- if block.settings.show_footer_title -%}
    <h2 class="h4 footer__title small--hide">
      {{ tytul_menu }}
    </h2>
    <button type="button" class="h4 footer__title collapsible-trigger collapsible-trigger-btn medium-up--hide" aria-controls="Footer-{{ block.id }}">
      {{ tytul_menu }}
      {%- render 'collapsible-icons' -%}
    </button>
  {%- endif -%}
  <div
    {% if block.settings.show_footer_title %}
      id="Footer-{{ block.id }}" class="collapsible-content collapsible-content--small"
    {% endif %}>
    <div class="collapsible-content__inner">
      <div class="footer__collapsible{% unless block.settings.show_footer_title %} footer_collapsible--disabled{% endunless %}">
        <ul class="no-bullets site-footer__linklist">
          {%- if block.settings.menu == 'customer-support-copy' -%}
            {%- comment -%}
              Menu polityk w panelu mialo pomieszane linki (Privatlivspolitik
              prowadzil do wysylki). Stala lista = zawsze zgodna ze stronami polityk.
            {%- endcomment -%}
            <li><a href="/pages/vilkar-og-betingelser">Terms of service</a></li>
            <li><a href="/pages/retur-og-refusionspolitik">Returns and refunds</a></li>
            <li><a href="/pages/forsendelsespolitik">Shipping and delivery</a></li>
            <li><a href="/pages/payment-policy">Payment</a></li>
            <li><a href="/pages/betalingspolitik">Privacy policy</a></li>
          {%- else -%}
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}
