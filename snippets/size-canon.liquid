{% comment %}
  Jedna nazwa dla roznych zapisow tego samego rozmiaru liczbowego:
   "10 US - 44 EU" => 44, "36|UK3.5" => 36, 30" => 30, "28 l XS" => 28,
   "12/14" => 12-14. Zwraca pusty tekst, gdy to nie jest rozmiar liczbowy.
  Sklep pokazuje tylko rozmiary EU, wiec przy uk: true brytyjskie rozmiary
  odziezy damskiej (4-28) sa przeliczane na EU: UK 10 => 38, "8-10" => 36-38.

  Parametry:
   - label (wymagany) - wartosc filtra z Shopify
   - uk (opcjonalny) - true, gdy liczby to rozmiary UK odziezy damskiej
{% endcomment %}

{%- liquid
  assign canon = label | strip
  if canon contains ' EU'
    assign canon = canon | split: '-' | last | remove: 'EU' | strip
  elsif canon contains '|'
    assign canon = canon | split: '|' | first | strip
  endif
  assign canon = canon | remove: '"' | replace: '/', '-' | split: ' ' | first

  assign has_dot = false
  if canon contains '.'
    assign has_dot = true
  endif

  if uk and has_dot == false and canon != blank
    assign parts = canon | split: '-'
    assign converted = ''
    assign all_uk = true
    for part in parts
      assign n = part | times: 1
      if n < 4 or n > 28
        assign all_uk = false
      endif
      assign eu = n | plus: 28
      if converted != blank
        assign converted = converted | append: '-'
      endif
      assign converted = converted | append: eu
    endfor
    if all_uk and parts.size > 0
      assign canon = converted
    endif
  endif
  # tylko liczby, kropka i myslnik - "22.50cm" to nie rozmiar
  assign leftover = canon | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: '.' | remove: '-'
-%}
{%- if canon != blank and leftover == blank -%}{{- canon -}}{%- endif -%}
