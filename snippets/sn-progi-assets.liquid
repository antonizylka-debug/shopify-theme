{%- comment -%}
  Styl i JS komponentu progow rabatu za ilosc (snippets/sn-progi):
  pasek pod naglowkiem, ramka w koszyku, karty w kolekcji - wzor Areleon.
  Renderowane raz w layout/theme.liquid.

  JS liczy wszystko z prawdziwej liczby sztuk w koszyku (/cart.js albo
  szczegoly zdarzenia cart:updated). Progi czyta z data-progi kazdego
  komponentu - musza zgadzac sie z rabatami automatycznymi w panelu.
  Odliczanie [data-snp-timer] tylko do prawdziwej daty konca kampanii
  (Ustawienia motywu -> Campaign); bez daty albo po terminie - ukryte.
{%- endcomment -%}
<style>
  [data-snp][hidden] { display: none !important; }
  .snp-track { position: relative; height: 12px; margin: 0 6px; }
  .snp-track__line { position: absolute; left: 0; right: 0; top: 5px; height: 2px; background: #ded8cf; }
  .snp-track__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: #1c1d1d; transition: width 0.4s ease; }
  .snp-track__dot {
    position: absolute; top: 0; width: 12px; height: 12px; margin-left: -6px;
    border: 1.5px solid #b9b2a8; border-radius: 50%; background: #ffffff; transition: background 0.3s ease, border-color 0.3s ease;
  }
  .snp-track__dot.is-on { border-color: #1c1d1d; background: #1c1d1d; }
  .snp-track__lbl {
    position: absolute; top: 18px; transform: translateX(-50%);
    font-size: 11px; line-height: 1.3; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; white-space: nowrap; color: #1c1d1d;
  }
  .snp-track__lbl small { display: block; font-size: 10px; letter-spacing: 0.04em; color: #8a857e; }
  .snp-track__lbl.is-first { transform: translateX(-10%); }
  .snp-track__lbl.is-last { transform: translateX(-90%); }
  .snp-msg { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #1c1d1d; }
  .snp-msg b { color: #c8102e; font-weight: 700; }

  /* ---------- pasek pod naglowkiem ---------- */
  .snp-bar { background: #f9f7f4; border-bottom: 1px solid #ebe6df; color: #1c1d1d; }
  .snp-bar__in {
    position: relative; display: grid; grid-template-columns: 200px minmax(0, 1fr) auto 30px; align-items: center; gap: 28px;
    max-width: 1500px; margin: 0 auto; padding: 12px 40px;
  }
  .snp-bar__left { display: flex; flex-direction: column; gap: 3px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a857e; }
  .snp-bar__left b { color: #1c1d1d; }
  .snp-bar__mid { display: flex; flex-direction: column; gap: 8px; max-width: 760px; width: 100%; justify-self: center; }
  .snp-bar__mid .snp-msg { text-align: center; font-size: 11px; }
  .snp-bar__timer { display: flex; align-items: baseline; gap: 12px; white-space: nowrap; }
  .snp-bar__timer[hidden] { display: none; }
  .snp-bar__tl { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a857e; }
  .snp-bar__tv { font-size: 16px; font-weight: 700; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }
  .snp-bar__x {
    display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; padding: 0;
    border: 0; background: none; color: #8a857e; cursor: pointer;
  }
  .snp-bar__x:hover { color: #1c1d1d; }
  @media only screen and (max-width: 989px) {
    .snp-bar__in { grid-template-columns: minmax(0, 1fr) 30px; gap: 6px 10px; padding: 10px 16px 9px; }
    .snp-bar__left { display: none; }
    .snp-bar__mid { grid-column: 1; grid-row: 1; gap: 7px; }
    .snp-bar__mid .snp-msg { font-size: 10.5px; letter-spacing: 0.04em; }
    .snp-bar__timer { grid-column: 1; grid-row: 2; justify-content: center; gap: 8px; }
    .snp-bar__tl { font-size: 10.5px; }
    .snp-bar__tv { font-size: 13px; }
    .snp-bar__x { grid-column: 2; grid-row: 1 / span 2; align-self: start; width: 30px; height: 30px; margin-top: -4px; }
  }

  /* ---------- ramka w koszyku ---------- */
  .snp-box { margin: 0 0 22px; padding: 18px 18px 16px; border: 1px solid #ebe6df; border-radius: 10px; background: #f9f7f4; text-align: center; }
  .snp-box__title { margin: 0 0 4px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #5f5b55; }
  .snp-box__cart { margin: 0 0 16px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #8a857e; }
  .snp-box__cart b { color: #1c1d1d; }
  .snp-box .snp-track { margin-bottom: 38px; }
  .snp-box .snp-msg { font-size: 11px; }

  /* ---------- linijka w kolekcji ---------- */
  .snp-line {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 6px 22px;
    margin: 0 0 26px; padding: 13px 12px; border-top: 1px solid #ebe6df; border-bottom: 1px solid #ebe6df;
    font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #6e6b65;
  }
  .snp-line__lbl { font-weight: 600; color: #1c1d1d; }
  .snp-line__t b { font-weight: 600; color: #1c1d1d; }
  .snp-line__t.is-on { color: #1c1d1d; }
  .snp-line__t.is-on b { padding-bottom: 2px; border-bottom: 1px solid #1c1d1d; }
  @media only screen and (max-width: 768px) {
    .snp-line { gap: 4px 14px; margin-bottom: 18px; padding: 10px 6px; font-size: 11px; letter-spacing: 0.06em; }
    .snp-line__lbl { flex: 0 0 100%; text-align: center; }
  }

  /* ---------- karty w kolekcji ---------- */
  .snp-col { margin: 0 0 40px; padding: 30px 24px 22px; background: #f9f7f4; text-align: center; color: #1c1d1d; }
  .snp-col__title { margin: 0 0 6px; font-size: 22px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; color: #6e6359; }
  .snp-col__sub { margin: 0 0 22px; font-size: 15px; font-style: italic; color: #6e6359; }
  .snp-col__status {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    max-width: 640px; margin: 0 auto 10px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #8a857e;
  }
  .snp-col__status b { color: #1c1d1d; }
  .snp-col .snp-track { max-width: 620px; margin: 0 auto 34px; }
  .snp-col__cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; max-width: 1400px; margin: 0 auto 22px; }
  .snp-card {
    position: relative; overflow: hidden; padding: 24px 12px 20px; border: 1px solid #e0d9cf; border-radius: 12px; background: #ffffff;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }
  .snp-card__name { margin: 0 0 4px; font-size: 18px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .snp-card__qty { margin: 0; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #8a857e; }
  .snp-card__sep { width: 34px; height: 1px; margin: 14px auto; background: #d9d2c8; }
  .snp-card__extra { margin: 0; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; }
  .snp-card__pct { margin: 2px 0 0; font-family: var(--typeHeaderPrimary), sans-serif; font-size: 38px; line-height: 1.05; color: #8c7d70; }
  .snp-card__off { margin: 2px 0 0; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .snp-card__ribbon {
    display: none; position: absolute; top: 16px; right: -34px; width: 130px; padding: 4px 0;
    transform: rotate(45deg); background: #c9a96e; color: #3d2f17;
    font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .snp-card.is-on { background: #1c1d1d; border-color: #1c1d1d; color: #ffffff; }
  .snp-card.is-on .snp-card__qty { color: #c9c3ba; }
  .snp-card.is-on .snp-card__pct { color: #ffffff; }
  .snp-card.is-on .snp-card__sep { background: #5f5b55; }
  .snp-card.is-on .snp-card__ribbon { display: block; }
  .snp-col__foot {
    display: flex; align-items: center; gap: 18px; max-width: 1400px; margin: 0 auto;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8c7d70;
  }
  .snp-col__foot::before, .snp-col__foot::after { content: ""; flex: 1; height: 1px; background: #ded8cf; }
  @media only screen and (max-width: 768px) {
    .snp-col { margin: 0 0 22px; padding: 18px 12px 14px; }
    .snp-col__title { font-size: 15px; letter-spacing: 0.2em; }
    .snp-col__sub { display: none; }
    .snp-col__status { flex-direction: column; align-items: center; gap: 4px; margin-bottom: 10px; font-size: 10.5px; }
    .snp-col .snp-track { margin: 0 8px 14px; }
    .snp-col .snp-track__lbl { display: none; }
    .snp-col__cards { gap: 6px; margin-bottom: 12px; }
    .snp-card { padding: 12px 4px 10px; border-radius: 8px; }
    .snp-card__name { font-size: 12px; letter-spacing: 0.04em; }
    .snp-card__qty { font-size: 10px; letter-spacing: 0.04em; }
    .snp-card__sep { margin: 7px auto; }
    .snp-card__extra, .snp-card__off { font-size: 9px; letter-spacing: 0.06em; }
    .snp-card__pct { font-size: 22px; }
    .snp-card__ribbon { top: 7px; right: -40px; font-size: 8px; padding: 2px 0; }
    .snp-col__foot { font-size: 10px; gap: 10px; }
  }
</style>

<script>
  (function () {
    if (window.snProgi) return;

    function progi(el) {
      return (el.getAttribute('data-progi') || '').split(',').map(function (x) {
        var p = x.split(':'); return [Number(p[0]), Number(p[1])];
      }).filter(function (p) { return p[0] > 0 && p[1] > 0; }).sort(function (a, b) { return a[0] - b[0]; });
    }
    function sztuk(n) { return n === 1 ? 'vare' : 'varer'; }

    function rysuj(el, n) {
      var P = progi(el);
      if (!P.length) return;
      var osiagniety = null, nastepny = null;
      P.forEach(function (p) { if (n >= p[0]) osiagniety = p; else if (!nastepny) nastepny = p; });

      var msg;
      if (!nastepny) msg = 'Du har den højeste rabat: <b>ekstra ' + osiagniety[1] + ' %</b>';
      else if (!osiagniety) msg = 'Tilføj ' + (nastepny[0] - n) + ' ' + sztuk(nastepny[0] - n) + (n ? ' mere' : '') + ' for <b>ekstra ' + nastepny[1] + ' %</b>';
      else msg = 'Ekstra ' + osiagniety[1] + ' % låst op · Tilføj ' + (nastepny[0] - n) + ' ' + sztuk(nastepny[0] - n) + ' mere for <b>ekstra ' + nastepny[1] + ' %</b>';
      el.querySelectorAll('[data-snp-msg]').forEach(function (m) { m.innerHTML = msg; });
      el.querySelectorAll('[data-snp-count]').forEach(function (m) { m.textContent = n; });
      el.querySelectorAll('[data-snp-unit]').forEach(function (m) { m.textContent = sztuk(n); });

      /* wypelnienie toru: start (0 szt.) i kolejne progi w rownych odstepach */
      var wezly = [0].concat(P.map(function (p) { return p[0]; }));
      var frac = 1;
      for (var i = 0; i < wezly.length - 1; i++) {
        if (n < wezly[i + 1]) { frac = (i + (n - wezly[i]) / (wezly[i + 1] - wezly[i])) / (wezly.length - 1); break; }
      }
      el.querySelectorAll('[data-snp-fill]').forEach(function (f) { f.style.width = (frac * 100) + '%'; });
      el.querySelectorAll('[data-snp-step]').forEach(function (d) { d.classList.toggle('is-on', n >= Number(d.getAttribute('data-snp-step'))); });
      el.querySelectorAll('[data-snp-card]').forEach(function (c) {
        var wl = osiagniety && Number(c.getAttribute('data-snp-card')) === osiagniety[0];
        c.classList.toggle('is-on', !!wl);
      });
    }

    var ostatnie = null;
    function wszystkie(n) {
      ostatnie = n;
      document.querySelectorAll('[data-snp]').forEach(function (el) { rysuj(el, n); });
    }
    function pobierz(e) {
      var c = e && e.detail && e.detail.cart;
      if (c && typeof c.item_count === 'number') { wszystkie(c.item_count); return; }
      fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (c) { wszystkie(c.item_count); })
        .catch(function () {});
    }
    ['cart:updated', 'ajaxProduct:added', 'drawerOpen'].forEach(function (nazwa) {
      document.addEventListener(nazwa, function (e) { setTimeout(function () { pobierz(e); }, 200); });
    });

    /* ---------- odliczanie do konca kampanii ---------- */
    function koniecZ(t) {
      var m = (t || '').match(/(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T]+(\d{1,2})[:.](\d{2}))?/);
      if (!m) return null;
      return m[4] ? new Date(+m[1], m[2] - 1, +m[3], +m[4], +m[5], 0) : new Date(+m[1], m[2] - 1, +m[3], 23, 59, 59);
    }
    function dwa(x) { return (x < 10 ? '0' : '') + x; }
    function tik() {
      document.querySelectorAll('[data-snp-timer]').forEach(function (t) {
        var k = koniecZ(t.getAttribute('data-slut'));
        var s = k ? Math.floor((k - new Date()) / 1000) : 0;
        if (s <= 0) { t.hidden = true; return; }
        var d = Math.floor(s / 86400); s -= d * 86400;
        var h = Math.floor(s / 3600); s -= h * 3600;
        var mi = Math.floor(s / 60); s -= mi * 60;
        var v = t.querySelector('[data-snp-tv]');
        if (v) v.textContent = dwa(d) + 'D : ' + dwa(h) + 'T : ' + dwa(mi) + 'M : ' + dwa(s) + 'S';
        t.hidden = false;
      });
    }
    setInterval(tik, 1000);

    /* ---------- zamykanie paska (do konca wizyty) ---------- */
    document.addEventListener('click', function (e) {
      var x = e.target.closest('[data-snp-close]');
      if (!x) return;
      var bar = x.closest('[data-snp]');
      if (bar) bar.hidden = true;
      try { sessionStorage.setItem('snp-bar-zamkniety', '1'); } catch (err) {}
    });

    window.snProgi = {
      init: function (el) {
        if (el.hasAttribute('data-snp-bar')) {
          try { if (sessionStorage.getItem('snp-bar-zamkniety') === '1') { el.hidden = true; } } catch (err) {}
        }
        rysuj(el, ostatnie !== null ? ostatnie : Number(el.getAttribute('data-count')) || 0);
        tik();
      }
    };
  })();
</script>
