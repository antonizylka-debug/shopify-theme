{%- comment -%}
  Pozycja w koszyku (szuflada i strona koszyka), uklad jak na icon-amsterdam:
  zdjecie z lewej, nazwa wersalikami, cena przed obnizka przekreslona,
  wariant "Sort / S", ilosc w zaokraglonej pigulce.
  Klasy js-qty__* i data-key zostaja - na nich dziala JS motywu
  (theme.QtySelector, przebudowa koszyka). "Fjern" ustawia ilosc na 0
  przez ten sam mechanizm (sn-kurv-assets).
{%- endcomment -%}
{%- liquid
  assign cena_teraz = product.final_price
  assign cena_przed = product.original_price
  if product.variant.compare_at_price > cena_przed
    assign cena_przed = product.variant.compare_at_price
  endif
  assign obnizka = false
  if cena_przed > cena_teraz
    assign obnizka = true
  endif
  assign procent = 0
  if obnizka
    assign procent = cena_przed | minus: cena_teraz | times: 100 | divided_by: cena_przed
  endif
-%}
<div class="cart__item snk-item" data-key="{{ product.key }}">
  <a href="{{ product.url }}" class="snk-item__img" tabindex="-1" aria-hidden="true">
    {%- if product.image != blank -%}
      {{ product.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.product.title, sizes: '110px', widths: '150, 220, 300' }}
    {%- endif -%}
  </a>

  <div class="snk-item__info">
    <a href="{{ product.url }}" class="cart__item-name snk-item__name">{{ product.product.title }}</a>

    <div class="snk-item__price">
      {%- if obnizka -%}
        <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
        <s class="snk-item__was">{%- render 'sn-cena', kwota: cena_przed -%}</s>
        <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
      {%- endif -%}
      <span class="snk-item__now">{%- render 'sn-cena', kwota: cena_teraz -%}</span>
      {%- if procent > 0 -%}<span class="snk-item__save">Spar {{ procent }} %</span>{%- endif -%}
    </div>

    {%- unless product.product.has_only_default_variant -%}
      <div class="snk-item__variant">
        {%- for option in product.options_with_values -%}
          {%- assign option_check = option.name | downcase -%}
          {%- if option_check == 'size' or option_check == 'størrelse' -%}
            {%- render 'size-label', label: option.value, product: product.product -%}
          {%- else -%}
            {%- render 'sn-da', tekst: option.value -%}
          {%- endif -%}
          {%- unless forloop.last %} / {% endunless -%}
        {%- endfor -%}
      </div>
    {%- endunless -%}

    {%- if product.line_level_discount_allocations != blank -%}
      {%- for discount_allocation in product.line_level_discount_allocations -%}
        <div class="snk-item__deal">{{ discount_allocation.discount_application.title }} (−{%- render 'sn-cena', kwota: discount_allocation.amount -%})</div>
      {%- endfor -%}
    {%- endif -%}

    {%- assign property_size = product.properties | size -%}
    {%- if property_size > 0 -%}
      {%- for p in product.properties -%}
        {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
        {%- unless p.last == blank or first_character_in_key == '_' -%}
          <div class="snk-item__variant">{{ p.first }}: {{ p.last }}</div>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    <div class="snk-item__row">
      <div class="js-qty__wrapper snk-qty">
        <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
        <button type="button" class="js-qty__adjust js-qty__adjust--minus snk-qty__btn" aria-label="{{ 'cart.general.reduce_quantity' | t }}">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="11" height="11"><path d="M1 6h10" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
        </button>
        <input type="text"
          id="cart_updates_{{ product.key }}"
          name="updates[]"
          class="js-qty__num snk-qty__num"
          value="{{ product.quantity }}"
          min="0"
          inputmode="numeric"
          pattern="[0-9]*"
          data-id="{{ product.key }}">
        <button type="button" class="js-qty__adjust js-qty__adjust--plus snk-qty__btn" aria-label="{{ 'cart.general.increase_quantity' | t }}">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="11" height="11"><path d="M1 6h10M6 1v10" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
        </button>
      </div>
      <button type="button" class="snk-item__remove" data-snk-remove>{{ 'cart.general.remove' | t }}</button>
    </div>
  </div>
</div>
