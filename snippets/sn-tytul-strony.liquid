{%- comment -%}
  Dunski tytul podstrony (06.10.2026). Tytuly stron w panelu sa po angielsku
  (About Us, Contact, FAQ...) i trafialy do zakladki przegladarki, okruszkow
  i Google. Tu podmieniamy je po handle; inne strony bez zmian.
  @param {string} fallback - tytul, gdy strona nie jest na liscie (zwykle page_title)
{%- endcomment -%}
{%- liquid
  assign t = fallback
  if request.page_type == 'page'
    case page.handle
      when 'about-us'
        assign t = 'About us'
      when 'contact'
        assign t = 'Contact us'
      when 'faq'
        assign t = 'FAQ'
      when 'track-order'
        assign t = 'Track your order'
      when 'payment-policy'
        assign t = 'Payment'
      when 'size-guide'
        assign t = 'Size guide'
    endcase
  endif
  echo t
-%}
