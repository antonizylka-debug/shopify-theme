{% comment %}
  Zwijanie dlugich list filtrow: pokazuje 10 wartosci + przycisk "Vis alle X".
  Wczytywane raz z layout/theme.liquid.

  Tu siedza tez style wyprzedazy dla kafelkow w kolekcji. Trzymamy je tutaj,
  a nie w snippets/product-grid-item.liquid, bo tamten nalezy do motywu
  i przy aktualizacji Impulse zostalby nadpisany.
{% endcomment %}

{%- assign ob_czerwien = '#d6332e' -%}
{%- style -%}
  /* ---------- kafelek w wyprzedazy ---------- */
  .grid-product__price--sale .grid-product__price-now {
    color: {{ ob_czerwien }};
    font-weight: 600;
  }

  /* cena przed obnizka schodzi pod cene, w osobna linie */
  .grid-product__price--sale .grid-product__price--original {
    display: block;
    font-size: 12px;
    color: #6e6b65;
    text-decoration: none;
    margin-top: 4px;
  }

  .grid-product__lowest {
    display: block;
    font-size: 12px;
    color: #6e6b65;
    margin-top: 2px;
  }
  .grid-product__lowest b {
    color: {{ ob_czerwien }};
    font-weight: 600;
    margin-left: 4px;
  }

  /* plakietka wyprzedazy na zdjeciu - lekko zaokraglona, jak na wzorcu */
  .grid-product__tag--sale {
    background: {{ ob_czerwien }};
    color: #fff;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* przekreslona najnizsza cena i czerwony procent obok niej */
  .grid-product__lowest s { text-decoration: line-through; }
{%- endstyle -%}

<script>
  (function () {
    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-filter-toggle]');
      if (!button) return;

      event.preventDefault();

      var list = button.previousElementSibling;
      while (list && list.tagName !== 'UL') {
        list = list.previousElementSibling;
      }
      if (!list) return;

      var expanded = list.classList.toggle('is-expanded');

      if (expanded) {
        if (!button.dataset.more) {
          button.dataset.more = button.textContent.trim();
        }
        button.textContent = button.dataset.less || 'Vis færre';
      } else {
        button.textContent = button.dataset.more || button.textContent;
      }

      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');

      // akordeon theme trzyma sztywna wysokosc w px - po zmianie liczby wierszy
      // trzeba ja przeliczyc, inaczej reszta wartosci i przycisk sa przyciete
      var panel = button.closest('.collapsible-content');
      if (panel) {
        requestAnimationFrame(function () {
          var inner = panel.querySelector('.collapsible-content__inner');
          var target = inner ? inner.offsetHeight : panel.scrollHeight;
          panel.style.height = target + 'px';
        });
      }
    });

    // wysokosc naglowka do obliczenia offsetu przyklejonych filtrow
    var siteHeader = document.getElementById('SiteHeader');
    if (siteHeader) {
      var setHeaderHeight = function () {
        document.documentElement.style.setProperty('--header-h', siteHeader.offsetHeight + 'px');
      };

      setHeaderHeight();
      window.addEventListener('resize', setHeaderHeight);
      document.addEventListener('shopify:section:load', setHeaderHeight);
    }
    // chipy i krazki grupujace kilka wartosci filtra:
    // przelaczamy ukryte checkboxy i zglaszamy zdarzenie, ktorego slucha motyw
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-filter-group]');
      if (!trigger) return;

      event.preventDefault();

      var item = trigger.closest('.tag');
      if (!item) return;

      var inputs = item.querySelectorAll('input[type="checkbox"]');
      if (!inputs.length) return;

      var anyChecked = Array.prototype.some.call(inputs, function (input) {
        return input.checked;
      });

      Array.prototype.forEach.call(inputs, function (input) {
        input.checked = !anyChecked;
      });

      // zdarzenie musi wyjsc Z CHECKBOXA, nie z formularza: motyw robi
      // evt.target.closest('li'), przy formularzu dostaje null, wywala sie
      // i zostawia isAnimating = true, przez co kolejne klikniecia sa martwe.
      // Klase tag--active przelacza juz motyw, wiec tutaj jej nie ruszamy.
      inputs[0].dispatchEvent(new Event('input', { bubbles: true }));
    });
    // chip w pasku usuwa cala grupe: klikamy odpowiadajacy kafel w sidebarze,
    // zeby przejsc ta sama sciezka co zwykle klikniecie filtra
    document.addEventListener('click', function (event) {
      var chip = event.target.closest('[data-clear-group]');
      if (!chip) return;

      event.preventDefault();

      var label = chip.getAttribute('data-clear-group');
      var group = document.querySelector(
        '.tag[data-group-label="' + label.replace(/"/g, '\\"') + '"] [data-filter-group]'
      );

      if (group) group.click();
    });

    // chipy ponad limitem chowamy do czasu klikniecia "+N more"
    var markExtraChips = function () {
      document.querySelectorAll('[data-active-filters]').forEach(function (row) {
        var limit = parseInt(row.getAttribute('data-visible-chips'), 10);
        if (!limit) return;

        row.querySelectorAll('.active-filters__chip').forEach(function (chip, index) {
          chip.classList.toggle('active-filters__chip--extra', index >= limit);
        });
      });
    };

    markExtraChips();
    document.addEventListener('collection:reloaded', markExtraChips);
    // pasek aktywnych filtrow: +N flere / Vis færre
    document.addEventListener('click', function (event) {
      var more = event.target.closest('[data-active-filters-more]');
      if (!more) return;

      event.preventDefault();

      var row = more.closest('[data-active-filters]');
      if (!row) return;

      var expanded = row.classList.toggle('is-expanded');

      if (expanded) {
        if (!more.dataset.more) {
          more.dataset.more = more.textContent.trim();
        }
        more.textContent = more.dataset.less || 'Vis færre';
      } else {
        more.textContent = more.dataset.more || more.textContent;
      }
    });
    // powrot na gore ze stopki
    document.addEventListener('click', function (event) {
      if (!event.target.closest('[data-back-to-top]')) return;

      event.preventDefault();

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
    // strzalki w rzedzie podkolekcji
    document.addEventListener('click', function (event) {
      var nav = event.target.closest('[data-subrow-prev], [data-subrow-next]');
      if (!nav) return;

      var row = nav.closest('[data-subrow]');
      var track = row && row.querySelector('[data-subrow-track]');
      if (!track) return;

      var step = track.clientWidth * 0.8;
      track.scrollLeft += nav.hasAttribute('data-subrow-next') ? step : -step;
    });

    // wygaszanie strzalek na koncach
    function updateArrows(row) {
      var track = row.querySelector('[data-subrow-track]');
      var prev = row.querySelector('[data-subrow-prev]');
      var next = row.querySelector('[data-subrow-next]');
      if (!track || !prev || !next) return;

      var maxScroll = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll;
    }

    document.querySelectorAll('[data-subrow]').forEach(function (row) {
      var track = row.querySelector('[data-subrow-track]');
      if (!track) return;
      updateArrows(row);
      track.addEventListener('scroll', function () { updateArrows(row); });
      window.addEventListener('resize', function () { updateArrows(row); });
    });
  })();
</script>

<script>
  // lista sortowania: przycisk "SORT: X" otwiera panel, klikniecie opcji
  // ustawia ukryty #SortBy i wysyla change - motyw przeladowuje produkty
  (function () {
    function closeAll(except) {
      document.querySelectorAll('[data-sort-menu]').forEach(function (menu) {
        if (menu === except) return;
        menu.hidden = true;
        var toggle = menu.parentNode.querySelector('[data-sort-toggle]');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      });
    }

    document.addEventListener('click', function (event) {
      var toggle = event.target.closest('[data-sort-toggle]');
      if (toggle) {
        var menu = toggle.parentNode.querySelector('[data-sort-menu]');
        var open = menu.hidden;
        closeAll(menu);
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        return;
      }

      var item = event.target.closest('[data-sort-value]');
      if (item) {
        var wrap = item.closest('.collection-links-row__sort');
        var select = wrap && wrap.querySelector('#SortBy');
        if (select) {
          select.value = item.getAttribute('data-sort-value');
          var label = wrap.querySelector('[data-sort-current]');
          if (label) label.textContent = item.textContent.trim();
          wrap.querySelectorAll('[data-sort-value]').forEach(function (btn) {
            btn.classList.toggle('is-current', btn === item);
          });
          closeAll();
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
        return;
      }

      if (!event.target.closest('[data-sort-menu]')) closeAll();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeAll();
    });
  })();
</script>


<script>
  /* Kafel w kolekcji: przegladanie zdjec strzalkami i dodanie do koszyka
     bez wchodzenia na karte produktu.

     Zdarzenia wieszamy na dokumencie, a nie na kazdym kaflu - kafle
     dochodza przy doladowywaniu kolejnej strony kolekcji i filtrowaniu,
     wiec podpiecie ich raz na starcie nie wystarczyloby. */
  (function () {
    var KAFEL = '.grid-product';

    function kafel(el) {
      return el.closest ? el.closest(KAFEL) : null;
    }

    /* ---------- rezerwacja wysokosci kafla ----------
       Po najechaniu karta przechodzi w position: absolute i wypada
       z ukladu, wiec kafel bez tego zapadlby sie do zera, a caly rzad
       podskoczylby w gore. Wpisujemy kazdemu kaflowi jego wlasna
       wysokosc; mierzymy tylko te, na ktorych nie ma kursora. */
    function zmierz(k) {
      if (k.matches(':hover')) return;
      var tresc = k.querySelector('.grid-product__content');
      if (!tresc) return;
      k.style.minHeight = '';
      k.style.minHeight = tresc.offsetHeight + 'px';

      // wysokosc zdjecia - od niej liczy sie gorna krawedz mgielki
      var maska = k.querySelector('.grid-product__image-mask');
      if (maska) k.style.setProperty('--tile-img-h', maska.offsetHeight + 'px');

      // wciecie kafla - karta ustawiona absolutnie musi je uszanowac,
      // inaczej rozszerza sie o nie i wyglada, jakby zdjecie roslo
      var st = getComputedStyle(k);
      k.style.setProperty('--tile-pad-l', st.paddingLeft);
      k.style.setProperty('--tile-pad-r', st.paddingRight);

      /* wysokosci paneli w stanie zwinietym - scrollHeight podaje
         wysokosc tresci mimo max-height: 0 i overflow: hidden */
      var panel = k.querySelector('[data-tile-hover]');
      if (panel) k.style.setProperty('--tile-panel-h', (panel.scrollHeight + 2) + 'px');
      var kolory = k.querySelector('.grid-product__colors');
      if (kolory) k.style.setProperty('--tile-colors-h', (kolory.scrollHeight + 2) + 'px');

      // dopiero teraz karta moze wyjsc z ukladu - wysokosc jest zmierzona
      k.classList.add('is-measured');
    }

    /* requestAnimationFrame nie chodzi, kiedy karta jest w tle albo
       strona nie maluje - a wtedy kafle zostalyby bez zarezerwowanej
       wysokosci. Stad drugie wyjscie na zwyklym timerze; ktore pierwsze
       zdazy, to liczy, drugie sie wycofuje. */
    var czeka = false;
    function przelicz() {
      if (!czeka) return;
      czeka = false;
      var kafle = document.querySelectorAll(KAFEL);
      for (var i = 0; i < kafle.length; i++) zmierz(kafle[i]);
    }
    function odswiez() {
      if (czeka) return;
      czeka = true;
      requestAnimationFrame(przelicz);
      setTimeout(przelicz, 250);
    }

    odswiez();
    window.addEventListener('load', odswiez);
    window.addEventListener('resize', odswiez);
    document.addEventListener('shopify:section:load', odswiez);

    // zdjecia dochodza leniwie, a kafle przy filtrowaniu i kolejnej stronie
    document.addEventListener('load', function (e) {
      if (e.target && e.target.tagName === 'IMG' && kafel(e.target)) odswiez();
    }, true);

    /* Skrypt siedzi w <head>, wiec przy pierwszym przejsciu document.body
       jeszcze nie istnieje. Bez tego MutationObserver rzucal wyjatkiem
       i zabijal cala reszte pliku - strzalki i dodawanie do koszyka
       nigdy sie nie podpinaly. */
    function pilnujSiatki() {
      if (!window.MutationObserver || !document.body) return;
      new MutationObserver(function () { odswiez(); ustawStrzalki(); })
        .observe(document.body, { childList: true, subtree: true });
      odswiez();
      ustawStrzalki();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pilnujSiatki);
    } else {
      pilnujSiatki();
    }

    /* ---------- strzalki i kropki ---------- */
    function pokaz(nav, nowy) {
      var lista;
      try {
        lista = JSON.parse(nav.getAttribute('data-tile-media') || '[]');
      } catch (err) {
        return;
      }
      if (!lista.length) return;

      var i = ((nowy % lista.length) + lista.length) % lista.length;
      /* Motyw nie nadaje zdjeciu klasy grid-product__image - obrazek
         ma tylko image-element. Bierzemy wiec pierwszy widoczny obrazek
         z maski, w ktorej siedzi ta nawigacja. */
      var maska = nav.closest('.grid-product__image-mask');
      if (!maska) return;
      var img = null;
      var kandydaci = maska.querySelectorAll('img');
      for (var q = 0; q < kandydaci.length; q++) {
        if (kandydaci[q].getBoundingClientRect().width > 0) { img = kandydaci[q]; break; }
      }
      if (!img) img = kandydaci[0];
      if (!img) return;

      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.src = lista[i];
      nav.setAttribute('data-tile-index', i);

      var kropki = nav.querySelectorAll('.tile-nav__dot');
      for (var j = 0; j < kropki.length; j++) {
        kropki[j].classList.toggle('is-on', j === i);
      }

      // na pierwszym zdjeciu chowamy strzalke wstecz, na ostatnim - dalej
      var wstecz = nav.querySelector('[data-tile-prev]');
      var dalej = nav.querySelector('[data-tile-next]');
      if (wstecz) wstecz.classList.toggle('is-off', i === 0);
      if (dalej) dalej.classList.toggle('is-off', i === lista.length - 1);
    }

    /* ustawienie poczatkowe - bez tego na pierwszym zdjeciu widac obie */
    function ustawStrzalki() {
      var nawigacje = document.querySelectorAll('[data-tile-nav]');
      for (var i = 0; i < nawigacje.length; i++) {
        var nav = nawigacje[i];
        var ile = nav.querySelectorAll('.tile-nav__dot').length;
        var teraz = parseInt(nav.getAttribute('data-tile-index') || '0', 10);
        var wstecz = nav.querySelector('[data-tile-prev]');
        var dalej = nav.querySelector('[data-tile-next]');
        if (wstecz) wstecz.classList.toggle('is-off', teraz === 0);
        if (dalej) dalej.classList.toggle('is-off', teraz === ile - 1);
      }
    }

    document.addEventListener('click', function (e) {
      var strzalka = e.target.closest('[data-tile-prev], [data-tile-next]');
      if (!strzalka) return;
      e.preventDefault();
      e.stopPropagation();

      var nav = strzalka.closest('[data-tile-nav]');
      var teraz = parseInt(nav.getAttribute('data-tile-index') || '0', 10);
      pokaz(nav, strzalka.hasAttribute('data-tile-next') ? teraz + 1 : teraz - 1);
    });

    /* ---------- dodanie do koszyka ---------- */
    function dodaj(id, przycisk) {
      przycisk.disabled = true;
      var napis = przycisk.textContent;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] })
      })
        .then(function (r) {
          if (!r.ok) throw new Error('add failed');
          return r.json();
        })
        .then(function () {
          przycisk.classList.add('is-done');
          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          setTimeout(function () {
            przycisk.classList.remove('is-done');
            przycisk.textContent = napis;
            przycisk.disabled = false;
          }, 1600);
        })
        .catch(function () {
          przycisk.disabled = false;
          var k = przycisk.closest(KAFEL);
          var link = k && k.querySelector('.grid-product__link');
          if (link) window.location.href = link.href;
        });
    }

    document.addEventListener('click', function (e) {
      var chip = e.target.closest('.tile-hover__chip');
      if (chip && !chip.disabled) {
        e.preventDefault();
        e.stopPropagation();
        var panel = chip.closest('[data-tile-hover]');
        dodaj(chip.getAttribute('data-variant'), panel.querySelector('[data-tile-add]'));
        var pick = panel.querySelector('[data-tile-pick]');
        if (pick) pick.hidden = true;
        return;
      }

      var btn = e.target.closest('[data-tile-add]');
      if (!btn || btn.disabled) return;
      e.preventDefault();
      e.stopPropagation();

      var id = btn.getAttribute('data-variant');
      if (id) {
        dodaj(id, btn);
        return;
      }

      // produkt ma rozmiary - najpierw trzeba wybrac ktory
      var wybor = btn.closest('[data-tile-hover]').querySelector('[data-tile-pick]');
      if (wybor) wybor.hidden = !wybor.hidden;
    });
  })();
</script>
