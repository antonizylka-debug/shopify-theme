{% comment %}
  Filtr koloru sprowadzony do stalej listy rodzin.

  Kazda surowa wartosc nalezy do DOKLADNIE JEDNEJ rodziny - decyduje pierwsze
  slowo, ktore pasuje do slownika. Dzieki temu "Black And White" to Black,
  a "Ivory With Black Trim" to White, zamiast wpadac do obu naraz.

  Parametry:
   - filter (wymagany)
   - mode (opcjonalny) - 'list' (domyslnie) albo 'chips' dla paska nad siatka
   - filter_name (opcjonalny) - etykieta filtra w chipie, np. "Colour"
   - enable_swatch_labels (opcjonalny)
   - show_unmatched (opcjonalny)
{% endcomment %}

{%- liquid
  assign color_map = 'Black|#111111|black;onyx,White|#ffffff|white;ivory;cream,Grey|#8b8b8b|grey;gray;charcoal;silver,Beige|#e8dcc4|beige;nude;apricot;sand;oat,Brown|#6b4a2f|brown;chocolate;coffee;mocha;camel;tan;taupe,Blue|#2b4a7d|blue;denim;navy;azure;indigo;teal;turquoise,Green|#4a7d55|green;olive;mint;sage;emerald,Khaki|#a89f68|khaki,Red|#b3262c|red;scarlet;crimson;cherry,Burgundy|#6b2233|burgundy;wine;maroon;bordeaux,Pink|#e8a8bb|pink;rose;blush;fuchsia;magenta,Purple|#6b4a8f|purple;violet;lilac;lavender;plum,Orange|#d2793a|orange;coral;rust;terracotta;peach,Yellow|#d8c14a|yellow;mustard;lemon;ochre,Gold|#c9a227|gold;bronze;brass,Multi|multi|multi;colorful;colourful;rainbow;floral;print;pattern;striped;leopard;pictured' | split: ','

  comment
    Jedno przejscie po wartosciach: kazdej przypisujemy rodzine wiodaca.
    Mapa ma postac [Etykieta]=Rodzina; i sluzy pozniej do wyszukiwania.
  endcomment
  assign value_families = ''

  for value in filter.values
    assign words = value.label | downcase | replace: '/', ' ' | replace: '&', ' ' | replace: '-', ' ' | split: ' '
    assign matched_family = ''

    comment
      Pierwsze przejscie pomija rodzine Multi - konkretny kolor jest wazniejszy
      niz wzor, wiec "Floral Blue" to Blue, a nie Multi.
    endcomment
    for word in words
      if matched_family != blank
        break
      endif

      for family in color_map
        assign family_parts = family | split: '|'
        if family_parts[0] == 'Multi'
          continue
        endif
        assign keywords = family_parts[2] | split: ';'

        for keyword in keywords
          assign word_head = word | slice: 0, keyword.size
          if word_head == keyword
            assign matched_family = family_parts[0]
            break
          endif
        endfor

        if matched_family != blank
          break
        endif
      endfor
    endfor

    comment
      Dopiero gdy nie ma zadnego konkretnego koloru, wpada Multi
      ("Multicolour", "Floral").
    endcomment
    if matched_family == blank
      for family in color_map
        assign family_parts = family | split: '|'
        if family_parts[0] != 'Multi'
          continue
        endif
        assign keywords = family_parts[2] | split: ';'

        for word in words
          for keyword in keywords
            assign word_head = word | slice: 0, keyword.size
            if word_head == keyword
              assign matched_family = 'Multi'
              break
            endif
          endfor

          if matched_family != blank
            break
          endif
        endfor
      endfor
    endif

    assign value_families = value_families | append: '[' | append: value.label | append: ']=' | append: matched_family | append: ';'
  endfor

  assign render_mode = mode | default: 'list'
-%}

{%- if render_mode == 'chips' -%}
  {%- for family in color_map -%}
    {%- liquid
      assign family_parts = family | split: '|'
      assign family_label = family_parts[0]
      assign family_active = false

      for value in filter.values
        assign family_key = '[' | append: value.label | append: ']=' | append: family_label | append: ';'
        if value_families contains family_key and value.active
          assign family_active = true
          break
        endif
      endfor
    -%}

    {%- if family_active -%}
      <button type="button" class="active-filters__chip" data-clear-group="{{ family_label | escape }}">
        <span class="active-filters__name">{{ filter_name | default: filter.label | escape }}:</span>
        <span class="active-filters__value">{{ family_label | escape }}</span>
        <svg aria-hidden="true" focusable="false" role="presentation" class="active-filters__x" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    {%- endif -%}
  {%- endfor -%}

{%- else -%}
  <ul class="no-bullets tag-list tag-list--swatches">
    {%- for family in color_map -%}
      {%- liquid
        assign family_parts = family | split: '|'
        assign family_label = family_parts[0]
        assign family_color = family_parts[1]

        assign family_active = false
        assign family_found = false
      -%}

      {%- capture family_inputs -%}
        {%- for value in filter.values -%}
          {%- assign family_key = '[' | append: value.label | append: ']=' | append: family_label | append: ';' -%}

          {%- if value_families contains family_key and value.count > 0 -%}
            {%- liquid
              assign family_found = true
              if value.active
                assign family_active = true
              endif
            -%}
            <input
              type="checkbox"
              class="tag__input visually-hidden"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}checked{% endif %}>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if family_found -%}
        <li
          class="tag tag--swatch{% if family_active %} tag--active{% endif %}{% if enable_swatch_labels %} tag--show-label{% endif %}"
          data-group-label="{{ family_label | escape }}"
        >
          <button type="button" class="tag__checkbox-wrapper text-label" data-filter-group>
            {%- if family_color == 'multi' -%}
              <span class="color-swatch color-swatch--filter color-swatch--multi"></span>
            {%- else -%}
              <span class="color-swatch color-swatch--filter" style="background-color: {{ family_color }};"></span>
            {%- endif -%}
            <span class="tag__text{% unless enable_swatch_labels %} hide{% endunless %}">{{ family_label }}</span>
          </button>
          {{ family_inputs }}
        </li>
      {%- endif -%}
    {%- endfor -%}

    {%- if show_unmatched -%}
      {%- for value in filter.values -%}
        {%- assign unmatched_key = '[' | append: value.label | append: ']=;' -%}

        {%- if value_families contains unmatched_key and value.count > 0 -%}
          {%- assign fallback_color = value.label | split: ' ' | last | handle -%}
          <li
            class="tag tag--swatch{% if value.active %} tag--active{% endif %}{% if enable_swatch_labels %} tag--show-label{% endif %}"
            data-group-label="{{ value.label | escape }}"
          >
            <button type="button" class="tag__checkbox-wrapper text-label" data-filter-group>
              <span class="color-swatch color-swatch--filter" style="background-color: {{ fallback_color }};"></span>
              <span class="tag__text{% unless enable_swatch_labels %} hide{% endunless %}">{{ value.label | escape }}</span>
            </button>
            <input
              type="checkbox"
              class="tag__input visually-hidden"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}checked{% endif %}>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
{%- endif -%}
