{% comment %}
  Filtr rozmiaru jako chipy w grupach:
   1. litery w stalej kolejnosci (XXS ... 6XL, One Size), ze scaleniem
      zapisow tego samego rozmiaru (XXL = 2XL, Medium = M),
   2. liczby rosnaco, ze scaleniem zapisow (snippet size-canon):
      "10 US - 44 EU" i "44" to jeden chip 44.
  Tylko rozmiary EU: brytyjskie rozmiary odziezy damskiej sa przeliczane
  (UK 10 => 38). Liczby dziela sie na ubrania ("Tøj (EU)", na spodniach
  "Talje") i buty ("Sko (EU)", tylko na stronach butow). Na stronach
  dzialow zwykle liczby sa pomijane - "30" to ta sama wartosc dla spodni
  i butow, wiec filtr pokazywalby jedno i drugie.

  Jeden chip = ukryte checkboxy wszystkich zapisow, wiec dziala natywny
  AJAX motywu i wybor wielu rozmiarow naraz.

  Parametry:
   - filter (wymagany)
   - mode (opcjonalny) - 'list' (domyslnie) albo 'chips' dla paska nad siatka
   - filter_name (opcjonalny) - etykieta filtra w chipie, np. "Size"
{% endcomment %}

{%- liquid
  assign size_map = 'XXS|xxs;2xs,XS|xs;xs i 28-30,S|s;small,M|m;medium;medium (us 32-34,L|l;large,XL|xl,2XL|2xl;xxl,3XL|3xl;xxxl,4XL|4xl;xxxxl,5XL|5xl,6XL|6xl,One Size|one size;onesize' | split: ','

  # wszystkie zapisy literowe - zeby nie wpadly do grupy liczbowej
  assign letter_variants = '|'
  for size in size_map
    assign variants_part = size | split: '|' | last | replace: ';', '|'
    assign letter_variants = letter_variants | append: variants_part | append: '|'
  endfor

  # grupa liczbowa: klucz sortowania (liczba x10 + 1000000, zawsze 7 cyfr) i nazwa chipa
  # UK-rozmiary odziezy damskiej pokazujemy jako EU (UK 10 => 38);
  # spodnie (talia w calach), buty i akcesoria zostaja bez przeliczania
  assign ctx = collection.handle | default: ''
  assign size_uk = false
  if ctx contains 'womens'
    assign size_uk = true
    if ctx contains 'bottoms' or ctx contains 'footwear' or ctx contains 'accessories'
      assign size_uk = false
    endif
  endif

  assign keep_small = false
  if ctx contains 'bottoms' or ctx contains 'accessories'
    assign keep_small = true
  endif

  # buty (S) czy ubrania (T): na stronach butow liczby to rozmiary butow.
  # Na stronach dzialow (mens, womens) zwykla liczba jest niejednoznaczna -
  # "30" to ta sama wartosc dla spodni (talia) i butow - wiec jej nie
  # pokazujemy; zostaja litery i rozmiary przeliczone z UK na EU.
  assign shoe_ctx = false
  if ctx contains 'footwear'
    assign shoe_ctx = true
  endif
  assign dept_page = true
  if ctx contains '-'
    assign dept_page = false
  endif

  # szablon kolekcji moze wprost powiedziec, co to za kolekcja
  # (ustawienie sekcji "Filtr rozmiarow: rodzaj kolekcji") - wtedy uchwyt
  # kolekcji nie ma znaczenia, np. dla Nyheder czy Udsalg
  assign size_mode = section.settings.size_filter_mode | default: 'auto'
  if size_mode != 'auto'
    assign size_uk = false
    assign shoe_ctx = false
    assign dept_page = false
    assign keep_small = false
    case size_mode
      when 'womens_department'
        assign size_uk = true
        assign dept_page = true
      when 'mens_department'
        assign dept_page = true
      when 'womens_clothing'
        assign size_uk = true
      when 'footwear'
        assign shoe_ctx = true
      when 'bottoms'
        assign keep_small = true
      when 'accessories'
        assign keep_small = true
    endcase
  endif


  assign numeric_rows = ''
  # "|<indeks wartosci>=<grupa>:<rozmiar EU>|" - uzywane przy budowie chipow
  assign value_map = '|'
  for value in filter.values
    assign raw = value.label | downcase | strip
    assign raw_lookup = '|' | append: raw | append: '|'
    unless letter_variants contains raw_lookup
      capture canon
        render 'size-canon', label: value.label, uk: size_uk
      endcapture
      # render zostawia biale znaki (nowa linia), a split: ' ' w Shopify tnie tez po nich
      assign canon = canon | strip
      capture canon_plain
        render 'size-canon', label: value.label
      endcapture
      assign canon_plain = canon_plain | strip

      assign size_group = 'T'
      if size_uk and canon != canon_plain
        assign size_group = 'T'
      elsif shoe_ctx
        assign size_group = 'S'
      elsif dept_page
        assign size_group = 'X'
      endif

      if canon != blank
        assign value_map = value_map | append: forloop.index | append: '=' | append: size_group | append: ':' | append: canon | append: '|'
      endif

      if size_group != 'X' and canon != blank and value.count > 0 or size_group != 'X' and canon != blank and value.active
        # zakres "36-38" trafia do obu chipow, 36 i 38 - bez osobnych kafli z zakresami
        assign canon_parts = canon | split: '-'
        for part in canon_parts
          assign as_number = part | times: 1.0
          # ponizej 30 to rozmiary US/UK butow i pierscionkow, powyzej 60 centymetry
          # paskow - poza spodniami i akcesoriami ich nie pokazujemy
          if keep_small or as_number >= 30 and as_number <= 60
            assign sort_key = as_number | times: 10 | plus: 1000000 | round
            assign row = size_group | append: sort_key | append: ':' | append: part
            assign row_lookup = ' ' | append: row | append: ' '
            assign padded = ' ' | append: numeric_rows
            unless padded contains row_lookup
              assign numeric_rows = numeric_rows | append: row | append: ' '
            endunless
          endif
        endfor
      endif
    endunless
  endfor
  assign numeric_sorted = numeric_rows | strip | split: ' ' | sort

  assign clothes_title = 'Tøj (EU)'
  if ctx contains 'bottoms'
    assign clothes_title = 'Talje'
  elsif ctx contains 'accessories'
    assign clothes_title = 'Numre'
  endif

  case size_mode
    when 'bottoms'
      assign clothes_title = 'Talje'
    when 'accessories'
      assign clothes_title = 'Numre'
    when 'womens_department', 'mens_department', 'womens_clothing', 'mens_clothing', 'footwear'
      assign clothes_title = 'Tøj (EU)'
  endcase

  assign render_mode = mode | default: 'list'
-%}

{%- if render_mode == 'chips' -%}
  {%- for size in size_map -%}
    {%- liquid
      assign parts = size | split: '|'
      assign size_label = parts[0]
      assign variants = parts[1] | split: ';'
      assign size_active = false

      for value in filter.active_values
        assign value_label = value.label | downcase | strip
        if variants contains value_label
          assign size_active = true
          break
        endif
      endfor
    -%}

    {%- if size_active -%}
      <button type="button" class="active-filters__chip" data-clear-group="{{ size_label | escape }}">
        <span class="active-filters__name">{{ filter_name | default: filter.label | escape }}:</span>
        <span class="active-filters__value">{{ size_label | escape }}</span>
        <svg aria-hidden="true" focusable="false" role="presentation" class="active-filters__x" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    {%- endif -%}
  {%- endfor -%}

  {%- for row in numeric_sorted -%}
    {%- liquid
      assign row_group = row | slice: 0
      assign row_canon = row | split: ':' | last
      assign size_active = false
      for value in filter.values
        if value.active
          assign map_key = '|' | append: forloop.index | append: '='
          if value_map contains map_key
            assign entry = value_map | split: map_key | last | split: '|' | first
            assign entry_group = entry | slice: 0
            assign entry_parts = entry | split: ':' | last | split: '-'
            if entry_group == row_group and entry_parts contains row_canon
              assign size_active = true
              break
            endif
          endif
        endif
      endfor
    -%}

    {%- if size_active -%}
      <button type="button" class="active-filters__chip" data-clear-group="{{ row_group }}{{ row_canon | escape }}">
        <span class="active-filters__name">{{ filter_name | default: filter.label | escape }}:</span>
        <span class="active-filters__value">{{ row_canon | escape }}</span>
        <svg aria-hidden="true" focusable="false" role="presentation" class="active-filters__x" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    {%- endif -%}
  {%- endfor -%}

{%- else -%}
  {%- capture letter_chips -%}
    {%- for size in size_map -%}
      {%- liquid
        assign parts = size | split: '|'
        assign size_label = parts[0]
        assign variants = parts[1] | split: ';'
        assign size_active = false
        assign size_found = false
      -%}

      {%- capture size_inputs -%}
        {%- for value in filter.values -%}
          {%- assign value_label = value.label | downcase | strip -%}
          {%- if variants contains value_label -%}
            {%- if value.count > 0 or value.active -%}
              {%- liquid
                assign size_found = true
                if value.active
                  assign size_active = true
                endif
              -%}
              <input
                type="checkbox"
                class="tag__input visually-hidden"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                {% if value.active %}checked{% endif %}>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if size_found -%}
        <li class="tag{% if size_active %} tag--active{% endif %}" data-group-label="{{ size_label | escape }}">
          <button type="button" class="tag__checkbox-wrapper text-label" data-filter-group>
            <span class="tag__text">{{ size_label }}</span>
          </button>
          {{ size_inputs }}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture clothes_chips -%}{%- endcapture -%}
  {%- capture shoe_chips -%}{%- endcapture -%}
  {%- for row in numeric_sorted -%}
    {%- liquid
      assign row_group = row | slice: 0
      assign row_canon = row | split: ':' | last
      assign size_active = false
    -%}

    {%- capture size_inputs -%}
      {%- for value in filter.values -%}
        {%- liquid
          assign in_chip = false
          assign map_key = '|' | append: forloop.index | append: '='
          if value_map contains map_key
            assign entry = value_map | split: map_key | last | split: '|' | first
            assign entry_group = entry | slice: 0
            assign entry_parts = entry | split: ':' | last | split: '-'
            if entry_group == row_group and entry_parts contains row_canon
              assign in_chip = true
            endif
          endif
        -%}
        {%- if in_chip -%}
          {%- if value.count > 0 or value.active -%}
            {%- if value.active -%}{%- assign size_active = true -%}{%- endif -%}
            <input
              type="checkbox"
              class="tag__input visually-hidden"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}checked{% endif %}>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture chip -%}
      <li class="tag{% if size_active %} tag--active{% endif %}" data-group-label="{{ row_group }}{{ row_canon | escape }}">
        <button type="button" class="tag__checkbox-wrapper text-label" data-filter-group>
          <span class="tag__text">{{ row_canon }}</span>
        </button>
        {{ size_inputs }}
      </li>
    {%- endcapture -%}

    {%- if row_group == 'S' -%}
      {%- assign shoe_chips = shoe_chips | append: chip -%}
    {%- else -%}
      {%- assign clothes_chips = clothes_chips | append: chip -%}
    {%- endif -%}
  {%- endfor -%}

  {%- liquid
    assign group_count = 0
    if letter_chips contains 'data-group-label'
      assign group_count = group_count | plus: 1
    endif
    if clothes_chips contains 'data-group-label'
      assign group_count = group_count | plus: 1
    endif
    if shoe_chips contains 'data-group-label'
      assign group_count = group_count | plus: 1
    endif
  -%}

  {%- if letter_chips contains 'data-group-label' -%}
    {%- if group_count > 1 -%}<p class="size-group__title">Tøj</p>{%- endif -%}
    <ul class="no-bullets tag-list tag-list--chips">{{ letter_chips }}</ul>
  {%- endif -%}

  {%- if clothes_chips contains 'data-group-label' -%}
    {%- if group_count > 1 -%}<p class="size-group__title">{{ clothes_title }}</p>{%- endif -%}
    <ul class="no-bullets tag-list tag-list--chips">{{ clothes_chips }}</ul>
  {%- endif -%}

  {%- if shoe_chips contains 'data-group-label' -%}
    {%- if group_count > 1 -%}<p class="size-group__title">Sko (EU)</p>{%- endif -%}
    <ul class="no-bullets tag-list tag-list--chips">{{ shoe_chips }}</ul>
  {%- endif -%}
{%- endif -%}
