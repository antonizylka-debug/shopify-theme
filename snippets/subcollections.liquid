{% comment %}
  Rzad podkolekcji dla otwartej kolekcji.

  Zrodlo 1 (priorytet): wybrane menu - daje pelna kontrole nad kolejnoscia i nazwami,
  ale wymaga, zeby pozycja menu prowadzila do kolekcji, a nie do "#".

  Zrodlo 2 (zapas): automatyczne wykrycie dzieci po prefiksie uchwytu,
  np. na /collections/womens beda to womens-dresses, womens-sweaters itd.
  Kolejnosc: od najliczniejszej kolekcji.

  Parametry:
   - per_row (opcjonalny)
   - menu (opcjonalny) - uchwyt menu, domyslnie main-menu
{% endcomment %}

{%- liquid
  assign subrow_menu = linklists[menu]
  if subrow_menu == blank or subrow_menu.links.size == 0
    assign subrow_menu = linklists['main-menu']
  endif

  assign current_items = ''

  unless current_tags
    for link in subrow_menu.links
      if link.active and link.levels > 0 and link.child_active == false
        unless current_items contains link.title
          render 'collection-subrow', per_row: per_row, sub_collection_links: link.links
          assign current_items = current_items | append: link.title
        endunless
      endif

      for sub_link in link.links
        if sub_link.active and sub_link.levels > 0 and sub_link.child_active == false
          unless current_items contains sub_link.title
            render 'collection-subrow', per_row: per_row, sub_collection_links: sub_link.links
            assign current_items = current_items | append: sub_link.title
          endunless
        endif

        for sub_sub_link in sub_link.links
          if sub_sub_link.active and sub_sub_link.url == sub_link.url
            unless current_items contains sub_sub_link.title
              render 'collection-subrow', per_row: per_row, parent_url: sub_link.url, sub_collection_links: sub_link.links
              assign current_items = current_items | append: sub_sub_link.title
            endunless
          elsif sub_sub_link.active and sub_sub_link.levels > 0
            unless current_items contains sub_sub_link.title
              render 'collection-subrow', per_row: per_row, sub_collection_links: sub_sub_link.links
              assign current_items = current_items | append: sub_sub_link.title
            endunless
          endif
        endfor
      endfor
    endfor
  endunless
-%}

{%- comment -%} Menu nic nie dalo - probujemy wykryc dzieci po uchwycie {%- endcomment -%}
{%- if current_items == blank and current_tags == blank and collection.handle != blank -%}
  {%- liquid
    assign child_prefix = collection.handle | append: '-'
    assign prefix_size = child_prefix.size
    assign sortable = ''

    for child in collections
      assign head = child.handle | slice: 0, prefix_size
      comment
        Kafel ma sens, gdy jest co pokazac: produkty albo chociaz zdjecie
        kolekcji. Pusta kolekcja bez zdjecia zostawialaby dziure w rzedzie.
      endcomment
      assign child_has_content = false
      if child.all_products_count > 0 or child.image != blank
        assign child_has_content = true
      endif

      if head == child_prefix and child_has_content
        assign sort_key = child.all_products_count | plus: 1000000
        assign sortable = sortable | append: sort_key | append: ':' | append: child.handle | append: ' '
      endif
    endfor

    assign sorted_rows = sortable | split: ' ' | sort | reverse

    assign child_handles = ''
    for row in sorted_rows
      assign row_handle = row | split: ':' | last
      assign child_handles = child_handles | append: row_handle | append: ','
    endfor

    assign child_handle_list = child_handles | split: ','
  -%}

  {%- if child_handle_list.size > 0 -%}
    {%- render 'collection-subrow', per_row: per_row, sub_collection_handles: child_handle_list -%}
  {%- endif -%}
{%- endif -%}
