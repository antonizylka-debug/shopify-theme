{%- comment -%}
  Rzad "Style den med" w prawej kolumnie karty produktu, pod akordeonami.
  Te same kafle co w kolekcji (sn-card), tylko z zaokraglonym zdjeciem,
  jak we wzorze z icon-amsterdam. "+" otwiera to samo okno wyboru
  rozmiaru i koloru.

  Zastepuje wczesniejsza waska karte z jednym produktem naraz i listem
  rozwijanym wariantow - wybor wariantu robi teraz okno spod "+".

  To snippet, a nie sekcja, bo ma stac WEWNATRZ kolumny z opisem.
  Sekcja renderuje sie zawsze na calej szerokosci strony i nie da sie
  jej wsunac miedzy akordeony a koniec kolumny.

  @param {object} product - ogladany produkt
  @param {object} ustawienia - section.settings sekcji karty produktu
{%- endcomment -%}

{%- comment -%}
  Co pokazac: rzeczy DO KOMPLETU z innych kategorii tej samej plci -
  do sukienki buty i dodatki, do spodni bluzki i buty itd. Kafle z kilku
  kolekcji ida na przemian. 04.10.2026 Antoni zmienil zdanie: zamiast
  bestsellerow (ktore pokazywaly kolejne sukienki) chce pasujace buty
  i torebki.

  Kolekcja wybrana recznie w ustawieniach sekcji ("Collection") wygrywa.
  Start przesuniety o id produktu, zeby rozne produkty nie mialy
  identycznego rzedu.
{%- endcomment -%}
{%- liquid
  assign ile = ustawienia.cross_count
  assign uchwyty = product.collections | map: 'handle'
  assign reczna = collections[ustawienia.cross_collection]

  if reczna != blank and reczna.products_count > 0
    assign lista = reczna.handle
  elsif uchwyty contains 'mens'
    if uchwyty contains 'mens-footwear'
      assign lista = 'mens-accessories,mens-bottoms,mens-shirts'
    elsif uchwyty contains 'mens-accessories'
      assign lista = 'mens-footwear,mens-shirts'
    elsif uchwyty contains 'mens-bottoms'
      assign lista = 'mens-shirts,mens-footwear,mens-sweaters-and-knitwear'
    elsif uchwyty contains 'mens-jackets-and-coats'
      assign lista = 'mens-sweaters-and-knitwear,mens-footwear,mens-bottoms'
    else
      assign lista = 'mens-bottoms,mens-footwear,mens-accessories'
    endif
  else
    if uchwyty contains 'womens-footwear'
      assign lista = 'womens-accessories,womens-dresses,womens-bottoms'
    elsif uchwyty contains 'womens-accessories'
      assign lista = 'womens-footwear,womens-dresses'
    elsif uchwyty contains 'womens-dresses'
      assign lista = 'womens-footwear,womens-accessories,womens-jackets-and-coats'
    elsif uchwyty contains 'womens-sets-and-one-pieces'
      assign lista = 'womens-footwear,womens-accessories,womens-jackets-and-coats'
    elsif uchwyty contains 'womens-bottoms'
      assign lista = 'womens-tops,womens-footwear,womens-sweaters-and-knitwear'
    elsif uchwyty contains 'womens-jackets-and-coats'
      assign lista = 'womens-sweaters-and-knitwear,womens-footwear,womens-dresses'
    else
      assign lista = 'womens-bottoms,womens-footwear,womens-accessories'
    endif
  endif

  assign kolekcje_x = lista | split: ','
  assign start = product.id | modulo: 25

  assign jest_co = false
  for h in kolekcje_x
    if collections[h].products_count > 0
      assign jest_co = true
    endif
  endfor
-%}

{%- if jest_co -%}
  {%- render 'sn-card-assets' -%}

  <style>
    .snx { margin-top: 30px; }
    .snx__head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 14px; margin-bottom: 14px;
    }
    .snx__title {
      margin: 0;
      font-size: 17px; font-weight: 600;
      letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.2;
    }
    .snx__nav { display: flex; gap: 6px; flex: 0 0 auto; }
    .snx__arrow {
      display: flex; align-items: center; justify-content: center;
      width: 36px; height: 34px; padding: 0;
      border: 1px solid #1c1d1d; border-radius: 4px;
      background: #ffffff; color: #1c1d1d; cursor: pointer;
      transition: opacity 0.2s ease, border-color 0.2s ease;
    }
    .snx__arrow svg { width: 8px; height: 13px; display: block; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .snx__arrow[disabled] { border-color: #e4e6ea; color: #b8b4ae; cursor: default; }

    {%- comment -%}
      Dwa kafle i skrawek trzeciego - skrawek mowi, ze rzad jedzie dalej,
      lepiej niz sama strzalka.
    {%- endcomment -%}
    .snx__track {
      display: flex; gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
    }
    .snx__track::-webkit-scrollbar { display: none; }
    .snx__track.is-drag { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; user-select: none; }
    .snx__track.is-dojezdza { scroll-snap-type: none; scroll-behavior: auto; }
    .snx__track.is-drag * { pointer-events: none; }

    .snx__item {
      flex: 0 0 calc((100% - 24px) / 2.25);
      scroll-snap-align: start;
      min-width: 0;
    }

    {%- comment -%}
      W waskiej kolumnie jedna linijka nazwy - dwie przy dwoch kafelkach
      obok siebie rozpychaja rzad w pionie bardziej niz zdjecie.
    {%- endcomment -%}
    .snx .snc__nazwa { -webkit-line-clamp: 1; }

    {%- comment -%}
      Dwa poziome przewijania w sobie: rzad i pasek zdjec w kafelku. Palec
      trafialby w zdjecia i przesuwal je zamiast rzedu. Tutaj pasek zdjec
      nie reaguje na palec - strzalki na PC dalej go przewijaja, bo
      przewijanie z kodu dziala takze przy overflow: hidden.
    {%- endcomment -%}
    .snx .snc__pas { overflow-x: hidden; }

    @media only screen and (max-width: 768px) {
      .snx__item { flex-basis: calc((100% - 12px) / 1.6); }
    }
  </style>

  <div class="snx" data-snx data-snx-produkt="{{ product.id }}" data-snx-ile="{{ ile }}">
    <div class="snx__head">
      <p class="snx__title">{{ ustawienia.cross_title }}</p>
      <div class="snx__nav">
        <button type="button" class="snx__arrow" data-snx-prev aria-label="{{ 'general.slider.previous_slide' | t }}" disabled>
          <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false"><path d="M8.5 1.5 2 8l6.5 6.5"/></svg>
        </button>
        <button type="button" class="snx__arrow" data-snx-next aria-label="{{ 'general.slider.next_slide' | t }}">
          <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false"><path d="M1.5 1.5 8 8l-6.5 6.5"/></svg>
        </button>
      </div>
    </div>

    <div class="snx__track" data-snx-track>
      {%- assign pokazane = 0 -%}
      {%- assign uzyte = ',' -%}
      {%- for i in (0..36) -%}
        {%- if pokazane >= ile -%}{%- break -%}{%- endif -%}
        {%- assign nr = i | plus: start -%}
        {%- for h in kolekcje_x -%}
          {%- if pokazane >= ile -%}{%- break -%}{%- endif -%}
          {%- assign p = collections[h].products[nr] -%}
          {%- if p == blank or p.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- unless p.available -%}{%- continue -%}{%- endunless -%}
          {%- assign znak = ',' | append: p.id | append: ',' -%}
          {%- if uzyte contains znak -%}{%- continue -%}{%- endif -%}
          {%- assign uzyte = uzyte | append: p.id | append: ',' -%}
          <div class="snx__item">
            {%- render 'sn-card', product: p, grid_item: false, rounded: true -%}
          </div>
          {%- assign pokazane = pokazane | plus: 1 -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      var ramka = document.querySelector('[data-snx]');
      if (!ramka || ramka.hasAttribute('data-snx-gotowe')) return;
      ramka.setAttribute('data-snx-gotowe', '');

      var tor = ramka.querySelector('[data-snx-track]');
      var wstecz = ramka.querySelector('[data-snx-prev]');
      var dalej = ramka.querySelector('[data-snx-next]');

      function krok() {
        var k = tor.children[0];
        return k ? k.getBoundingClientRect().width + 12 : tor.clientWidth;
      }
      function stan() {
        var maks = tor.scrollWidth - tor.clientWidth;
        wstecz.disabled = tor.scrollLeft < 4;
        dalej.disabled = tor.scrollLeft > maks - 4;
      }

      /* ---------- dojazd jak w Swiperze we wzorze: 300 ms, krzywa ease ---------- */
      function krzywa(x1, y1, x2, y2) {
        function A(a, b) { return 1 - 3 * b + 3 * a; }
        function B(a, b) { return 3 * b - 6 * a; }
        function C(a) { return 3 * a; }
        function wart(t, a, b) { return ((A(a, b) * t + B(a, b)) * t + C(a)) * t; }
        function nachyl(t, a, b) { return 3 * A(a, b) * t * t + 2 * B(a, b) * t + C(a); }
        return function (x) {
          var t = x;
          for (var i = 0; i < 5; i++) { var d = nachyl(t, x1, x2); if (d === 0) break; t -= (wart(t, x1, x2) - x) / d; }
          return wart(t, y1, y2);
        };
      }
      var EASE = krzywa(0.25, 0.1, 0.25, 1);
      var klatka = null;

      function jedzDo(cel) {
        if (klatka) cancelAnimationFrame(klatka);
        var maks = tor.scrollWidth - tor.clientWidth;
        cel = Math.max(0, Math.min(cel, maks));
        var start = tor.scrollLeft, roznica = cel - start, t0 = performance.now();
        if (Math.abs(roznica) < 1) { tor.classList.remove('is-dojezdza'); stan(); return; }
        tor.classList.add('is-dojezdza');
        klatka = requestAnimationFrame(function ruch(teraz) {
          var p = (teraz - t0) / 300;
          if (p >= 1) { tor.scrollLeft = cel; klatka = null; tor.classList.remove('is-dojezdza'); stan(); return; }
          tor.scrollLeft = start + roznica * EASE(p);
          klatka = requestAnimationFrame(ruch);
        });
      }

      wstecz.addEventListener('click', function () { jedzDo(Math.round(tor.scrollLeft / krok()) * krok() - krok()); });
      dalej.addEventListener('click', function () { jedzDo(Math.round(tor.scrollLeft / krok()) * krok() + krok()); });
      tor.addEventListener('scroll', stan, { passive: true });

      /* ---------- ciagniecie myszka ---------- */
      var trzyma = false, ruszony = false, startX = 0, startScroll = 0, ostX = 0, ostT = 0, predkosc = 0;

      tor.addEventListener('pointerdown', function (e) {
        /* Zerowane przy kazdym wcisnieciu - po przeciagnieciu zakonczonym
           poza torem zostawaloby ustawione i zjadalo nastepne klikniecie. */
        ruszony = false;
        /* Palec zostawiam przegladarce - jej przewijanie ma bezwladnosc. */
        if (e.pointerType === 'touch' || e.button !== 0) return;
        /* Klikniecie w "+" albo strzalke zdjecia to nie poczatek ciagniecia. */
        if (e.target.closest('button')) return;
        if (klatka) { cancelAnimationFrame(klatka); klatka = null; }
        trzyma = true; ruszony = false; predkosc = 0;
        startX = ostX = e.clientX; ostT = performance.now();
        startScroll = tor.scrollLeft;
      });

      tor.addEventListener('pointermove', function (e) {
        if (!trzyma) return;
        var d = e.clientX - startX;
        if (!ruszony && Math.abs(d) < 4) return;
        if (!ruszony) { ruszony = true; tor.classList.add('is-drag'); tor.setPointerCapture(e.pointerId); }
        e.preventDefault();
        var teraz = performance.now(), dt = teraz - ostT;
        if (dt > 0) { predkosc = predkosc * 0.4 + (-(e.clientX - ostX) / dt) * 0.6; ostX = e.clientX; ostT = teraz; }
        tor.scrollLeft = startScroll - d;
      });

      function koniec(e) {
        if (!trzyma) return;
        trzyma = false;
        tor.classList.remove('is-drag');
        if (e && e.pointerId !== undefined && tor.hasPointerCapture(e.pointerId)) tor.releasePointerCapture(e.pointerId);
        if (!ruszony) return;
        if (performance.now() - ostT > 90) predkosc = 0;
        var k = krok(), teraz = tor.scrollLeft / k, i;
        if (Math.abs(predkosc) > 0.35) i = predkosc > 0 ? Math.ceil(teraz) : Math.floor(teraz);
        else i = Math.round(teraz);
        jedzDo(i * k);
      }
      tor.addEventListener('pointerup', koniec);
      tor.addEventListener('pointercancel', koniec);
      tor.addEventListener('pointerleave', koniec);
      tor.addEventListener('dragstart', function (e) { e.preventDefault(); });

      /* Po przeciagnieciu nie otwieram produktu, na ktorym akurat puszczono mysz. */
      tor.addEventListener('click', function (e) {
        if (!ruszony) return;
        ruszony = false;
        e.preventDefault();
        e.stopPropagation();
      }, true);

      stan();

      /* ---------- rekomendacje Shopify (Search & Discovery) ----------
         Najpierw produkty uzupelniajace ustawione recznie w Search &
         Discovery, potem powiazane, ktore Shopify dobiera sam - az do
         pelnego rzedu, bez powtorzen. Gdy Shopify nic nie zwroci, zostaje
         to, co wyrenderowal serwer (rzeczy do kompletu). */
      var KORZEN = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var ID = ramka.getAttribute('data-snx-produkt');
      var ILE = Number(ramka.getAttribute('data-snx-ile')) || 8;

      function pobierz(intent) {
        var url = KORZEN + 'recommendations/products?section_id=sn-rekomendacje&product_id=' + ID +
          '&limit=' + ILE + '&intent=' + intent;
        return fetch(url)
          .then(function (o) { return o.ok ? o.text() : ''; })
          .then(function (t) {
            var d = new DOMParser().parseFromString(t, 'text/html');
            return Array.prototype.slice.call(d.querySelectorAll('.snx__item[data-produkt]'));
          })
          .catch(function () { return []; });
      }

      /* Tylko 'complementary' (reczne pary z Search & Discovery). 'related'
         zwracal podobne produkty - do sukienki kolejne sukienki - wiec
         odpada; bez recznych par zostaje rzad do kompletu z serwera. */
      Promise.all([pobierz('complementary')]).then(function (wyniki) {
        var widziane = {}, wybrane = [];
        wyniki[0].forEach(function (el) {
          var id = el.getAttribute('data-produkt');
          if (widziane[id] || wybrane.length >= ILE) return;
          widziane[id] = true;
          wybrane.push(el);
        });
        if (!wybrane.length) return;
        tor.innerHTML = '';
        wybrane.forEach(function (el) { tor.appendChild(document.importNode(el, true)); });
        tor.scrollLeft = 0;
        stan();
      });
    })();
  </script>
{%- endif -%}
