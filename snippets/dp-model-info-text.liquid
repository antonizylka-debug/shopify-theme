{%- comment -%}
  ============================================================================
  WSPOLNY TEKST I WYGLAD KAPSULKI "MODEL" - jedno miejsce dla wszystkich produktow.
  Zmiana tutaj zmienia kapsulke na kazdej karcie produktu.
  ============================================================================

  01.11.2026: teksty, rozmiar czcionki, kolory, zaokraglenie i ikona sa tez
  w edytorze motywu: sekcja strony produktu -> "Model fit line" (ss = section.settings).
  Ustawienie z edytora wygrywa; wartosci ponizej to zapas, gdy pole jest puste.

  TEKSTY (ponizej, w bloku liquid):
    tekst_model    - gdy produkt ma prawdziwe dane modela (wzrost, rozmiar, zrodlo)
    tekst_przyklad - gdy produkt ma tylko przykladowe wartosci
  Zmienne w tekstach:
    [height] - wzrost w cm (sama liczba, np. 174)
    [ft]     - ten sam wzrost w stopach i calach (np. 5′9″)
    [size]   - rozmiar
  Przyklad zawsze zostaje oznaczony: jesli tekst_przyklad nie zawiera slowa
  "example" ani "illustrative", na poczatek doklejany jest znacznik_przykladu.

  WYGLAD (ponizej, w <style>): zmienne --dp-fit-* - kolory, czcionka, obwodka,
  zaokraglenie, odstepy. Ikona linijki: <svg> nizej.

  Uzywane przez snippets/dp-model-info.liquid (tam decyzja, ktory tekst pokazac).

  @param {string} rodzaj    - 'model' albo 'example'
  @param {number} wzrost    - cm
  @param {string} rozmiar   - wartosc wariantu
  @param {string} section_id
  @param {object} ss        - section.settings (fit_text_model, fit_text_example, fit_font, fit_pill, fit_icon, fit_bg, fit_border, fit_color, fit_strong)
  @param {number} waga      - kg, 0 = brak (tylko prawdziwe dane modela)
  @param {string} miejsce   - 'photo' = pastylka na zdjeciu (jak hang-eleven.com), puste = linia pod rozmiarami
  @param {boolean} pelny    - tylko z miejsce 'photo': cale zdanie "Model is 166 cm (5′5″) tall and wears size S."

  PASTYLKA NA ZDJECIU (02.11.2026, Antoni): krotszy tekst, lewy dolny rog zdjecia.
    tekst_foto_model    - prawdziwe dane; [weight] = ", 62 kg" albo nic, gdy wagi nie ma
    tekst_foto_przyklad - przyklad: bez "Model is" i bez wagi, tak jak linia na zywo
  Wyglad: zmienne --dp-photo-fit-* nizej.
{%- endcomment -%}
{%- if miejsce == 'photo' -%}
  {%- liquid
    assign tekst_foto_model = 'Model is [height] cm[weight] · Wears [size]'
    assign tekst_foto_przyklad = '[height] cm · Size [size]'

    if rodzaj == 'model'
      assign szablon = tekst_foto_model
    else
      assign szablon = tekst_foto_przyklad
    endif
    assign waga_txt = ''
    if rodzaj == 'model' and waga > 0
      assign waga_txt = ', ' | append: waga | append: ' kg'
    endif
    assign rozmiar_bezp = rozmiar | escape
    assign tresc = szablon | escape | replace: '[height]', wzrost | replace: '[weight]', waga_txt | replace: '[size]', rozmiar_bezp

    comment
      pelny = cale zdanie jak w linii na zywo (strona catalog, 02.11.2026): "Model is 166 cm (5′5″) tall and wears size S."
      Z waga (tylko prawdziwe dane): "Model is 166 cm (5′5″) tall, 62 kg and wears size S."
    endcomment
    if pelny
      assign cale = wzrost | divided_by: 2.54 | round
      assign stopy = cale | divided_by: 12
      assign reszta = cale | modulo: 12
      capture ft
        echo stopy | append: '′' | append: reszta | append: '″'
      endcapture
      assign waga_pelny = ''
      if rodzaj == 'model' and waga > 0
        assign waga_pelny = ', ' | append: waga | append: ' kg'
      endif
      capture tresc
        echo 'Model is ' | append: wzrost | append: ' cm (' | append: ft | append: ') tall' | append: waga_pelny | append: ' and wears size ' | append: rozmiar_bezp | append: '.' | escape_once
      endcapture
    endif
  -%}
  <span class="dp-photo-fit" data-dp-fit="{{ rodzaj }}">{{ tresc }}</span>
  <style>
    .dp-photo-fit {
      /* ---- wyglad pastylki na zdjeciu: zmieniaj tutaj ---- */
      --dp-photo-fit-bg: rgba(239, 239, 239, 0.92);
      --dp-photo-fit-text: #1c1d1d;
      --dp-photo-fit-font-size: 12px;
      --dp-photo-fit-padding: 8px 11px;
      --dp-photo-fit-radius: 2px;
      /* --------------------------------------------------- */
      display: inline-block; max-width: 100%;
      padding: var(--dp-photo-fit-padding);
      background: var(--dp-photo-fit-bg); color: var(--dp-photo-fit-text);
      border-radius: var(--dp-photo-fit-radius);
      font-size: var(--dp-photo-fit-font-size); line-height: 1.2; letter-spacing: 0.01em;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      pointer-events: none;
    }
  </style>
{%- else -%}
{%- liquid
  assign tekst_model = 'Model is [height] cm tall and wears size [size].'
  assign tekst_przyklad = 'Illustrative fit example: [height] cm · Size [size].'
  assign znacznik_przykladu = 'Illustrative fit example: '
  if ss.fit_text_model != blank
    assign tekst_model = ss.fit_text_model
  endif
  if ss.fit_text_example != blank
    assign tekst_przyklad = ss.fit_text_example
  endif

  capture styl
    if ss.fit_font
      echo '--dp-fit-font-size:' | append: ss.fit_font | append: 'px;'
    endif
    if ss.fit_pill == false
      echo '--dp-fit-radius:6px;'
    endif
    if ss.fit_bg != blank
      echo '--dp-fit-bg:' | append: ss.fit_bg | append: ';'
    endif
    if ss.fit_border != blank
      echo '--dp-fit-border:' | append: ss.fit_border | append: ';'
    endif
    if ss.fit_color != blank
      echo '--dp-fit-text:' | append: ss.fit_color | append: ';'
    endif
    if ss.fit_strong != blank
      echo '--dp-fit-strong:' | append: ss.fit_strong | append: ';'
    endif
  endcapture

  if rodzaj == 'example'
    assign szablon = tekst_przyklad
    assign maly = tekst_przyklad | downcase
    unless maly contains 'example' or maly contains 'illustrative'
      assign szablon = znacznik_przykladu | append: tekst_przyklad
    endunless
  else
    assign szablon = tekst_model
  endif

  assign cale = wzrost | divided_by: 2.54 | round
  assign stopy = cale | divided_by: 12
  assign reszta = cale | modulo: 12
  capture ft
    echo stopy | append: '′' | append: reszta | append: '″'
  endcapture
  capture h_html
    echo '<b>' | append: wzrost | append: '</b>'
  endcapture
  assign rozmiar_bezp = rozmiar | escape
  capture s_html
    echo '<b>' | append: rozmiar_bezp | append: '</b>'
  endcapture
  assign tresc = szablon | escape | replace: '[height]', h_html | replace: '[ft]', ft | replace: '[size]', s_html
-%}
<p class="dp-fit{% if rodzaj == 'example' %} dp-fit--example{% endif %}" data-dp-fit="{{ rodzaj }}"{% if styl != blank %} style="{{ styl | strip }}"{% endif %}>
  {%- unless ss.fit_icon == false %}
  <svg class="dp-fit__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/></svg>
  {%- endunless %}
  <span class="dp-fit__text">{{ tresc }}</span>
</p>
<style>
  .dp-fit {
    /* ---- wyglad kapsulki: zmieniaj tutaj ---- */
    /* 01.11 Antoni: sam tekst z linijka, bez tla i obwodki */
    --dp-fit-bg: transparent;
    --dp-fit-border: transparent;
    --dp-fit-text: #4a4d52;
    --dp-fit-strong: #1c1d1d;
    --dp-fit-icon: #6b6f76;
    --dp-fit-font-size: 13px;
    --dp-fit-radius: 999px;
    --dp-fit-padding: 0;
    --dp-fit-gap: 8px;
    --dp-fit-margin: 12px 0 0;
    /* ------------------------------------------ */
    display: inline-flex; align-items: center; gap: var(--dp-fit-gap);
    align-self: flex-start; max-width: 100%;
    margin: var(--dp-fit-margin); padding: var(--dp-fit-padding);
    background: var(--dp-fit-bg); border: 0 solid var(--dp-fit-border); border-radius: var(--dp-fit-radius);
    color: var(--dp-fit-text); font-size: var(--dp-fit-font-size); line-height: 1.35;
  }
  .dp-fit b { color: var(--dp-fit-strong); font-weight: 600; }
  .dp-fit__icon { flex: 0 0 auto; width: 16px; height: 16px; fill: none; stroke: var(--dp-fit-icon); stroke-width: 1.5; stroke-linecap: round; }
  /* telefon: ob-pdp uklada dzieci .pdp__info - kapsulka w tym samym miejscu co rozmiary, nad "Add to cart" */
  #shopify-section-{{ section_id }} .pdp__info > .dp-fit { order: 2; margin-bottom: 14px; }
</style>
{%- endif -%}
