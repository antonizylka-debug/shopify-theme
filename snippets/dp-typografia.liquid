{%- comment -%}
  Typografia 1:1 z hang-eleven.com (zmierzone 03.11.2026, Antoni: "te same czcionki w announcement barach, headerach itd., ten sam styl").
  Aktiv Grotesk, bez pogrubien: tekst 12 px / 400 / 0.36 px, naglowki sekcji 300 (Light) bez wielkich liter,
  maly druk (karty, stopka, pasek) 10-12 px, wielkie litery, odstep 0.3-0.5 px.
  !important, bo sekcje maja wlasne style z id sekcji.
{%- endcomment -%}
<style>
  body { font-size: 12px; font-weight: 400; letter-spacing: 0.36px; line-height: 1.5; }

  /* pasek ogloszen: 10 px, wielkie litery, odstep 0.5 px */
  .announcement-arrows, .announcement-arrows * { font-size: 10px !important; line-height: 12px !important; letter-spacing: 0.5px !important; text-transform: uppercase !important; }

  /* pasek korzysci pod naglowkiem (infobar) i inne paski informacyjne */
  .usp-bar, .usp-bar * { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* naglowek: odnosniki i menu 12 px, odstep 0.36 px */
  .site-header .site-nav__link, .site-header .site-nav__link *, .site-header [class*="nav"] a, .site-header [class*="menu"] a { font-size: 14px !important; line-height: 18.2px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: capitalize !important; }
  .site-header .site-nav__link .icon, .site-header .site-nav__link svg { font-size: inherit !important; }

  /* naglowki sekcji: lekkie (300), bez wielkich liter; glowny 24 px, pozostale 18 px */
  .hero__title, .hero__title * { font-size: 24px !important; line-height: 31.2px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .section-header__title, h2.section-header__title { font-size: 18px !important; line-height: 23.4px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  @media (min-width: 769px) { .hero__title, .hero__title * { font-size: 24px !important; } }

  /* stopka: linki 10 px, tytuly kolumn 12 px, opisy 12 px - wszystko wielkimi literami z odstepem 0.3 px */
  .site-footer a, .footer a, footer a { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .footer__title, footer h2, footer h3, footer h4 { font-size: 12px !important; line-height: 14.4px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  footer p, footer li, footer span { font-size: 12px !important; line-height: 14.4px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; }
  footer a span { font-size: inherit !important; text-transform: inherit !important; }
  footer button, .footer__newsletter-btn, .footer__to-top { font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; }

  /* kafle produktow na stronie glownej, w kolekcjach i wyszukiwaniu: 10 px, wielkie litery */
  .snc__nazwa, .snc__jest, .snc__bylo, .snc__od, .snc__kolor-nazwa { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .snc__bylo { color: #939393; }
  .snc__pigulka { font-size: 10px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .snc__sale { font-size: 10px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* przyciski: 12 px, wielkie litery, odstep 0.36 px, bez pogrubienia */
  .btn, .button, button[type="submit"], .hero__cta, .hero a[class*="btn"], .snk-card__add { font-size: 12px !important; font-weight: 500 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; }
  /* nic nie jest pogrubione: kazdy element ma grubosc 400, duze naglowki 300 jak u hang-eleven (03.11.2026) */
  body *, body *::before, body *::after { font-weight: 400 !important; }
  h1, h2, h3, .hero__title, .section-header__title, .collection-banner__heading { font-weight: 300 !important; text-transform: none !important; letter-spacing: normal !important; }
  .collection-banner__heading { font-size: 24px !important; line-height: 31.2px !important; }
  .section-header__eyebrow, .collection-banner__eyebrow, .collection-banner__btn, .section-header__link--plain, .ob-usp__title { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .hero__top-subtitle .animation-contents { font-size: 10px !important; line-height: 12px !important; letter-spacing: 0.5px !important; text-transform: uppercase !important; }
  /* jedyne pogrubienia jak u hang-eleven: tytul na pasku ogloszen (700); przyciski 500, naglowki 300, reszta 400 */
  .announcement-arrows .announcement-arrows__title, .announcement-arrows strong, .announcement-arrows b { font-weight: 700 !important; }
  .btn, .button, button[type="submit"], .hero__cta, .hero a[class*="btn"], .snk-card__add { font-weight: 500 !important; }
  /* menu w naglowku (szuflada) 1:1 z hang-eleven: glowne pozycje 18 px / 400 / odstep miedzy wierszami 20 px, pomocnicze 10 px wielkimi literami */
  .mobile-nav__link:not(.mobile-nav__link--top-level), .mobile-nav__item:not(.mobile-nav__item--pomoc) > .mobile-nav__link, .mobile-nav__item:not(.mobile-nav__item--pomoc) > .mobile-nav__link * { font-size: 18px !important; line-height: 23.4px !important; letter-spacing: normal !important; text-transform: none !important; }
  .mobile-nav__item:not(.mobile-nav__item--pomoc) > .mobile-nav__link { padding: 10px 15px !important; }
  .mobile-nav__item--pomoc .mobile-nav__link, .mobile-nav__item--pomoc .mobile-nav__link * { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .mobile-nav__item--pomoc .mobile-nav__link { padding: 10px 15px !important; }
  .menu-hl__badge { font-size: 10px !important; letter-spacing: 0.3px !important; }
  .mnav__oferta-tytul, .mnav__oferta-pod, .mnav__oferta-cta { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .mnav__usp-item, .mnav__usp-item span { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  /* pasek korzysci pod naglowkiem na komputerze (10 px jak maly druk hang-eleven) */
  .ub__d { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* ---------- spojna skala pod produktem (03.11.2026, kontrola calosci): naglowki 18 px Light, tekst 12 px, maly druk 10 px ---------- */
  .rvs, .rvs *, .rvw, .rvw *, .dp-mix, .dp-mix *, .snb2, .snb2 *, .sns, .sns *, .obf, .obf *, .sne, .sne * { font-family: var(--typeBasePrimary), var(--typeBaseFallback) !important; }
  .dp-mix__title, .snb2__title, .sns__title, .obf__title, .rvw__verdict, .dp-mix__accent, .snb2__akcent { font-size: 18px !important; line-height: 23.4px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .rvw__body, .sns__text, .sns__text *, .sns__note, .obf__sub, .obf__body, .obf__body *, .obf__item, .snb2__sub, .snb2__tab, .dp-mix__tiers, .dp-mix__tiers *, .cp__acc-body, .cp__acc-body * { font-size: 12px !important; line-height: 18px !important; letter-spacing: 0.36px !important; }
  .rvw__who, .rvw__rated, .rvw__reply-head, .rvw__more { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; }
  .obf__item { text-transform: none !important; }

  /* ---------- strony (About, FAQ, Contact): ta sama skala 24 / 18 Light, tekst 12, maly druk 10 ---------- */
  .template-page h1, .ob-faqp__title { font-size: 24px !important; line-height: 31.2px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .template-page h2, .ob-faqp__contact-title, .ob-contact__h2 { font-size: 18px !important; line-height: 23.4px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .template-page main p, .template-page main li, .about-values__title, .about-values__desc, .ob-contact__tagline, .ob-contact__note, .ob-support__value, .ob-faqp__sub, .ob-faqp__nav-link, .ob-faq__q-text, .ob-faq__a, .ob-faq__a *, .template-page main strong, .template-page main td { font-size: 12px !important; line-height: 18px !important; letter-spacing: 0.36px !important; }
  .ob-faqp__eyebrow, .about-block__cta-btn { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* okruszki i strony polityk */
  .breadcrumb, .breadcrumb * { font-size: 10px !important; line-height: 13px !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .shopify-policy__title, .shopify-policy__title h1, .template-policy h1 { font-size: 24px !important; line-height: 31.2px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .shopify-policy__body, .shopify-policy__body *, .rte p, .rte li { font-size: 12px !important; line-height: 18px !important; letter-spacing: 0.36px !important; }
</style>
