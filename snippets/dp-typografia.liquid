{%- comment -%}
  Typografia 1:1 z hang-eleven.com (zmierzone 03.11.2026, Antoni: "te same czcionki w announcement barach, headerach itd., ten sam styl").
  Aktiv Grotesk, bez pogrubien: tekst 12 px / 400 / 0.36 px, naglowki sekcji 300 (Light) bez wielkich liter,
  maly druk (karty, stopka, pasek) 10-12 px, wielkie litery, odstep 0.3-0.5 px.
  !important, bo sekcje maja wlasne style z id sekcji.
{%- endcomment -%}
<style>
  body { font-size: 12px; font-weight: 400; letter-spacing: 0.36px; line-height: 1.5; }

  /* pasek ogloszen: 10 px, wielkie litery, odstep 0.5 px */
  .announcement-arrows, .announcement-arrows * { font-size: 10px !important; line-height: 12px !important; font-weight: 400 !important; letter-spacing: 0.5px !important; text-transform: uppercase !important; }

  /* pasek korzysci pod naglowkiem (infobar) i inne paski informacyjne */
  .usp-bar, .usp-bar * { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* naglowek: odnosniki i menu 12 px, odstep 0.36 px */
  .site-header .site-nav__link, .site-header .site-nav__link *, .site-header [class*="nav"] a, .site-header [class*="menu"] a { font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: none !important; }
  .site-header .site-nav__link .icon, .site-header .site-nav__link svg { font-size: inherit !important; }

  /* naglowki sekcji: lekkie (300), bez wielkich liter; glowny 24 px, pozostale 18 px */
  .hero__title, .hero__title * { font-size: 24px !important; line-height: 31.2px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  .section-header__title, h2.section-header__title { font-size: 18px !important; line-height: 23.4px !important; font-weight: 300 !important; letter-spacing: normal !important; text-transform: none !important; }
  @media (min-width: 769px) { .hero__title, .hero__title * { font-size: 24px !important; } }

  /* stopka: linki 10 px, tytuly kolumn 12 px, opisy 12 px - wszystko wielkimi literami z odstepem 0.3 px */
  .site-footer a, .footer a, footer a { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .footer__title, footer h2, footer h3, footer h4 { font-size: 12px !important; line-height: 14.4px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  footer p, footer li, footer span { font-size: 12px !important; line-height: 14.4px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; }
  footer a span { font-size: inherit !important; text-transform: inherit !important; }
  footer button, .footer__newsletter-btn, .footer__to-top { font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; }

  /* kafle produktow na stronie glownej, w kolekcjach i wyszukiwaniu: 10 px, wielkie litery */
  .snc__nazwa, .snc__jest, .snc__bylo, .snc__od, .snc__kolor-nazwa { font-size: 10px !important; line-height: 13px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .snc__bylo { color: #939393; }
  .snc__pigulka { font-size: 10px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }
  .snc__sale { font-size: 10px !important; font-weight: 400 !important; letter-spacing: 0.3px !important; text-transform: uppercase !important; }

  /* przyciski: 12 px, wielkie litery, odstep 0.36 px, bez pogrubienia */
  .btn, .button, button[type="submit"], .hero__cta, .hero a[class*="btn"], .snk-card__add { font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; }
</style>
