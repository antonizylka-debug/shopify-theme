      var b = document.createElement('button');
      b.type = 'button'; b.className = 'dp-filterbtn';
      b.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M1 4h14M1 8h14M1 12h14"/><circle cx="10.5" cy="4" r="1.6" fill="#fff"/><circle cx="5.5" cy="8" r="1.6" fill="#fff"/><circle cx="9" cy="12" r="1.6" fill="#fff"/></svg><span>Filter</span>';
      row.appendChild(b);
      var head = document.createElement('div'); head.className = 'dp-fhead';
