<script>
  (function () {
    var h = document.documentElement;
    function mobile() { return window.matchMedia("(max-width: 768px)").matches; }
    function ikona() {
      var s = '', r, c;
      for (r = 0; r < 3; r++) for (c = 0; c < 3; c++) s += '<rect x="' + (c * 6) + '" y="' + (r * 6) + '" width="4.4" height="4.4" fill="currentColor"/>';
      return '<svg viewBox="0 0 17 17">' + s + '</svg>';
    }
    function stan() {
      var v = null;
      try { v = parseInt(localStorage.getItem(mobile() ? "dp-cols-m" : "dp-cols-d"), 10); } catch (e) {}
      if (mobile()) return v === 1 ? 1 : 2;
      return v === 6 || v === 8 ? v : 4;
    }
    function ustaw(n, zapisz) {
      h.classList.remove("dp-cols-1", "dp-cols-6", "dp-cols-8");
      if (n === 1 || n === 6 || n === 8) h.classList.add("dp-cols-" + n);
      var b = document.querySelector(".dp-gridbtn");
      if (b) b.innerHTML = ikona();
      if (zapisz) { try { localStorage.setItem(mobile() ? "dp-cols-m" : "dp-cols-d", String(n)); } catch (e) {} }
    }
    function start() {
      if (!document.body.classList.contains("template-collection")) return;
      var box = document.querySelector(".collection-links-row__sort");
      if (!box || box.querySelector(".dp-gridbtn")) return;
      var b = document.createElement("button");
      b.type = "button"; b.className = "dp-gridbtn"; b.setAttribute("aria-label", "Change number of products per row");
      b.addEventListener("click", function () {
        var n = stan();
        var nx = mobile() ? (n === 2 ? 1 : 2) : (n === 4 ? 6 : n === 6 ? 8 : 4);
        ustaw(nx, true);
      });
      box.insertBefore(b, box.firstChild);
      ustaw(stan(), false);
      window.addEventListener("resize", function () { ustaw(stan(), false); });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
  })();
</script>
