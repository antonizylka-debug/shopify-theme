<script>
  /* cienkie kreski postepu pod rzedami produktow na telefonie (jak u hang-eleven): tyle kresek, ile "stron" przewijania */
  (function () {
    function buduj(w) {
      if (w.__dpSeg) return;
      var bar = document.createElement('div');
      bar.className = 'dp-seg';
      bar.setAttribute('aria-hidden', 'true');
      w.parentNode.insertBefore(bar, w.nextSibling);
      w.__dpSeg = bar;
      function odswiez() {
        var max = w.scrollWidth - w.clientWidth;
        if (max < 4) { bar.hidden = true; return; }
        bar.hidden = false;
        var stron = Math.max(2, Math.ceil(w.scrollWidth / w.clientWidth));
        if (bar.children.length !== stron) {
          bar.innerHTML = '';
          for (var i = 0; i < stron; i++) bar.appendChild(document.createElement('span'));
        }
        var akt = Math.round((w.scrollLeft / max) * (stron - 1));
        Array.prototype.forEach.call(bar.children, function (s, i) { s.classList.toggle('is-on', i === akt); });
      }
      w.addEventListener('scroll', odswiez, { passive: true });
      window.addEventListener('resize', odswiez);
      odswiez();
      setTimeout(odswiez, 800);
    }
    function start() {
      Array.prototype.forEach.call(document.querySelectorAll('[id*="featured_picks"] .grid-overflow-wrapper, [id*="featured_men"] .grid-overflow-wrapper, [id*="our_favourites"] .grid-overflow-wrapper'), buduj);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
    window.addEventListener('load', start);
  })();
</script>
