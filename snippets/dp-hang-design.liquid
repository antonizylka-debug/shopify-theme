{%- comment -%}
  Wyglad 1:1 z hang-eleven.com (zmierzone 03.11.2026, Antoni: "design, wyglad, grubosc scianek... spojnosc i minimalizm").
  Tylko styl - tresci sie nie zmieniaja. Zasady hang-eleven:
  - biale tlo, czarny tekst, cienkie linie #E5E5E5, zero zaokraglen,
  - zdjecia od krawedzi do krawedzi, bez odstepow miedzy bannerami,
  - boczne marginesy tekstu 15 px,
  - male czarne przyciski 32 px (10 px / 500 / wielkie litery),
  - naglowek sekcji 18 px Light, napisy na zdjeciach wysrodkowane.
  Reguly stoja po custom-styles i dp-typografia, wiec wygrywaja przez !important tylko tam, gdzie sekcje maja wlasne style.
{%- endcomment -%}
<style>
  :root { --dp-gutter: 15px; --dp-line: #e5e5e5; }

  /* zero zaokraglen na przyciskach, polach i kafelkach */
  .btn, .button, button[type="submit"], input[type="text"], input[type="email"], input[type="search"], input[type="password"], select, textarea,
  .snc__foto, .snc__pas, .collection-banner, .collection-banner__btn, .site-footer .btn { border-radius: 0 !important; }

  /* boczne marginesy 15 px jak u nich */
  .page-width { padding-left: var(--dp-gutter) !important; padding-right: var(--dp-gutter) !important; }
  @media (max-width: 768px) { .page-width--flush-small { padding-left: 0 !important; padding-right: 0 !important; } }

  /* hero na caly ekran (u nich pelna wysokosc okna pod naglowkiem), bez bocznych marginesow */
  .index-section--hero .page-width { padding-left: 0 !important; padding-right: 0 !important; max-width: none !important; }
  @media (max-width: 768px) {
    .index-section--hero, .index-section--hero .page-width, .index-section--hero [class*="slideshow"] { min-height: calc(100svh - 86px) !important; height: calc(100svh - 86px) !important; }
  }

  /* male czarne przyciski: 32 px, 10 px / 500 / wielkie litery */
  .btn:not(.btn--full):not([class*="cart"]):not(.snk-card__add):not(.cp__atc) { min-height: 32px; padding: 9px 12px !important; font-size: 10px !important; line-height: 12px !important; letter-spacing: 0.36px !important; font-weight: 500 !important; text-transform: uppercase !important; }
  .collection-banner__btn { padding: 9px 12px !important; font-size: 10px !important; letter-spacing: 0.36px !important; }

  /* banery kolekcji: od krawedzi do krawedzi, jeden pod drugim, bez przerw, napis na srodku (18 px Light) */
  .shopify-section .page-width:has(> .collection-banners) { padding-left: 0 !important; padding-right: 0 !important; max-width: none !important; }
  .collection-banners { gap: 0 !important; margin: 0 !important; }
  .collection-banner { margin: 0 !important; }
  @media (max-width: 768px) {
    .collection-banners { display: block !important; }
    .collection-banner { display: block !important; width: 100% !important; height: auto !important; min-height: calc(100vw * 482 / 375) !important; }
    .collection-banner image-element, .collection-banner img { display: block; width: 100% !important; height: calc(100vw * 482 / 375) !important; object-fit: cover; }
  }
  .collection-banner__content { display: flex !important; flex-direction: column; align-items: center !important; justify-content: center !important; text-align: center !important; inset: 0; padding: 0 var(--dp-gutter) !important; }
  .collection-banner__heading { font-size: 18px !important; line-height: 23.4px !important; }
  .collection-banner__eyebrow { margin-bottom: 6px; }

  /* sekcje z produktami: tytul po lewej z marginesem 15 px, mniejsze odstepy pionowe, bez zaokraglen */
  .section-header { padding-left: 0; padding-right: 0; margin-bottom: 12px !important; }
  .section-header__title { text-align: left; }
  .index-section { margin-top: 24px !important; margin-bottom: 24px !important; }

  /* stopka: biala, wyrownana do lewej, cienkie linie miedzy blokami */
  .site-footer { background: #fff !important; color: #000 !important; border-top: 1px solid var(--dp-line); text-align: left !important; }
  .site-footer .footer__item--brand, .site-footer .footer__brand-text, .site-footer .footer__title, .site-footer .footer__collapsible, .site-footer .grid__item { text-align: left !important; }
  .site-footer .footer__title.collapsible-trigger { border-top: 1px solid var(--dp-line); }
  .site-footer a { text-decoration: none; }

  /* naglowek: cienka linia pod spodem jak u nich */
  .site-header { border-bottom: 1px solid var(--dp-line); box-shadow: none !important; }

  /* karty produktow: zdjecie bez zaokraglen i bez ramki */
  .snc { border: 0 !important; box-shadow: none !important; }
  .site-footer, .site-footer ul, .site-footer li, .site-footer a, .site-footer p, .site-footer div { text-align: left !important; justify-content: flex-start; }

  /* rzad kategorii (40 px) podniosl naglowek: filtry w kolekcji maja sie przyklejac pod nim, nie pod nim zagubione */
  @media (min-width: 769px) {
    .collection-sidebar, .grid__item:has(> .collection-sidebar), .grid__item:has(.collection-sidebar) { top: 174px !important; }
  }
</style>
<style>
  /* ==== Strona produktu pod zdjeciami i stopka w stylu hang-eleven (03.11.2026, Antoni: "wszystko ladnie dopracowane, minimalizm") ====
     Tylko wyglad, tresci bez zmian: naglowki po lewej z marginesem 15 px, zdjecia i slidery od krawedzi do krawedzi z odstepem 2 px,
     cienkie linie #e5e5e5, zero zaokraglen i cieni, male czarne przyciski. */

  /* naglowki sekcji pod produktem: po lewej, 15 px od krawedzi */
  .dp-mix__head, .rvw__head, .rvw__top, .snb2__head, .obf__inner > .obf__eyebrow, .obf__title, .obf__sub { text-align: left !important; padding-left: var(--dp-gutter); padding-right: var(--dp-gutter); }
  .dp-mix__head, .rvw__head { margin-bottom: 14px !important; }
  .dp-mix, .rvw, .sns, .obf, .snb2, .sne { border-radius: 0 !important; box-shadow: none !important; }

  /* baner z promocja (sne): zdjecie od krawedzi do krawedzi, tekst na srodku, maly czarny przycisk jak w hero */
  .sne { margin: 0 !important; }
  .sne__txt, .sne__over { display: flex !important; flex-direction: column; align-items: center !important; justify-content: center !important; text-align: center !important; padding: 0 var(--dp-gutter) !important; }
  .sne__tytul { font-size: 24px !important; line-height: 31.2px !important; }
  .sne__btn { width: auto !important; min-height: 32px; padding: 9px 12px !important; background: #000 !important; color: #fff !important; border: 0 !important; border-radius: 0 !important; font-size: 10px !important; font-weight: 500 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; }

  /* mix & match: plaski rzad warunkow z cienkimi liniami zamiast pastylek */
  .dp-mix { padding-left: 0 !important; padding-right: 0 !important; }
  .dp-mix__tiers { display: flex; justify-content: flex-start; gap: 0 !important; padding: 0 var(--dp-gutter); }
  .dp-mix__tiers > * { padding: 0 14px 0 0; }
  .dp-mix__subtitle { padding: 0 var(--dp-gutter); text-align: left !important; }

  /* slidery z kartami: bez odstepow, od krawedzi do krawedzi (2 px jak linie miedzy zdjeciami) */
  .dp-mix__track, .sno__track, .snb2__track { gap: 2px !important; }
  .dp-mix__track { padding-left: 0 !important; padding-right: 0 !important; }

  /* gwarancja zwrotu (sns): tekst po lewej, bez ramek */
  .sns__body { text-align: left !important; padding-left: var(--dp-gutter) !important; padding-right: var(--dp-gutter) !important; }
  .sns__media, .sns__media img { border-radius: 0 !important; }

  /* opinie: plaskie karty z cienka linia */
  .rvw__card, .rvs__card, [class*="rvw__card"], [class*="rvs__card"] { background: #fff !important; border: 1px solid var(--dp-line) !important; border-radius: 0 !important; box-shadow: none !important; }
  .rvw__reply, .rvs__reply { border-left: 0 !important; border-top: 1px solid var(--dp-line); border-radius: 0 !important; background: transparent !important; padding-left: 0 !important; }

  /* FAQ pod produktem: wiersze z cienkimi liniami */
  .obf__item { border-top: 1px solid var(--dp-line) !important; border-bottom: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; padding-left: 0; padding-right: 0; }
  .obf__inner { padding-left: 0; padding-right: 0; }

  /* stopka na telefonie jak u nich: jedna kolumna, rozwijane bloki z "+" */
  @media (max-width: 768px) {
    .site-footer .grid { display: block !important; margin-left: 0 !important; }
    .site-footer .grid__item { width: 100% !important; padding-left: var(--dp-gutter) !important; padding-right: var(--dp-gutter) !important; float: none !important; }
    .site-footer .footer__title.small--hide { display: none !important; }
    .site-footer .footer__title.collapsible-trigger[aria-expanded="true"]::after { content: "2"; }
    .site-footer .footer__title.collapsible-trigger .collapsible-trigger__icon { display: none !important; }
    .site-footer .site-footer__linklist a, .site-footer .footer__collapsible a { justify-content: flex-start !important; min-height: 0 !important; }
    .site-footer button.footer__title.collapsible-trigger { display: flex !important; justify-content: space-between; align-items: center; width: 100%; padding: 17px 0; border: 0; border-top: 1px solid var(--dp-line); background: none; color: #000; font-size: 12px !important; font-weight: 400 !important; letter-spacing: 0.36px !important; text-transform: uppercase !important; text-align: left; }
    .site-footer button.footer__title.collapsible-trigger::after { content: '+'; font-size: 12px; }
    .site-footer .footer__item--menu_shop, .site-footer .footer__item--menu_help, .site-footer .footer__item--menu_policies { padding-top: 0 !important; padding-bottom: 0 !important; margin: 0 !important; }
    .site-footer .footer__collapsible a { display: block; padding: 8px 0; }
  }
</style>
