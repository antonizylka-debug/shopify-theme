<script>
  /* numer produktow w czarnym kolku przy koszyku w naglowku (bez pozycji "Order Add-on" czyli ochrony dostawy) */
  (function () {
    function ustaw(n) {
      Array.prototype.forEach.call(document.querySelectorAll('.cart-link__bubble'), function (b) { b.textContent = n > 0 ? String(n) : ''; });
    }
    function wczytaj() {
      fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (c) {
        var n = 0;
        (c.items || []).forEach(function (it) { if (it.product_type !== 'Order Add-on') n += it.quantity; });
        ustaw(n);
      }).catch(function () {});
    }
    var t;
    function wkrotce() { clearTimeout(t); t = setTimeout(wczytaj, 700); }
    wczytaj();
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-cp-atc], [name="add"], .snc__plus, [data-snk-remove], [data-snq-dodaj], .snk-item, .snq__dodaj')) wkrotce();
    }, true);
    var b = document.querySelector('.cart-link__bubble');
    if (b && window.MutationObserver) new MutationObserver(wkrotce).observe(b, { attributes: true, attributeFilter: ['class'] });
    var d = document.getElementById('CartDrawer');
    if (d && window.MutationObserver) new MutationObserver(wkrotce).observe(d, { childList: true, subtree: true });
  })();
</script>
