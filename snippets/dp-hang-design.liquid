      var over = document.createElement('div'); over.className = 'dp-fover';
      side.insertBefore(head, side.firstChild); side.appendChild(foot); document.body.appendChild(over); document.body.appendChild(side);
      var h = document.documentElement;
      function open() { h.classList.add('dp-filter-open'); }
      function close() { h.classList.remove('dp-filter-open'); }
      b.addEventListener('click', open);
