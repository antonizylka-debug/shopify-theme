{%- comment -%}
  Kapsulka z informacja o modelu pod wyborem rozmiaru, nad "Add to cart" (31.10 / 01.11.2026).
  TU tylko decyzja, CO pokazac. Teksty i wyglad: snippets/dp-model-info-text.liquid.

  Pokazuje sie tylko przy produkcie z custom.has_model_photo = true i z opcja rozmiaru.

  1. Prawdziwe dane modela ("Model is ..."), gdy sa wszystkie:
       custom.model_height_cm    (integer, 140-210)
       custom.model_size         (musi byc wariantem; XXL = 2XL, Small = S ...)
       custom.model_data_source  (skad dane - opis dostawcy, karta sesji...)
  2. W przeciwnym razie przyklad ("Illustrative fit example: ..."), gdy sa:
       custom.fit_example_height_cm  (integer, 140-210)
       custom.fit_example_size       (musi byc wariantem)
     Przyklady sa w osobnych polach - nigdy nie mieszaja sie z prawdziwymi danymi.
  Po wpisaniu prawdziwych pomiarow i zrodla produkt sam przechodzi na "Model is ...".
  Brak danych / rozmiar spoza wariantow = nic.
  Buty (typ produktu z listy dp_typy_butow) = nic - wzrost modela nic nie mowi o rozmiarze buta (Antoni, 01.11).

  Waga (02.11.2026): custom.model_weight_kg (40-150), tylko przy prawdziwych danych modela.
  Przy przykladzie wagi nie ma nigdy - nie zgadujemy wagi konkretnej osoby.

  @param {string} section_id
  @param {string} miejsce - 'photo' = pastylka na zdjeciu (ob-pdp, galeria); puste = linia pod rozmiarami
  @param {boolean} pelny  - tylko z 'photo': cale zdanie "Model is 166 cm (5′5″) tall and wears size S." (strona catalog)
  @param {object} ss - section.settings z ob-pdp (teksty i wyglad, sekcja "Model fit line")
{%- endcomment -%}
{%- liquid
  assign dp_photo = product.metafields.custom.has_model_photo.value

  assign dp_size_opt = nil
  for opt in product.options_with_values
    assign dp_name = opt.name | downcase
    if dp_name contains 'size' or dp_name contains 'størrelse'
      assign dp_size_opt = opt
      break
    endif
  endfor

  assign dp_typy_butow = 'sandals,sneakers,heels,boots,loafers,dress shoes,slides,mules,espadrilles,clogs,flats,slippers,shoes,trainers,flip flops' | split: ','
  assign dp_typ = product.type | downcase | strip
  assign dp_but = false
  if dp_typy_butow contains dp_typ
    assign dp_but = true
  endif

  assign dp_rodzaj = ''
  if dp_photo == true and dp_size_opt and dp_but == false
    assign dp_h = product.metafields.custom.model_height_cm.value | times: 1
    assign dp_zrodlo = product.metafields.custom.model_data_source.value | strip
    assign dp_ex_h = product.metafields.custom.fit_example_height_cm.value | times: 1

    comment
      Dopasowanie rozmiaru do wariantu dla obu rodzajow danych naraz:
      indeks 0 = prawdziwy rozmiar modela, 1 = przyklad.
    endcomment
    assign dp_szukane = product.metafields.custom.model_size.value | strip | append: '|' | append: product.metafields.custom.fit_example_size.value | split: '|'
    for szukany in dp_szukane
      assign dp_want = szukany | upcase | remove: ' ' | remove: '-'
      case dp_want
        when 'XXL', 'DOUBLEEXTRALARGE'
          assign dp_want = '2XL'
        when 'XXXL'
          assign dp_want = '3XL'
        when 'SMALL'
          assign dp_want = 'S'
        when 'MEDIUM'
          assign dp_want = 'M'
        when 'LARGE'
          assign dp_want = 'L'
        when 'XSMALL', 'EXTRASMALL'
          assign dp_want = 'XS'
        when 'XLARGE', 'EXTRALARGE'
          assign dp_want = 'XL'
      endcase
      assign dp_match = ''
      if dp_want != blank
        for val in dp_size_opt.values
          assign dp_v = val | upcase | remove: ' ' | remove: '-'
          case dp_v
            when 'XXL', 'DOUBLEEXTRALARGE'
              assign dp_v = '2XL'
            when 'XXXL'
              assign dp_v = '3XL'
            when 'SMALL'
              assign dp_v = 'S'
            when 'MEDIUM'
              assign dp_v = 'M'
            when 'LARGE'
              assign dp_v = 'L'
            when 'XSMALL', 'EXTRASMALL'
              assign dp_v = 'XS'
            when 'XLARGE', 'EXTRALARGE'
              assign dp_v = 'XL'
          endcase
          if dp_v == dp_want
            assign dp_match = val
            break
          endif
        endfor
      endif
      if forloop.index == 1
        assign dp_real_size = dp_match
      else
        assign dp_ex_size = dp_match
      endif
    endfor

    if dp_h >= 140 and dp_h <= 210 and dp_real_size != blank and dp_zrodlo != blank
      assign dp_rodzaj = 'model'
      assign dp_waga = product.metafields.custom.model_weight_kg.value | times: 1
      if dp_waga < 40 or dp_waga > 150
        assign dp_waga = 0
      endif
    elsif dp_ex_h >= 140 and dp_ex_h <= 210 and dp_ex_size != blank
      assign dp_rodzaj = 'example'
    endif
  endif
-%}
{%- if dp_rodzaj == 'model' -%}
  {%- render 'dp-model-info-text', rodzaj: 'model', wzrost: dp_h, rozmiar: dp_real_size, waga: dp_waga, miejsce: miejsce, pelny: pelny, section_id: section_id, ss: ss -%}
{%- elsif dp_rodzaj == 'example' -%}
  {%- render 'dp-model-info-text', rodzaj: 'example', wzrost: dp_ex_h, rozmiar: dp_ex_size, waga: 0, miejsce: miejsce, pelny: pelny, section_id: section_id, ss: ss -%}
{%- endif -%}
