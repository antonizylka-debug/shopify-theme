{%- comment -%}
  "Complete the look" pod przyciskiem "Add to bag" (brief AOV, 31.10.2026).
  Ogladany produkt + 3 rzeczy do kompletu (te same typy co "Style it with":
  sn-komplet-typy, karty z sections/sn-kurv-kort). Klientka zaznacza, co chce,
  wybiera rozmiar i jednym przyciskiem dodaje wszystko do koszyka.

  - Nic nie jest zaznaczone samo z siebie poza ogladanym produktem - bez zgody
    klientki nic nie trafia do koszyka (zasada z briefu).
  - Cena "z rabatem" liczy progi z ustawien sekcji (promo_tiers, np. "2:10,3:20,4:25,5:30")
    od liczby sztuk w koszyku + zaznaczonych. Rabat naliczaja automatyczne rabaty
    w panelu - progi w sekcji musza byc z nimi zgodne.
  - Produkty pobierane po zaladowaniu strony (/products/<handle>.js); gdy nic nie
    przyjdzie, modul sie nie pokazuje.

  @param {object} product - ogladany produkt
  @param {string} sekcja - section.id karty produktu (stamtad bierzemy wybrany wariant)
  @param {string} progi - section.settings.promo_tiers
{%- endcomment -%}
{%- liquid
  assign typ = ''
  assign dzial = 'womens'
  for tag in product.tags
    if tag contains 'Product Type: '
      assign typ = tag | remove: 'Product Type: ' | strip
      break
    endif
  endfor
  if product.tags contains 'Department: Men'
    unless product.tags contains 'Department: Women'
      assign dzial = 'mens'
    endunless
  endif
  capture cele
    render 'sn-komplet-typy', typ: typ, dzial: dzial
  endcapture
  assign cele = cele | strip | split: ','
  assign elegancko = false
  if dzial == 'womens'
    case typ
      when 'Dresses', 'Jumpsuits', 'Matching Sets', 'Playsuits & Rompers'
        assign elegancko = true
    endcase
  endif
  assign zrodla = ''
  for c in cele
    assign tag_c = 'Product Type: ' | append: c | handle
    assign zrodla = zrodla | append: routes.collections_url | append: '/' | append: dzial | append: '/' | append: tag_c | append: '|'
  endfor
-%}
{%- if zrodla != blank and product.type != 'Order Add-on' -%}
<style>
  .dp-look { margin: 28px 0 4px; padding: 14px 14px 12px; border: 1px solid #e4e6ea; border-radius: 8px; }
  .dp-look[hidden] { display: none; }
  .dp-look__head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 10px; }
  .dp-look__title { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .dp-look__hint { margin: 0; font-size: 12px; color: #6b1f2d; font-weight: 600; text-align: right; }
  .dp-look__list { list-style: none; margin: 0; padding: 0; }
  .dp-look__item { display: grid; grid-template-columns: 22px 52px minmax(0, 1fr); gap: 10px; align-items: center; padding: 8px 0; border-top: 1px solid #f0f1f3; }
  .dp-look__item:first-child { border-top: 0; padding-top: 2px; }
  .dp-look__checkbox { width: 18px; height: 18px; margin: 0; accent-color: #1c1d1d; cursor: pointer; }
  .dp-look__checkbox:disabled { cursor: default; }
  .dp-look__img { display: block; width: 52px; height: 68px; border-radius: 4px; overflow: hidden; background: #f6f6f4; }
  .dp-look__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dp-look__info { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .dp-look__name { font-size: 13px; line-height: 1.3; color: inherit; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dp-look__name b { font-weight: 600; }
  .dp-look__row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .dp-look__price { font-size: 13px; font-weight: 600; white-space: nowrap; }
  .dp-look__select { max-width: 130px; height: 30px; padding: 0 26px 0 8px; font-size: 12.5px; border: 1px solid #c9cbcf; border-radius: 4px; background-color: #fff; }
  .dp-look__select.is-err { border-color: #6b1f2d; }
  .dp-look__options { font-size: 12px; color: #6b6f76; }
  .dp-look__summary { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 10px 0 10px; padding-top: 10px; border-top: 1px solid #e4e6ea; font-size: 13px; }
  .dp-look__summary s { color: #6b6f76; margin-right: 6px; font-weight: 400; }
  .dp-look__summary b { font-size: 15px; }
  .dp-look__save { color: #6b1f2d; font-weight: 600; }
  .dp-look__button { width: 100%; min-height: 46px; border: 1px solid #1c1d1d; background: #fff; color: #1c1d1d; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; border-radius: 0; }
  .dp-look__button:hover:not([disabled]) { background: #1c1d1d; color: #fff; }
  .dp-look__button[disabled] { opacity: .55; cursor: default; }
  .dp-look__error { margin: 8px 0 0; font-size: 12.5px; color: #6b1f2d; }
  .dp-look__error[hidden] { display: none; }
</style>
<div class="dp-look" data-dp-look data-dp-look-section="{{ sekcja }}" data-dp-look-sources="{{ zrodla | escape }}" data-dp-look-tiers="{{ progi | escape }}" data-dp-look-pid="{{ product.id }}" data-dp-look-handle="{{ product.handle }}"{% if elegancko %} data-dp-look-formal{% endif %} hidden>
  <div class="dp-look__head">
    <p class="dp-look__title">Complete the look</p>
    <p class="dp-look__hint" data-dp-look-hint></p>
  </div>
  <ul class="dp-look__list" data-dp-look-list>
    <li class="dp-look__item" data-dp-look-main>
      <input type="checkbox" class="dp-look__checkbox" checked disabled aria-label="This item">
      <span class="dp-look__img">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
      <span class="dp-look__info">
        <span class="dp-look__name"><b>This item:</b> {{ product.title | escape }}</span>
        <span class="dp-look__row"><span class="dp-look__price" data-dp-look-main-price></span><span class="dp-look__options" data-dp-look-main-options></span></span>
      </span>
    </li>
  </ul>
  <div class="dp-look__summary" aria-live="polite">
    <span data-dp-look-count></span>
    <span><s data-dp-look-old hidden></s><b data-dp-look-total></b></span>
  </div>
  <button type="button" class="dp-look__button" data-dp-look-add>Add selected to bag</button>
  <p class="dp-look__error" data-dp-look-error role="alert" hidden></p>
</div>
<script>
  (function () {
    var ramka = document.querySelector('[data-dp-look]:not([data-dp-look-ready])');
    if (!ramka) return;
    ramka.setAttribute('data-dp-look-ready', '');
    var KORZEN = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var sekcja = document.getElementById('shopify-section-' + ramka.getAttribute('data-dp-look-section'));
    var lista = ramka.querySelector('[data-dp-look-list]');
    var przycisk = ramka.querySelector('[data-dp-look-add]');
    var blad = ramka.querySelector('[data-dp-look-error]');
    var PID = ramka.getAttribute('data-dp-look-pid');
    var elegancko = ramka.hasAttribute('data-dp-look-formal');
    var wKoszyku = 0;

    var PROGI = (ramka.getAttribute('data-dp-look-tiers') || '').split(',').map(function (p) {
      var a = p.split(':'); return [Number(a[0]), Number(a[1])];
    }).filter(function (p) { return p[0] > 0 && p[1] > 0; }).sort(function (a, b) { return b[0] - a[0]; });
    function rabat(n) { for (var i = 0; i < PROGI.length; i++) if (n >= PROGI[i][0]) return PROGI[i][1]; return 0; }
    function nastepny(n) {
      var r = PROGI.slice().reverse();
      for (var i = 0; i < r.length; i++) if (r[i][0] > n) return r[i];
      return null;
    }
    function cena(gr) {
      if (window.snCena) return window.snCena(gr, function (g) {
        return window.theme && theme.Currency && theme.settings ? theme.Currency.formatMoney(g, theme.settings.moneyFormat) : '$' + (g / 100).toFixed(2);
      });
      return '$' + (gr / 100).toFixed(2);
    }

    /* wariant wybrany w glownym formularzu karty produktu. JSON wariantow stoi w sekcji
       PO tym skrypcie - czytamy go przy pierwszym uzyciu, nie od razu. */
    var warianty = null;
    function glowny() {
      if (!warianty) {
        try { warianty = JSON.parse(sekcja.querySelector('[data-pdp-variants]').textContent); } catch (e) { return null; }
      }
      var pole = sekcja && sekcja.querySelector('[data-pdp-id]');
      var id = pole ? Number(pole.value) : 0;
      return warianty.filter(function (v) { return v.id === id; })[0] || null;
    }

    function przelicz() {
      odswiezKolor();
      var g = glowny();
      var suma = 0, n = 0;
      if (g) {
        suma += g.price; n++;
        ramka.querySelector('[data-dp-look-main-price]').textContent = cena(g.price);
        ramka.querySelector('[data-dp-look-main-options]').textContent = g.title === 'Default Title' ? '' : g.title;
      }
      lista.querySelectorAll('[data-dp-look-item]').forEach(function (li) {
        if (!li.querySelector('.dp-look__checkbox').checked) return;
        var v = wariantX(li);
        suma += v ? v.price : li.__snz.p.price;
        n++;
      });
      var r = rabat(wKoszyku + n);
      var stara = ramka.querySelector('[data-dp-look-old]');
      ramka.querySelector('[data-dp-look-count]').innerHTML = n + (n === 1 ? ' item' : ' items') + (r ? ' · <span class="dp-look__save">−' + r + '% in cart</span>' : '');
      ramka.querySelector('[data-dp-look-total]').textContent = cena(Math.round(suma * (100 - r) / 100));
      stara.hidden = !r;
      stara.textContent = r ? cena(suma) : '';
      var nx = nastepny(wKoszyku + n);
      ramka.querySelector('[data-dp-look-hint]').textContent = nx ? 'Add ' + (nx[0] - wKoszyku - n) + ' more → −' + nx[1] + '%' : '';
      przycisk.textContent = n > 1 ? 'Add ' + n + ' items to bag' : 'Add selected to bag';
    }

    function wariantX(li) {
      var p = li.__snz.p;
      if (p.variants.length === 1) return p.variants[0].available ? p.variants[0] : null;
      var wybor = Array.prototype.map.call(li.querySelectorAll('.dp-look__select'), function (s) { return s.value; });
      if (wybor.indexOf('') >= 0) return null;
      return p.variants.filter(function (v) {
        return v.available && v.options.every(function (o, i) { return o === wybor[i]; });
      })[0] || null;
    }

    /* "Love the fit? Try another shade" - ten sam produkt w innym kolorze, jako pierwszy
       wiersz. Rozmiar podpowiadamy z wyboru w glownym formularzu, kolor wybrany wyzej jest
       wylaczony (to bylby drugi raz to samo). */
    function idxKoloru(p) {
      for (var i = 0; i < p.options.length; i++) if (/colou?r|farve|shade/i.test(String(p.options[i].name || p.options[i]))) return i;
      return -1;
    }
    function odswiezKolor() {
      var li = lista.querySelector('[data-dp-look-colour]');
      var g = glowny();
      if (!li || !g) return;
      var iK = Number(li.getAttribute('data-dp-look-colour'));
      var sel = li.querySelector('[data-dp-look-option="' + iK + '"]');
      Array.prototype.forEach.call(sel.options, function (o) {
        if (!o.value) return;
        var jest = li.__snz.p.variants.some(function (v) { return v.available && v.options[iK] === o.value; });
        o.disabled = !jest || o.value === g.options[iK];
      });
      if (sel.value === g.options[iK]) sel.value = '';
      /* rozmiar jak w glownym formularzu, jesli klientka jeszcze nie wybrala */
      g.options.forEach(function (w, i) {
        if (i === iK) return;
        var s = li.querySelector('[data-dp-look-option="' + i + '"]');
        if (s && !s.value && !s.__reczny) {
          var o = Array.prototype.filter.call(s.options, function (x) { return x.value === w && !x.disabled; })[0];
          if (o) s.value = w;
        }
      });
    }

    function wiersz(p, iKoloru) {
      var li = document.createElement('li');
      li.className = 'dp-look__item';
      li.setAttribute('data-dp-look-item', p.id);
      li.__snz = { p: p };
      var kolor = typeof iKoloru === 'number';
      if (kolor) li.setAttribute('data-dp-look-colour', iKoloru);
      var img = p.featured_image ? p.featured_image + (p.featured_image.indexOf('?') < 0 ? '?' : '&') + 'width=120' : '';
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.className = 'dp-look__checkbox'; cb.setAttribute('aria-label', 'Add ' + p.title);
      li.appendChild(cb);
      var a = document.createElement('a');
      a.className = 'dp-look__img'; a.href = p.url; a.tabIndex = -1;
      if (img) { var im = document.createElement('img'); im.src = img; im.alt = ''; im.loading = 'lazy'; im.width = 52; im.height = 68; a.appendChild(im); }
      li.appendChild(a);
      var info = document.createElement('span'); info.className = 'dp-look__info';
      var nazwa = document.createElement(kolor ? 'span' : 'a'); nazwa.className = 'dp-look__name';
      if (kolor) { var b = document.createElement('b'); b.textContent = 'Love the fit? Try another shade'; nazwa.appendChild(b); }
      else { nazwa.href = p.url; nazwa.textContent = p.title; }
      info.appendChild(nazwa);
      var rz = document.createElement('span'); rz.className = 'dp-look__row';
      var pr = document.createElement('span'); pr.className = 'dp-look__price'; pr.textContent = cena(p.price);
      rz.appendChild(pr);
      /* osobne pole na kazda opcje (kolor, rozmiar) - jedna lista "kolor / rozmiar"
         przy butach miala 60 pozycji */
      if (p.variants.length > 1) {
        p.options.forEach(function (opt, i) {
          var nazwaOpcji = String(opt.name || opt);
          var wartosci = [];
          p.variants.forEach(function (v) { if (wartosci.indexOf(v.options[i]) < 0) wartosci.push(v.options[i]); });
          var sel = document.createElement('select');
          sel.className = 'dp-look__select'; sel.setAttribute('data-dp-look-option', i);
          sel.setAttribute('aria-label', nazwaOpcji + ' for ' + p.title);
          var pusta = document.createElement('option'); pusta.value = ''; pusta.textContent = nazwaOpcji;
          sel.appendChild(pusta);
          var zDostepnych = [];
          wartosci.forEach(function (w) {
            var jest = p.variants.some(function (v) { return v.available && v.options[i] === w; });
            var o = document.createElement('option');
            o.value = w; o.textContent = w + (jest ? '' : ' – sold out');
            o.disabled = !jest;
            if (jest) zDostepnych.push(w);
            sel.appendChild(o);
          });
          if (zDostepnych.length === 1) sel.value = zDostepnych[0];
          rz.appendChild(sel);
        });
      }
      info.appendChild(rz);
      li.appendChild(info);
      return li;
    }

    function wybierz(teksty) {
      /* po jednej rzeczy z kazdego typu (buty, torebka, bizuteria...), max 3 */
      var ziarno = Number(String(PID).slice(-3)) || 0;
      var uchwyty = [];
      teksty.forEach(function (t) {
        if (uchwyty.length >= 3) return;
        var d = new DOMParser().parseFromString(t, 'text/html');
        var g = Array.prototype.slice.call(d.querySelectorAll('[data-snk-g]')).filter(function (el) {
          if (elegancko && el.hasAttribute('data-snk-casual')) return false;
          return el.getAttribute('data-snk-pid') !== PID;
        });
        if (!g.length) return;
        var el = g[ziarno % g.length];
        var link = el.querySelector('a[href*="/products/"]');
        if (!link) return;
        var h = link.getAttribute('href').split('/products/')[1].split(/[?#\/]/)[0];
        if (h && uchwyty.indexOf(h) < 0) uchwyty.push(h);
      });
      return uchwyty;
    }

    function start() {
      var zrodla = (ramka.getAttribute('data-dp-look-sources') || '').split('|').filter(Boolean);
      var pamiec = window.__snKort = window.__snKort || {};
      Promise.all(zrodla.map(function (u) {
        if (!pamiec[u]) {
          pamiec[u] = fetch(u + (u.indexOf('?') < 0 ? '?' : '&') + 'section_id=sn-kurv-kort', { credentials: 'same-origin' })
            .then(function (o) { return o.ok ? o.text() : ''; })
            .catch(function () { return ''; });
        }
        return pamiec[u];
      })).then(function (teksty) {
        var uchwyty = [ramka.getAttribute('data-dp-look-handle')].concat(wybierz(teksty));
        return Promise.all(uchwyty.map(function (h) {
          return fetch(KORZEN + 'products/' + h + '.js').then(function (o) { return o.ok ? o.json() : null; }).catch(function () { return null; });
        }));
      }).then(function (produkty) {
        var ten = produkty && produkty.shift();
        produkty = (produkty || []).filter(function (p) { return p && p.available; });
        /* inny kolor tylko gdy sa co najmniej 2 dostepne kolory */
        var iK = ten ? idxKoloru(ten) : -1;
        var kolory = {};
        if (iK >= 0) ten.variants.forEach(function (v) { if (v.available) kolory[v.options[iK]] = 1; });
        var zKolorem = iK >= 0 && Object.keys(kolory).length > 1;
        if (!produkty.length && !zKolorem) return;
        if (zKolorem) lista.appendChild(wiersz(ten, iK));
        produkty.forEach(function (p) { lista.appendChild(wiersz(p)); });
        odswiezKolor();
        ramka.hidden = false;
        return fetch(KORZEN + 'cart.js', { credentials: 'same-origin' }).then(function (o) { return o.json(); })
          .then(function (c) { wKoszyku = window.dpItemCount ? window.dpItemCount(c) : c.item_count; })
          .catch(function () {});
      }).then(przelicz);
    }

    ramka.addEventListener('change', function (e) {
      blad.hidden = true;
      if (e.target.matches('.dp-look__select')) {
        e.target.classList.remove('is-err');
        e.target.__reczny = true;
        var li = e.target.closest('[data-dp-look-item]');
        if (e.target.value) li.querySelector('.dp-look__checkbox').checked = true;
        /* zdjecie wybranego koloru */
        var i = Number(e.target.getAttribute('data-dp-look-option'));
        var zf = li.__snz.p.variants.filter(function (v) { return v.options[i] === e.target.value && v.featured_image; })[0];
        var im = li.querySelector('.dp-look__img img');
        if (zf && im) im.src = zf.featured_image.src + (zf.featured_image.src.indexOf('?') < 0 ? '?' : '&') + 'width=120';
      }
      if (e.target.matches('.dp-look__checkbox') && e.target.checked) {
        var s = Array.prototype.filter.call(e.target.closest('[data-dp-look-item]').querySelectorAll('.dp-look__select'), function (x) { return !x.value; })[0];
        if (s) s.focus();
      }
      przelicz();
    });

    /* zmiana rozmiaru/koloru w glownym formularzu */
    if (sekcja) sekcja.addEventListener('click', function (e) {
      if (e.target.closest('[data-pdp-val], .pdp__size, .pdp__sw, [data-pdp-color]')) setTimeout(przelicz, 60);
    });
    ['cart:updated', 'ajaxProduct:added'].forEach(function (n) {
      document.addEventListener(n, function () {
        setTimeout(function () {
          fetch(KORZEN + 'cart.js', { credentials: 'same-origin' }).then(function (o) { return o.json(); })
            .then(function (c) { wKoszyku = window.dpItemCount ? window.dpItemCount(c) : c.item_count; przelicz(); }).catch(function () {});
        }, 300);
      });
    });

    przycisk.addEventListener('click', function () {
      var g = glowny();
      if (!g || !g.available) { blad.textContent = 'Please choose an available size for this item first.'; blad.hidden = false; return; }
      var pozycje = [{ id: g.id, quantity: 1 }], brak = null;
      lista.querySelectorAll('[data-dp-look-item]').forEach(function (li) {
        if (!li.querySelector('.dp-look__checkbox').checked) return;
        var v = wariantX(li);
        if (!v) {
          li.querySelectorAll('.dp-look__select').forEach(function (s) { if (!s.value) s.classList.add('is-err'); });
          brak = brak || li; return;
        }
        pozycje.push({ id: v.id, quantity: 1 });
      });
      if (brak) {
        blad.textContent = 'Please choose the options for each ticked item.'; blad.hidden = false;
        var s = brak.querySelector('.dp-look__select.is-err'); if (s) s.focus();
        return;
      }
      przycisk.disabled = true;
      fetch(KORZEN + 'cart/add.js', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: pozycje })
      })
        .then(function (o) { return o.json().then(function (j) { if (!o.ok) throw j; return j; }); })
        .then(function () {
          lista.querySelectorAll('[data-dp-look-item] .dp-look__checkbox').forEach(function (cb) { cb.checked = false; });
          document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { addToCartBtn: przycisk } }));
        })
        .catch(function (j) {
          blad.textContent = (j && (j.description || j.message)) || 'Something went wrong. Please try again.';
          blad.hidden = false;
        })
        .then(function () { przycisk.disabled = false; przelicz(); });
    });

    /* Pobieramy dopiero w wolnej chwili - nie konkuruje z pierwszym wyswietleniem karty. */
    function pozniej() {
      if (window.requestIdleCallback) requestIdleCallback(start, { timeout: 2500 });
      else setTimeout(start, 1200);
    }
    if (document.readyState === 'complete') pozniej();
    else window.addEventListener('load', pozniej, { once: true });
  })();
</script>
{%- endif -%}
