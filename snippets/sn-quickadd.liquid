{%- comment -%}
  Szybki wybor wariantu spod przycisku "+" na kafelku produktu.

  Jedno okno na cala strone, nie jedno na kafelek. Przy kolekcji z 48
  produktami po kilkanascie wariantow kazdy wlasny formularz w HTML
  urosl by do kilkuset kilobajtow, a otwarte jest zawsze jedno.

  Dane produktu sciagam dopiero przy kliknieciu, z /products/<uchwyt>.js.
  Kafelek nosi tylko uchwyt, wiec siatka zostaje lekka.

  Wstawiane raz, w layout/theme.liquid tuz przed </body>.
{%- endcomment -%}

{%- liquid
  assign t_wybierz = 'Select'
  assign t_dodaj = 'Add to cart'
  assign t_dodano = 'Added to cart'
  assign t_wyprzedane = 'Sold out'
  assign t_zamknij = 'Close'
  assign t_blad = 'Something went wrong. Please try again.'
  assign t_oszczedzasz = 'Save'
  assign t_opis = 'Description'
  assign t_pelny = 'View full product'
-%}

<div class="snq" data-snq hidden>
  <div class="snq__tlo" data-snq-tlo></div>

  {%- comment -%}
    Panel z boku na cala wysokosc (Antoni 01.11.2026, wzor: icon-amsterdam.nl):
    pasek z nazwa i krzyzykiem, duze zdjecia z licznikiem, cena, kolor,
    rozmiar, "Add to cart", opis i link do pelnej karty produktu.
  {%- endcomment -%}
  <div class="snq__okno" role="dialog" aria-modal="true" aria-labelledby="snq-tytul">
    <div class="snq__pasek">
      <p class="snq__nag" data-snq-nag></p>
      <button type="button" class="snq__zamknij" data-snq-zamknij aria-label="{{ t_zamknij }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>

    <div class="snq__tresc" data-snq-tresc>
      <div class="snq__galeria">
        <div class="snq__zdjecia" data-snq-zdjecia></div>
        <div class="snq__nawig" data-snq-nawig>
          <button type="button" class="snq__strz" data-snq-foto-krok="-1" aria-label="{{ 'general.slider.previous_slide' | t }}">&lsaquo;</button>
          <span data-snq-licznik></span>
          <button type="button" class="snq__strz" data-snq-foto-krok="1" aria-label="{{ 'general.slider.next_slide' | t }}">&rsaquo;</button>
        </div>
      </div>

      <p class="snq__tytul" id="snq-tytul" data-snq-tytul></p>
      <p class="snq__ceny">
        <span class="snq__bylo" data-snq-bylo hidden></span>
        <span class="snq__jest" data-snq-jest></span>
        <span class="snq__spar" data-snq-spar hidden></span>
      </p>

      <div class="snq__opcje" data-snq-opcje></div>

      <p class="snq__blad" data-snq-blad hidden>{{ t_blad }}</p>

      <button type="button" class="snq__dodaj" data-snq-dodaj>{{ t_dodaj }}</button>

      <details class="snq__opis-prod" data-snq-opis-box>
        <summary>{{ t_opis }}</summary>
        <div class="snq__opis-tekst" data-snq-opis></div>
      </details>

      <a class="snq__link" data-snq-link href="#">{{ t_pelny }}</a>
    </div>
  </div>
</div>

<style>
  .snq[hidden] { display: none; }

  .snq { position: fixed; inset: 0; z-index: 40; }

  .snq__tlo {
    position: absolute;
    inset: 0;
    background: rgba(28, 29, 29, 0.28);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    opacity: 0;
    transition: opacity 0.24s ease;
  }
  .snq.is-on .snq__tlo { opacity: 1; }

  .snq__okno {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(520px, 100%);
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: #1c1d1d;
    box-shadow: -12px 0 48px rgba(0, 0, 0, 0.16);
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }
  .snq.is-on .snq__okno { transform: translateX(0); }

  .snq__pasek {
    flex: 0 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 16px 14px 20px;
    border-bottom: 1px solid #e5e5e5;
  }
  .snq__nag {
    margin: 0; min-width: 0;
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .snq__zamknij {
    flex: 0 0 auto;
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0; border: 0;
    background: transparent; color: #1c1d1d; cursor: pointer;
  }
  .snq__zamknij svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }

  .snq__tresc {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 20px calc(28px + env(safe-area-inset-bottom, 0px));
  }

  /* ---------- zdjecia ---------- */
  .snq__zdjecia {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background: #f1efec;
  }
  .snq__zdjecia::-webkit-scrollbar { display: none; }
  @media (hover: hover) and (pointer: fine) { .snq__zdjecia { cursor: grab; } }
  .snq__zdjecia img {
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    scroll-snap-align: start;
    display: block;
  }
  .snq__nawig { display: flex; align-items: center; justify-content: center; gap: 20px; margin: 10px 0 18px; font-size: 13px; }
  .snq__nawig[hidden] { display: none; }
  .snq__strz { width: 36px; height: 32px; padding: 0; border: 0; background: none; color: #1c1d1d; font-size: 22px; line-height: 1; cursor: pointer; }

  .snq__tytul {
    margin: 0 0 8px;
    font-size: 18px; font-weight: 600;
    letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.3;
  }
  .snq__ceny { margin: 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 16px; }
  {%- comment -%}
    Motyw przygasza przekreslona cene do 45 procent krycia i robi sie
    nieczytelna - tutaj kolor ustawiam wprost.
  {%- endcomment -%}
  .snq__bylo { color: #6b6f76; opacity: 1; text-decoration: line-through; }
  .snq__jest { font-weight: 600; }
  .snq__spar { color: #000000; font-size: 13.5px; font-weight: 600; }

  /* ---------- opcje ---------- */
  .snq__opcje { margin-top: 20px; }
  .snq__grupa + .snq__grupa { margin-top: 20px; }
  .snq__etykieta { margin: 0 0 10px; font-size: 14px; color: #6b6f76; }
  .snq__etykieta b { color: #1c1d1d; font-weight: 600; }

  .snq__wartosci { display: flex; flex-wrap: wrap; gap: 8px; }

  {%- comment -%}
    Kolor pokazuje zdjecie wariantu, a nie kolorowe kolko. Przy
    zaimportowanych produktach probki koloru w panelu prawie nigdy nie
    sa ustawione, a zdjecie jest zawsze.
  {%- endcomment -%}
  .snq__foto {
    width: 56px; height: 76px;
    padding: 0;
    border: 1px solid #e5e5e5;
    background: #f1efec center/cover no-repeat;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .snq__foto:hover { border-color: #b8b4ae; }
  .snq__foto.is-on { border: 2px solid #1c1d1d; }

  .snq__chip {
    flex: 1 1 0;
    min-width: 64px;
    padding: 14px 10px;
    border: 1px solid #d9d6d1;
    background: #ffffff; color: #1c1d1d;
    font-family: inherit; font-size: 14px; font-weight: 500; line-height: 1;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .snq__chip:hover { border-color: #1c1d1d; }
  .snq__chip.is-on { border: 2px solid #1c1d1d; font-weight: 600; background: #1c1d1d; color: #ffffff; }
  {%- comment -%}
    Wyprzedany rozmiar zostaje widoczny, a nie znika - inaczej klientka
    szuka go w kolko i mysli, ze to blad strony.
  {%- endcomment -%}
  .snq__chip.is-brak {
    color: #a8a49e; border-color: #ececea;
    text-decoration: line-through; cursor: not-allowed;
  }
  .snq__foto.is-brak { opacity: 0.4; }

  .snq__blad { margin: 16px 0 0; font-size: 14px; color: #000000; }
  .snq__blad[hidden] { display: none; }

  .snq__dodaj {
    margin-top: 22px;
    width: 100%;
    padding: 17px 18px;
    border: 0;
    background: #000000; color: #ffffff;
    font-family: inherit; font-size: 14px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .snq__dodaj:hover { background: #2a2a2a; }
  .snq__dodaj[disabled] { background: #c9c6c1; cursor: not-allowed; }
  .snq__dodaj.is-ok { background: #366d12; }

  /* ---------- opis i link ---------- */
  .snq__opis-prod { margin-top: 22px; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; }
  .snq__opis-prod summary {
    display: flex; justify-content: space-between; align-items: center;
    padding: 15px 0; list-style: none; cursor: pointer;
    font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .snq__opis-prod summary::-webkit-details-marker { display: none; }
  .snq__opis-prod summary::after { content: '+'; font-size: 18px; font-weight: 400; }
  .snq__opis-prod[open] summary::after { content: '\2212'; }
  .snq__opis-tekst { padding: 0 0 16px; font-size: 14px; line-height: 1.6; color: #3d3f43; }
  .snq__opis-tekst p { margin: 0 0 10px; }
  .snq__opis-tekst img { max-width: 100%; height: auto; }
  .snq__link { display: block; margin-top: 18px; text-align: center; font-size: 14px; font-weight: 600; color: #1c1d1d; text-decoration: underline; text-underline-offset: 3px; }

  /* ==== Styl katalogu (03.11.2026, Antoni: "ten podglad mniej wiecej w stylu mojego PDP") ====
     Te same wymiary i kolory co nowa strona produktu: zdjecie od krawedzi do krawedzi, drobna typografia (10-16 px),
     kafle koloru 3:4, plaski rzad szarych rozmiarow, ciemny przycisk, akordeon z "+" po tytule. */
  .snq__okno { letter-spacing: 0.36px; }
  .snq__pasek { padding: 0 15px; height: 50px; }
  .snq__nag { font-size: 12px; font-weight: 400; letter-spacing: 0.36px; }
  .snq__zamknij { width: 36px; height: 36px; margin-right: -8px; }
  .snq__zamknij svg { width: 20px; height: 20px; stroke-width: 1.5; }
  .snq__tresc { padding: 0 0 calc(28px + env(safe-area-inset-bottom, 0px)); }
  .snq__tresc > *:not(.snq__galeria) { margin-left: 15px; margin-right: 15px; }
  .snq__zdjecia { background: #f9f9f9; }
  .snq__zdjecia img { aspect-ratio: 375 / 544; }
  .snq__nawig { margin: 8px 15px 14px; gap: 14px; font-size: 11px; letter-spacing: 0.3px; }
  .snq__strz { width: 32px; height: 28px; font-size: 18px; }
  .snq__tytul { margin: 0 15px 6px; font-size: 16px; font-weight: 400; letter-spacing: 0; text-transform: none; line-height: 1.3; }
  .snq__ceny { font-size: 14px; gap: 8px; }
  .snq__bylo { color: #939393; }
  .snq__jest { font-weight: 400; }
  .snq__spar { color: #525252; font-size: 11px; font-weight: 400; letter-spacing: 0.3px; text-transform: uppercase; }
  .snq__opcje { margin-top: 16px; }
  .snq__grupa + .snq__grupa { margin-top: 16px; }
  .snq__etykieta { margin: 0 0 8px; font-size: 10px; line-height: 13px; letter-spacing: 0.3px; text-transform: uppercase; color: #000; }
  .snq__etykieta b { font-weight: 400; }
  .snq__wartosci { gap: 4px; }
  .snq__foto { width: 76px; height: auto; aspect-ratio: 3 / 4; border: 1px solid transparent; background-color: #f9f9f9; }
  .snq__foto:hover { border-color: #939393; }
  .snq__foto.is-on { border: 1px solid #939393; }
  .snq__grupa:has(.snq__chip) .snq__wartosci { gap: 0; }
  .snq__chip { flex: 1 1 40px; min-width: 40px; height: 50px; padding: 0 2px; border: 1px solid #f9f9f9; background: #f9f9f9; font-size: 12px; font-weight: 400; letter-spacing: 0.3px; }
  .snq__chip:hover { border-color: #f9f9f9; background: #efefef; }
  .snq__chip.is-on { border: 1px solid #e5e5e5; background: #e5e5e5; color: #000; font-weight: 400; }
  .snq__chip.is-brak { color: #b3b3b3; border-color: #f9f9f9; background: #f9f9f9; }
  .snq__dodaj { margin: 14px 15px 0; width: calc(100% - 30px); padding: 0; height: 50px; background: #2d2d2d; font-size: 12px; font-weight: 400; letter-spacing: 0.36px; }
  .snq__dodaj:hover { background: #000; }
  .snq__opis-prod { margin-top: 20px; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; }
  .snq__opis-prod summary { justify-content: flex-start; gap: 5px; padding: 17px 0; font-size: 12px; font-weight: 400; letter-spacing: 0.36px; }
  .snq__opis-prod summary::after { content: '+'; font-size: 12px; }
  .snq__opis-prod[open] summary::after { content: '-'; }
  .snq__opis-tekst { font-size: 12px; line-height: 18px; color: #525252; }
  .snq__link { margin-top: 16px; font-size: 12px; font-weight: 400; letter-spacing: 0.36px; }
  /* galeria jak na stronie produktu: zdjecia jedno pod drugim, bez przewijania na boki; scrolluje caly panel (pasek ukryty) */
  .snq__zdjecia { display: block; overflow: visible; cursor: default; }
  .snq__zdjecia img { width: 100%; margin-bottom: 2px; }
  .snq__nawig { display: none !important; }
  .snq__tresc { scrollbar-width: none; }
  .snq__tresc::-webkit-scrollbar { display: none; }
</style>

<script>
  (function () {
    var okno = document.querySelector('[data-snq]');
    if (!okno) return;

    var panel = okno.querySelector('[data-snq-tresc]');
    var nag = okno.querySelector('[data-snq-nag]');
    var zdjecia = okno.querySelector('[data-snq-zdjecia]');
    var nawig = okno.querySelector('[data-snq-nawig]');
    var licznik = okno.querySelector('[data-snq-licznik]');
    var opisBox = okno.querySelector('[data-snq-opis-box]');
    var opisTekst = okno.querySelector('[data-snq-opis]');
    var link = okno.querySelector('[data-snq-link]');
    var tytul = okno.querySelector('[data-snq-tytul]');
    var bylo = okno.querySelector('[data-snq-bylo]');
    var jest = okno.querySelector('[data-snq-jest]');
    var spar = okno.querySelector('[data-snq-spar]');
    var opcje = okno.querySelector('[data-snq-opcje]');
    var blad = okno.querySelector('[data-snq-blad]');
    var dodaj = okno.querySelector('[data-snq-dodaj]');

    var produkt = null;
    var wybor = [];
    var wrocDo = null;
    var pobrane = {};

    var NAZWY = {
      kolor: ['color', 'colour', 'farve', 'kolor'],
      rozmiar: ['size', 'størrelse', 'storrelse', 'rozmiar', 'maat']
    };
    var TEKST = {
      dodaj: {{ t_dodaj | json }},
      dodano: {{ t_dodano | json }},
      wyprzedane: {{ t_wyprzedane | json }},
      wybierz: {{ t_wybierz | json }},
      spar: {{ t_oszczedzasz | json }}
    };
    var WALUTA = {{ cart.currency.iso_code | json }};
    var JEZYK = WALUTA === 'DKK' ? 'da-DK' : 'en-CA';
    var FORMAT = {{ shop.money_format | json }};

    /* Kwoty przez formater motywu i format sklepu - ten sam, ktorym
       liczone sa ceny na kafelkach, wiec w oknie wychodzi "1.599 kr",
       a nie "DKK 1,599". Intl bral jezyk sklepu (en) i skladal kwote
       po angielsku, co obok duńskich cen na siatce zdradza obcy sklep.
       Intl zostaje tylko na wypadek, gdyby motyw formatera nie mial. */
    function pieniadze(grosze) {
      if (window.snCena && WALUTA === 'DKK') return window.snCena(grosze);
      if (WALUTA === 'DKK' && window.theme && window.theme.Currency && window.theme.Currency.formatMoney) {
        try { return window.theme.Currency.formatMoney(grosze, FORMAT); } catch (e) {}
      }
      try {
        return new Intl.NumberFormat(JEZYK, {
          style: 'currency',
          currency: WALUTA,
          minimumFractionDigits: WALUTA === 'DKK' && grosze % 100 === 0 ? 0 : 2
        }).format(grosze / 100);
      } catch (e) {
        return (grosze / 100).toFixed(2);
      }
    }

    /* Ten sam slownik co na karcie produktu (ustawienie "dictionary" w
       sekcji PDP). Tlumacze tylko to, co widac - do dopasowania wariantu
       i do koszyka idzie oryginalna wartosc z produktu, bo po niej
       Shopify szuka wariantu. */
    var SLOWNIK = {
      'colour': 'Color', 'farve': 'Color', 'størrelse': 'Size'
    };
    function poDunsku(tekst) {
      var klucz = String(tekst).toLowerCase().trim();
      return SLOWNIK.hasOwnProperty(klucz) ? SLOWNIK[klucz] : tekst;
    }

    function rodzaj(nazwa) {
      var n = String(nazwa).toLowerCase().trim();
      if (NAZWY.kolor.indexOf(n) > -1) return 'kolor';
      if (NAZWY.rozmiar.indexOf(n) > -1) return 'rozmiar';
      return 'inne';
    }

    function wariantDla(opcjeWyboru) {
      for (var i = 0; i < produkt.variants.length; i++) {
        var w = produkt.variants[i], pasuje = true;
        for (var j = 0; j < opcjeWyboru.length; j++) {
          if (opcjeWyboru[j] !== null && w.options[j] !== opcjeWyboru[j]) { pasuje = false; break; }
        }
        if (pasuje) return w;
      }
      return null;
    }

    /* Czy przy obecnym wyborze istnieje dostepny wariant z ta wartoscia na
       tej pozycji. Dzieki temu rozmiar, ktorego nie ma w wybranym kolorze,
       jest przekreslony od razu, a nie dopiero po kliknieciu. */
    function dostepna(poz, wartosc) {
      for (var i = 0; i < produkt.variants.length; i++) {
        var w = produkt.variants[i], pasuje = true;
        for (var j = 0; j < wybor.length; j++) {
          if (j !== poz && wybor[j] !== null && w.options[j] !== wybor[j]) { pasuje = false; break; }
        }
        if (pasuje && w.options[poz] === wartosc && w.available) return true;
      }
      return false;
    }

    function zdjecieDla(poz, wartosc) {
      for (var i = 0; i < produkt.variants.length; i++) {
        var w = produkt.variants[i];
        if (w.options[poz] === wartosc && w.featured_image && w.featured_image.src) {
          return w.featured_image.src;
        }
      }
      return produkt.featured_image || '';
    }

    function maly(url) {
      if (!url) return '';
      return url.replace(/(\.(jpg|jpeg|png|webp|gif))(\?|$)/i, '_240x$1$3');
    }

    /* ---------- galeria w panelu ---------- */
    function duzy(url) {
      if (!url) return '';
      if (url.indexOf('//') === 0) url = 'https:' + url;
      return url + (url.indexOf('?') < 0 ? '?' : '&') + 'width=900';
    }
    function rdzen(url) { return String(url || '').split('?')[0].replace(/^https?:/, ''); }
    function rysujGalerie() {
      zdjecia.innerHTML = '';
      var lista = (produkt.images && produkt.images.length) ? produkt.images : [produkt.featured_image];
      lista.forEach(function (u, i) {
        if (!u) return;
        var im = document.createElement('img');
        im.src = duzy(u); im.alt = i === 0 ? produkt.title : '';
        im.loading = 'eager'; im.decoding = 'async';
        im.width = 450; im.height = 600;
        zdjecia.appendChild(im);
      });
      zdjecia.scrollLeft = 0;
      nawig.hidden = zdjecia.children.length < 2;
      liczZdjecia();
    }
    function ktoreZdjecie() { return Math.round(zdjecia.scrollLeft / Math.max(1, zdjecia.clientWidth)); }
    function liczZdjecia() { licznik.textContent = (ktoreZdjecie() + 1) + ' / ' + zdjecia.children.length; }
    function idzDo(i) {
      var n = zdjecia.children.length;
      if (!n) return;
      i = (i + n) % n;
      /* skok bez "smooth" - plynne przewijanie z przyciaganiem potrafi stanac w pol drogi */
      zdjecia.scrollLeft = i * zdjecia.clientWidth;
      liczZdjecia();
    }
    function pokazZdjecieWariantu(w) {
      if (!w || !w.featured_image || !w.featured_image.src) return;
      var szukany = rdzen(w.featured_image.src);
      Array.prototype.forEach.call(zdjecia.children, function (im, i) {
        if (rdzen(im.src) === szukany) idzDo(i);
      });
    }
    zdjecia.addEventListener('scroll', function () { liczZdjecia(); }, { passive: true });

    /* przeciaganie zdjec myszka - palcem przesuwaja sie same; po puszczeniu najblizsze zdjecie */
    var ciag = null;
    zdjecia.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      ciag = { x: e.clientX, left: zdjecia.scrollLeft, id: e.pointerId, ruszone: false };
    });
    zdjecia.addEventListener('pointermove', function (e) {
      if (!ciag || e.pointerId !== ciag.id) return;
      var dx = e.clientX - ciag.x;
      if (!ciag.ruszone && Math.abs(dx) < 6) return;
      if (!ciag.ruszone) {
        ciag.ruszone = true;
        zdjecia.setPointerCapture(e.pointerId);
        zdjecia.style.scrollSnapType = 'none';
        zdjecia.style.cursor = 'grabbing';
      }
      zdjecia.scrollLeft = ciag.left - dx;
    });
    function koniecCiagniecia() {
      if (!ciag) return;
      var bylo = ciag;
      ciag = null;
      if (!bylo.ruszone) return;
      zdjecia.style.cursor = '';
      zdjecia.style.scrollSnapType = '';
      /* wystarczy pociagnac o 1/5 szerokosci, zeby przejsc do nastepnego */
      var w = zdjecia.clientWidth, start = Math.round(bylo.left / w), przesun = (bylo.left - zdjecia.scrollLeft) / w;
      idzDo(przesun < -0.2 ? start + 1 : przesun > 0.2 ? start - 1 : start);
    }
    zdjecia.addEventListener('pointerup', koniecCiagniecia);
    zdjecia.addEventListener('pointercancel', koniecCiagniecia);
    zdjecia.addEventListener('dragstart', function (e) { e.preventDefault(); });

    function rysujOpcje() {
      opcje.innerHTML = '';
      /* Jeden wariant bez nazwanych opcji - nie ma czego wybierac. */
      var pierwsza = produkt.options[0];
      var pierwszaNazwa = (pierwsza && typeof pierwsza === 'object') ? pierwsza.name : pierwsza;
      if (produkt.variants.length === 1 && produkt.options.length === 1 &&
          String(pierwszaNazwa).toLowerCase() === 'title') return;

      produkt.options.forEach(function (opcja, poz) {
        /* /products/<uchwyt>.js daje opcje jako obiekty {name, values},
           a nie same nazwy - bez tego w etykiecie stalo "[object Object]",
           a kolor nie byl rozpoznawany i nie dostawal zdjec. */
        var nazwa = (opcja && typeof opcja === 'object') ? opcja.name : opcja;
        var typ = rodzaj(nazwa);
        var wartosci = [];
        produkt.variants.forEach(function (w) {
          if (wartosci.indexOf(w.options[poz]) === -1) wartosci.push(w.options[poz]);
        });

        var grupa = document.createElement('div');
        grupa.className = 'snq__grupa';

        var etykieta = document.createElement('p');
        etykieta.className = 'snq__etykieta';
        etykieta.appendChild(document.createTextNode(poDunsku(nazwa) + ': '));
        var mocne = document.createElement('b');
        mocne.textContent = wybor[poz] ? poDunsku(wybor[poz]) : TEKST.wybierz;
        etykieta.appendChild(mocne);
        grupa.appendChild(etykieta);

        var rzad = document.createElement('div');
        rzad.className = 'snq__wartosci';

        wartosci.forEach(function (wartosc) {
          var b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('data-snq-poz', poz);
          b.setAttribute('data-snq-wartosc', wartosc);

          if (typ === 'kolor') {
            b.className = 'snq__foto';
            b.style.backgroundImage = 'url(' + maly(zdjecieDla(poz, wartosc)) + ')';
            b.setAttribute('aria-label', poDunsku(wartosc));
            b.title = poDunsku(wartosc);
          } else {
            b.className = 'snq__chip';
            b.textContent = poDunsku(wartosc);
          }

          if (wybor[poz] === wartosc) b.classList.add('is-on');
          if (!dostepna(poz, wartosc)) {
            b.classList.add('is-brak');
            /* Kolor zostaje klikalny - przelaczenie na inny kolor moze
               odblokowac rozmiary, ktorych w tym nie bylo. */
            if (typ !== 'kolor') b.disabled = true;
          }
          rzad.appendChild(b);
        });

        grupa.appendChild(rzad);
        opcje.appendChild(grupa);
      });
    }

    function odswiez() {
      var w = wariantDla(wybor);
      var pelny = wybor.length > 0 && wybor.every(function (x) { return x !== null && x !== undefined; });

      if (w) {
        pokazZdjecieWariantu(w);
        jest.textContent = pieniadze(w.price);
        if (w.compare_at_price && w.compare_at_price > w.price) {
          bylo.hidden = false; bylo.textContent = pieniadze(w.compare_at_price);
          spar.hidden = false; spar.textContent = TEKST.spar + ' ' + pieniadze(w.compare_at_price - w.price);
        } else {
          bylo.hidden = true; spar.hidden = true;
        }
      }

      if (!pelny) { dodaj.disabled = true; dodaj.textContent = TEKST.wybierz; }
      else if (!w || !w.available) { dodaj.disabled = true; dodaj.textContent = TEKST.wyprzedane; }
      else { dodaj.disabled = false; dodaj.textContent = TEKST.dodaj; }

      dodaj.classList.remove('is-ok');
      dodaj.setAttribute('data-snq-wariant', w ? w.id : '');
    }

    function pokaz() {
      okno.hidden = false;
      /* Klasa dopiero w nastepnej klatce - inaczej przejscie nie ma od
         czego ruszyc i okno pojawia sie skokiem. */
      requestAnimationFrame(function () { okno.classList.add('is-on'); });
      document.documentElement.style.overflow = 'hidden';
      panel.scrollTop = 0;
    }

    function schowaj() {
      okno.classList.remove('is-on');
      document.documentElement.style.overflow = '';
      setTimeout(function () { okno.hidden = true; }, 240);
      if (wrocDo && document.contains(wrocDo)) wrocDo.focus();
    }

    function otworz(uchwyt, zrodlo) {
      wrocDo = zrodlo || null;
      blad.hidden = true;

      function gotowe(dane) {
        produkt = dane;
        /* Zaczynam od pierwszego dostepnego wariantu, zeby klientka
           zobaczyla cene i zdjecie od razu, a nie pusty formularz. */
        var start = null;
        for (var i = 0; i < produkt.variants.length; i++) {
          if (produkt.variants[i].available) { start = produkt.variants[i]; break; }
        }
        if (!start) start = produkt.variants[0];
        wybor = start ? start.options.slice() : [];

        /* Ta sama krotka nazwa co na kafelku, z ktorego przyszlo klikniecie -
           inaczej okno witalo by klientke innym, dluzszym napisem niz ten,
           w ktory przed chwila kliknela. Pelny tytul tylko jako zapas. */
        var krotka = zrodlo && zrodlo.getAttribute ? zrodlo.getAttribute('data-snq-nazwa') : '';
        tytul.textContent = krotka || produkt.title;
        nag.textContent = krotka || produkt.title;
        opisTekst.innerHTML = produkt.description || '';
        opisBox.hidden = !produkt.description;
        opisBox.open = false;
        link.href = produkt.url || ((window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/') + 'products/' + uchwyt;

        pokaz();
        rysujGalerie();
        rysujOpcje();
        odswiez();
      }

      if (pobrane[uchwyt]) { gotowe(pobrane[uchwyt]); return; }

      var korzen = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(korzen + 'products/' + uchwyt + '.js', { headers: { Accept: 'application/json' } })
        .then(function (o) { if (!o.ok) throw new Error('brak'); return o.json(); })
        .then(function (dane) { pobrane[uchwyt] = dane; gotowe(dane); })
        .catch(function () { window.location.href = korzen + 'products/' + uchwyt; });
    }

    /* ---------- zdarzenia ---------- */

    document.addEventListener('click', function (e) {
      var start = e.target.closest ? e.target.closest('[data-snq-otworz]') : null;
      if (!start) return;
      /* Kafelek ma pod spodem odnosnik na cala powierzchnie - bez tego
         strona zmienilaby sie zamiast otworzyc okno. */
      e.preventDefault();
      e.stopPropagation();
      otworz(start.getAttribute('data-snq-otworz'), start);
    });

    okno.addEventListener('click', function (e) {
      if (e.target.closest('[data-snq-tlo]') || e.target.closest('[data-snq-zamknij]')) { schowaj(); return; }

      var krok = e.target.closest('[data-snq-foto-krok]');
      if (krok) { idzDo(ktoreZdjecie() + Number(krok.getAttribute('data-snq-foto-krok'))); return; }

      var wartosc = e.target.closest('[data-snq-wartosc]');
      if (wartosc && !wartosc.disabled) {
        var poz = Number(wartosc.getAttribute('data-snq-poz'));
        wybor[poz] = wartosc.getAttribute('data-snq-wartosc');

        /* Zmiana koloru moze uniewaznic rozmiar - wtedy biore pierwszy
           dostepny w nowym kolorze zamiast zostawiac martwy wybor. */
        for (var i = 0; i < wybor.length; i++) {
          if (i !== poz && !dostepna(i, wybor[i])) {
            var zamiast = null;
            for (var k = 0; k < produkt.variants.length; k++) {
              var kandydat = produkt.variants[k].options[i];
              if (dostepna(i, kandydat)) { zamiast = kandydat; break; }
            }
            if (zamiast !== null) wybor[i] = zamiast;
          }
        }

        rysujOpcje();
        odswiez();
        return;
      }

      if (e.target.closest('[data-snq-dodaj]') && !dodaj.disabled) {
        var id = dodaj.getAttribute('data-snq-wariant');
        if (!id) return;
        dodaj.disabled = true;
        blad.hidden = true;

        var korzen = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        fetch(korzen + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] })
        })
          .then(function (o) { if (!o.ok) throw new Error('odmowa'); return o.json(); })
          .then(function () {
            dodaj.classList.add('is-ok');
            dodaj.textContent = TEKST.dodano;
            /* Motyw na to zdarzenie sam otwiera szuflade i przelicza licznik. */
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { addToCartBtn: dodaj } }));
            setTimeout(schowaj, 700);
          })
          .catch(function () {
            dodaj.disabled = false;
            blad.hidden = false;
          });
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !okno.hidden) schowaj();
    });
  })();
</script>
