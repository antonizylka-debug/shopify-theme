{%- comment -%}
  Rabat za ilosc na gorze kolekcji, zaraz pod tytulem - na telefonie
  pierwsza rzecz, ktora widac po wejsciu w kolekcje.
  Zwarty: czerwony naglowek akcji (z licznikiem, gdy jest data), tytul,
  progi w jednym rzedzie z cienkimi kreskami i jedna linijka na dole
  (zasady szarym + haslo pogrubione). Na PC jeden poziomy pas: tekst po
  lewej, progi po prawej. Wczesniejsze wersje mialy na telefonie 236-256 px.

  Parametry: title, sub, text2 i note (opcjonalne), tiers ("2:10, 3:20, 4:25, 5:30").
  Progi musza sie zgadzac z rabatami automatycznymi w Shopify - sprawdzone
  w koszyku 2026-10-03: 2 = 10 %, 3 = 20 %, 4 = 25 %, 5 i wiecej = 30 %.
{%- endcomment -%}
{%- assign progi = tiers | split: ',' -%}
{%- if progi.size > 0 -%}
  <div class="snbund">
    <style>
      .snbund { margin: 0 0 24px; }
      .snbund__box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 40px;
        padding: 18px 28px;
        background: #fdf6f4;
      }
      .snbund__tekst { min-width: 0; }
      .snbund__brw {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2px 8px;
        margin: 0 0 4px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #c8102e;
      }
      .snbund__dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: #c8102e; flex: 0 0 7px; }
      .snbund__dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #c8102e;
        animation: snbund-puls 1.6s ease-out infinite;
      }
      @keyframes snbund-puls { from { transform: scale(1); opacity: 0.6; } to { transform: scale(2.6); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .snbund__dot::after { animation: none; } }
      .snbund__licznik[hidden] { display: none; }
      .snbund__licznik b { font-weight: 700; font-variant-numeric: tabular-nums; }
      .snbund__tytul {
        margin: 0;
        font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
        font-size: 22px;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: 0.01em;
        text-transform: none;
        color: #1c1d1d;
      }
      .snbund__linia { margin: 4px 0 0; font-size: 13.5px; line-height: 1.4; color: #6e6b65; text-wrap: balance; }
      .snbund__linia b { font-weight: 700; color: #1c1d1d; }
      .snbund__progi {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        flex: 0 0 auto;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .snbund__prog { display: flex; flex-direction: column; align-items: center; gap: 2px; margin: 0; padding: 4px 18px; }
      .snbund__prog + .snbund__prog { border-left: 1px solid #ead9d5; }
      .snbund__ile { font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6e6b65; white-space: nowrap; }
      .snbund__proc { font-size: 22px; font-weight: 700; line-height: 1.1; color: #1c1d1d; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .snbund__prog--max .snbund__ile,
      .snbund__prog--max .snbund__proc { color: #c8102e; }
      /* strzalki rzedu podkategorii (38 px) wisza 62 px nad nim - bez tego
         odstepu wchodzily na kafel. 72 = 62 + 10 px przerwy; marginesy
         sie nakladaja, wiec liczy sie wiekszy, nie suma z marginesem kafla */
      @media only screen and (min-width: 769px) {
        .snbund + .subrow { margin-top: 72px; }
      }
      @media only screen and (max-width: 768px) {
        .snbund { margin: 0 0 14px; }
        .snbund__box { flex-direction: column; align-items: stretch; gap: 8px; padding: 12px 10px 10px; text-align: center; }
        .snbund__brw { justify-content: center; margin-bottom: 2px; font-size: 10.5px; }
        .snbund__tytul { font-size: 17px; }
        .snbund__progi { order: 2; border-top: 1px solid #ead9d5; padding-top: 6px; }
        .snbund__prog { padding: 0 2px; gap: 0; }
        .snbund__ile { font-size: 10px; letter-spacing: 0.05em; }
        .snbund__proc { font-size: 17px; }
        .snbund__linia { order: 3; margin: 0; font-size: 12px; }
        .snbund__sep { display: none; }
        .snbund__linia b { display: block; }
        .snbund__tekst { display: contents; }
        .snbund__naglowek { order: 1; }
      }
    </style>
    <div class="snbund__box">
      <div class="snbund__tekst">
        <div class="snbund__naglowek">
          {%- if settings.campaign_name != blank -%}
            <p class="snbund__brw">
              <span class="snbund__dot" aria-hidden="true"></span>
              {{ settings.campaign_name | escape }}
              {%- if settings.campaign_end != blank -%}
                <span class="snbund__licznik" data-sn-licznik data-slut="{{ settings.campaign_end | escape }}" hidden>· <span data-sn-etykieta>slutter om</span> <b data-sn-czas></b></span>
              {%- endif -%}
            </p>
          {%- endif -%}
          <p class="snbund__tytul">{{ title | escape }}</p>
        </div>
        {%- if sub != blank or text2 != blank or note != blank -%}
          <p class="snbund__linia">
            {%- if sub != blank -%}{{ sub | escape }}{%- endif -%}
            {%- if text2 != blank -%}{%- if sub != blank %}<span class="snbund__sep"> · </span>{% endif -%}{{ text2 | escape }}{%- endif -%}
            {%- if note != blank -%}{%- if sub != blank or text2 != blank %}<span class="snbund__sep"> · </span>{% endif -%}<b>{{ note | escape }}</b>{%- endif -%}
          </p>
        {%- endif -%}
      </div>
      <ol class="snbund__progi">
        {%- for prog in progi -%}
          {%- assign czesci = prog | split: ':' -%}
          {%- assign ile = czesci[0] | strip -%}
          {%- assign proc = czesci[1] | strip -%}
          {%- if ile != blank and proc != blank -%}
            <li class="snbund__prog{% if forloop.last %} snbund__prog--max{% endif %}">
              <span class="snbund__ile">{{ ile }}{% if forloop.last %}+{% endif %} stk.</span>
              <span class="snbund__proc">−{{ proc }} %</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
    {%- if settings.campaign_end != blank -%}
      <script>
        (function () {
          // jeden zegar na strone; co sekunde szuka licznikow na nowo, wiec
          // dziala tez po filtrowaniu, gdy motyw podmienia tresc kolekcji
          if (window.__snLicznik) return;
          window.__snLicznik = true;
          function koniecZ(tekst) {
            var m = (tekst || '').match(/(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T]+(\d{1,2})[:.](\d{2}))?/);
            if (!m) return null;
            return m[4]
              ? new Date(+m[1], m[2] - 1, +m[3], +m[4], +m[5], 0)
              : new Date(+m[1], m[2] - 1, +m[3], 23, 59, 59);
          }
          function dwa(n) { return (n < 10 ? '0' : '') + n; }
          function tik() {
            var el = document.querySelectorAll('[data-sn-licznik]');
            for (var i = 0; i < el.length; i++) {
              var koniec = koniecZ(el[i].getAttribute('data-slut'));
              var s = koniec ? Math.floor((koniec - new Date()) / 1000) : 0;
              if (s <= 0) { el[i].hidden = true; continue; }
              var d = Math.floor(s / 86400); s -= d * 86400;
              var h = Math.floor(s / 3600); s -= h * 3600;
              var mi = Math.floor(s / 60); s -= mi * 60;
              // w dniu konca: 'slutter i aften' (od 17:00 do konca dnia) albo
              // 'slutter i dag' i sam licznik godzin; wczesniej 'slutter om X dage'
              var teraz = new Date();
              var dzis = koniec.toDateString() === teraz.toDateString();
              var etykieta = el[i].querySelector('[data-sn-etykieta]');
              if (etykieta) etykieta.textContent = dzis ? (koniec.getHours() >= 17 ? 'slutter i aften' : 'slutter i dag') : 'slutter om';
              var czas = el[i].querySelector('[data-sn-czas]');
              if (czas) czas.textContent = (!dzis && d > 0 ? d + (d === 1 ? ' dag ' : ' dage ') : '') + dwa(h + (dzis ? d * 24 : 0)) + ':' + dwa(mi) + ':' + dwa(s);
              el[i].hidden = false;
            }
          }
          tik();
          setInterval(tik, 1000);
        })();
      </script>
    {%- endif -%}
  </div>
{%- endif -%}
