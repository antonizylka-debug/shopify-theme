{%- comment -%}
  Rabat za ilosc na gorze kolekcji, zaraz pod tytulem - na telefonie
  pierwsza rzecz, ktora widac po wejsciu w kolekcje.
  Ten sam wyglad co ramka akcji na stronie produktu (.pdp__akcja w
  ob-pdp): wysrodkowana, czerwony naglowek akcji (z licznikiem, gdy jest
  data w Ustawieniach motywu > Campaign), tytul, progi w jednym rzedzie
  z cienkimi kreskami, linijka zasad szarym i haslo pogrubione.

  Parametry: title, sub, text2 i note (opcjonalne), tiers ("2:10, 3:20, 4:25, 5:30").
  Progi musza sie zgadzac z rabatami automatycznymi w Shopify - sprawdzone
  w koszyku 2026-10-03: 2 = 10 %, 3 = 20 %, 4 = 25 %, 5 i wiecej = 30 %.
{%- endcomment -%}
{%- assign progi = tiers | split: ',' -%}
{%- if progi.size > 0 -%}
  <div class="snbund">
    <style>
      .snbund { margin: 0 0 24px; }
      .snbund__box { padding: 14px 16px 13px; background: #f2f3f5; text-align: center; }
      .snbund__in { max-width: 560px; margin: 0 auto; }
      .snbund__brw {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 2px 8px;
        margin: 0 0 3px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #d6332e;
      }
      .snbund__dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: #d6332e; flex: 0 0 7px; }
      .snbund__dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #d6332e;
        animation: snbund-puls 1.6s ease-out infinite;
      }
      @keyframes snbund-puls { from { transform: scale(1); opacity: 0.6; } to { transform: scale(2.6); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .snbund__dot::after { animation: none; } }
      .snbund__licznik[hidden] { display: none; }
      .snbund__licznik b { font-weight: 700; font-variant-numeric: tabular-nums; }
      .snbund__tytul { margin: 0 0 8px; font-size: 16px; font-weight: 700; line-height: 1.3; text-transform: none; letter-spacing: 0; color: #1c1d1d; }
      .snbund__progi {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        margin: 0;
        padding: 7px 0 0;
        list-style: none;
        border-top: 1px solid #e4e6ea;
      }
      .snbund__prog { display: flex; flex-direction: column; align-items: center; margin: 0; padding: 0 2px; }
      .snbund__prog + .snbund__prog { border-left: 1px solid #e4e6ea; }
      .snbund__ile { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #6b6f76; white-space: nowrap; }
      .snbund__proc { font-size: 18px; font-weight: 700; line-height: 1.15; color: #1c1d1d; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .snbund__prog--max .snbund__ile,
      .snbund__prog--max .snbund__proc { color: #d6332e; }
      .snbund__pod { margin: 8px 0 0; font-size: 12.5px; line-height: 1.4; color: #6b6f76; text-wrap: balance; }
      .snbund__note { margin: 2px 0 0; font-size: 12.5px; font-weight: 700; line-height: 1.4; color: #1c1d1d; text-wrap: balance; }
      /* strzalki rzedu podkategorii (38 px) wisza 62 px nad nim - bez tego
         odstepu wchodzily na kafel. 72 = 62 + 10 px przerwy; marginesy
         sie nakladaja, wiec liczy sie wiekszy, nie suma z marginesem kafla */
      @media only screen and (min-width: 769px) {
        .snbund + .subrow { margin-top: 72px; }
      }
      @media only screen and (max-width: 768px) {
        .snbund { margin: 0 0 14px; }
        .snbund__box { padding: 12px 12px 11px; }
        .snbund__tytul { font-size: 15px; }
      }
    </style>
    <div class="snbund__box">
      <div class="snbund__in">
        {%- if settings.campaign_name != blank -%}
          <p class="snbund__brw">
            <span class="snbund__dot" aria-hidden="true"></span>
            {{ settings.campaign_name | escape }}
            {%- if settings.campaign_end != blank -%}
              <span class="snbund__licznik" data-sn-licznik data-slut="{{ settings.campaign_end | escape }}" hidden>· <span data-sn-etykieta>ends in</span> <b data-sn-czas></b></span>
            {%- endif -%}
          </p>
        {%- endif -%}
        <p class="snbund__tytul">{{ title | escape }}</p>
        <ol class="snbund__progi">
          {%- for prog in progi -%}
            {%- assign czesci = prog | split: ':' -%}
            {%- assign ile = czesci[0] | strip -%}
            {%- assign proc = czesci[1] | strip -%}
            {%- if ile != blank and proc != blank -%}
              <li class="snbund__prog{% if forloop.last %} snbund__prog--max{% endif %}">
                <span class="snbund__ile">{{ ile }}{% if forloop.last %}+{% endif %} items</span>
                <span class="snbund__proc">−{{ proc }} %</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
        {%- if sub != blank -%}
          <p class="snbund__pod">{{ sub | escape }}</p>
        {%- endif -%}
        {%- if text2 != blank -%}
          <p class="snbund__pod">{{ text2 | escape }}</p>
        {%- endif -%}
        {%- if note != blank -%}
          <p class="snbund__note">{{ note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
    {%- if settings.campaign_end != blank -%}{%- render 'sn-licznik' -%}{%- endif -%}
  </div>
{%- endif -%}
