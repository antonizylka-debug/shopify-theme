{%- comment -%}
  Rabat za ilosc na gorze kolekcji, zaraz pod tytulem - to samo, co "Fall
  Bundle Savings" u Iselle, ale zwiezle: tytul, jedno zdanie, progi.
  Na telefonie to pierwsza rzecz, ktora widac po wejsciu w kolekcje.

  Parametry: title, sub, note (opcjonalny), tiers ("2:10, 3:20, 4:25, 5:30").
  Progi musza sie zgadzac z rabatami automatycznymi w Shopify - sprawdzone
  w koszyku 2026-10-03: 2 = 10 %, 3 = 20 %, 4 = 25 %, 5 i wiecej = 30 %.
{%- endcomment -%}
{%- assign progi = tiers | split: ',' -%}
{%- if progi.size > 0 -%}
  <div class="snbund">
    <style>
      .snbund { margin: 0 0 26px; }
      .snbund__box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px 32px;
        padding: 18px 24px;
        background: #fdf6f4;
        border: 1px solid #e8d9d6;
      }
      .snbund__tekst { min-width: 0; }
      .snbund__brw {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2px 7px;
        margin: 0 0 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #c8102e;
      }
      .snbund__dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: #c8102e; flex: 0 0 8px; }
      .snbund__dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #c8102e;
        animation: snbund-puls 1.6s ease-out infinite;
      }
      @keyframes snbund-puls { from { transform: scale(1); opacity: 0.6; } to { transform: scale(2.6); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .snbund__dot::after { animation: none; } }
      .snbund__licznik[hidden] { display: none; }
      .snbund__licznik b { font-weight: 700; font-variant-numeric: tabular-nums; }
      .snbund__tytul {
        margin: 0 0 4px;
        font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
        font-size: 20px;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0.01em;
        text-transform: none;
        color: #1c1d1d;
      }
      .snbund__pod { margin: 0; font-size: 14px; line-height: 1.45; color: #5a5651; }
      .snbund__note { margin: 4px 0 0; font-size: 14px; font-weight: 700; line-height: 1.4; color: #1c1d1d; }
      .snbund__progi { display: flex; gap: 8px; flex: 0 0 auto; margin: 0; padding: 0; list-style: none; }
      .snbund__prog {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        min-width: 84px;
        margin: 0;
        padding: 9px 12px;
        background: #ffffff;
        border: 1px solid #ecdcd8;
      }
      .snbund__ile { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6e6b65; white-space: nowrap; }
      .snbund__proc { font-size: 20px; font-weight: 700; line-height: 1.15; color: #c8102e; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .snbund__prog--max { background: #c8102e; border-color: #c8102e; }
      .snbund__prog--max .snbund__ile,
      .snbund__prog--max .snbund__proc { color: #ffffff; }
      /* strzalki rzedu podkategorii (38 px) wisza 62 px nad nim - bez tego
         odstepu wchodzily na ostatni prog. 72 = 62 + 10 px przerwy; marginesy
         sie nakladaja, wiec liczy sie wiekszy, nie suma z 26 px rabatu */
      @media only screen and (min-width: 769px) {
        .snbund + .subrow { margin-top: 72px; }
      }
      @media only screen and (max-width: 768px) {
        .snbund { margin: 0 0 18px; }
        .snbund__box { flex-direction: column; align-items: stretch; gap: 10px; padding: 12px 12px 12px; }
        .snbund__brw { margin-bottom: 4px; font-size: 11px; }
        .snbund__tytul { margin-bottom: 2px; font-size: 16px; }
        .snbund__pod { font-size: 12.5px; line-height: 1.35; }
        .snbund__note { font-size: 12.5px; }
        .snbund__progi { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 6px; }
        .snbund__prog { min-width: 0; padding: 6px 2px; gap: 1px; }
        .snbund__ile { font-size: 10.5px; letter-spacing: 0.04em; }
        .snbund__proc { font-size: 16px; }
      }
    </style>
    <div class="snbund__box">
      <div class="snbund__tekst">
        {%- if settings.campaign_name != blank -%}
          <p class="snbund__brw">
            <span class="snbund__dot" aria-hidden="true"></span>
            {{ settings.campaign_name | escape }}
            {%- if settings.campaign_end != blank -%}
              <span class="snbund__licznik" data-sn-licznik data-slut="{{ settings.campaign_end | escape }}" hidden>· slutter om <b data-sn-czas></b></span>
            {%- endif -%}
          </p>
        {%- endif -%}
        <p class="snbund__tytul">{{ title | escape }}</p>
        {%- if sub != blank -%}
          <p class="snbund__pod">{{ sub | escape }}</p>
        {%- endif -%}
        {%- if note != blank -%}
          <p class="snbund__note">{{ note | escape }}</p>
        {%- endif -%}
      </div>
      <ol class="snbund__progi">
        {%- for prog in progi -%}
          {%- assign czesci = prog | split: ':' -%}
          {%- assign ile = czesci[0] | strip -%}
          {%- assign proc = czesci[1] | strip -%}
          {%- if ile != blank and proc != blank -%}
            <li class="snbund__prog{% if forloop.last %} snbund__prog--max{% endif %}">
              <span class="snbund__ile">{{ ile }}{% if forloop.last %}+{% endif %} stk.</span>
              <span class="snbund__proc">−{{ proc }} %</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
    {%- if settings.campaign_end != blank -%}
      <script>
        (function () {
          // jeden zegar na strone; co sekunde szuka licznikow na nowo, wiec
          // dziala tez po filtrowaniu, gdy motyw podmienia tresc kolekcji
          if (window.__snLicznik) return;
          window.__snLicznik = true;
          function koniecZ(tekst) {
            var m = (tekst || '').match(/(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T]+(\d{1,2})[:.](\d{2}))?/);
            if (!m) return null;
            return m[4]
              ? new Date(+m[1], m[2] - 1, +m[3], +m[4], +m[5], 0)
              : new Date(+m[1], m[2] - 1, +m[3], 23, 59, 59);
          }
          function dwa(n) { return (n < 10 ? '0' : '') + n; }
          function tik() {
            var el = document.querySelectorAll('[data-sn-licznik]');
            for (var i = 0; i < el.length; i++) {
              var koniec = koniecZ(el[i].getAttribute('data-slut'));
              var s = koniec ? Math.floor((koniec - new Date()) / 1000) : 0;
              if (s <= 0) { el[i].hidden = true; continue; }
              var d = Math.floor(s / 86400); s -= d * 86400;
              var h = Math.floor(s / 3600); s -= h * 3600;
              var mi = Math.floor(s / 60); s -= mi * 60;
              var czas = el[i].querySelector('[data-sn-czas]');
              if (czas) czas.textContent = (d > 0 ? d + (d === 1 ? ' dag ' : ' dage ') : '') + dwa(h) + ':' + dwa(mi) + ':' + dwa(s);
              el[i].hidden = false;
            }
          }
          tik();
          setInterval(tik, 1000);
        })();
      </script>
    {%- endif -%}
  </div>
{%- endif -%}
