{% comment %}
  Style wyroznionych linkow w menu (mega menu i menu mobilne).
  Kolory i plakietki z ustawien naglowka "Mega menu highlights".
{% endcomment %}
{%- style -%}
  {%- for n in (1..3) -%}
    {%- liquid
      assign k_color = 'mm_hl' | append: n | append: '_color'
      assign k_bold = 'mm_hl' | append: n | append: '_bold'
      assign k_bg = 'mm_hl' | append: n | append: '_badge_bg'
      assign c = section.settings[k_color]
      assign bg = section.settings[k_bg] | default: '#16150f'
      assign fg = '#ffffff'
      assign bg_light = bg | color_brightness
      if bg_light > 150
        assign fg = '#16150f'
      endif
    -%}
    .menu-hl--{{ n }} .megamenu__link-title,
    a.mobile-nav__link.menu-hl--{{ n }} {
      {%- if c != blank and c != 'rgba(0,0,0,0)' %}color: {{ c }} !important;{% endif -%}
      {%- if section.settings[k_bold] %}font-weight: 700 !important;{% endif -%}
    }
    .menu-hl--{{ n }} .menu-hl__badge {
      background: {{ bg }};
      color: {{ fg }};
    }
  {%- endfor -%}
  .menu-hl__badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 6px 1px;
    border-radius: 2px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: middle;
    text-decoration: none !important;
  }
{%- endstyle -%}
