{%- comment -%}
  Duńska nazwa opcji sortowania. Sklep dziala na jezyku 'en', wiec Shopify
  podaje nazwy po angielsku ("Best selling", "Price, low to high").
  @param {string} wartosc - option.value (np. 'best-selling')
  @param {string} nazwa - option.name, gdy wartosci nie ma na liscie
{%- endcomment -%}
{%- case wartosc -%}
  {%- when 'manual' -%}Featured
  {%- when 'relevance' -%}Most relevant
  {%- when 'best-selling' -%}Best selling
  {%- when 'title-ascending' -%}Alphabetically, A–Z
  {%- when 'title-descending' -%}Alphabetically, Z–A
  {%- when 'price-ascending' -%}Price, low to high
  {%- when 'price-descending' -%}Price, high to low
  {%- when 'created-ascending' -%}Date, old to new
  {%- when 'created-descending' -%}Date, new to old
  {%- else -%}{{ nazwa }}
{%- endcase -%}
