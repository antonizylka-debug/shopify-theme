{%- comment -%}
  Kafel produktu. Uklad wybrany przez Antoniego z makiety 10 wariantow:

  - zdjecia: wszystkie zdjecia produktu po kolei, jak w galerii zwyklego
    motywu Shopify - strzalki i kropki przechodza przez kazde,
  - na zdjeciu: procent rabatu w wygladzie wariantu 02 (czerwona
    plakietka, bialy napis),
  - pod zdjeciem: dwie kolumny (wariant 04) - po lewej nazwa i pod nia
    pigulka rabatu z wariantu 07, po prawej cena i pod nia przekreslona
    cena sprzed obnizki,
  - pod spodem: kolka kolorow (wariant 09).

  Cena jest czarna, jak w wariancie 07 - rabat mowia plakietka i pigulka.

  Argumenty
  - product: obiekt produktu
  - [per_row]: ile w rzedzie, do klas siatki motywu
  - [grid_item]: false, gdy kafel nie siedzi w siatce motywu
  - [rounded]: true dla wersji z zaokraglonym zdjeciem (rzad na PDP)

  Style i skrypt sa w sn-card-assets, wstawiane raz na strone.

  Swiadomie BEZ klasy grid-product. Na nia poluja reguly i skrypty starego
  kafla kolekcji (mierzenie, wysuwana karta, blur) i rozebralyby ten kafel.
{%- endcomment -%}

{%- liquid
  unless per_row
    assign per_row = 4
  endunless

  capture widok_siatki
    render 'products_per_row', products_per_row: per_row, style: 'fractions'
  endcapture

  assign na_promocji = false
  if product.compare_at_price > product.price
    assign na_promocji = true
    assign procent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign jeden = false
  if product.variants.size == 1 and product.variants.first.available
    assign jeden = true
  endif

  assign zdjecia = product.media | where: 'media_type', 'image'

  # Opcja koloru moze byc na dowolnej pozycji i miec dowolna nazwe
  # zaleznie od tego, skad przyszedl produkt.
  assign opcja_koloru = nil
  for o in product.options_with_values
    assign n = o.name | downcase
    if n == 'color' or n == 'colour' or n == 'farve' or n == 'kolor'
      assign opcja_koloru = o
    endif
  endfor
-%}

{%- capture krotka_nazwa -%}{%- render 'sn-krotka-nazwa', product: product -%}{%- endcapture -%}

{%- if grid_item != false -%}
<div class="grid__item {{ widok_siatki }} snc-item" data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}">
{%- endif -%}

  <div class="snc{% if rounded %} snc--round{% endif %}">
    <div class="snc__foto">
      <div class="snc__pas" data-snc-pas>
        {%- assign pokazane = 0 -%}
        {%- for m in zdjecia -%}
          <a class="snc__klatka" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {{ m.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 769px) 25vw, 50vw', alt: product.title, class: 'snc__img' }}
          </a>
          {%- assign pokazane = pokazane | plus: 1 -%}
        {%- endfor -%}
        {%- if pokazane == 0 -%}
          {%- assign pokazane = 1 -%}
          <a class="snc__klatka" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {{ 'product-1' | placeholder_svg_tag: 'snc__img placeholder-svg' }}
          </a>
        {%- endif -%}
      </div>

      {%- if na_promocji -%}
        <span class="snc__sale">−{{ procent }} %</span>
      {%- endif -%}

      {%- if pokazane > 1 -%}
        <button type="button" class="snc__strz snc__strz--l" data-snc-krok="-1" aria-label="{{ 'general.slider.previous_slide' | t }}">
          <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false"><path d="M8.5 1.5 2 8l6.5 6.5"/></svg>
        </button>
        <button type="button" class="snc__strz snc__strz--p" data-snc-krok="1" aria-label="{{ 'general.slider.next_slide' | t }}">
          <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false"><path d="M1.5 1.5 8 8l-6.5 6.5"/></svg>
        </button>
        <div class="snc__kropki" aria-hidden="true">
          {%- for k in (1..pokazane) -%}
            <span class="snc__kropka{% if forloop.first %} is-on{% endif %}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <button
        type="button"
        class="snc__plus"
        {% if jeden %}data-snc-dodaj="{{ product.variants.first.id }}"{% else %}data-snq-otworz="{{ product.handle }}"{% endif %}
        data-snq-nazwa="{{ krotka_nazwa }}"
        aria-label="{% if jeden %}Add to cart{% else %}Select size and color{% endif %}">
        <svg class="snc__ikona" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
        <svg class="snc__ikona-ok" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5 10 17.5 19 7"/></svg>
      </button>
    </div>

    <a class="snc__opis" href="{{ product.url }}">
      <span class="snc__rzad">
        <span class="snc__lewa">
          <span class="snc__nazwa">{{ krotka_nazwa }}</span>
          {%- if na_promocji -%}
            <span class="snc__pigulka">−{{ procent }} %</span>
          {%- endif -%}
        </span>
        <span class="snc__ceny">
          {%- if na_promocji -%}
            <span class="snc__jest">{%- render 'sn-cena', kwota: product.price -%}</span>
            <span class="snc__bylo">{%- render 'sn-cena', kwota: product.compare_at_price -%}</span>
          {%- else -%}
            <span class="snc__jest">{% if product.price_varies %}<span class="snc__od">From</span> {% endif %}{%- render 'sn-cena', kwota: product.price -%}</span>
          {%- endif -%}
        </span>
      </span>

      {%- if opcja_koloru != nil and opcja_koloru.values.size > 1 -%}
        {%- liquid
          assign maks = 4
          assign nadmiar = opcja_koloru.values.size | minus: maks
        -%}
        <span class="snc__kolory">
          {%- for w in opcja_koloru.values limit: maks -%}
            {%- liquid
              assign tlo = ''
              assign obraz = nil
              if w.swatch.color
                assign tlo = w.swatch.color
              elsif w.swatch.image
                assign obraz = w.swatch.image
              else
                capture tlo
                  render 'sn-kolor', nazwa: w
                endcapture
                assign tlo = tlo | strip
                if tlo == blank and w.variant.featured_media
                  assign obraz = w.variant.featured_media
                endif
              endif
            -%}
            <span
              class="snc__kolko"
              title="{{ w | escape }}"
              style="
                {%- if tlo == 'multi' -%}background: conic-gradient(#c2415a, #f0b48a, #d1a32a, #557a55, #4a6fa5, #6b4a8a, #c2415a);
                {%- elsif tlo != blank -%}background-color: {{ tlo }};
                {%- elsif obraz -%}background-image: url({{ obraz | image_url: width: 48 }});
                {%- endif -%}
              "></span>
          {%- endfor -%}
          {%- if nadmiar > 0 -%}
            <span class="snc__wiecej">+{{ nadmiar }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>
  </div>

{%- if grid_item != false -%}
</div>
{%- endif -%}
