{%- if settings.cart_type == 'drawer' -%}
  {%- comment -%}
    Szuflada koszyka w stylu icon-amsterdam (styl i JS: sn-kurv-assets).
    Elementy, ktorych uzywa JS motywu, zostaja: [data-products],
    [data-discounts], [data-subtotal] (ukryte), .cart__checkout.
    Bez licznika "rezerwacji" - koszyk niczego nie rezerwuje.
  {%- endcomment -%}
  {%- render 'sn-kurv-assets' -%}
  {%- render 'sn-card-assets' -%}
  <div id="CartDrawer" class="drawer drawer--right">
    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents" data-location="cart-drawer">
      <div class="drawer__fixed-header">
        <div class="drawer__header appear-animation appear-delay-1">
          <div class="h2 drawer__title">
            {{ 'cart.general.title' | t }}
            <span class="snk-count" data-snk-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
          </div>
          <div class="drawer__close">
            <button type="button" class="drawer__close-button js-drawer-close">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg>
              <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="drawer__inner">
        <div class="drawer__scrollable">
          {%- comment -%}
            Zielony pasek jak na icon-amsterdam, ale z prawdziwym czasem:
            odliczanie do konca kampanii (Ustawienia motywu -> Campaign ->
            Campaign ends at). Bez daty albo po terminie - zdanie z sn_kurv_note.
          {%- endcomment -%}
          {%- if settings.campaign_end != blank -%}
            <p class="snk-note snk-note--timer" data-sn-licznik data-slut="{{ settings.campaign_end | escape }}" hidden>
              {{ settings.campaign_name | split: '·' | first | strip }} <span data-sn-etykieta>slutter om</span> <span data-sn-czas></span>
            </p>
            {%- render 'sn-licznik' -%}
          {%- endif -%}
          {%- if settings.sn_kurv_note != blank -%}
            <p class="snk-note">{{ settings.sn_kurv_note }}</p>
          {%- endif -%}
          {%- comment -%}
            Licznik 10 minut (06.10.2026, na prosbe Antoniego - strona demo).
            Startuje przy pierwszym produkcie w koszyku, przy 0 znika. Niczego
            nie usuwa i nie rezerwuje - tekst nie moze mowic o rezerwacji.
            Wlasna klasa, bo .snk-note chowa sie, gdy dziala licznik akcji.
            Styl i JS: koniec sn-kurv-assets.
          {%- endcomment -%}
          {%- if settings.sn_rez_show -%}
            <p class="snk-rez" data-sn-rez data-min="{{ settings.sn_rez_minutes }}" data-tekst="{{ settings.sn_rez_text | escape }}" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 1.5M9.5 2.5h5"/></svg>
              <span data-sn-rez-txt></span>
            </p>
          {%- endif -%}
          {%- render 'sn-prog-rabatu', kompakt: true -%}

          <div data-products class="appear-animation appear-delay-2"></div>

          <div data-snk-forslag>{%- render 'sn-kurv-forslag' -%}</div>

          {% if settings.cart_notes_enable %}
            <div class="appear-animation appear-delay-3">
              <label for="CartNoteDrawer">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer">{{ cart.note }}</textarea>
            </div>
          {% endif %}
        </div>

        <div class="drawer__footer appear-animation appear-delay-4">
          <div data-discounts class="snk-hidden"></div>
          <div data-subtotal class="snk-hidden">{%- render 'sn-cena', kwota: cart.total_price -%}</div>

          {%- render 'sn-kurv-total' -%}

          {% if settings.cart_terms_conditions_enable %}
            <div class="cart__item-row cart__terms">
              <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
              <label for="CartTermsDrawer">
                {% if settings.cart_terms_conditions_page != blank %}
                  {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
                {% else %}
                  {{ 'cart.general.terms' | t }}
                {% endif %}
              </label>
            </div>
          {% endif %}

          {%- comment -%}
            Godzina graniczna (06.10.2026): do niej w dni robocze zamowienie jest
            przekazywane do realizacji tego samego dnia. Liczy do prawdziwej godziny
            z ustawien (czas dunski), po niej podaje nastepny dzien roboczy. Nie mowi
            "wyslemy dzis" - wysylka trwa 3-4 dni robocze.
          {%- endcomment -%}
          {%- if settings.sn_cutoff_show -%}
            <p class="snk-cutoff" data-sn-cutoff data-godz="{{ settings.sn_cutoff_hour }}"
               data-tekst="{{ settings.sn_cutoff_text | escape }}" data-tekst-nast="{{ settings.sn_cutoff_text_next | escape }}" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span data-sn-cutoff-txt></span>
            </p>
          {%- endif -%}

          <div class="cart__checkout-wrapper">
            <button type="submit" name="checkout" data-terms-required="{{ settings.cart_terms_conditions_enable }}" class="btn cart__checkout">
              {{ 'cart.general.checkout' | t }}
            </button>

            {% if additional_checkout_buttons and settings.cart_additional_buttons %}
              <div class="additional-checkout-buttons additional-checkout-buttons--vertical">{{ content_for_additional_checkout_buttons }}</div>
            {% endif %}
          </div>

          {%- comment -%} Trzy ikony zaufania pod przyciskiem (wzor od Antoniego). {%- endcomment -%}
          <div class="snk-trust">
            <div class="snk-trust__i">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><path d="M2 6h11v9H2zM13 9h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="6" cy="17" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.4"/><circle cx="16.5" cy="17" r="1.8" fill="#fff" stroke="currentColor" stroke-width="1.4"/></svg>
              <span><b>Gratis fragt</b>På alle ordrer</span>
            </div>
            <div class="snk-trust__i">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M3.5 7 12 11.5 20.5 7M12 11.5v10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              <span><b>30 dages returret</b>Nem og enkel</span>
            </div>
            <div class="snk-trust__i">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              <span><b>Sikker betaling</b>Krypteret</span>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%}
        Pusty koszyk jak na icon-amsterdam: naglowek, jedno zdanie,
        przycisk i dwa kafle kolekcji ze zdjeciem. Pusty koszyk to
        slepa uliczka - bez tego klientka zamyka szuflade i nie ma
        dokad isc dalej.

        Napisy, kolekcje i zdjecia ustawia sie w edytorze: Ustawienia
        motywu -> Koszyk -> Empty cart.
      {%- endcomment -%}
      {%- liquid
        # Zapas to kolekcje, ktore naprawde maja produkty. new-women i
        # womens-favorites sa w sklepie puste (sprawdzone: zero produktow),
        # a kafel prowadzacy do pustej strony jest gorszy niz zaden.
        # Wybrana w edytorze kolekcja bez produktow tez spada na zapas.
        assign k1 = collections[settings.cart_empty_c1]
        if k1 == blank or k1.handle == blank or k1.products_count == 0
          assign k1 = collections['womens-dresses']
        endif
        assign k2 = collections[settings.cart_empty_c2]
        if k2 == blank or k2.handle == blank or k2.products_count == 0
          assign k2 = collections['womens']
        endif

        assign obraz1 = settings.cart_empty_c1_image
        if obraz1 == blank
          assign obraz1 = k1.image
        endif
        if obraz1 == blank
          assign obraz1 = k1.products.first.featured_media.preview_image
        endif

        assign obraz2 = settings.cart_empty_c2_image
        if obraz2 == blank
          assign obraz2 = k2.image
        endif
        if obraz2 == blank
          assign obraz2 = k2.products.first.featured_media.preview_image
        endif

        assign link_btn = settings.cart_empty_btn_url
        if link_btn == blank
          assign link_btn = routes.all_products_collection_url
        endif
      -%}

      <div class="drawer__cart-empty appear-animation appear-delay-2">
        <div class="drawer__scrollable">
          <div class="snpk">
            <p class="snpk__tytul">{{ settings.cart_empty_title }}</p>
            {%- if settings.cart_empty_sub != blank -%}
              <p class="snpk__pod">{{ settings.cart_empty_sub }}</p>
            {%- endif -%}
            {%- if settings.cart_empty_btn != blank -%}
              <a class="snpk__btn" href="{{ link_btn }}">{{ settings.cart_empty_btn }}</a>
            {%- endif -%}

            <div class="snpk__kafle">
              {%- if k1 != blank and k1.url != blank -%}
                <a class="snpk__kafel" href="{{ k1.url }}">
                  {%- if obraz1 -%}
                    {{ obraz1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'snpk__img', alt: '', widths: '300,450,600' }}
                  {%- endif -%}
                  <span class="snpk__napis">{{ settings.cart_empty_c1_label | default: k1.title }}</span>
                </a>
              {%- endif -%}
              {%- if k2 != blank and k2.url != blank -%}
                <a class="snpk__kafel" href="{{ k2.url }}">
                  {%- if obraz2 -%}
                    {{ obraz2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'snpk__img', alt: '', widths: '300,450,600' }}
                  {%- endif -%}
                  <span class="snpk__napis">{{ settings.cart_empty_c2_label | default: k2.title }}</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      <style>
        {%- comment -%}
          Przy pustym koszyku zostaje sam krzyzyk, jak we wzorze. Tytul
          "Kurv" nad komunikatem "Din kurv er tom" mowilby to samo dwa razy.
        {%- endcomment -%}
        .drawer.is-empty .drawer__title { visibility: hidden; }

        .snpk {
          padding: 44px 4px 24px;
          text-align: center;
        }
        .snpk__tytul {
          margin: 0;
          font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
          font-size: 24px;
          font-weight: 600;
          letter-spacing: 0.02em;
          text-transform: uppercase;
          line-height: 1.2;
        }
        .snpk__pod {
          margin: 10px 0 0;
          font-size: 16px;
          color: #6b6f76;
        }
        {%- comment -%}
          Przez #CartDrawer, nie sama klasa - motyw koloruje wszystkie
          linki w szufladzie swoim kolorem i napis wychodzil granatowy
          na czarnym, nieczytelny.
        {%- endcomment -%}
        #CartDrawer .snpk__btn,
        #CartDrawer .snpk__btn:hover { color: #ffffff; }
        .snpk__btn {
          display: inline-block;
          margin-top: 20px;
          padding: 13px 28px;
          background: #000000;
          color: #ffffff;
          font-size: 14px;
          font-weight: 600;
          letter-spacing: 0.04em;
          text-decoration: none;
          transition: background-color 0.18s ease;
        }
        .snpk__btn:hover { background: #2a2a2a; color: #ffffff; }

        .snpk__kafle {
          margin-top: 40px;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 2px;
        }
        .snpk__kafel {
          position: relative;
          display: block;
          aspect-ratio: 2 / 3;
          overflow: hidden;
          background: #f1efec;
          color: #ffffff;
          text-decoration: none;
        }
        #CartDrawer .snpk__napis { color: #ffffff; }
        .snpk__img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
          transition: transform 0.6s ease;
        }
        .snpk__kafel:hover .snpk__img { transform: scale(1.03); }
        {%- comment -%}
          Przyciemnienie tylko na dole, pod napisem. Biale litery na jasnym
          zdjeciu bez tego po prostu znikaja.
        {%- endcomment -%}
        .snpk__kafel::after {
          content: "";
          position: absolute;
          inset: 45% 0 0 0;
          background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
          pointer-events: none;
        }
        .snpk__napis {
          position: absolute;
          left: 8px; right: 8px; bottom: 18px;
          z-index: 1;
          font-size: 15px;
          font-weight: 600;
          letter-spacing: 0.04em;
          text-transform: uppercase;
          line-height: 1.2;
          color: #ffffff;
        }
      </style>
    </form>
  </div>
{%- endif -%}
