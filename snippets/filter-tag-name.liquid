{% comment %}
  Dunska nazwa grupy dla prefiksu tagu, np. "Dress Style" => "Stil",
  "Sleeve Length" => "Ærmelængde". Najpierw pelny prefiks, potem ostatnie
  slowo, a jak nic nie pasuje - prefiks bez zmian.

  Parametry:
   - prefix (wymagany) - czesc tagu przed dwukropkiem
{% endcomment %}

{%- liquid
  assign key = prefix | downcase | strip
  assign full_map = 'merchandising|Selection,sleeve length|Sleeve length,heel height|Heel height,leg length|Leg length,toe shape|Toe shape,neckline|Neckline,neck line|Neckline,waist rise|Rise' | split: ','
  assign word_map = 'style|Style,length|Length,fit|Fit,sleeve|Sleeves,sleeves|Sleeves,material|Material,fabric|Material,pattern|Pattern,print|Pattern,occasion|Occasion,rise|Rise,closure|Closure,heel|Heel,collar|Collar,season|Season,detail|Details,details|Details,silhouette|Silhouette,shape|Shape,lining|Lining,type|Type,cut|Cut,wash|Wash,weight|Weight'
  assign word_map = word_map | split: ','
  assign result = ''

  for pair in full_map
    assign kv = pair | split: '|'
    if kv[0] == key
      assign result = kv[1]
      break
    endif
  endfor

  if result == blank
    assign last_word = key | split: ' ' | last
    for pair in word_map
      assign kv = pair | split: '|'
      if kv[0] == last_word
        assign result = kv[1]
        break
      endif
    endfor
  endif

  if result == blank
    assign result = prefix | strip
  endif
-%}
{{- result -}}
