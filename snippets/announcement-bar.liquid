{%- liquid
  assign show_announcement = false
  assign announcement_block_count = 0
  for block in section.blocks
    if block.type == 'announcement' or block.type == '@app'
      assign show_announcement = true
      assign announcement_block_count = announcement_block_count | plus: 1
    endif
  endfor

  # uklad: wszystkie wiadomosci naraz w jednym rzedzie, czy przewijane po kolei
  assign announcement_row = false
  if section.settings.announcement_layout == 'row'
    assign announcement_row = true
  endif

  assign separator = '·'
  case section.settings.announcement_separator
    when 'line'
      assign separator = '|'
    when 'dash'
      assign separator = '—'
    when 'none'
      assign separator = ''
  endcase
-%}

{% if show_announcement %}
  {%- if section.settings.announcement_layout == 'arrows' -%}
    {%- comment -%}
      Jedna wiadomosc naraz ze strzalkami po bokach, zmiana co kilka sekund -
      jak pasek u Oliver & Blake. Strzalki pokazuja sie przy 2+ wiadomosciach.
    {%- endcomment -%}
    <div class="announcement-bar announcement-arrows" data-announcement-arrows data-interval="{{ section.settings.announcement_interval | default: 5 }}">
      {%- if announcement_block_count > 1 -%}
        <button type="button" class="announcement-arrows__btn announcement-arrows__btn--prev" data-announcement-prev aria-label="Forrige">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 16" width="10" height="16"><path d="M8.5 1.5 2 8l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
      {%- endif -%}
      <div class="announcement-arrows__track">
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'announcement' or block.type == '@app' -%}
            <div class="announcement-arrows__slide{% if slide_index == 0 %} is-active{% endif %}" data-announcement-slide {{ block.shopify_attributes }}>
              {%- if block.type == '@app' -%}
                {%- render block -%}
              {%- else -%}
                {%- if block.settings.link != blank -%}<a class="announcement-link" href="{{ block.settings.link }}">{%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="announcement-arrows__title">{{ block.settings.text }}</span>
                  {%- endif -%}
                  {%- if block.settings.link_text != blank -%}
                    <span class="announcement-arrows__text">{{ block.settings.link_text }}</span>
                  {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              {%- endif -%}
            </div>
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if announcement_block_count > 1 -%}
        <button type="button" class="announcement-arrows__btn announcement-arrows__btn--next" data-announcement-next aria-label="Næste">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 16" width="10" height="16"><path d="M1.5 1.5 8 8l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- elsif announcement_row -%}
    <div class="announcement-bar announcement-bar--row">
      <div class="page-width">
        <div class="announcement-row">
          {%- assign item_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'announcement' or block.type == '@app' -%}
              {%- if item_index > 0 and separator != blank -%}
                <span class="announcement-row__sep" aria-hidden="true">{{ separator }}</span>
              {%- endif -%}

              <span class="announcement-row__item" {{ block.shopify_attributes }}>
                {%- if block.type == '@app' -%}
                  {%- render block -%}
                {%- else -%}
                  {%- if block.settings.link != blank -%}
                    <a class="announcement-link" href="{{ block.settings.link }}">
                  {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <span class="announcement-text">{{ block.settings.text }}</span>
                    {%- endif -%}
                    {%- if block.settings.link_text != blank -%}
                      <span class="announcement-link-text">{{ block.settings.link_text }}</span>
                    {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </span>

              {%- assign item_index = item_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="announcement-bar">
      <div class="page-width">
        <div class="slideshow-wrapper">
          <button type="button" class="visually-hidden slideshow__pause" data-id="{{ section.id }}" aria-live="polite">
            <span class="slideshow__pause-stop">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-pause" viewBox="0 0 10 13"><path d="M0 0h3v13H0zm7 0h3v13H7z" fill-rule="evenodd"/></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.pause_slideshow' | t }}</span>
            </span>
            <span class="slideshow__pause-play">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.play_slideshow' | t }}</span>
            </span>
          </button>

          <div
            id="AnnouncementSlider"
            class="announcement-slider"
            data-compact="{{ section.settings.announcement_compact }}"
            data-block-count="{{ announcement_block_count }}">
            {%- assign slide_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div
                  id="AnnouncementSlide-{{ block.id }}"
                  class="announcement-slider__slide"
                  data-index="{{ slide_index }}"
                  {{ block.shopify_attributes }}
                >
                  {%- render block -%}
                </div>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
              {%- if block.type == 'announcement' -%}
                <div
                  id="AnnouncementSlide-{{ block.id }}"
                  class="announcement-slider__slide"
                  data-index="{{ slide_index }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.link != blank -%}
                    <a class="announcement-link" href="{{ block.settings.link }}">
                  {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <span class="announcement-text">{{ block.settings.text }}</span>
                    {%- endif -%}
                    {%- if block.settings.link_text != blank -%}
                      <span class="announcement-link-text">{{ block.settings.link_text }}</span>
                    {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{% endif %}
