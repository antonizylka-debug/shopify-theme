{%- comment -%}
  Rzad kategorii pod naglowkiem (jak na hang-eleven.com: All Items / New In / Jackets...), 03.11.2026.
  Kategorie biora sie z menu glownego (podmenu "Women" i "Men"), zadnych nowych tresci.
  Ktora plec pokazac:
   1. miejsce, w ktorym klient jest: damska kolekcja albo damski produkt -> Women, meska -> Men (po uchwycie kolekcji),
   2. inaczej ostatni wybor klienta (przelacznik Women / Men, zapamietany w przegladarce),
   3. inaczej Women.
  Parametr: menu - lista linkow glownego menu.
{%- endcomment -%}
{%- liquid
  assign dpr_women = nil
  assign dpr_men = nil
  for l in menu.links
    assign t = l.title | downcase | strip
    if t == 'women'
      assign dpr_women = l
    elsif t == 'men'
      assign dpr_men = l
    endif
  endfor

  assign dpr_handles = ''
  if template.name == 'collection'
    assign dpr_handles = collection.handle
  elsif template.name == 'product'
    if collection
      assign dpr_handles = collection.handle
    else
      assign dpr_handles = product.collections | map: 'handle' | join: ' '
    endif
  endif
  assign dpr_auto = ''
  if dpr_handles contains 'women'
    assign dpr_auto = 'women'
  elsif dpr_handles contains 'men'
    assign dpr_auto = 'men'
  endif
-%}
{%- if dpr_women != nil and dpr_men != nil -%}
  <nav class="dpr" aria-label="Categories" data-dpr data-dpr-auto="{{ dpr_auto }}">
    <div class="dpr__track">
      <div class="dpr__sw" role="group" aria-label="Women or men">
        <button type="button" class="dpr__g" data-dpr-g="women" aria-pressed="false">{{ dpr_women.title }}</button>
        <button type="button" class="dpr__g" data-dpr-g="men" aria-pressed="false">{{ dpr_men.title }}</button>
      </div>
      {%- for g in (1..2) -%}
        {%- if g == 1 -%}{%- assign dpr_l = dpr_women -%}{%- assign dpr_key = 'women' -%}{%- else -%}{%- assign dpr_l = dpr_men -%}{%- assign dpr_key = 'men' -%}{%- endif -%}
        <ul class="dpr__list" data-dpr-list="{{ dpr_key }}" hidden>
          <li><a href="{{ dpr_l.url }}" data-dpr-link>All items</a></li>
          {%- for c in dpr_l.links -%}
            <li><a href="{{ c.url }}" data-dpr-link>{{ c.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </nav>

  <style>
    .dpr { background: #fff; border-bottom: 1px solid #e5e5e5; }
    .dpr__track { display: flex; align-items: center; gap: 20px; overflow-x: auto; white-space: nowrap; padding: 6px 15px; scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
    .dpr__track::-webkit-scrollbar { display: none; width: 0; height: 0; }
    .dpr__sw { display: flex; gap: 12px; flex: 0 0 auto; padding-right: 20px; border-right: 1px solid #e5e5e5; }
    .dpr__g { padding: 4px 0; border: 0; background: none; color: #939393; font-family: inherit; font-size: 10px !important; line-height: 16px; letter-spacing: 0.3px !important; text-transform: uppercase !important; cursor: pointer; }
    .dpr__g[aria-pressed="true"] { color: #000; text-decoration: underline; text-underline-offset: 4px; }
    .dpr__list { display: flex; gap: 20px; margin: 0; padding: 0; list-style: none; flex: 0 0 auto; }
    .dpr__list[hidden] { display: none; }
    .dpr__list a { display: block; padding: 4px 0; color: #000; font-size: 14px !important; line-height: 16px; letter-spacing: 0.42px !important; text-transform: none !important; text-decoration: none; }
    .dpr__list a.is-on { font-weight: 700 !important; text-decoration: underline; text-underline-offset: 4px; }
    @media (min-width: 769px) { .dpr__track { padding-left: 20px; padding-right: 20px; } .dpr__sw { display: none; } }
    /* na komputerze gorne menu ma juz Men i Women, wiec przelacznik w rzedzie jest zbedny; na telefonie zostaje, bo tam jest tylko hamburger */
  </style>

  <script>
    (function () {
      var nav = document.querySelector('[data-dpr]');
      if (!nav) return;
      var KEY = 'dp-gender';
      var auto = nav.getAttribute('data-dpr-auto');
      var stored = null;
      try { stored = localStorage.getItem(KEY); } catch (e) {}
      var now = (auto === 'women' || auto === 'men') ? auto : ((stored === 'women' || stored === 'men') ? stored : 'women');
      function show(g, save) {
        now = g;
        Array.prototype.forEach.call(nav.querySelectorAll('[data-dpr-list]'), function (u) { u.hidden = u.getAttribute('data-dpr-list') !== g; });
        Array.prototype.forEach.call(nav.querySelectorAll('[data-dpr-g]'), function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-dpr-g') === g ? 'true' : 'false'); });
        if (save) { try { localStorage.setItem(KEY, g); } catch (e) {} }
      }
      var path = location.pathname.replace(/\/$/, '');
      Array.prototype.forEach.call(nav.querySelectorAll('[data-dpr-link]'), function (a) {
        var p = (a.getAttribute('href') || '').split('?')[0].replace(/\/$/, '');
        if (p && p === path) a.classList.add('is-on');
      });
      /* miejsce, w ktorym klient jest, jest wazniejsze niz stary wybor - zapisujemy je jako nowy wybor */
      show(now, auto === 'women' || auto === 'men');
      nav.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-dpr-g]') : null;
        if (b) show(b.getAttribute('data-dpr-g'), true);
      });
      /* klik "Shop Men" / "Shop Women" na stronie glownej tez przestawia rzad */
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || a.closest('[data-dpr]')) return;
        var h = (a.getAttribute('href') || '').split('?')[0];
        if (/\/collections\/womens?(-|$)|\/collections\/new-women/.test(h)) { try { localStorage.setItem(KEY, 'women'); } catch (x) {} }
        else if (/\/collections\/mens?(-|$)|\/collections\/new-men/.test(h)) { try { localStorage.setItem(KEY, 'men'); } catch (x) {} }
      }, true);
    })();
  </script>
{%- endif -%}
