{% comment %}
  Blok kontaktowy w stopce: naglowek + wiersze z ikona.
  Pusty wiersz sie nie renderuje.
  Parametry:
   - block (wymagany)
{% endcomment %}

<div class="footer__item-padding">
  {%- if block.settings.title != blank -%}
    <h2 class="h4 footer__title">{{ block.settings.title | escape }}</h2>
  {%- endif -%}

  <ul class="no-bullets footer__contact">
    {%- if block.settings.email != blank -%}
      <li class="footer__contact-row">
        <svg aria-hidden="true" focusable="false" role="presentation" class="footer__contact-icon" viewBox="0 0 16 16">
          <rect x="1" y="3" width="14" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/>
          <path d="m1.5 4 6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.2"/>
        </svg>
        <a href="mailto:{{ block.settings.email | strip }}">{{ block.settings.email | escape }}</a>
      </li>
    {%- endif -%}

    {%- if block.settings.phone != blank -%}
      <li class="footer__contact-row">
        <svg aria-hidden="true" focusable="false" role="presentation" class="footer__contact-icon" viewBox="0 0 16 16">
          <path d="M5.2 1.8 6.8 5 5.3 6.6c.9 1.8 2.3 3.2 4.1 4.1L11 9.2l3.2 1.6v3c0 .6-.5 1.1-1.1 1C6.4 14.2 1.8 9.6 1.2 2.9c-.1-.6.4-1.1 1-1.1h3Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        <a href="tel:{{ block.settings.phone | strip | remove: ' ' }}">{{ block.settings.phone | escape }}</a>
      </li>
    {%- endif -%}

    {%- if block.settings.hours != blank -%}
      <li class="footer__contact-row">
        <svg aria-hidden="true" focusable="false" role="presentation" class="footer__contact-icon" viewBox="0 0 16 16">
          <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.2"/>
          <path d="M8 4.2V8l2.6 1.6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span>{{ block.settings.hours | escape }}</span>
      </li>
    {%- endif -%}

    {%- if block.settings.address != blank -%}
      <li class="footer__contact-row">
        <svg aria-hidden="true" focusable="false" role="presentation" class="footer__contact-icon" viewBox="0 0 16 16">
          <path d="M8 1.6c2.5 0 4.5 2 4.5 4.5 0 3.2-4.5 8.3-4.5 8.3S3.5 9.3 3.5 6.1c0-2.5 2-4.5 4.5-4.5Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <circle cx="8" cy="6.1" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        </svg>
        <span>{{ block.settings.address | escape }}</span>
      </li>
    {%- endif -%}
  </ul>
</div>
