{%- comment -%}
  Custom-styled dropdown for a single product option (used for Størrelse/Size).

  A real native <select data-variant-input> drives the theme's existing
  variant-switching JS (untouched) — it's just visually hidden. The visible
  flyout (opener button + list with price/availability per row) is a pure UI
  layer: clicking a row sets the real select's value and dispatches a native
  'change' event on it, so the theme handles the actual variant update
  exactly as if the native dropdown had been used directly.
{%- endcomment -%}

{%- liquid
  assign option_index = forloop.index
  assign current_variant = product.selected_or_first_available_variant
  assign selected_value = option.selected_value
-%}

<div class="variant-wrapper js" data-type="dropdown">
  <div class="sz-head">
    <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
      for="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
      {{ option.name }}
    </label>

    <a class="sz-guide" href="/pages/storrelsesguide">
      <span class="sz-guide-q">Usikker på din størrelse?</span>
      <span class="sz-guide-a">Brug <u>Størrelsesguiden ↓</u></span>
    </a>
  </div>

  <size-flyout class="sz-wrap" data-option-index="option{{ option_index }}">

    {%- comment -%} Real native select — visually hidden, functionally untouched {%- endcomment -%}
    <select
      form="{{ form_id }}"
      data-variant-input
      data-sz-native-select
      id="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}"
      data-index="option{{ option_index }}"
      class="sz-native-select">
      {%- for value in option.values -%}
        <option
          value="{{ value | escape }}"
          {% if option.selected_value == value %} selected="selected"{% endif %}
          name="{{ option.name }}"
          data-index="option{{ option_index }}">
          {{ value }}
        </option>
      {%- endfor -%}
    </select>

    <button type="button" class="sz-opener" data-sz-opener aria-expanded="false" aria-haspopup="listbox">
      <span class="sz-opener-text" data-sz-current>
        {%- if product.selected_variant -%}{{ selected_value }}{%- else -%}Vælg størrelse{%- endif -%}
      </span>
      <svg class="sz-caret" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3.5 6l4.5 4.5L12.5 6" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <ul class="sz-list" data-sz-list role="listbox" hidden>
      {%- for value in option.values -%}
        {%- liquid
          assign row_variant = null
          assign row_variant_fallback = null
          for v in product.variants
            case option_index
              when 1
                assign v_val = v.option1
              when 2
                assign v_val = v.option2
              else
                assign v_val = v.option3
            endcase

            if v_val == value
              assign match_others = true
              if option_index != 1 and v.option1 != current_variant.option1
                assign match_others = false
              endif
              if option_index != 2 and v.option2 != current_variant.option2
                assign match_others = false
              endif
              if option_index != 3 and v.option3 != current_variant.option3
                assign match_others = false
              endif

              if match_others
                assign row_variant = v
                break
              endif

              if row_variant_fallback == null
                assign row_variant_fallback = v
              endif
            endif
          endfor

          if row_variant == null
            assign row_variant = row_variant_fallback
          endif

          assign row_is_selected = false
          if value == selected_value and product.selected_variant
            assign row_is_selected = true
          endif
        -%}

        <li role="option" data-sz-row data-value="{{ value | escape }}" {% if row_is_selected %}aria-selected="true"{% endif %}>
          <span class="sz-opt" data-available="{{ row_variant.available }}" {% unless row_variant.available %}aria-disabled="true"{% endunless %}>
            <span class="sz-radio" data-checked="{{ row_is_selected }}"></span>
            <span class="sz-opt-name">{{ value }}</span>
            <span class="sz-opt-right" data-sz-opt-right>
              {%- if row_variant.available -%}
                <span class="sz-opt-price">{{ row_variant.price | money }}</span>
                <span class="sz-opt-vat">inkl. moms</span>
              {%- else -%}
                <span class="sz-opt-note">Udsolgt</span>
              {%- endif -%}
            </span>
          </span>
        </li>
      {%- endfor -%}
    </ul>

  </size-flyout>
</div>

{%- comment -%} Variant data for live price/availability recompute when other options (e.g. color) change {%- endcomment -%}
<script type="application/json" data-sz-variants="option{{ option_index }}">
  {{ product.variants | json | replace: '</script', '<\/script' }}
</script>

{% stylesheet %}
  .sz-wrap {
    display: block;
    position: relative;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
    color: #000000;
  }

  .sz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .sz-head .variant__label[for] {
    margin-bottom: 0;
  }

  .sz-guide {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    text-decoration: none;
  }

  .sz-guide-q { color: #434343; }
  .sz-guide-a { color: #000000; }
  .sz-guide u { text-underline-offset: 2px; }

  .sz-native-select {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sz-opener {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 12px 18px;
    background: #ffffff;
    border: 1px solid #2A3743;
    border-radius: 4px;
    cursor: pointer;
    box-sizing: border-box;
    text-align: left;
    font-family: inherit;
  }

  .sz-opener-text {
    font-size: 16px;
    line-height: 22px;
    font-weight: 600;
    color: #2A3743;
  }

  .sz-caret {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: #2A3743;
    transition: transform 150ms ease;
  }

  .sz-opener[aria-expanded="true"] .sz-caret { transform: rotate(180deg); }

  .sz-list {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 50;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    background: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    max-height: 300px;
    overflow-y: auto;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .sz-list[hidden] { display: none; }

  .sz-opt {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 18px;
    color: #000000;
    cursor: pointer;
    border-bottom: 1px solid #ececec;
  }

  .sz-list li:last-child .sz-opt { border-bottom: 0; }

  .sz-opt:hover { background: #fafafa; }

  .sz-list li[aria-selected="true"] .sz-opt { background: #f5f5f5; }

  .sz-radio {
    position: relative;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border: 2px solid #000000;
    border-radius: 50%;
    box-sizing: border-box;
  }

  .sz-radio[data-checked="true"]::after {
    content: '';
    position: absolute;
    inset: 4px;
    background: #000000;
    border-radius: 50%;
  }

  .sz-opt-name {
    font-size: 16px;
    line-height: 22px;
    font-weight: 700;
    color: #000000;
    flex: 1 1 auto;
  }

  .sz-opt-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
  }

  .sz-opt-price {
    background: #e3ecf8;
    color: #1539cf;
    font-size: 15px;
    line-height: 21px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .sz-opt-vat {
    font-size: 11px;
    line-height: 15px;
    font-weight: 500;
    color: #434343;
  }

  .sz-opt[data-available="false"] { cursor: not-allowed; }

  .sz-opt[data-available="false"] .sz-opt-name { color: #9b9b9b; }

  .sz-opt[data-available="false"] .sz-radio { border-color: #c4c4c4; }

  .sz-opt-note {
    font-size: 13px;
    font-weight: 500;
    color: #9b9b9b;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .sz-guide { font-size: 11px; }
    .sz-opener { min-height: 52px; padding: 11px 15px; }
    .sz-opener-text { font-size: 15px; }
    .sz-opt { padding: 16px 15px; gap: 12px; }
    .sz-opt-name { font-size: 15px; }
    .sz-opt-price { font-size: 14px; }
  }

  @media (max-width: 380px) {
    .sz-guide-q { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  class SizeFlyout extends HTMLElement {
    connectedCallback() {
      if (this.dataset.szInit) return;
      this.dataset.szInit = '1';
      this.init();
    }

    init() {
      var root = this;
      var opener = root.querySelector('[data-sz-opener]');
      var list = root.querySelector('[data-sz-list]');
      var currentText = root.querySelector('[data-sz-current]');
      var nativeSelect = root.querySelector('[data-sz-native-select]');
      var optionIndexAttr = root.dataset.optionIndex;

      var variantsScript = document.querySelector('[data-sz-variants="' + optionIndexAttr + '"]');
      var variants = [];
      try {
        variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];
      } catch (e) {
        variants = [];
      }

      var container = root.closest('.product-block') || document;
      var moneyFormat = (window.theme && window.theme.settings && window.theme.settings.moneyFormat) || '${{amount}}';

      function formatMoney(cents) {
        if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
          return window.theme.Currency.formatMoney(cents, moneyFormat);
        }
        return (cents / 100).toFixed(2);
      }

      function open() {
        list.hidden = false;
        opener.setAttribute('aria-expanded', 'true');
      }

      function close() {
        list.hidden = true;
        opener.setAttribute('aria-expanded', 'false');
      }

      opener.addEventListener('click', function (e) {
        e.stopPropagation();
        list.hidden ? open() : close();
      });

      document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) close();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });

      list.querySelectorAll('[data-sz-row]').forEach(function (row) {
        var opt = row.querySelector('.sz-opt');
        opt.addEventListener('click', function () {
          if (opt.getAttribute('data-available') === 'false') return;

          var value = row.dataset.value;
          nativeSelect.value = value;
          nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));

          currentText.textContent = value;
          list.querySelectorAll('[data-sz-row]').forEach(function (r) {
            r.removeAttribute('aria-selected');
            r.querySelector('.sz-radio').setAttribute('data-checked', 'false');
          });
          row.setAttribute('aria-selected', 'true');
          row.querySelector('.sz-radio').setAttribute('data-checked', 'true');

          close();
        });
      });

      function getCurrentSelections(excludeIndex) {
        var selections = {};
        container.querySelectorAll('[data-variant-input]').forEach(function (el) {
          var idx = el.getAttribute('data-index');
          if (!idx || idx === excludeIndex) return;
          var value;
          if (el.tagName === 'SELECT') {
            value = el.value;
          } else if (el.type === 'radio') {
            if (!el.checked) return;
            value = el.value;
          }
          if (value !== undefined) selections[idx] = value;
        });
        return selections;
      }

      function findVariant(selections) {
        return variants.find(function (v) {
          for (var key in selections) {
            var num = key.replace('option', '');
            if (v['option' + num] !== selections[key]) return false;
          }
          return true;
        });
      }

      function refreshRows() {
        var baseSelections = getCurrentSelections(optionIndexAttr);

        list.querySelectorAll('[data-sz-row]').forEach(function (row) {
          var selections = Object.assign({}, baseSelections);
          selections[optionIndexAttr] = row.dataset.value;

          var variant = findVariant(selections);
          var opt = row.querySelector('.sz-opt');
          var right = row.querySelector('[data-sz-opt-right]');

          if (!variant) return;

          opt.setAttribute('data-available', variant.available);
          if (variant.available) {
            opt.removeAttribute('aria-disabled');
            right.innerHTML =
              '<span class="sz-opt-price">' + formatMoney(variant.price) + '</span>' +
              '<span class="sz-opt-vat">inkl. moms</span>';
          } else {
            opt.setAttribute('aria-disabled', 'true');
            right.innerHTML = '<span class="sz-opt-note">Udsolgt</span>';
          }
        });
      }

      container.querySelectorAll('[data-variant-input]').forEach(function (el) {
        if (el.getAttribute('data-index') === optionIndexAttr) return;
        el.addEventListener('change', refreshRows);
      });
    }
  }

  if (!customElements.get('size-flyout')) {
    customElements.define('size-flyout', SizeFlyout);
  }
{% endjavascript %}
