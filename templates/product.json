    "faq": {
      "type": "ob-faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "Hvor lang tid tager leveringen?",
            "answer": "<p>We pack and ship orders within 3–4 business days. Delivery then takes another 3–6 business days.</p><p>If you order at the weekend or on a public holiday, we start on your order the next business day.</p>",
            "open_by_default": true
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "How do I find my size?",
            "answer": "<p>Sizes vary from line to line, so go by the measurements on the product page rather than the size you usually wear.</p><p>The easiest check: lay a garment you own and like the fit of flat, measure it, and compare.</p>",
            "open_by_default": false
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Hvordan starter jeg en returnering?",
            "answer": "<p>Email <a href=\"mailto:kontakt@stilhusetnord.dk\">kontakt@stilhusetnord.dk</a> with your order number and the item you'd like to return, within 30 days of receiving it. We'll reply with the return address and short instructions.</p><p>Please wait for our reply before sending anything – packages sent back on your own often end up at a warehouse that can't process them.</p>",
            "open_by_default": false
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "It doesn't fit. Can I exchange the size?",
            "answer": "<p>We don't exchange sizes directly. Send the item back for a refund and place a new order in the size you want – that way the size isn't sold to someone else while your package is on its way.</p>",
            "open_by_default": false
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "Hvem betaler returfragten?",
            "answer": "<p>You do – unless the item was faulty, damaged or not what you ordered. Then we pay.</p><p>Use a tracked shipping service. Until the package reaches us, it's your responsibility.</p>",
            "open_by_default": false
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "question": "Where do you ship, and do I pay duties?",
            "answer": "<p>We ship across Canada – to every province and territory.</p><p>We cover duties, import fees and charges, so there's nothing extra to pay on delivery. We deliver to home addresses, businesses and pickup points.</p>",
            "open_by_default": false
          }
        }
      },
