        "q-27": {
          "type": "question",
          "settings": {
            "title": "How do I find my size?",
            "text": "<p>Sizing varies between ranges, so go by the measurements on the product page rather than the size you usually take.</p><p>The easiest check: measure a garment you already own and like the fit of, laid flat, and compare.</p>"
          }
        },
        "q-28": {
          "type": "question",
          "settings": {
            "title": "Where are the exact measurements?",
            "text": "<p>In the product description, under the images. If the measurement you need is not listed, email <a href=\"mailto:support@stilhusetnord.dk\">support@stilhusetnord.dk</a> with the product name and we will get it for you before you order.</p>"
          }
        },
        "q-29": {
          "type": "question",
          "settings": {
            "title": "How do I care for my item?",
            "text": "<p>Follow the care label in the garment &mdash; it takes priority over anything general.</p><p>As a rule: wash at 30&deg;C on a gentle cycle, turn prints and dark colours inside out, skip the tumble dryer, and dry knitwear flat rather than on a hanger.</p>"
          }
        }
