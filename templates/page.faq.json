        "q-2": {
          "type": "question",
          "settings": {
            "title": "How do I start a return?",
            "text": "Email support@daltonpierce.com within 14 days of receiving your order to register your return. We will provide you with the return address of our supplier. Ship the item back at your own expense, including any applicable customs duties or shipping fees. We strongly recommend using a tracked shipping service, as we cannot be held responsible for returns lost in transit without tracking."
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "title": "What can I return?",
            "text": "Returns can only be requested after you have physically received your order. Items must be unused, unwashed, undamaged and in their original condition, with all tags and labels still attached. Trying on items is permitted, but wearing them is not. Ordering multiple sizes with the intention of returning part of the order is not permitted."
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "title": "It doesn't fit. Can I exchange the size?",
            "text": "We don't exchange sizes directly. Return the item as described in our return policy and place a new order in the size you want. Please note that ordering multiple sizes with the intention of returning part of the order is not permitted."
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "title": "Who pays for return shipping?",
            "text": "You do. Return shipping costs are the full responsibility of the customer, including any international shipping fees and applicable customs duties. We strongly recommend using a tracked shipping service, as we cannot be held responsible for returns lost in transit without tracking."
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "title": "Where should I send my return?",
            "text": "To the return address of our supplier, which we send you after you've emailed support@daltonpierce.com to register your return."
          }
        },
        "q-7": {
          "type": "question",
          "settings": {
            "title": "My item is damaged or wrong. What now?",
            "text": "Email support@daltonpierce.com with your order number and a few photos, and we'll look into it. Nothing in our policies limits your rights under applicable consumer protection law."
          }
        },
        "q-8": {
          "type": "question",
          "settings": {
            "title": "Why do you need photos?",
            "text": "Photos help us see the problem and resolve it faster."
          }
        },
        "q-9": {
          "type": "question",
          "settings": {
            "title": "How long until I get my money back?",
            "text": "Once your returned item has been received and inspected, your return is processed within 14 days. You'll receive an email when your refund or store credit has been processed."
          }
        },
        "q-10": {
          "type": "question",
          "settings": {
            "title": "Do I get my money back?",
            "text": "It depends on what you bought. Regular-priced items: if the return meets all of our return conditions, you get a refund to your original payment method. Sale items and promotional purchases are not eligible for a refund – if the return is approved and all return conditions have been met, you receive store credit for a future purchase instead."
          }
        },
        "group-11": {
